{
  "name": "medol",
  "scopeName": "source.medol",
  "fileTypes": [
    ".medol",
    ".em"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.medol",
      "match": "\\b(actor|assert|automation|background|command|concept|condition|confirm|context|decision|deployment|derived|detail|dialog|domain|drawer|emits|enum|event|example|expression|false|form|format|from|generated|given|hotspot|id|import|includes|inline|integration|issue|length|list|matches|metric|note|null|on|oneOf|policy|projection|query|range|reactsTo|readmodel|reject|risk|rule|scenario|slice|source|specification|startsLifecycle|state|steps|subscribe|tags|target|technical|then|true|type|ui|unique|userJourney|value|view|when|wizard)\\b"
    },
    {
      "name": "string.quoted.double.medol",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.medol",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.medol",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.medol"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.medol"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.medol"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.medol"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.medol",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
