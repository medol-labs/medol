{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medol.dev/agent/task-protocols/build-slice.schema.json",
  "title": "BuildSliceTask",
  "type": "object",
  "required": ["taskId", "workspacePath", "sliceId", "target", "mode", "acceptanceCriteria"],
  "properties": {
    "taskId": { "type": "string" },
    "workspacePath": { "type": "string" },
    "modelPath": { "type": "string" },
    "codegenModelPath": { "type": "string" },
    "generationPlanPath": { "type": "string" },
    "sliceId": { "type": "string" },
    "target": {
      "type": "string",
      "enum": ["axon", "refine", "fullstack"]
    },
    "mode": {
      "type": "string",
      "enum": ["generate", "modify", "fix"]
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}

