{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medol.dev/agent/task-protocols/generate-docs.schema.json",
  "title": "GenerateDocsTask",
  "type": "object",
  "required": ["taskId", "workspaceId", "documentKind", "language"],
  "properties": {
    "taskId": { "type": "string" },
    "workspaceId": { "type": "string" },
    "medolSourcePath": { "type": "string" },
    "documentKind": {
      "type": "string",
      "enum": ["prd", "software-design", "database-design", "process", "acceptance"]
    },
    "language": {
      "type": "string",
      "enum": ["en-US", "zh-CN"]
    },
    "incremental": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}

