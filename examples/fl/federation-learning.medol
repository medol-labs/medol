  slice ReceiveParticipantExecutionPlan {
    startsLifecycle
    reactsTo ParticipantExecutionPlanDispatched

    automation ReceiveExecutionPlanWhenDispatched {
      on ParticipantExecutionPlanDispatched
      emits ReceiveParticipantExecutionPlan
    }

    command ReceiveParticipantExecutionPlan {
      executionPlanId: UUID id technical from ParticipantExecutionPlanDispatched.executionPlanId
      roundExecutionId: UUID from ParticipantExecutionPlanDispatched.executionPlanId
      executionSessionId: UUID from ParticipantExecutionPlanDispatched.executionSessionId
      trainingJobId: UUID from ParticipantExecutionPlanDispatched.trainingJobId
      trainingRunConfigurationId: UUID from ParticipantExecutionPlanDispatched.trainingRunConfigurationId
      featureSchemaId: UUID from ParticipantExecutionPlanDispatched.featureSchemaId
      roundId: UUID from ParticipantExecutionPlanDispatched.roundId
      roundNumber: Int from ParticipantExecutionPlanDispatched.roundNumber
      runtimeId: UUID from ParticipantExecutionPlanDispatched.runtimeId
      organizationId: UUID from ParticipantExecutionPlanDispatched.organizationId
      baseModelId: UUID from ParticipantExecutionPlanDispatched.baseModelId
      baseModelArtifactUri: String from ParticipantExecutionPlanDispatched.baseModelArtifactUri
      baseModelRegistryRef: String from ParticipantExecutionPlanDispatched.baseModelRegistryRef
      baseModelFormat: String from ParticipantExecutionPlanDispatched.baseModelFormat
      baseModelArtifactDigest: String from ParticipantExecutionPlanDispatched.baseModelArtifactDigest
      baseModelSignatureUri: String? from ParticipantExecutionPlanDispatched.baseModelSignatureUri
      secureAggregationRequired: Boolean from ParticipantExecutionPlanDispatched.secureAggregationRequired
      secureAggregationSessionId: UUID? from ParticipantExecutionPlanDispatched.secureAggregationSessionId
      encryptionScheme: String? from ParticipantExecutionPlanDispatched.encryptionScheme
      publicKeyVersion: String? from ParticipantExecutionPlanDispatched.publicKeyVersion
      publicKeyRef: String? from ParticipantExecutionPlanDispatched.publicKeyRef
      encryptedParameterScale: Int? from ParticipantExecutionPlanDispatched.encryptedParameterScale
    }

    event ExecutionPlanReceived {
      executionPlanId: UUID id technical
      roundExecutionId: UUID
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
    }

    state PlanReceived
  }

  slice AcceptExecutionPlan {
    reactsTo ExecutionPlanReceived
    port

    automation AcceptExecutionPlanWhenExecutionPlanReceived {
      on ExecutionPlanReceived
      emits AcceptExecutionPlan
    }

    command AcceptExecutionPlan {
      executionPlanId: UUID id technical from ExecutionPlanReceived.executionPlanId
      roundExecutionId: UUID from ExecutionPlanReceived.roundExecutionId
      executionSessionId: UUID from ExecutionPlanReceived.executionSessionId
      trainingJobId: UUID from ExecutionPlanReceived.trainingJobId
      trainingRunConfigurationId: UUID from ExecutionPlanReceived.trainingRunConfigurationId
      featureSchemaId: UUID from ExecutionPlanReceived.featureSchemaId
      roundId: UUID from ExecutionPlanReceived.roundId
      roundNumber: Int from ExecutionPlanReceived.roundNumber
      runtimeId: UUID from ExecutionPlanReceived.runtimeId
      organizationId: UUID from ExecutionPlanReceived.organizationId
      baseModelId: UUID from ExecutionPlanReceived.baseModelId
      baseModelArtifactUri: String from ExecutionPlanReceived.baseModelArtifactUri
      baseModelRegistryRef: String from ExecutionPlanReceived.baseModelRegistryRef
      baseModelFormat: String from ExecutionPlanReceived.baseModelFormat
      baseModelArtifactDigest: String from ExecutionPlanReceived.baseModelArtifactDigest
      baseModelSignatureUri: String? from ExecutionPlanReceived.baseModelSignatureUri
      secureAggregationRequired: Boolean from ExecutionPlanReceived.secureAggregationRequired
      secureAggregationSessionId: UUID? from ExecutionPlanReceived.secureAggregationSessionId
      encryptionScheme: String? from ExecutionPlanReceived.encryptionScheme
      publicKeyVersion: String? from ExecutionPlanReceived.publicKeyVersion
      publicKeyRef: String? from ExecutionPlanReceived.publicKeyRef
      encryptedParameterScale: Int? from ExecutionPlanReceived.encryptedParameterScale
    }

    event ExecutionPlanAccepted {
      executionPlanId: UUID id technical
      roundExecutionId: UUID
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
      localExecutionRequirementsSatisfied: Boolean
      runtimeIdentityMatched: Boolean
      runtimeDatasetBindingAvailable: Boolean
      datasetAccessValidated: Boolean
      baseModelAvailable: Boolean
      trainingConfigurationSupported: Boolean
      runtimeResourceAvailable: Boolean
      runtimeAgentIdle: Boolean
    }

    event ExecutionPlanRejected {
      executionPlanId: UUID id technical
      roundExecutionId: UUID
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
      localExecutionRequirementsSatisfied: Boolean
      runtimeIdentityMatched: Boolean
      runtimeDatasetBindingAvailable: Boolean
      datasetAccessValidated: Boolean
      baseModelAvailable: Boolean
      trainingConfigurationSupported: Boolean
      runtimeResourceAvailable: Boolean
      runtimeAgentIdle: Boolean
      rejectionReasons: String[]
    }

    state PlanAccepted

    specification "Execution Plan Local Acceptance Outcome" {
      rule """
        When a participant execution plan is received, the runtime agent performs a local readiness check before starting any training work. The check verifies that the plan targets this runtime, the required dataset binding exists, dataset access has already been validated, the base model is available, the requested training configuration is supported, sufficient local resources are available, and the runtime agent is idle. The port records exactly one outcome: ExecutionPlanAccepted when all local requirements are satisfied, or ExecutionPlanRejected with rejection reasons when any requirement fails.
      """

      scenario "Execution Plan Accepted" {
        given ExecutionPlanReceived {
          executionPlanId = "execution-plan-1"
        }
        when AcceptExecutionPlan {
          executionPlanId = "execution-plan-1"
        }
        then ExecutionPlanAccepted
      }

      scenario "Execution Plan Rejected" {
        given ExecutionPlanReceived {
          executionPlanId = "execution-plan-2"
        }
        when AcceptExecutionPlan {
          executionPlanId = "execution-plan-2"
        }
        then ExecutionPlanRejected
      }
    }
  }

  slice StartRoundExecution {
    reactsTo ExecutionPlanAccepted
    port

    automation StartRoundExecutionWhenPlanAccepted {
      on ExecutionPlanAccepted
      emits StartRoundExecution
    }

    command StartRoundExecution {
      roundExecutionId: UUID id technical from ExecutionPlanAccepted.roundExecutionId
      executionSessionId: UUID from ExecutionPlanAccepted.executionSessionId
      executionPlanId: UUID from ExecutionPlanAccepted.executionPlanId
      trainingJobId: UUID from ExecutionPlanAccepted.trainingJobId
      trainingRunConfigurationId: UUID from ExecutionPlanAccepted.trainingRunConfigurationId
      roundId: UUID from ExecutionPlanAccepted.roundId
      roundNumber: Int from ExecutionPlanAccepted.roundNumber
      runtimeId: UUID from ExecutionPlanAccepted.runtimeId
      organizationId: UUID from ExecutionPlanAccepted.organizationId
      featureSchemaId: UUID from ExecutionPlanAccepted.featureSchemaId
      baseModelId: UUID from ExecutionPlanAccepted.baseModelId
      baseModelArtifactUri: String from ExecutionPlanAccepted.baseModelArtifactUri
      baseModelRegistryRef: String from ExecutionPlanAccepted.baseModelRegistryRef
      baseModelFormat: String from ExecutionPlanAccepted.baseModelFormat
      baseModelArtifactDigest: String from ExecutionPlanAccepted.baseModelArtifactDigest
      baseModelSignatureUri: String? from ExecutionPlanAccepted.baseModelSignatureUri
      secureAggregationRequired: Boolean from ExecutionPlanAccepted.secureAggregationRequired
      secureAggregationSessionId: UUID? from ExecutionPlanAccepted.secureAggregationSessionId
      encryptionScheme: String? from ExecutionPlanAccepted.encryptionScheme
      publicKeyVersion: String? from ExecutionPlanAccepted.publicKeyVersion
      publicKeyRef: String? from ExecutionPlanAccepted.publicKeyRef
      encryptedParameterScale: Int? from ExecutionPlanAccepted.encryptedParameterScale
    }

    event RoundExecutionStarted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
      runtimeEngineJobId: String portOutput
    }

    event RoundExecutionStartFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
      runtimeEngineJobId: String?
      failureReason: String
    }

    state Running

    specification "Round Execution Runtime Engine Start Outcome" {
      rule """
        Starting a round execution is responsible for launching the local runtime engine on demand for this participant round, not for calling a pre-existing always-on engine. The adapter prepares the local training workspace and configuration, starts the matching runtime engine service, process, or container, submits the local model training job to that engine, and records the created runtimeEngineJobId. The port records exactly one outcome: RoundExecutionStarted when the runtime engine is running and the training job has been accepted, or RoundExecutionStartFailed when environment preparation, engine startup, model loading, resource allocation, or training job submission fails.
        Runtime engine model selection must come from the participant execution plan base model snapshot. Runtime agents must not decide the model plugin from local environment variables because the selected model is platform training configuration data.
        When secureAggregationRequired is true, StartRoundExecution must pass encryptionScheme, publicKeyVersion, publicKeyRef, and encryptedParameterScale to the runtime engine so the local model update is encrypted inside the participant runtime boundary before any update artifact is reported to the platform.
      """

      scenario "Round Execution Started" {
        given ExecutionPlanAccepted {
          executionPlanId = "execution-plan-1"
        }
        when StartRoundExecution {
          executionPlanId = "execution-plan-1"
        }
        then RoundExecutionStarted
      }

      scenario "Round Execution Start Failed" {
        given ExecutionPlanAccepted {
          executionPlanId = "execution-plan-2"
        }
        when StartRoundExecution {
          executionPlanId = "execution-plan-2"
        }
        then RoundExecutionStartFailed
      }
    }
  }

  slice ObserveRuntimeEngineJob {
    reactsTo RoundExecutionStarted
    port

    automation ObserveRuntimeEngineJobWhenRoundExecutionStarted {
      on RoundExecutionStarted
      emits ObserveRuntimeEngineJob
    }

    command ObserveRuntimeEngineJob {
      roundExecutionId: UUID id technical from RoundExecutionStarted.roundExecutionId
      executionSessionId: UUID from RoundExecutionStarted.executionSessionId
      executionPlanId: UUID from RoundExecutionStarted.executionPlanId
      trainingJobId: UUID from RoundExecutionStarted.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionStarted.trainingRunConfigurationId
      roundId: UUID from RoundExecutionStarted.roundId
      roundNumber: Int from RoundExecutionStarted.roundNumber
      runtimeId: UUID from RoundExecutionStarted.runtimeId
      organizationId: UUID from RoundExecutionStarted.organizationId
      featureSchemaId: UUID from RoundExecutionStarted.featureSchemaId
      runtimeEngineJobId: String from RoundExecutionStarted.runtimeEngineJobId
      secureAggregationRequired: Boolean from RoundExecutionStarted.secureAggregationRequired
      secureAggregationSessionId: UUID? from RoundExecutionStarted.secureAggregationSessionId
      encryptionScheme: String? from RoundExecutionStarted.encryptionScheme
      publicKeyVersion: String? from RoundExecutionStarted.publicKeyVersion
    }

    event RuntimeEngineJobObserved {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      runtimeEngineJobId: String
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      observedStatus: String
      failureReason: String?
      localUpdateArtifactRef: String?
      encryptedUpdateArtifactRef: String?
      encryptedUpdateDigest: String?
      modelUpdateArtifactRef: String?
      modelUpdateArtifactDigest: String?
      updateProtectionType: String? dictionary "MODEL_UPDATE_PROTECTION_TYPE"
      metricsArtifactRef: String?
      trainingLoss: Decimal?
    }

    specification "Runtime Engine Job Observation Outcome" {
      rule """
        Observing a runtime engine job is an external status check and must not advance or reset the RoundExecution lifecycle state. The adapter queries the runtime engine by runtimeEngineJobId and records RuntimeEngineJobObserved with observedStatus RUNNING, COMPLETED, or FAILED. Completion and failure domain state changes are triggered by follow-up automations instead of embedding runtime engine polling inside CompleteRoundExecution or FailRoundExecution.
        When secure aggregation is required, the completed runtime engine observation must report an encrypted update artifact and digest. The platform must not receive or derive a plaintext local model update artifact for secure aggregation rounds.
      """

      scenario "Runtime Engine Job Observed Running" {
        given RoundExecutionStarted {
          roundExecutionId = "round-execution-1"
        }
        when ObserveRuntimeEngineJob {
          roundExecutionId = "round-execution-1"
        }
        then RuntimeEngineJobObserved
      }

      scenario "Runtime Engine Job Observed Completed" {
        given RoundExecutionStarted {
          roundExecutionId = "round-execution-2"
        }
        when ObserveRuntimeEngineJob {
          roundExecutionId = "round-execution-2"
        }
        then RuntimeEngineJobObserved
      }

      scenario "Runtime Engine Job Observed Failed" {
        given RoundExecutionStarted {
          roundExecutionId = "round-execution-3"
        }
        when ObserveRuntimeEngineJob {
          roundExecutionId = "round-execution-3"
        }
        then RuntimeEngineJobObserved
      }
    }
  }

  slice CompleteRoundExecution {
    reactsTo RuntimeEngineJobObserved

    automation CompleteRoundExecutionWhenRuntimeEngineJobCompleted {
      on RuntimeEngineJobObserved
      condition observedStatus == "COMPLETED"
      emits CompleteRoundExecution
    }

    command CompleteRoundExecution {
      roundExecutionId: UUID id technical from RuntimeEngineJobObserved.roundExecutionId
      executionSessionId: UUID from RuntimeEngineJobObserved.executionSessionId
      executionPlanId: UUID from RuntimeEngineJobObserved.executionPlanId
      trainingJobId: UUID from RuntimeEngineJobObserved.trainingJobId
      trainingRunConfigurationId: UUID from RuntimeEngineJobObserved.trainingRunConfigurationId
      roundId: UUID from RuntimeEngineJobObserved.roundId
      roundNumber: Int from RuntimeEngineJobObserved.roundNumber
      runtimeId: UUID from RuntimeEngineJobObserved.runtimeId
      organizationId: UUID from RuntimeEngineJobObserved.organizationId
      featureSchemaId: UUID from RuntimeEngineJobObserved.featureSchemaId
      runtimeEngineJobId: String from RuntimeEngineJobObserved.runtimeEngineJobId
      secureAggregationRequired: Boolean from RuntimeEngineJobObserved.secureAggregationRequired
      secureAggregationSessionId: UUID? from RuntimeEngineJobObserved.secureAggregationSessionId
      encryptionScheme: String? from RuntimeEngineJobObserved.encryptionScheme
      publicKeyVersion: String? from RuntimeEngineJobObserved.publicKeyVersion
      localUpdateArtifactRef: String? from RuntimeEngineJobObserved.localUpdateArtifactRef
      encryptedUpdateArtifactRef: String? from RuntimeEngineJobObserved.encryptedUpdateArtifactRef
      encryptedUpdateDigest: String? from RuntimeEngineJobObserved.encryptedUpdateDigest
      modelUpdateArtifactRef: String? from RuntimeEngineJobObserved.modelUpdateArtifactRef
      modelUpdateArtifactDigest: String? from RuntimeEngineJobObserved.modelUpdateArtifactDigest
      updateProtectionType: String? from RuntimeEngineJobObserved.updateProtectionType
      metricsArtifactRef: String? from RuntimeEngineJobObserved.metricsArtifactRef
      trainingLoss: Decimal? from RuntimeEngineJobObserved.trainingLoss
    }

    event RoundExecutionCompleted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      runtimeEngineJobId: String
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      localUpdateArtifactRef: String?
      encryptedUpdateArtifactRef: String?
      encryptedUpdateDigest: String?
      modelUpdateArtifactRef: String?
      modelUpdateArtifactDigest: String?
      updateProtectionType: String? dictionary "MODEL_UPDATE_PROTECTION_TYPE"
      metricsArtifactRef: String?
      trainingLoss: Decimal?
    }

    state Completed
  }

  slice FailRoundExecution {
    reactsTo RuntimeEngineJobObserved

    automation FailRoundExecutionWhenRuntimeEngineJobFailed {
      on RuntimeEngineJobObserved
      condition observedStatus == "FAILED"
      emits FailRoundExecution
    }

    command FailRoundExecution {
      roundExecutionId: UUID id technical from RuntimeEngineJobObserved.roundExecutionId
      executionSessionId: UUID from RuntimeEngineJobObserved.executionSessionId
      executionPlanId: UUID from RuntimeEngineJobObserved.executionPlanId
      trainingJobId: UUID from RuntimeEngineJobObserved.trainingJobId
      trainingRunConfigurationId: UUID from RuntimeEngineJobObserved.trainingRunConfigurationId
      roundId: UUID from RuntimeEngineJobObserved.roundId
      roundNumber: Int from RuntimeEngineJobObserved.roundNumber
      runtimeId: UUID from RuntimeEngineJobObserved.runtimeId
      organizationId: UUID from RuntimeEngineJobObserved.organizationId
      featureSchemaId: UUID from RuntimeEngineJobObserved.featureSchemaId
      runtimeEngineJobId: String? from RuntimeEngineJobObserved.runtimeEngineJobId
      failureReason: String? from RuntimeEngineJobObserved.failureReason
    }

    event RoundExecutionFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      runtimeEngineJobId: String?
      failureReason: String?
    }

    state Failed
  }

