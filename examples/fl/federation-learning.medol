  slice AgentRoundContributionCatalog {
    readmodel AgentRoundContributionCatalog[] {
      agentRoundContributionId: UUID id
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      state: AgentRoundContribution.State
      trainingDatasetAccessValidationId: UUID
      evaluationDatasetAccessValidationId: UUID
      globalModelVersionId: UUID?
      localModelVersionId: UUID?
      updateArtifactId: UUID?
      localUpdateArtifactRef: String?
      metricsArtifactRef: String?
      trainingLoss: Decimal?
      localAccuracy: Decimal?
      localFairnessScore: Decimal?
      startedAt: DateTime?
      submittedAt: DateTime?
      subscribe AgentRoundContributionStarted
      subscribe AgentLocalModelUpdateSubmitted
      subscribe AgentLocalModelEvaluationSubmitted
    }
  }

  concept AgentRoundContribution {
    state Running
    state UpdateSubmitted
    state EvaluationSubmitted

    slice StartAgentRoundContribution
    slice SubmitAgentLocalModelUpdate
    slice SubmitAgentLocalModelEvaluation
    slice AgentRoundContributionCatalog
  }

  slice ReportAgentRuntimeInfrastructureConnection {
    startsLifecycle
    reactsTo RuntimeInfrastructureRegistered

    command ReportAgentRuntimeInfrastructureConnection {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
    }

    event AgentRuntimeInfrastructureConnectionReported {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
    }

    state Reported
  }

  slice AgentRuntimeInfrastructureConnectionCatalog {
    readmodel AgentRuntimeInfrastructureConnectionCatalog[] {
      runtimeInfrastructureId: UUID id
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      subscribe AgentRuntimeInfrastructureConnectionReported
    }
  }

  concept AgentRuntimeInfrastructureConnection {
    state Reported

    slice ReportAgentRuntimeInfrastructureConnection
    slice AgentRuntimeInfrastructureConnectionCatalog
  }

  slice ReportAgentRuntimeHeartbeat {
    startsLifecycle

    command ReportAgentRuntimeHeartbeat {
      agentRuntimeHeartbeatId: UUID id generated technical
      nodeId: UUID
      runtimeAgentId: UUID
      federationId: UUID
      trainingJobId: UUID?
      agentRuntimeJobId: UUID?
      cpuLoad: Decimal
      gpuLoad: Decimal
      memoryLoad: Decimal
      reportedAt: DateTime
    }

    event AgentRuntimeHeartbeatReported {
      agentRuntimeHeartbeatId: UUID id technical
      nodeId: UUID
      runtimeAgentId: UUID
      federationId: UUID
      trainingJobId: UUID?
      agentRuntimeJobId: UUID?
      cpuLoad: Decimal
      gpuLoad: Decimal
      memoryLoad: Decimal
      reportedAt: DateTime
    }

    state Reported
  }

  slice AgentRuntimeHeartbeatCatalog {
    readmodel AgentRuntimeHeartbeatCatalog[] {
      agentRuntimeHeartbeatId: UUID id
      nodeId: UUID
      runtimeAgentId: UUID
      federationId: UUID
      trainingJobId: UUID?
      agentRuntimeJobId: UUID?
      cpuLoad: Decimal
      gpuLoad: Decimal
      memoryLoad: Decimal
      reportedAt: DateTime
      subscribe AgentRuntimeHeartbeatReported
    }
  }

  concept AgentRuntimeHeartbeat {
    state Reported

    slice ReportAgentRuntimeHeartbeat
    slice AgentRuntimeHeartbeatCatalog
  }

  slice ReportAgentRuntimeNodeInventory {
    startsLifecycle

    command ReportAgentRuntimeNodeInventory {
      runtimeNodeInventoryReportId: UUID id generated technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String              // CONTROL_PLANE / WORKER
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      discoveredAt: DateTime
    }

    event AgentRuntimeNodeInventoryReported {
      runtimeNodeInventoryReportId: UUID id technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      discoveredAt: DateTime
    }

    state Reported
  }

  slice AgentRuntimeNodeInventoryCatalog {
    readmodel AgentRuntimeNodeInventoryCatalog[] {
      runtimeNodeInventoryReportId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      discoveredAt: DateTime
      subscribe AgentRuntimeNodeInventoryReported
    }
  }

  concept AgentRuntimeNodeInventory {
    state Reported

    slice ReportAgentRuntimeNodeInventory
    slice AgentRuntimeNodeInventoryCatalog
  }

  slice ReportAgentRuntimeNodeResourceSnapshot {
    startsLifecycle

    command ReportAgentRuntimeNodeResourceSnapshot {
      runtimeNodeResourceSnapshotId: UUID id generated technical
      nodeId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
    }

    event AgentRuntimeNodeResourceSnapshotReported {
      runtimeNodeResourceSnapshotId: UUID id technical
      nodeId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
    }

    state Reported
  }

  slice AgentRuntimeNodeResourceSnapshotCatalog {
    readmodel AgentRuntimeNodeResourceSnapshotCatalog[] {
      runtimeNodeResourceSnapshotId: UUID id
      nodeId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
      subscribe AgentRuntimeNodeResourceSnapshotReported
    }
  }

  concept AgentRuntimeNodeResourceSnapshot {
    state Reported

    slice ReportAgentRuntimeNodeResourceSnapshot
    slice AgentRuntimeNodeResourceSnapshotCatalog
  }

  slice AcceptAgentRuntimeJob {
    startsLifecycle
    reactsTo TrainingRuntimeDispatched

      command AcceptAgentRuntimeJob {
        agentRuntimeJobId: UUID id generated technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        trainingDatasetSelectionId: UUID
        trainingDatasetAccessValidationId: UUID
        evaluationDatasetAccessValidationId: UUID
        gemiflRuntimeImage: String
        runtimePayloadRef: String
        artifactStoreRef: String
      }

      event AgentRuntimeJobAccepted {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        trainingDatasetSelectionId: UUID
        trainingDatasetAccessValidationId: UUID
        evaluationDatasetAccessValidationId: UUID
        gemiflRuntimeImage: String
        runtimePayloadRef: String
        artifactStoreRef: String
      }

      state Accepted
    }

    slice StartAgentRuntimeJob {
      reactsTo AgentRuntimeJobAccepted

      automation StartRuntimeJobAfterAccepted {
        on AgentRuntimeJobAccepted
        emits StartAgentRuntimeJob
      }

      command StartAgentRuntimeJob {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        runtimeAgentId: UUID
        gemiflRuntimeImage: String
        runtimePayloadRef: String
        artifactStoreRef: String
        localSecretRef: String
        localSecretRefType: String
        localDataMountPath: String?
      }

      event AgentRuntimeJobStarted {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        runtimeAgentId: UUID
        gemiflRuntimeImage: String
        runtimePayloadRef: String
        artifactStoreRef: String
        localSecretRef: String
        localSecretRefType: String
        localDataMountPath: String?
        startedAt: DateTime
      }

      state Running
    }

    slice CompleteAgentRuntimeJob {
      reactsTo AgentRuntimeJobStarted

      command CompleteAgentRuntimeJob {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        runtimeJobId: UUID
        localUpdateArtifactRef: String?
        metricsArtifactRef: String?
        runtimeStatus: String
        completedAt: DateTime
      }

      event AgentRuntimeJobCompleted {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        runtimeJobId: UUID
        localUpdateArtifactRef: String?
        metricsArtifactRef: String?
        runtimeStatus: String
        completedAt: DateTime
      }

      state Completed
    }

    slice FailAgentRuntimeJob {
      reactsTo AgentRuntimeJobStarted

      command FailAgentRuntimeJob {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        runtimeJobId: UUID?
        failureReason: String
        failedAt: DateTime
      }

      event AgentRuntimeJobFailed {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        runtimeJobId: UUID?
        failureReason: String
        failedAt: DateTime
      }

      state Failed
    }

    slice AgentRuntimeJobCatalog {
      readmodel AgentRuntimeJobCatalog[] {
        agentRuntimeJobId: UUID id
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        nodeId: UUID
        runtimeAgentId: UUID
        runtimeJobId: UUID?
        trainingDatasetSelectionId: UUID
        trainingDatasetAccessValidationId: UUID
        evaluationDatasetAccessValidationId: UUID
        gemiflRuntimeImage: String
        runtimePayloadRef: String
        artifactStoreRef: String
        localSecretRefType: String?
        localDataMountPath: String?
        runtimeStatus: String
        localUpdateArtifactRef: String?
        metricsArtifactRef: String?
        failureReason: String?
        startedAt: DateTime?
        completedAt: DateTime?
        failedAt: DateTime?
        subscribe AgentRuntimeJobAccepted
        subscribe AgentRuntimeJobStarted
        subscribe AgentRuntimeJobCompleted
        subscribe AgentRuntimeJobFailed
      }
    }

    concept AgentRuntimeJob {
      state Accepted
      state Running
      state Completed
      state Failed

      slice AcceptAgentRuntimeJob
      slice StartAgentRuntimeJob
      slice CompleteAgentRuntimeJob
      slice FailAgentRuntimeJob
      slice AgentRuntimeJobCatalog
    }
  }
}
