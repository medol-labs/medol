domain FederationLearningPlatform {
context OrganizationManagement {
  
  note "Organization management owns organization lifecycle and runtime-discovered compute node availability."

  risk "Inactive organizations can be invited into federations if organization lifecycle state is not enforced."
  risk "Disabled compute nodes can still be selected for training if runtime-discovered node availability is not enforced."
  metric organizationActivationLeadTime
  metric runtimeIdentityCoverage

  enum OrganizationType {
    HOSPITAL
    RESEARCH_INSTITUTE
    PUBLIC_HEALTH_AGENCY
    LABORATORY
    REHABILITATION_CENTER
  }

  slice RegisterOrganization {
    startsLifecycle

    tags {
      organizationName = normalize(organizationName)
    }

    actor OrganizationAdmin
    ui OrganizationRegistrationScreen

    command RegisterOrganization {
      organizationId: UUID id generated technical
      organizationName: String
      organizationType: OrganizationType
      contactEmail: String
    }

    event OrganizationRegistered {
      organizationId: UUID id technical
      organizationName: String
      organizationType: OrganizationType
      contactEmail: String
    }

    state Registered

    specification "Organization Name Unique" {
      rule """
        Organization names must be unique.
      """

      expression {
        unique Organization.organizationName
      }

      scenario "Reject Duplicate Organization" {
        given OrganizationRegistered {
          organizationName = "Acme"
        }
        when RegisterOrganization {
          organizationName = "Acme"
        }
        then reject "Organization Already Exists"
      }
    }
  }

  slice ActivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationRegistered

    command ActivateOrganization {
      organizationId: UUID id technical
      activationNote: String?
    }

    event OrganizationActivated {
      organizationId: UUID id technical
      activationNote: String?
    }

    state Active
  }

  slice DeactivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationActivated

    command DeactivateOrganization {
      organizationId: UUID id technical
      deactivationReason: String
    }

    event OrganizationDeactivated {
      organizationId: UUID id technical
      deactivationReason: String
    }

    state Deactivated
  }

  slice ReactivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationDeactivated

    command ReactivateOrganization {
      organizationId: UUID id technical
      reactivationReason: String
    }

    event OrganizationReactivated {
      organizationId: UUID id technical
      reactivationReason: String
    }

    state Active
  }

  slice OrganizationDirectory {
    ui OrganizationDirectory

    readmodel OrganizationDirectory[] {
      organizationId: UUID id
      organizationName: String
      organizationType: OrganizationType
      state: Organization.State
      approvedDatasetCount: Int
      subscribe OrganizationRegistered
      subscribe OrganizationActivated
      subscribe OrganizationDeactivated
      subscribe OrganizationReactivated
      subscribe DatasetApprovedForTraining
    }
  }

  concept Organization {
    state Registered
    state Active
    state Deactivated

    slice RegisterOrganization
    slice ActivateOrganization
    slice DeactivateOrganization
    slice ReactivateOrganization
    slice OrganizationDirectory
  }

}

context FederationManagement {
  note "Federation management owns federations and federation membership governance."

  risk "Inactive organizations joining a federation can compromise model governance and data sharing agreements."
  risk "Federation training can proceed with too few available organization-owned compute nodes if eligibility is not enforced."
  metric participantApprovalLeadTime
  metric federationActivationLeadTime

  slice CreateFederation {
    startsLifecycle

    tags {
      federationName
    }

    actor PlatformAdmin
    ui FederationSetupScreen form

    command CreateFederation {
      federationId: UUID id generated technical
      federationName: String
      description: String
      minimumParticipantCount: Int
    }

    event FederationCreated {
      federationId: UUID id technical
      federationName: String
      description: String
      minimumParticipantCount: Int
    }

    state Draft

    specification "Federation Name Unique" {
      rule """
        Federation names must be unique.
      """

      expression {
        unique Federation.federationName
      }

      scenario "Reject Duplicate Federation" {
        given FederationCreated {
          federationName = "B"
        }
        when CreateFederation {
          federationName = "B"
        }
        then reject "Federation Already Exists"
      }
    }
  }

  slice ActivateFederation {
    actor PlatformAdmin
    ui FederationSetupScreen
    reactsTo FederationCreated

    command ActivateFederation {
      federationId: UUID id technical
      activationNote: String?
    }

    event FederationActivated {
      federationId: UUID id technical
      activationNote: String?
    }

    state Active
  }

  slice SuspendFederation {
    actor PlatformAdmin
    ui FederationSetupScreen confirm
    reactsTo FederationActivated

    command SuspendFederation {
      federationId: UUID id technical
      suspensionReason: String
    }

    event FederationSuspended {
      federationId: UUID id technical
      suspensionReason: String
    }

    state Suspended
  }

  slice ReactivateFederation {
    actor PlatformAdmin
    ui FederationSetupScreen
    reactsTo FederationSuspended

    command ReactivateFederation {
      federationId: UUID id technical
      reactivationReason: String
    }

    event FederationReactivated {
      federationId: UUID id technical
      reactivationReason: String
    }

    state Active
  }

  slice FederationOverview {
    reactsTo ParticipantJoined

    readmodel FederationOverview[] {
      federationId: UUID id
      federationName: String
      state: Federation.State
      minimumParticipantCount: Int
      activeMemberCount: Int
      pendingInvitationCount: Int
      admittedRuntimeCount: Int
      activeRuntimeGrantCount: Int
      activeTrainingJobCount: Int
      subscribe FederationCreated
      subscribe FederationActivated
      subscribe FederationSuspended
      subscribe FederationReactivated
      subscribe ParticipantInvited
      subscribe ParticipantJoined
      subscribe ParticipantRejected
      subscribe ParticipantInvitationRevoked
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe RuntimeAdmitted
      subscribe RuntimeIdentityRevoked
      subscribe FederationRuntimeAccessGranted
      subscribe FederationRuntimeAccessRevoked
      subscribe TrainingJobSubmitted
    }
  }

  slice InviteParticipant {
    startsLifecycle

    tags {
      federationId
      organizationId
    }

    actor FederationOwner
    ui ParticipantInvitationScreen dialog
    reactsTo FederationCreated

    command InviteParticipant {
      federationId: UUID id technical
      organizationId: UUID
      invitationNote: String
    }

    event ParticipantInvited {
      federationId: UUID id technical
      organizationId: UUID
      invitationNote: String
    }

    state Invited
  }


  slice FederationMembershipDirectory {
    reactsTo ParticipantInvited

    readmodel FederationMembershipDirectory[] {
      federationId: UUID id
      organizationId: UUID id
      federationName: String? derived from FederationOverview.federationName by federationId
      organizationName: String? derived from OrganizationDirectory.organizationName by organizationId
      membershipStatus: String
      invitationNote: String?
      approvalNote: String?
      subscribe FederationCreated
      subscribe ParticipantInvited
      subscribe ParticipantJoined
      subscribe ParticipantRejected
      subscribe ParticipantInvitationRevoked
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe OrganizationRegistered
      subscribe OrganizationActivated
    }
  }

  slice ApproveParticipant {
    actor GovernanceReviewer

    ui MembershipReviewScreen dialog
    reactsTo ParticipantInvited

    command ApproveParticipant {
      federationId: UUID id technical
      organizationId: UUID
      approvalNote: String?
    }

    event ParticipantJoined {
      federationId: UUID id technical
      organizationId: UUID
      approvalNote: String?
    }

    specification "Only Invited Active Organizations Join Federation" {
      rule """
        A participant can join only after the organization is active and has an outstanding invitation for the target federation.
      """

      scenario "Approve Invited Participant" {
        given ParticipantInvited {
          federationId = "fed-1"
          organizationId = "org-1"
        }
        when ApproveParticipant {
          federationId = "fed-1"
          organizationId = "org-1"
        }
        then ParticipantJoined
      }

      scenario "Reject Uninvited Participant Approval" {
        when ApproveParticipant {
          federationId = "fed-1"
          organizationId = "org-2"
        }
        then reject "Participant Invitation Required"
      }
    }

    state Active
  }

  slice RejectParticipant {
    actor GovernanceReviewer

    ui MembershipReviewScreen dialog
    reactsTo ParticipantInvited

    command RejectParticipant {
      federationId: UUID id technical
      organizationId: UUID
      rejectionReason: String
    }

    event ParticipantRejected {
      federationId: UUID id technical
      organizationId: UUID
      rejectionReason: String
    }

    state Rejected
  }
  // 什么情况下可以撤销，已被使用能否撤销 TODO
  slice RevokeParticipantInvitation {
    actor FederationOwner
    ui ParticipantInvitationScreen confirm
    reactsTo ParticipantInvited

    command RevokeParticipantInvitation {
      federationId: UUID id technical
      organizationId: UUID
      revokeReason: String
    }

    event ParticipantInvitationRevoked {
      federationId: UUID id technical
      organizationId: UUID
      revokeReason: String
    }

    state InvitationRevoked
  }

  slice SuspendParticipant {
    actor GovernanceReviewer
    ui MembershipReviewScreen dialog
    reactsTo ParticipantJoined

    command SuspendParticipant {
      federationId: UUID id technical
      organizationId: UUID
      suspensionReason: String
    }

    event ParticipantSuspended {
      federationId: UUID id technical
      organizationId: UUID
      suspensionReason: String
    }

    state Suspended
  }

  slice RemoveParticipant {
    actor GovernanceReviewer
    ui MembershipReviewScreen confirm
    reactsTo ParticipantSuspended

    command RemoveParticipant {
      federationId: UUID id technical
      organizationId: UUID
      removalReason: String
    }

    event ParticipantRemoved {
      federationId: UUID id technical
      organizationId: UUID
      removalReason: String
    }

    state Removed
  }


  concept Federation {
    state Draft
    state Active
    state Suspended

    slice CreateFederation
    slice ActivateFederation
    slice SuspendFederation
    slice ReactivateFederation
    slice FederationOverview
  }

  concept FederationMembership {
    state Invited
    state Active
    state Rejected
    state InvitationRevoked
    state Suspended
    state Removed

    slice InviteParticipant
    slice ApproveParticipant
    slice RejectParticipant
    slice RevokeParticipantInvitation
    slice SuspendParticipant
    slice RemoveParticipant
    slice FederationMembershipDirectory
  }

}

context DictionaryMaintenance {
  note "Dictionary maintenance owns dynamic option dictionaries used by platform contexts. Business contexts store valueCode and query DictionaryValueCatalog by dictionaryCode for display and selection."

  risk "Runtime option changes can invalidate pending installation plans if dictionary values are removed instead of disabled."
  risk "Duplicate dictionary value codes can cause inconsistent command payloads across deployables."
  metric dictionaryValueActivationLatency

  type DictionaryCode = String
  type DictionaryValueCode = String
  type DisplayOrder = Int {
    range 0..999999
  }

  slice RegisterDictionary {
    startsLifecycle

    actor PlatformAdmin
    ui DictionaryCatalogScreen

    tags {
      dictionaryCode
    }

    command RegisterDictionary {
      dictionaryId: UUID id generated technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      description: String?
    }

    event DictionaryRegistered {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      description: String?
    }

    state Registered

    specification "Dictionary Code Unique" {
      rule """
        FederDictionary Codes must be unique.
      """

      expression {
        unique Dictionary.dictionaryCode
      }

      scenario "Reject Duplicate Dictionary" {
        given DictionaryRegistered {
          dictionaryCode = "B"
        }
        when RegisterDictionary {
          dictionaryCode = "B"
        }
        then reject "Dictionary Already Exists"
      }
    }
  }

  slice UpdateDictionary {
    actor PlatformAdmin
    ui DictionaryCatalogScreen
    reactsTo DictionaryRegistered

    command UpdateDictionary {
      dictionaryId: UUID id technical
      dictionaryName: String
      description: String?
    }

    event DictionaryUpdated {
      dictionaryId: UUID id technical
      dictionaryName: String
      description: String?
    }
  }

  slice ArchiveDictionary {
    actor PlatformAdmin
    ui DictionaryCatalogScreen confirm
    reactsTo DictionaryRegistered

    command ArchiveDictionary {
      dictionaryId: UUID id technical
      archiveReason: String
    }

    event DictionaryArchived {
      dictionaryId: UUID id technical
      archiveReason: String
    }

    state Archived
  }

  slice DictionaryCatalog {
    readmodel DictionaryCatalog[] {
      dictionaryId: UUID id
      dictionaryCode: DictionaryCode query
      dictionaryName: String
      description: String?
      state: Dictionary.State
      registeredAt: DateTime
      updatedAt: DateTime?
      archivedAt: DateTime?
      archiveReason: String?
      subscribe DictionaryRegistered
      subscribe DictionaryUpdated
      subscribe DictionaryArchived
    }
  }

  slice AddDictionaryValue {
    startsLifecycle

    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryRegistered

    tags {
      dictionaryCode
      valueCode
    }

    command AddDictionaryValue {
      dictionaryValueId: UUID id generated technical
      dictionaryId: UUID
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
    }

    event DictionaryValueAdded {
      dictionaryValueId: UUID id technical
      dictionaryId: UUID
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
    }

    state Active
  }

  slice DisableDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen confirm
    reactsTo DictionaryValueAdded

    command DisableDictionaryValue {
      dictionaryValueId: UUID id technical
      disabledReason: String
    }

    event DictionaryValueDisabled {
      dictionaryValueId: UUID id technical
      disabledReason: String
    }

    state Disabled
  }

  slice EnableDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryValueDisabled

    command EnableDictionaryValue {
      dictionaryValueId: UUID id technical
      enableReason: String
    }

    event DictionaryValueEnabled {
      dictionaryValueId: UUID id technical
      enableReason: String
    }

    state Active
  }

  slice DictionaryValueCatalog {
    readmodel DictionaryValueCatalog[] {
      dictionaryProvider DictionaryValueCatalog {
        code dictionaryCode
        value valueCode
        label displayName
        active active
        state state
        order displayOrder
      }
      dictionaryValueId: UUID id
      dictionaryId: UUID
      dictionaryCode: DictionaryCode query
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean query
      state: DictionaryValue.State
      addedAt: DateTime
      updatedAt: DateTime?
      disabledAt: DateTime?
      disabledReason: String?
      enabledAt: DateTime?
      subscribe DictionaryValueAdded
      subscribe DictionaryValueDisabled
      subscribe DictionaryValueEnabled
    }
  }

  concept Dictionary {
    state Registered
    state Archived

    slice RegisterDictionary
    slice UpdateDictionary
    slice ArchiveDictionary
    slice DictionaryCatalog
  }

  concept DictionaryValue {
    state Active
    state Disabled

    slice AddDictionaryValue
    slice DisableDictionaryValue
    slice EnableDictionaryValue
    slice DictionaryValueCatalog
  }
}

context RuntimeProvisioning {
  note "Runtime onboarding owns runtime installation planning, bootstrap configuration, runtime environment registration, agent installation, readiness, connection reporting, and access revocation. K3s, Kubernetes, Docker Compose, and host process runtimes are installation targets, not separate domain concepts."
  note "Runtime bootstrap and agent installation material is support configuration, not domain state: the platform backend adapter reads platform.runtime.bootstrap.publicBaseAddress, platform.runtime.agent.platformApiBaseAddress, platform.runtime.agent.controlApiBaseAddress, platform.runtime.agent.containerRegistry, platform.runtime.agent.trustBundleSecretName, and platform.runtime.agent.accessGrantSecretPrefix from deployment config or a secret store. Commands, events, and read models keep only runtimeInstallationPlanId, runtimeInfrastructurePackageId, and generated access grant IDs."

  risk "Organizations can receive wrong runtime installation guidance and fail to connect runtime infrastructure."
  risk "Leaked bootstrap tokens can allow unauthorized infrastructure to join the platform."
  metric runtimeBootstrapSuccessRate
  metric runtimeInfrastructureConnectionLatency

  external RuntimeAgent {
    kind runtime-agent
    protocol http
    capabilities {
      command RequestDatasetAccess
      event DatasetAccessValidated
    }
  }

  slice RegisterRuntimeInfrastructurePackage {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeInfrastructurePackageCatalogScreen

    tags {
      packageName = normalize(packageName)
      packageVersion
    }

    command RegisterRuntimeInfrastructurePackage {
      runtimeInfrastructurePackageId: UUID id generated technical
      packageName: String
      packageVersion: String
      // 安装包支持的 runtime 环境类型；真实包地址、签名、secret 由平台包服务按 packageId 解析。
      runtimeEnvironmentType: String dictionary "RUNTIME_ENVIRONMENT_TYPE"
      // 安装包对应的 runtime agent 部署方式；真实 adapter 配置不进入建模。
      runtimeDeploymentTargetType: String dictionary "RUNTIME_DEPLOYMENT_TARGET_TYPE"
      // 安装规格档位，和安装包一起维护，创建计划时不再人工重复填写。
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      architecture: String
      // 面向 RuntimeInstaller 的安装向导内容或模板，由平台维护并在 RuntimeInstallationGuide 中展示。
      installGuide: String
    }

    event RuntimeInfrastructurePackageRegistered {
      runtimeInfrastructurePackageId: UUID id technical
      packageName: String
      packageVersion: String
      runtimeEnvironmentType: String dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeDeploymentTargetType: String dictionary "RUNTIME_DEPLOYMENT_TARGET_TYPE"
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      architecture: String
      installGuide: String
    }

    state Registered
  }

  slice RuntimeInfrastructurePackageCatalog {
    readmodel RuntimeInfrastructurePackageCatalog[] {
      runtimeInfrastructurePackageId: UUID id
      packageName: String
      packageVersion: String
      runtimeEnvironmentType: String dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeDeploymentTargetType: String dictionary "RUNTIME_DEPLOYMENT_TARGET_TYPE"
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      architecture: String
      installGuide: String
      state: RuntimeInfrastructurePackage.State
      subscribe RuntimeInfrastructurePackageRegistered
    }
  }

  // Runtime installation plan describes how an organization runtime will be onboarded.
  // PlatformAdmin selects a platform-maintained infrastructure package; RuntimeInstaller follows the generated guide to prepare K3s, Docker Compose, or local runtime.
  // After infrastructure registration and verification, the platform requests runtime agent installation according to this plan.
  slice CreateRuntimeInstallationPlan {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo OrganizationActivated

    tags {
      organizationId
    }

    command CreateRuntimeInstallationPlan {
      runtimeInstallationPlanId: UUID id generated technical
      organizationId: UUID
      runtimeInfrastructurePackageId: UUID
      runtimeName: String
      // agent 安装责任模式，表达是平台自动请求安装，还是仅生成指引由人工执行。
      // 例：PLATFORM_MANAGED、MANUAL_GUIDED。
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
    }

    event RuntimeInstallationPlanCreated {
      runtimeInstallationPlanId: UUID id technical
      runtimeInfrastructureId: UUID generated technical
      organizationId: UUID
      runtimeInfrastructurePackageId: UUID
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
    }

    state Planned
  }

  slice RuntimeInstallationPlanCatalog {
    readmodel RuntimeInstallationPlanCatalog[] {
      runtimeInstallationPlanId: UUID id
      organizationId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime installation plan catalog."
      }
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructurePackageCatalog.packageName by runtimeInfrastructurePackageId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructurePackageCatalog.packageVersion by runtimeInfrastructurePackageId
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      planStatus: String
      runtimeInfrastructureId: UUID?
      observedNodeCount: Int?
      runtimeAgentId: UUID?
      runtimeAgentVersion: String?
      plannedAt: DateTime
      verifiedAt: DateTime?
      verificationFailedAt: DateTime?
      verificationFailureReason: String?
      agentReadyAt: DateTime?
      agentDeploymentFailedAt: DateTime?
      agentDeploymentFailureReason: String?
      agentDeploymentRetryFailedAt: DateTime?
      agentDeploymentRetryFailureReason: String?
      lastConnectedAt: DateTime?
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructurePackageRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructureVerified
      subscribe RuntimeInfrastructureVerificationFailed
      subscribe RuntimeAgentInstallationSucceeded
      subscribe RuntimeAgentInstallationFailed
      subscribe RuntimeAgentDeploymentRetrySucceeded
      subscribe RuntimeAgentDeploymentRetryFailed
      subscribe RuntimeConnectionEstablished
    }
  }

  slice RuntimeInstallationGuide {
    actor RuntimeInstaller
    ui RuntimeInstallationGuideScreen
    reactsTo RuntimeInstallationPlanCreated

    readmodel RuntimeInstallationGuide[] {
      runtimeInstallationPlanId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeInfrastructurePackageId: UUID? derived {
        from RuntimeInstallationPlanCreated.runtimeInfrastructurePackageId
        rule "Lookup by runtimeInstallationPlanId and display the selected infrastructure installer package."
      }
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructurePackageCatalog.packageName by runtimeInfrastructurePackageId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructurePackageCatalog.packageVersion by runtimeInfrastructurePackageId
      infrastructureInstallGuide: String? derived from RuntimeInfrastructurePackageCatalog.installGuide by runtimeInfrastructurePackageId
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime installation guide."
      }
      runtimeName: String? derived {
        from RuntimeInstallationPlanCreated.runtimeName
        rule "Lookup by runtimeInstallationPlanId and denormalize the planned runtime display name into the runtime installation guide."
      }
      bootstrapCommand: String derived {
        from RuntimeInstallationPlanCreated.runtimeInstallationPlanId
        rule "Render the copyable install/start command using the runtime installation plan and platform-managed bootstrap service."
      }
      runtimeDeploymentTargetType: String? dictionary "RUNTIME_DEPLOYMENT_TARGET_TYPE" derived from RuntimeInfrastructurePackageCatalog.runtimeDeploymentTargetType by runtimeInfrastructurePackageId
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" derived from RuntimeInfrastructurePackageCatalog.runtimeEnvironmentType by runtimeInfrastructurePackageId
      agentInstallMode: String? dictionary "RUNTIME_AGENT_INSTALL_MODE" derived {
        from RuntimeInstallationPlanCreated.agentInstallMode
        rule "Lookup by runtimeInstallationPlanId and display how the platform should request runtime agent installation."
      }
      installProfile: String? dictionary "RUNTIME_INSTALL_PROFILE" derived from RuntimeInfrastructurePackageCatalog.installProfile by runtimeInfrastructurePackageId
      architecture: String? derived from RuntimeInfrastructurePackageCatalog.architecture by runtimeInfrastructurePackageId
      expectedNodeCount: Int? derived {
        from RuntimeInstallationPlanCreated.expectedNodeCount
        rule "Lookup by runtimeInstallationPlanId and display the planned node count."
      }
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructurePackageRegistered
      subscribe RuntimeInstallationPlanCreated
    }
  }

  slice RegisterRuntimeInfrastructure {
    startsLifecycle

    actor RuntimeInstaller
    reactsTo RuntimeInstallationPlanCreated

    command RegisterRuntimeInfrastructure {
      runtimeInfrastructureId: UUID id technical from RuntimeInstallationPlanCreated.runtimeInfrastructureId
      installedAt: DateTime
    }

    event RuntimeInfrastructureRegistered {
      runtimeInfrastructureId: UUID id technical
      installedAt: DateTime
    }

    state Registered
  }

  slice VerifyRuntimeInfrastructure {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo RuntimeInfrastructureRegistered
    port

    automation VerifyInfrastructureWhenRegistered {
      on RuntimeInfrastructureRegistered
      emits VerifyRuntimeInfrastructure
    }

    command VerifyRuntimeInfrastructure {
      runtimeInfrastructureId: UUID id technical from RuntimeInfrastructureRegistered.runtimeInfrastructureId
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" derived from RuntimeInstallationPlanCreated.agentInstallMode by runtimeInfrastructureId
      verificationPassed: Boolean
      verifiedAt: DateTime?
      failedAt: DateTime?
      observedNodeCount: Int
      failureReason: String?
    }

    event RuntimeInfrastructureVerified {
      runtimeInfrastructureId: UUID id technical
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      verifiedAt: DateTime
      observedNodeCount: Int
    }

    event RuntimeInfrastructureVerificationFailed {
      runtimeInfrastructureId: UUID id technical
      failedAt: DateTime
      observedNodeCount: Int
      failureReason: String
    }

    state Verified

    specification "Runtime Infrastructure Verification Outcome" {
      rule """
        Runtime infrastructure verification runs once after the runtime infrastructure is registered. The verification processor resolves the selected runtime infrastructure package and records exactly one outcome: RuntimeInfrastructureVerified when the runtime environment is usable, or RuntimeInfrastructureVerificationFailed when required checks fail.
      """

      scenario "Runtime Infrastructure Verification Passed" {
        given RuntimeInfrastructureRegistered {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        when VerifyRuntimeInfrastructure {
          runtimeInfrastructureId = "runtime-infra-1"
          agentInstallMode = "PLATFORM_MANAGED"
          verificationPassed = true
          observedNodeCount = 3
        }
        then RuntimeInfrastructureVerified
      }

      scenario "Runtime Infrastructure Verification Failed" {
        given RuntimeInfrastructureRegistered {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when VerifyRuntimeInfrastructure {
          runtimeInfrastructureId = "runtime-infra-2"
          verificationPassed = false
          observedNodeCount = 0
          failureReason = "Runtime infrastructure is unreachable."
        }
        then RuntimeInfrastructureVerificationFailed
      }
    }
  }

  slice DeployRuntimeAgent {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo RuntimeInfrastructureVerified
    port

    automation DeployRuntimeAgentWhenInfrastructureVerified {
      on RuntimeInfrastructureVerified
      condition agentInstallMode == "PLATFORM_MANAGED"
      emits DeployRuntimeAgent
    }

    command DeployRuntimeAgent {
      runtimeAgentId: UUID generated technical
      runtimeInfrastructureId: UUID id technical
      requestedAt: DateTime
    }

    event RuntimeAgentInstallationSucceeded {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      agentVersion: String
      startedAt: DateTime
      readyAt: DateTime
    }

    event RuntimeAgentInstallationFailed {
      runtimeInfrastructureId: UUID id technical
      startedAt: DateTime
      failedAt: DateTime
      failureReason: String
    }

    state AgentReady

    specification "Runtime Agent Deployment Outcome" {
      rule """
        Runtime agent deployment runs automatically after the runtime infrastructure is verified when the selected installation mode is platform managed. The deployment service deploys the agent workload to the target infrastructure and records exactly one outcome: RuntimeAgentInstallationSucceeded when the agent starts and passes its readiness checks, or RuntimeAgentInstallationFailed when deployment or readiness fails.
      """

      scenario "Runtime Agent Deployment Succeeded" {
        given RuntimeInfrastructureVerified {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        when DeployRuntimeAgent {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        then RuntimeAgentInstallationSucceeded
      }

      scenario "Runtime Agent Deployment Failed" {
        given RuntimeInfrastructureVerified {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when DeployRuntimeAgent {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        then RuntimeAgentInstallationFailed
      }
    }
  }

  slice RetryRuntimeAgentDeployment {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen confirm
    port

    command RetryRuntimeAgentDeployment {
      runtimeAgentId: UUID generated technical
      runtimeInfrastructureId: UUID id technical
      currentRuntimeInfrastructureState: RuntimeInfrastructure.State derived from RuntimeInfrastructureAccessView.state by runtimeInfrastructureId
      retryReason: String
      requestedAt: DateTime
    }

    event RuntimeAgentDeploymentRetrySucceeded {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      agentVersion: String
      startedAt: DateTime
      requestedAt: DateTime
      readyAt: DateTime
    }

    event RuntimeAgentDeploymentRetryFailed {
      runtimeInfrastructureId: UUID id technical
      startedAt: DateTime
      requestedAt: DateTime
      failedAt: DateTime
      failureReason: String
    }

    state AgentReady

    specification "Runtime Agent Deployment Retry Outcome" {
      rule """
        The runtime installation plan screen exposes a retry deployment action only when the current runtime infrastructure state is RuntimeAgentFailed or Offline. A platform admin manually triggers the same platform-managed deployment port from the page; no human installs the agent on the server. The retry records exactly one outcome: RuntimeAgentDeploymentRetrySucceeded when the agent becomes ready, or RuntimeAgentDeploymentRetryFailed when deployment or readiness fails again.
      """

      scenario "Runtime Agent Deployment Retry Succeeded After Failed Deployment" {
        given RuntimeAgentInstallationFailed {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-2"
          currentRuntimeInfrastructureState = "RuntimeAgentFailed"
          retryReason = "Retry after fixing registry credentials."
        }
        then RuntimeAgentDeploymentRetrySucceeded
      }

      scenario "Runtime Agent Deployment Retry Succeeded After Offline" {
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-3"
          currentRuntimeInfrastructureState = "Offline"
          retryReason = "Reconnect runtime agent."
        }
        then RuntimeAgentDeploymentRetrySucceeded
      }

      scenario "Runtime Agent Deployment Retry Failed" {
        given RuntimeAgentInstallationFailed {
          runtimeInfrastructureId = "runtime-infra-4"
        }
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-4"
          currentRuntimeInfrastructureState = "RuntimeAgentFailed"
          retryReason = "Retry after transient failure."
        }
        then RuntimeAgentDeploymentRetryFailed
      }

      scenario "Reject Runtime Agent Deployment Retry While Connected" {
        given RuntimeConnectionEstablished {
          runtimeInfrastructureId = "runtime-infra-5"
        }
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-5"
          currentRuntimeInfrastructureState = "Connected"
          retryReason = "Force redeploy."
        }
        then reject "Runtime Agent Deployment Retry Not Allowed"
      }
    }
  }

  slice RecordRuntimeConnectionEstablished {
    reactsTo AgentRuntimeConnectionEstablished

    command RecordRuntimeConnectionEstablished {
      runtimeInfrastructureId: UUID id technical from AgentRuntimeConnectionEstablished.runtimeInfrastructureId
      runtimeAgentId: UUID from AgentRuntimeConnectionEstablished.runtimeAgentId
      connectedAt: DateTime from AgentRuntimeConnectionEstablished.connectedAt
    }

    event RuntimeConnectionEstablished {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      connectedAt: DateTime
    }

    state Connected
  }

  slice RuntimeInfrastructureAccessView {
    readmodel RuntimeInfrastructureAccessView[] {
      runtimeInfrastructureId: UUID id
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructurePackageCatalog.packageName by runtimeInfrastructurePackageId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructurePackageCatalog.packageVersion by runtimeInfrastructurePackageId
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime infrastructure access view."
      }
      runtimeName: String? derived {
        from RuntimeInstallationPlanCreated.runtimeName
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime display name into the access view."
      }
      runtimeDeploymentTargetType: String? dictionary "RUNTIME_DEPLOYMENT_TARGET_TYPE" derived from RuntimeInfrastructurePackageCatalog.runtimeDeploymentTargetType by runtimeInfrastructurePackageId
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" derived from RuntimeInfrastructurePackageCatalog.runtimeEnvironmentType by runtimeInfrastructurePackageId
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      runtimeAgentId: UUID?
      runtimeAgentVersion: String?
      infrastructureVerifiedAt: DateTime?
      infrastructureVerificationFailedAt: DateTime?
      infrastructureVerificationFailureReason: String?
      agentReadyAt: DateTime?
      agentDeploymentFailedAt: DateTime?
      agentDeploymentFailureReason: String?
      agentDeploymentRetryFailedAt: DateTime?
      agentDeploymentRetryFailureReason: String?
      connectedAt: DateTime?
      state: RuntimeInfrastructure.State
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructurePackageRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructureVerified
      subscribe RuntimeInfrastructureVerificationFailed
      subscribe RuntimeAgentInstallationSucceeded
      subscribe RuntimeAgentInstallationFailed
      subscribe RuntimeAgentDeploymentRetrySucceeded
      subscribe RuntimeAgentDeploymentRetryFailed
      subscribe RuntimeConnectionEstablished
    }
  }

  concept RuntimeInstallationPlan {
    state Planned

    slice CreateRuntimeInstallationPlan
    slice RuntimeInstallationPlanCatalog
    slice RuntimeInstallationGuide
  }

  concept RuntimeInfrastructurePackage {
    state Registered

    slice RegisterRuntimeInfrastructurePackage
    slice RuntimeInfrastructurePackageCatalog
  }

  concept RuntimeInfrastructure {
    state Registered
    state Verified
    state VerificationFailed
    state AgentReady
    state RuntimeAgentFailed
    state Offline
    state Connected

    slice RegisterRuntimeInfrastructure
    slice VerifyRuntimeInfrastructure
    slice DeployRuntimeAgent
    slice RetryRuntimeAgentDeployment
    slice RecordRuntimeConnectionEstablished
    slice RuntimeInfrastructureAccessView
  }
}

context DatasetGovernance {
  note "Dataset governance separates feature schemas, organization-declared dataset records, runtime-agent-reported dataset metadata, dataset access validation evidence, and train evaluation bundles. Runtime agents own data connectors, local access profiles, and credentials inside participant infrastructure."

  risk "Datasets may be approved despite schema drift, privacy sensitivity, or non IID skew that invalidates training assumptions."
  risk "Validated dataset access can remain selectable after governance revocation unless blocked explicitly."
  metric datasetContractValidationFailureRate
  metric runtimeDatasetAccessValidationLatency

  slice DefineFeatureSchema {
    startsLifecycle

    tags {
      featureDomain
      version
    }

    actor DataSteward
    ui FeatureSchemaEditor
  
    command DefineFeatureSchema {
      featureSchemaId: UUID id generated technical
      featureDomain: String
      version: String generated technical
      dataModality: String dictionary "FEATURE_SCHEMA_DATA_MODALITY"
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
    }
  
    event FeatureSchemaDefined {
      featureSchemaId: UUID id technical
      featureDomain: String
      version: String
      dataModality: String dictionary "FEATURE_SCHEMA_DATA_MODALITY"
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
      featureCount: Int derived {
        from DefineFeatureSchema.features
        rule "Count entries in the features collection."
      }
    }
  
    state Draft
  
    specification "Feature Schema Domain Version Unique" {
      rule """
        A feature schema is uniquely identified by the combination of its domain and system-assigned version. Two schemas within the same domain cannot share a version, and users do not manually type the next version. The schema data modality describes whether the feature list represents tabular columns or logical inputs for unstructured data such as text, image, audio, document, or embedding datasets.
      """
  
      expression {
        unique (FeatureSchema.featureDomain, FeatureSchema.version)
      }
  
      scenario "Reject Duplicate Feature Schema Version" {
        given FeatureSchemaDefined {
          featureDomain = "CreditRisk"
          version = "1.0.0"
        }
        when DefineFeatureSchema {
          featureDomain = "CreditRisk"
          version = "1.0.0"
        }
        then reject "Feature Schema Version Already Exists"
      }
    }
  }

  slice PublishFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaDefined
  
    command PublishFeatureSchema {
      featureSchemaId: UUID id technical
      publishNote: String?
    }
  
    event FeatureSchemaPublished {
      featureSchemaId: UUID id technical
      publishNote: String?
    }
  
    state Published
  
    specification "Only Draft Schemas Can Be Published" {
      rule """
        A feature schema can be published only from the Draft lifecycle state.
      """
  
      scenario "Publish Draft Schema" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-1"
        }
        when PublishFeatureSchema {
          featureSchemaId = "schema-1"
        }
        then FeatureSchemaPublished
      }
    }
  }
  
  slice DeprecateFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command DeprecateFeatureSchema {
      featureSchemaId: UUID id technical
      deprecationReason: String
    }
  
    event FeatureSchemaDeprecated {
      featureSchemaId: UUID id technical
      deprecationReason: String
    }
  
    state Deprecated
  }
  
  slice RetireFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaDeprecated
  
    command RetireFeatureSchema {
      featureSchemaId: UUID id technical
      retirementReason: String
    }
  
    event FeatureSchemaRetired {
      featureSchemaId: UUID id technical
      retirementReason: String
    }
  
    state Retired
  }
  
  // 确认逻辑（升级版本？） TODO
  slice SupersedeFeatureSchemaVersion {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command SupersedeFeatureSchemaVersion {
      featureSchemaId: UUID id technical
      supersededByFeatureSchemaId: UUID
      supersessionReason: String?
    }
  
    event FeatureSchemaVersionSuperseded {
      featureSchemaId: UUID id technical
      supersededByFeatureSchemaId: UUID
      featureDomain: String
      supersededVersion: String
      supersessionReason: String?
      supersededAt: DateTime
    }
  
    specification "Supersede Published Schema With Newer Version" {
      rule """
        Only schemas in the Published state can be superseded, and the superseding schema must belong to the same domain and have a later system-assigned version according to schema version ordering.
      """
  
      scenario "Supersede Older Version" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-1"
          featureDomain = "CreditRisk"
          version = "1.0.0"
        }
        given FeatureSchemaDefined {
          featureSchemaId = "schema-2"
          featureDomain = "CreditRisk"
          version = "1.1.0"
        }
        when SupersedeFeatureSchemaVersion {
          featureSchemaId = "schema-1"
          supersededByFeatureSchemaId = "schema-2"
        }
        then FeatureSchemaVersionSuperseded
      }
    }
  }
  
  slice MarkCurrentRecommendedFeatureSchemaVersion {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command MarkCurrentRecommendedFeatureSchemaVersion {
      featureSchemaId: UUID id technical
      recommendationNote: String?
    }
  
    event CurrentRecommendedFeatureSchemaVersionMarked {
      featureSchemaId: UUID id technical
      featureDomain: String derived {
        from FeatureSchema.featureDomain
        rule "Use the schema domain as the recommendation boundary."
      }
      recommendedVersion: String derived {
        from FeatureSchema.version
        rule "Expose the recommended schema version for catalog projection."
      }
      recommendedAt: DateTime
      recommendationNote: String?
    }
  
    specification "Only One Recommended Version Per Domain" {
      rule """
        For each domain, at most one feature schema version is marked as the current recommended version. Marking a new version as recommended must clear the previous recommended version in the same domain.
      """
  
      scenario "Mark New Recommended Version" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-2"
          featureDomain = "CreditRisk"
          version = "1.1.0"
        }
        when MarkCurrentRecommendedFeatureSchemaVersion {
          featureSchemaId = "schema-2"
        }
        then CurrentRecommendedFeatureSchemaVersionMarked
      }
    }
  }
  
  slice CurrentRecommendedFeatureSchemaCatalog {
    readmodel CurrentRecommendedFeatureSchemaCatalog[] {
      featureDomain: String id
      recommendedFeatureSchemaId: UUID
      recommendedVersion: String
      recommendedAt: DateTime
      recommendationNote: String?
      subscribe CurrentRecommendedFeatureSchemaVersionMarked
    }
  }

  slice FeatureSchemaCatalog {
    readmodel FeatureSchemaCatalog[] {
      featureSchemaId: UUID id
      featureDomain: String
      version: String
      dataModality: String dictionary "FEATURE_SCHEMA_DATA_MODALITY"
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
      featureCount: Int
      schemaStatus: String
      supersededByFeatureSchemaId: UUID?
      recommendedForDomain: Boolean
      subscribe FeatureSchemaDefined
      subscribe FeatureSchemaPublished
      subscribe FeatureSchemaDeprecated
      subscribe FeatureSchemaRetired
      subscribe FeatureSchemaVersionSuperseded
      subscribe CurrentRecommendedFeatureSchemaVersionMarked
    }
  }

  concept FeatureSchema {
    state Draft
    state Published
    state Deprecated
    state Retired
  
    slice DefineFeatureSchema
    slice PublishFeatureSchema
    slice DeprecateFeatureSchema
    slice RetireFeatureSchema
    slice FeatureSchemaCatalog
    slice SupersedeFeatureSchemaVersion
    slice MarkCurrentRecommendedFeatureSchemaVersion
    slice CurrentRecommendedFeatureSchemaCatalog
  }

  slice DeclareDataset {
    startsLifecycle

    tags {
      organizationId
      featureSchemaId
      datasetName
    }

    actor DataOwner
    ui DatasetRegistrationScreen
    reactsTo FeatureSchemaPublished
  
    command DeclareDataset {
      datasetId: UUID id generated technical
      organizationId: UUID
      featureSchemaId: UUID
      datasetName: String
      datasetType: String
      datasetUsage: String
    }
  
    event DatasetDeclared {
      datasetId: UUID id technical
      organizationId: UUID
      featureSchemaId: UUID
      datasetName: String
      datasetType: String
      datasetUsage: String
    }
  
    state Registered
  }

  slice RecordRuntimeDatasetMetadata {
    reactsTo AgentDatasetMetadataReported

    automation RecordDatasetMetadataWhenAgentReported {
      on AgentDatasetMetadataReported
      emits RecordRuntimeDatasetMetadata
    }

    command RecordRuntimeDatasetMetadata {
      metadataReportId: UUID id technical from AgentDatasetMetadataReported.metadataReportId
      datasetId: UUID from AgentDatasetMetadataReported.datasetId
      organizationId: UUID from AgentDatasetMetadataReported.organizationId
      runtimeId: UUID from AgentDatasetMetadataReported.runtimeId
      featureSchemaId: UUID from AgentDatasetMetadataReported.featureSchemaId
      sampleCount: Int from AgentDatasetMetadataReported.sampleCount
      featureCount: Int from AgentDatasetMetadataReported.featureCount
      schemaCompatible: Boolean from AgentDatasetMetadataReported.schemaCompatible
      labelCompatible: Boolean from AgentDatasetMetadataReported.labelCompatible
      missingValueRate: Decimal from AgentDatasetMetadataReported.missingValueRate
      duplicateRate: Decimal from AgentDatasetMetadataReported.duplicateRate
      qualityScore: Decimal from AgentDatasetMetadataReported.qualityScore
      nonIidScore: Decimal from AgentDatasetMetadataReported.nonIidScore
      classBalanceScore: Decimal? from AgentDatasetMetadataReported.classBalanceScore
      statisticsRef: String? from AgentDatasetMetadataReported.statisticsRef
      profiledAt: DateTime from AgentDatasetMetadataReported.profiledAt
    }

    event DatasetMetadataReported {
      metadataReportId: UUID id technical
      datasetId: UUID
      organizationId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean
      labelCompatible: Boolean
      missingValueRate: Decimal
      duplicateRate: Decimal
      qualityScore: Decimal
      nonIidScore: Decimal
      classBalanceScore: Decimal?
      statisticsRef: String?
      profiledAt: DateTime
    }

    state MetadataReported
  }

  slice ValidateDatasetContract {
    reactsTo DatasetMetadataReported
    port
  
    automation ValidateDatasetContractAutomatically {
      on DatasetMetadataReported
      emits ValidateDatasetContract
    }
  
    command ValidateDatasetContract {
      datasetId: UUID id technical from DatasetMetadataReported.datasetId
      metadataReportId: UUID from DatasetMetadataReported.metadataReportId
      featureSchemaId: UUID from DatasetMetadataReported.featureSchemaId
    }

    event DatasetContractValidated {
      datasetId: UUID id technical
      featureSchemaId: UUID
      metadataReportId: UUID
      schemaCompatible: Boolean from DatasetMetadataReported.schemaCompatible
      labelCompatible: Boolean from DatasetMetadataReported.labelCompatible
      qualityScore: Decimal from DatasetMetadataReported.qualityScore
      nonIidScore: Decimal from DatasetMetadataReported.nonIidScore
    }

    event DatasetContractValidationFailed {
      datasetId: UUID id technical
      featureSchemaId: UUID
      metadataReportId: UUID
      schemaCompatible: Boolean from DatasetMetadataReported.schemaCompatible
      labelCompatible: Boolean from DatasetMetadataReported.labelCompatible
      qualityScore: Decimal from DatasetMetadataReported.qualityScore
      nonIidScore: Decimal from DatasetMetadataReported.nonIidScore
      failureReason: String generated technical
    }

    state ContractValidationCompleted
  }

  slice RejectDatasetForTraining {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetContractValidated

    command RejectDatasetForTraining {
      datasetId: UUID id technical
      rejectionReason: String
    }

    event DatasetRejectedForTraining {
      datasetId: UUID id technical
      rejectionReason: String
    }

    state Rejected
  }

  slice ApproveDatasetForTraining {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetContractValidated

    command ApproveDatasetForTraining {
      datasetId: UUID id technical
    }

    event DatasetApprovedForTraining {
      datasetId: UUID id technical
      organizationId: UUID derived {
        from Dataset.organizationId
        rule "Carry the owning organization for organization-level approved dataset counts."
      }
    }

    specification "Only Validated Quality Datasets Are Approved" {
      rule """
        A dataset can be approved only after contract validation succeeds with acceptable quality and schema compatibility.
      """

      scenario "Approve Validated Dataset" {
        given DatasetContractValidated {
          datasetId = "dataset-1"
          schemaCompatible = true
          labelCompatible = true
          qualityScore = 0.86
        }
        when ApproveDatasetForTraining {
          datasetId = "dataset-1"
        }
        then DatasetApprovedForTraining
      }

      scenario "Reject Approval Before Contract Validation" {
        when ApproveDatasetForTraining {
          datasetId = "dataset-2"
        }
        then reject "Dataset Contract Validation Required"
      }
    }

    state Approved
  }

  slice RevokeDatasetTrainingApproval {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetApprovedForTraining

    command RevokeDatasetTrainingApproval {
      datasetId: UUID id technical
      revokeReason: String
    }

    event DatasetTrainingApprovalRevoked {
      datasetId: UUID id technical
      revokeReason: String
    }

    state ApprovalRevoked
  }

  slice DatasetCapability {
    readmodel DatasetCapability[] {
      datasetId: UUID id
      organizationId: UUID
      runtimeId: UUID?
      featureSchemaId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the dataset capability catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the dataset capability catalog."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the dataset capability catalog."
      }
      datasetName: String
      datasetUsage: String
      sampleCount: Int?
      featureCount: Int?
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      metadataReportId: UUID?
      statisticsRef: String?
      metadataStatus: String
      approvalStatus: String
      approved: Boolean
      lastProfiledAt: DateTime?
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe DatasetDeclared
      subscribe DatasetMetadataReported
      subscribe DatasetContractValidated
      subscribe DatasetContractValidationFailed
      subscribe DatasetRejectedForTraining
      subscribe DatasetApprovedForTraining
      subscribe DatasetTrainingApprovalRevoked
    }
  }

  slice DatasetReadiness {
    readmodel DatasetReadiness[] {
      datasetId: UUID id
      organizationId: UUID
      runtimeId: UUID?
      featureSchemaId: UUID
      datasetName: String
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the dataset readiness view."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the dataset readiness view."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the dataset readiness view."
      }
      datasetUsage: String
      metadataStatus: String
      contractStatus: String
      approvalStatus: String
      accessStatus: String
      runtimeStatus: String
      overallReadiness: String
      readyForTraining: Boolean
      canBeSelectedForTraining: Boolean
      readinessScore: Int
      missingRequirements: String[]
      blockingReasons: String[]
      warnings: String[]
      sampleCount: Int?
      featureCount: Int?
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
      metadataReportId: UUID?
      statisticsRef: String?
      datasetAccessValidationId: UUID?
      readable: Boolean?
      schemaReadable: Boolean?
      sampleBatchReadable: Boolean?
      validationReportId: UUID?
      lastProfiledAt: DateTime?
      lastAccessValidatedAt: DateTime?
      lastRuntimeHeartbeatAt: DateTime?
      lastUpdatedAt: DateTime?
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe DatasetDeclared
      subscribe DatasetMetadataReported
      subscribe DatasetContractValidated
      subscribe DatasetContractValidationFailed
      subscribe DatasetRejectedForTraining
      subscribe DatasetApprovedForTraining
      subscribe DatasetTrainingApprovalRevoked
      subscribe AgentDatasetAccessValidated
      subscribe RuntimeConnectionEstablished
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
    }
  }

  concept Dataset {
    state Registered
    state MetadataReported
    state ContractValidationCompleted
    state Approved
    state Rejected
    state ApprovalRevoked

    slice DeclareDataset
    slice RecordRuntimeDatasetMetadata
    slice ValidateDatasetContract
    slice RejectDatasetForTraining
    slice ApproveDatasetForTraining
    slice RevokeDatasetTrainingApproval
    slice DatasetCapability
    slice DatasetReadiness
  }

  value FeatureDefinition {
    featureName: String
    dataType: String dictionary "FEATURE_DATA_TYPE"
    required: Boolean
    nullable: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
    isIdentifier: Boolean
    isSensitive: Boolean
    encodingStrategy: String? dictionary "FEATURE_ENCODING_STRATEGY"
    featureTags: String[]
  }
  
  value LabelDefinition {
    labelName: String
    dataType: String dictionary "FEATURE_DATA_TYPE"
    cardinality: Int
    classLabels: String[]?
    isMultilabel: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
  }
}

context ModelRepository {
  note "Model repository owns pullable model artifact references used by training orchestration and runtime agents."

  risk "Runtime agents can pull stale or tampered models if artifact hashes and repository references are not snapshotted with the training run."
  risk "Aggregated round models can lose lineage if their producing training job and round are not recorded."
  metric modelArtifactRegistrationLatency
  metric modelArtifactPullFailureRate

  slice RegisterModelArtifact {
    startsLifecycle

    actor MLOpsEngineer
    ui ModelRepositoryScreen

    command RegisterModelArtifact {
      modelVersionId: UUID id generated technical
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      modelSizeBytes: Int?
      sourceType: String
    }

    event ModelArtifactRegistered {
      modelVersionId: UUID id technical
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      modelSizeBytes: Int?
      sourceType: String
    }

    state Registered

    specification "Model Artifact Must Be Pullable And Verifiable" {
      rule """
        A model artifact registered for training must include a repository reference, an artifact reference, a model format, and a content hash so runtime agents can pull and verify it.
      """

      scenario "Register Pullable Model Artifact" {
        when RegisterModelArtifact {
          modelVersionId = "model-1"
          modelRepositoryRef = "model-repo"
          modelArtifactRef = "models/model-1"
          modelFormat = "ONNX"
          modelHash = "sha256:abc"
          sourceType = "INITIAL"
        }
        then ModelArtifactRegistered
      }
    }
  }

  slice ModelArtifactCatalog {
    readmodel ModelArtifactCatalog[] {
      modelVersionId: UUID id
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      modelSizeBytes: Int?
      sourceType: String?
      trainingJobId: UUID?
      roundId: UUID?
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the model artifact catalog."
      }
      state: ModelArtifact.State
      registeredAt: DateTime?
      subscribe TrainingJobCreated
      subscribe ModelArtifactRegistered
      subscribe GlobalModelUpdated
    }
  }

  concept ModelArtifact {
    state Registered

    slice RegisterModelArtifact
    slice ModelArtifactCatalog
  }
}

context TrainingOrchestration {
  note "Training orchestration owns job intent, participant eligibility, runtime dispatch, and each round of distributed training and evaluation."

  risk "Training can stall when started participant runtimes fall below quorum or when secure aggregation is requested before enough evaluated updates exist."
  risk "Poisoned local updates can degrade the global model if anomaly checks are not modeled as a first class decision."
  metric nodeDropoutRate
  metric roundCompletionLatency
  metric globalAccuracyGap

  integration SecureAggregationProvider {
    source TrainingRound
    target SecureAggregationService
    reactsTo SecureAggregationRequested
    emits CompleteSecureAggregation
  }

  integration ParticipantRoundRuntime {
    source TrainingRound
    target RuntimeAgent
    reactsTo ParticipantExecutionPlanIssued
    emits ReceiveParticipantExecutionPlan
  }

  integration AggregationNodeRuntime {
    source TrainingRound
    target AggregationRuntime
    reactsTo GlobalModelUpdated
    emits SubmitGlobalModelEvaluation
  }

  slice DefineTrainingRunConfiguration {
    startsLifecycle

    actor MLOpsEngineer
    ui TrainingRunConfigurationScreen

    command DefineTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id generated technical
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
    }

    event TrainingRunConfigurationDefined {
      trainingRunConfigurationId: UUID id technical
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      initialModelArtifactUri: String derived {
        from ModelArtifact.modelArtifactRef
        rule "Snapshot the initial model artifact URI selected from the model repository."
      }
      initialModelRepositoryName: String derived {
        from ModelArtifact.modelRepositoryRef
        rule "Snapshot the model repository name so runtime agents can identify where the initial global model is managed."
      }
      initialModelFormat: String derived {
        from ModelArtifact.modelFormat
        rule "Snapshot the model format needed by the runtime engine."
      }
      initialModelHash: String derived {
        from ModelArtifact.modelHash
        rule "Snapshot the content hash used by runtime agents to verify the pulled model."
      }
      initialModelSignatureUri: String? derived {
        from ModelArtifact.modelSignatureRef
        rule "Snapshot the optional signature URI used to verify model provenance."
      }
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
    }

    state Draft

    specification "Training Configuration Must Be Runnable" {
      rule """
        A training run configuration is accepted only when the selected federation, feature schema, and initial model version exist; the round budget, quorum, timeouts, and local training parameters are positive; and differential privacy parameters are complete when differential privacy is enabled.
      """

      scenario "Define Runnable Configuration" {
        when DefineTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-1"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelVersionId = "model-1"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 10
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          differentialPrivacyEnabled = false
          minimumAccuracy = 0.9
          failureToleranceRatio = 0.2
        }
        then TrainingRunConfigurationDefined
      }

      scenario "Reject Empty Round Budget" {
        when DefineTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-2"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelVersionId = "model-1"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 0
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          differentialPrivacyEnabled = false
          minimumAccuracy = 0.9
          failureToleranceRatio = 0.2
        }
        then reject "Positive Round Budget Required"
      }

      scenario "Reject Differential Privacy Without Parameters" {
        when DefineTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-3"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelVersionId = "model-1"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 10
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          differentialPrivacyEnabled = true
          minimumAccuracy = 0.9
          failureToleranceRatio = 0.2
        }
        then reject "Differential Privacy Parameters Required"
      }
    }
  }

  slice UpdateTrainingRunConfiguration {
    actor MLOpsEngineer
    ui TrainingRunConfigurationScreen
    reactsTo TrainingRunConfigurationDefined

    command UpdateTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id technical
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
      updateReason: String?
    }

    event TrainingRunConfigurationUpdated {
      trainingRunConfigurationId: UUID id technical
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      initialModelArtifactUri: String derived {
        from ModelArtifact.modelArtifactRef
        rule "Snapshot the updated initial model artifact URI selected from the model repository."
      }
      initialModelRepositoryName: String derived {
        from ModelArtifact.modelRepositoryRef
        rule "Snapshot the updated model repository name so runtime agents can identify where the initial global model is managed."
      }
      initialModelFormat: String derived {
        from ModelArtifact.modelFormat
        rule "Snapshot the updated model format needed by the runtime engine."
      }
      initialModelHash: String derived {
        from ModelArtifact.modelHash
        rule "Snapshot the updated content hash used by runtime agents to verify the pulled model."
      }
      initialModelSignatureUri: String? derived {
        from ModelArtifact.modelSignatureRef
        rule "Snapshot the updated optional signature URI used to verify model provenance."
      }
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
      updateReason: String?
    }

    state Draft

    specification "Draft Training Configuration Can Be Updated" {
      rule """
        A training run configuration can be updated only while it is still Draft. The updated values must satisfy the same runnable configuration rules as creation. After the configuration is locked by training submission, correction must happen by creating a new configuration.
      """

      scenario "Update Draft Runnable Configuration" {
        given TrainingRunConfigurationDefined {
          trainingRunConfigurationId = "cfg-1"
        }
        when UpdateTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-1"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelVersionId = "model-2"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 20
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          differentialPrivacyEnabled = false
          minimumAccuracy = 0.9
          failureToleranceRatio = 0.2
          updateReason = "Tune round budget before submission."
        }
        then TrainingRunConfigurationUpdated
      }

      scenario "Reject Update After Configuration Locked" {
        given TrainingRunConfigurationLocked {
          trainingRunConfigurationId = "cfg-2"
        }
        when UpdateTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-2"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelVersionId = "model-2"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 20
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          differentialPrivacyEnabled = false
          minimumAccuracy = 0.9
          failureToleranceRatio = 0.2
          updateReason = "Fix submitted configuration."
        }
        then reject "Training Run Configuration Locked"
      }
    }
  }

  slice LockTrainingRunConfiguration {
    reactsTo TrainingJobSubmitted

    automation LockConfigurationWhenTrainingSubmitted {
      on TrainingJobSubmitted
      emits LockTrainingRunConfiguration
    }

    command LockTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id technical derived {
        from TrainingJob.trainingRunConfigurationId
        rule "Lock the configuration selected by the submitted training job."
      }
      trainingJobId: UUID from TrainingJobSubmitted.trainingJobId
    }

    event TrainingRunConfigurationLocked {
      trainingRunConfigurationId: UUID id technical
      trainingJobId: UUID
    }

    state Locked
  }
  // 具体配置 TODO
  slice TrainingRunConfigurationCatalog {
    readmodel TrainingRunConfigurationCatalog[] {
      trainingRunConfigurationId: UUID id
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into the training run configuration catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the training run configuration catalog."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the training run configuration catalog."
      }
      initialModelArtifactUri: String
      initialModelRepositoryName: String
      initialModelFormat: String
      initialModelHash: String
      initialModelSignatureUri: String?
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
      updateReason: String?
      lockedByTrainingJobId: UUID? derived {
        from TrainingRunConfigurationLocked.trainingJobId
        rule "Record the training job that locked this configuration after submission."
      }
      state: TrainingRunConfiguration.State
      subscribe FederationCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingRunConfigurationDefined
      subscribe TrainingRunConfigurationUpdated
      subscribe TrainingRunConfigurationLocked
    }
  }

  concept TrainingRunConfiguration {
    state Draft
    state Locked

    slice DefineTrainingRunConfiguration
    slice UpdateTrainingRunConfiguration
    slice LockTrainingRunConfiguration
    slice TrainingRunConfigurationCatalog
  }

  slice CreateTrainingJob {
    startsLifecycle

    actor ResearchLead
    ui TrainingJobCreationScreen
    reactsTo TrainingRunConfigurationDefined

    // Participating organizations are resolved from federation membership and runtime readiness.
    command CreateTrainingJob {
      trainingJobId: UUID id generated technical
      federationId: UUID
      trainingRunConfigurationId: UUID
      // 本次训练任务的业务目标或实验目的，用于列表、审计和结果解释；不承载训练超参数。
      objective: String
    }

    event TrainingJobCreated {
      trainingJobId: UUID id technical
      federationId: UUID
      featureSchemaId: UUID derived {
        from TrainingRunConfiguration.featureSchemaId
        rule "Use the feature schema selected in the runnable training run configuration."
      }
      trainingRunConfigurationId: UUID
      // 本次训练任务的业务目标或实验目的，用于列表、审计和结果解释；不承载训练超参数。
      objective: String
    }

    state Draft

    specification "Training Job Requires Runnable Configuration And Runtime Access" {
      rule """
        A training job can be created only from a defined runnable training run configuration. Runtime agents match local datasets by the configuration's feature schema when work is dispatched.
      """

      scenario "Create Training Job With Runnable Configuration" {
        given TrainingRunConfigurationDefined {
          trainingRunConfigurationId = "config-1"
        }
        when CreateTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then TrainingJobCreated
      }

      scenario "Reject Training Job Without Runnable Configuration" {
        when CreateTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then reject "Runnable Training Configuration Required"
      }
    }
  }

  slice SubmitTrainingJob {
    actor ResearchLead
    ui TrainingSubmissionScreen
    reactsTo TrainingJobCreated

    command SubmitTrainingJob {
      trainingJobId: UUID id technical
    }

    event TrainingJobSubmitted {
      trainingJobId: UUID id technical from SubmitTrainingJob.trainingJobId
    }

    state Submitted

    specification "Only Created Training Jobs Can Be Submitted" {
      rule """
        A training job can be submitted after it is created from a runnable training run configuration. Dataset matching is delegated to each runtime agent using the selected feature schema.
      """

      scenario "Submit Created Training Job" {
        given TrainingJobCreated {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        when SubmitTrainingJob {
          trainingJobId = "job-1"
        }
        then TrainingJobSubmitted
      }

      scenario "Reject Unknown Training Job" {
        when SubmitTrainingJob {
          trainingJobId = "job-1"
        }
        then reject "Training Job Required"
      }
    }
  }

  slice TrainingParticipantEligibility {
    reactsTo TrainingJobSubmitted

    readmodel TrainingParticipantEligibility[] {
      trainingJobId: UUID id
      federationId: UUID
      organizationId: UUID
      runtimeId: UUID?
      featureSchemaId: UUID
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into participant eligibility."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into participant eligibility."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into participant eligibility."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into participant eligibility."
      }
      participantStatus: String
      readinessStatus: String
      readinessStage: String
      eligibilityScore: Int
      runtimeAdmitted: Boolean
      runtimeGrantActive: Boolean
      runtimeCapabilitySatisfied: Boolean
      runtimeQuarantined: Boolean
      runtimeConnectionEstablished: Boolean
      runtimeHealthy: Boolean
      datasetId: UUID?
      datasetName: String?
      datasetReady: Boolean
      datasetReadinessStatus: String
      matchedDatasetMetadataReady: Boolean
      datasetAccessValidated: Boolean
      datasetApprovedForTraining: Boolean
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      qualityScore: Decimal?
      securityReady: Boolean
      eligible: Boolean
      eligibilityReason: String?
      ineligibleReasons: String[]
      warningReasons: String[]
      nextRequiredAction: String?
      subscribe FederationCreated
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe TrainingJobCreated
      subscribe TrainingJobSubmitted
      subscribe ParticipantJoined
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe RuntimeAdmitted
      subscribe RuntimeIdentityRevoked
      subscribe RuntimeQuarantined
      subscribe RuntimeCapabilityVerified
      subscribe RuntimeCapabilityRevoked
      subscribe FederationRuntimeAccessGranted
      subscribe FederationRuntimeAccessRevoked
      subscribe RuntimeConnectionEstablished
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
      subscribe DatasetDeclared
      subscribe DatasetMetadataReported
      subscribe DatasetContractValidated
      subscribe DatasetApprovedForTraining
      subscribe DatasetTrainingApprovalRevoked
      subscribe AgentDatasetAccessValidated
    }
  }

  slice PauseTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingRoundStarted

    command PauseTrainingJob {
      trainingJobId: UUID id technical
      pauseReason: String
    }

    event TrainingJobPaused {
      trainingJobId: UUID id technical
      pauseReason: String
    }

    state Paused
  }

  slice ResumeTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingJobPaused

    command ResumeTrainingJob {
      trainingJobId: UUID id technical
      resumeReason: String?
    }

    event TrainingJobResumed {
      trainingJobId: UUID id technical
      resumeReason: String?
    }

    state Running
  }

  slice CancelTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingRoundStarted

    command CancelTrainingJob {
      trainingJobId: UUID id technical
      cancelReason: String?
    }

    event TrainingJobCanceled {
      trainingJobId: UUID id technical
      cancelReason: String?
    }

    state Canceled
  }

  slice ScheduleNextTrainingRound {
    reactsTo TrainingRoundCompleted

    automation SelectNextRoundParticipantsWhenTrainingShouldContinue {
      condition shouldStartNextRound == true
      emits SelectTrainingRoundParticipants
    }
  }
  slice CompleteTrainingJob {

    reactsTo TrainingRoundCompleted

    automation CompleteJobWhenRoundBudgetExhausted {
      condition currentRoundNumber >= maxRounds
      emits CompleteTrainingJob
    }

    automation CompleteJobWhenGlobalMetricReached {
      condition globalAccuracy >= minimumAccuracy
      emits CompleteTrainingJob
    }

    command CompleteTrainingJob {
      trainingJobId: UUID id technical
      finalRoundId: UUID
      finalModelVersionId: UUID
      stopReason: String
    }

    event TrainingJobCompleted {
      trainingJobId: UUID id technical
      finalRoundId: UUID
      finalModelVersionId: UUID
      stopReason: String
    }

    state Completed
  }

  slice TrainingJobDashboard {
    readmodel TrainingJobDashboard[] {
      trainingJobId: UUID id
      federationId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into the training job dashboard."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the training job dashboard."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the training job dashboard."
      }
      objective: String
      strategyName: String? dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String? dictionary "AGGREGATION_ALGORITHM"
      secureAggregationRequired: Boolean?
      state: TrainingJob.State
      workflowStage: String
      workflowStep: Int
      nextAction: String?
      availableActions: String[]
      blockedReason: String?
      canSubmit: Boolean
      canStartRound: Boolean
      canPause: Boolean
      canResume: Boolean
      canCancel: Boolean
      canComplete: Boolean
      currentRoundNumber: Int
      startedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      roundProgressPercent: Int
      globalAccuracy: Decimal?
      finalModelVersionId: UUID?
      stopReason: String?
      subscribe FederationCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingJobCreated
      subscribe TrainingJobSubmitted
      subscribe TrainingJobPaused
      subscribe TrainingJobResumed
      subscribe TrainingJobCanceled
      subscribe TrainingRoundStarted
      subscribe TrainingRoundCompleted
      subscribe TrainingJobCompleted
    }
  }

  concept TrainingJob {
    state Draft
    state Submitted
    state Running
    state Paused
    state Canceled
    state Completed

    slice CreateTrainingJob
    slice SubmitTrainingJob
    slice TrainingParticipantEligibility
    slice PauseTrainingJob
    slice ResumeTrainingJob
    slice CancelTrainingJob
    slice ScheduleNextTrainingRound
    slice CompleteTrainingJob
    slice TrainingJobDashboard
  }

  slice SelectTrainingRoundParticipants {
    startsLifecycle
    reactsTo TrainingJobSubmitted

    automation SelectInitialRoundParticipantsWhenTrainingSubmitted {
      on TrainingJobSubmitted
      condition selectedEligibleRuntimeCount >= minimumNodesPerRound
      emits SelectTrainingRoundParticipants
    }

    command SelectTrainingRoundParticipants {
      trainingJobId: UUID id technical from TrainingJobSubmitted.trainingJobId
      trainingRunConfigurationId: UUID derived {
        from TrainingJob.trainingRunConfigurationId
        rule "Use the training configuration selected by the submitted job."
      }
      featureSchemaId: UUID derived {
        from TrainingJob.featureSchemaId
        rule "Use the feature schema selected by the job configuration."
      }
      roundId: UUID generated technical
      roundNumber: Int generated technical
      minimumNodesPerRound: Int derived {
        from TrainingRunConfiguration.minimumNodesPerRound
        rule "Use the runtime quorum configured for the selected training configuration."
      }
      selectedEligibleRuntimeCount: Int generated technical
      selectedRuntimeCount: Int generated technical
      participantSelectionRef: String generated technical
      selectionPolicy: String generated technical
    }

    event TrainingRoundParticipantsSelected {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      minimumNodesPerRound: Int
      selectedEligibleRuntimeCount: Int
      selectedRuntimeCount: Int
      participantSelectionRef: String
      selectionPolicy: String
    }

    state ParticipantsSelected

    specification "Training Round Participants Are Snapshotted Per Round" {
      rule """
        Each training round starts from a runtime snapshot selected by domain policy. The policy evaluates domain facts, not readmodel state: submitted job, locked training configuration, active federation membership, admitted runtime identity, active federation runtime grant, verified runtime capability, non-quarantined connected runtime status, and approved dataset evidence matching the feature schema. Runtimes that become ready after a round has begun cannot join that round, but they can be selected for a later round when policy allows dynamic round snapshots.
      """

      scenario "Select Participants When Runtime Pool Reaches Quorum" {
        given TrainingJobSubmitted {
          trainingJobId = "job-1"
        }
        when SelectTrainingRoundParticipants {
          trainingJobId = "job-1"
        }
        then TrainingRoundParticipantsSelected
      }

      scenario "Reject Participant Snapshot Below Quorum" {
        given TrainingJobSubmitted {
          trainingJobId = "job-1"
        }
        when SelectTrainingRoundParticipants {
          trainingJobId = "job-1"
        }
        then reject "Round Participant Quorum Required"
      }
    }
  }

  slice StartTrainingRound {
    reactsTo TrainingRoundParticipantsSelected

    automation StartRoundWhenParticipantsSelected {
      on TrainingRoundParticipantsSelected
      condition selectedRuntimeCount >= minimumNodesPerRound
      emits StartTrainingRound
    }

    command StartTrainingRound {
      trainingJobId: UUID id technical from TrainingRoundParticipantsSelected.trainingJobId
      trainingRunConfigurationId: UUID from TrainingRoundParticipantsSelected.trainingRunConfigurationId
      featureSchemaId: UUID from TrainingRoundParticipantsSelected.featureSchemaId
      roundId: UUID from TrainingRoundParticipantsSelected.roundId
      roundNumber: Int from TrainingRoundParticipantsSelected.roundNumber
      participantSelectionRef: String from TrainingRoundParticipantsSelected.participantSelectionRef
      selectedRuntimeCount: Int from TrainingRoundParticipantsSelected.selectedRuntimeCount
      minimumNodesPerRound: Int from TrainingRoundParticipantsSelected.minimumNodesPerRound
    }

    event TrainingRoundStarted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      participantSelectionRef: String
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
    }

    state Running

    specification "Training Round Requires Selected Runtime Quorum" {
      rule """
        A training round can start only from a selected participant snapshot whose selected runtime count satisfies the configured runtime quorum.
      """

      scenario "Start Round With Selected Runtime Quorum" {
        given TrainingRoundParticipantsSelected {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 3
          minimumNodesPerRound = 3
        }
        when StartTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 3
        }
        then TrainingRoundStarted
      }

      scenario "Reject Round Start Below Quorum" {
        given TrainingRoundParticipantsSelected {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 2
          minimumNodesPerRound = 3
        }
        when StartTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 2
        }
        then reject "Selected Runtime Quorum Required"
      }
    }
  }

  slice PublishRoundGlobalModel {
    reactsTo TrainingRoundStarted

    automation PublishRoundGlobalModelWhenRoundStarts {
      on TrainingRoundStarted
      emits PublishRoundGlobalModel
    }

    command PublishRoundGlobalModel {
      trainingJobId: UUID id technical from TrainingRoundStarted.trainingJobId
      trainingRunConfigurationId: UUID from TrainingRoundStarted.trainingRunConfigurationId
      featureSchemaId: UUID from TrainingRoundStarted.featureSchemaId
      roundId: UUID from TrainingRoundStarted.roundId
      roundNumber: Int from TrainingRoundStarted.roundNumber
      participantSelectionRef: String from TrainingRoundStarted.participantSelectionRef
      sourceModelVersionId: UUID derived {
        from TrainingRunConfiguration.initialModelVersionId, TrainingRoundCompleted.aggregatedModelVersionId
        rule "Round one uses the initial model selected by the training configuration; later rounds use the aggregated model from the previous completed round."
      }
      sourceModelArtifactRef: String derived {
        from TrainingRunConfiguration.initialModelArtifactUri, TrainingRoundCompleted.modelArtifactRef
        rule "Publish the artifact URI that selected runtime agents can pull for this round."
      }
      modelRepositoryRef: String derived {
        from TrainingRunConfiguration.initialModelRepositoryName, TrainingRoundCompleted.modelRepositoryRef
        rule "Publish the model repository name used by runtime agents for pulling the round model."
      }
      modelFormat: String derived {
        from TrainingRunConfiguration.initialModelFormat, TrainingRoundCompleted.modelFormat
        rule "Publish the model format expected by the runtime engine."
      }
      modelHash: String derived {
        from TrainingRunConfiguration.initialModelHash, TrainingRoundCompleted.modelHash
        rule "Publish the content hash that runtime agents must verify after pulling the model."
      }
      modelSignatureRef: String? derived {
        from TrainingRunConfiguration.initialModelSignatureUri, TrainingRoundCompleted.modelSignatureRef
        rule "Publish the optional model signature URI for provenance verification."
      }
      targetRuntimeCount: Int from TrainingRoundStarted.selectedRuntimeCount
    }

    event RoundGlobalModelPublished {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      participantSelectionRef: String
      sourceModelVersionId: UUID
      sourceModelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      targetRuntimeCount: Int
    }

    state CollectingUpdates
  }

  slice GenerateParticipantExecutionPlan {
    startsLifecycle
    reactsTo RoundGlobalModelPublished

    automation GeneratePlanForSelectedRuntime {
      on RoundGlobalModelPublished
      condition runtimeSelected == true
      emits GenerateParticipantExecutionPlan
    }

    command GenerateParticipantExecutionPlan {
      executionPlanId: UUID id generated technical
      executionSessionId: UUID generated technical
      trainingJobId: UUID from RoundGlobalModelPublished.trainingJobId
      trainingRunConfigurationId: UUID from RoundGlobalModelPublished.trainingRunConfigurationId
      featureSchemaId: UUID from RoundGlobalModelPublished.featureSchemaId
      roundId: UUID from RoundGlobalModelPublished.roundId
      roundNumber: Int from RoundGlobalModelPublished.roundNumber
      runtimeId: UUID derived {
        from TrainingRoundParticipantsSelected.participantSelectionRef
        rule "Fan out one immutable execution plan per selected RuntimeIdentity."
      }
      organizationId: UUID derived {
        from TrainingRoundParticipantsSelected.participantSelectionRef
        rule "Carry participant organization for audit without exposing local node choice."
      }
      baseModelArtifactRef: String from RoundGlobalModelPublished.sourceModelArtifactRef
      baseModelDigest: String from RoundGlobalModelPublished.modelHash
      aggregationPublicKey: String?
      allowedNetworkDestinations: String[]
      nonce: String
      issuedAt: DateTime
      expiresAt: DateTime
    }

    event ParticipantExecutionPlanGenerated {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelArtifactRef: String
      baseModelDigest: String
      aggregationPublicKey: String?
      allowedNetworkDestinations: String[]
      nonce: String
      issuedAt: DateTime
      expiresAt: DateTime
    }

    state PlanGenerated
  }

  slice SignParticipantExecutionPlan {
    reactsTo ParticipantExecutionPlanGenerated

    automation SignExecutionPlanWhenGenerated {
      on ParticipantExecutionPlanGenerated
      emits SignParticipantExecutionPlan
    }

    command SignParticipantExecutionPlan {
      executionPlanId: UUID id technical from ParticipantExecutionPlanGenerated.executionPlanId
      signingKeyId: String
      signature: String
      signedAt: DateTime
    }

    event ParticipantExecutionPlanSigned {
      executionPlanId: UUID id technical
      signingKeyId: String
      signature: String
      signedAt: DateTime
    }

    state PlanSigned
  }

  slice IssueParticipantExecutionPlan {
    reactsTo ParticipantExecutionPlanSigned

    automation IssueExecutionPlanWhenSigned {
      on ParticipantExecutionPlanSigned
      emits IssueParticipantExecutionPlan
    }

    command IssueParticipantExecutionPlan {
      executionPlanId: UUID id technical from ParticipantExecutionPlanSigned.executionPlanId
      executionSessionId: UUID derived from ParticipantExecutionPlanGenerated.executionSessionId by executionPlanId
      trainingJobId: UUID derived from ParticipantExecutionPlanGenerated.trainingJobId by executionPlanId
      trainingRunConfigurationId: UUID derived from ParticipantExecutionPlanGenerated.trainingRunConfigurationId by executionPlanId
      featureSchemaId: UUID derived from ParticipantExecutionPlanGenerated.featureSchemaId by executionPlanId
      roundId: UUID derived from ParticipantExecutionPlanGenerated.roundId by executionPlanId
      roundNumber: Int derived from ParticipantExecutionPlanGenerated.roundNumber by executionPlanId
      runtimeId: UUID derived from ParticipantExecutionPlanGenerated.runtimeId by executionPlanId
      organizationId: UUID derived from ParticipantExecutionPlanGenerated.organizationId by executionPlanId
      baseModelArtifactRef: String derived from ParticipantExecutionPlanGenerated.baseModelArtifactRef by executionPlanId
      baseModelDigest: String derived from ParticipantExecutionPlanGenerated.baseModelDigest by executionPlanId
      aggregationPublicKey: String? derived from ParticipantExecutionPlanGenerated.aggregationPublicKey by executionPlanId
      allowedNetworkDestinations: String[] derived from ParticipantExecutionPlanGenerated.allowedNetworkDestinations by executionPlanId
      nonce: String derived from ParticipantExecutionPlanGenerated.nonce by executionPlanId
      issuedAt: DateTime derived from ParticipantExecutionPlanGenerated.issuedAt by executionPlanId
      expiresAt: DateTime derived from ParticipantExecutionPlanGenerated.expiresAt by executionPlanId
      signature: String from ParticipantExecutionPlanSigned.signature
    }

    event ParticipantExecutionPlanIssued {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelArtifactRef: String
      baseModelDigest: String
      aggregationPublicKey: String?
      allowedNetworkDestinations: String[]
      nonce: String
      issuedAt: DateTime
      expiresAt: DateTime
      signature: String
    }

    state PlanIssued
  }

  slice SubmitModelUpdateSubmission {
    actor RuntimeAgent
    reactsTo AgentLocalModelUpdateSubmitted

    command SubmitModelUpdateSubmission {
      modelUpdateSubmissionId: UUID id generated technical
      executionSessionId: UUID from AgentLocalModelUpdateSubmitted.executionSessionId
      executionPlanId: UUID from AgentLocalModelUpdateSubmitted.executionPlanId
      trainingJobId: UUID from AgentLocalModelUpdateSubmitted.trainingJobId
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundExecutionId: UUID from AgentLocalModelUpdateSubmitted.roundExecutionId
      runtimeId: UUID from AgentLocalModelUpdateSubmitted.runtimeId
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      trainingLoss: Decimal
      submittedAt: DateTime
    }

    event ModelUpdateSubmissionReceived {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundExecutionId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      trainingLoss: Decimal
      submittedAt: DateTime
    }

    state Received
  }

  slice EvaluateModelUpdateSubmission {
    reactsTo ModelUpdateSubmissionReceived

    automation EvaluateModelUpdateWhenReceived {
      on ModelUpdateSubmissionReceived
      emits EvaluateModelUpdateSubmission
    }

    command EvaluateModelUpdateSubmission {
      modelUpdateSubmissionId: UUID id technical from ModelUpdateSubmissionReceived.modelUpdateSubmissionId
      executionSessionId: UUID from ModelUpdateSubmissionReceived.executionSessionId
      executionPlanId: UUID from ModelUpdateSubmissionReceived.executionPlanId
      trainingJobId: UUID from ModelUpdateSubmissionReceived.trainingJobId
      trainingRunConfigurationId: UUID from ModelUpdateSubmissionReceived.trainingRunConfigurationId
      roundId: UUID from ModelUpdateSubmissionReceived.roundId
      runtimeId: UUID from ModelUpdateSubmissionReceived.runtimeId
      anomalyScore: Decimal generated technical
      evaluatedAt: DateTime
    }

    event ModelUpdateSubmissionAccepted {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      anomalyScore: Decimal
      evaluatedAt: DateTime
    }

    event ModelUpdateSubmissionRejected {
      modelUpdateSubmissionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      updateArtifactId: UUID from ModelUpdateSubmissionReceived.updateArtifactId
      anomalyScore: Decimal
      rejectionReason: String generated technical
      evaluatedAt: DateTime
    }

    state Evaluated

    specification "Poisoned Local Updates Are Excluded" {
      rule """
        A local model update is evaluated exactly once by aggregation policy. The same evaluation command records ModelUpdateSubmissionAccepted when the update passes policy, or ModelUpdateSubmissionRejected when anomaly checks fail.
      """

      scenario "Reject Anomalous Update" {
        given ModelUpdateSubmissionReceived {
          modelUpdateSubmissionId = "submission-1"
          roundId = "round-1"
          runtimeId = "runtime-1"
          updateArtifactId = "artifact-1"
          trainingLoss = 99.0
        }
        when EvaluateModelUpdateSubmission {
          modelUpdateSubmissionId = "submission-1"
          anomalyScore = 0.98
        }
        then ModelUpdateSubmissionRejected
      }
    }
  }

  slice RequestSecureAggregation {
    reactsTo ModelUpdateSubmissionAccepted

    automation RequestAggregationWhenEvaluatedUpdatesComplete {
      condition acceptedModelUpdateCount >= minimumNodesPerRound
      emits RequestSecureAggregation
    }

    command RequestSecureAggregation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      acceptedModelUpdateCount: Int
      minimumNodesPerRound: Int derived from TrainingRoundStarted.minimumNodesPerRound by roundId
      aggregationProvider: String
    }

    event SecureAggregationRequested {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      acceptedModelUpdateCount: Int
      minimumNodesPerRound: Int
      aggregationProvider: String
    }

    state Aggregating
  }

  slice CompleteSecureAggregation {
    reactsTo SecureAggregationRequested

    command CompleteSecureAggregation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      requestId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
    }

    event GlobalModelUpdated {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      requestId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
    }

    state EvaluatingGlobalModel
  }

  slice SubmitGlobalModelEvaluation {
    reactsTo GlobalModelUpdated

    command SubmitGlobalModelEvaluation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String from GlobalModelUpdated.modelArtifactRef
      modelRepositoryRef: String from GlobalModelUpdated.modelRepositoryRef
      modelFormat: String from GlobalModelUpdated.modelFormat
      modelHash: String from GlobalModelUpdated.modelHash
      modelSignatureRef: String? from GlobalModelUpdated.modelSignatureRef
      globalAccuracy: Decimal
      globalFairnessScore: Decimal
    }

    event GlobalModelEvaluationSubmitted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      globalAccuracy: Decimal
      globalFairnessScore: Decimal
    }
  }

  slice CompleteTrainingRound {
    reactsTo GlobalModelEvaluationSubmitted

    automation FinishRoundAfterGlobalModelEvaluated {
      on GlobalModelEvaluationSubmitted
      emits CompleteTrainingRound
    }

    command CompleteTrainingRound {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String from GlobalModelEvaluationSubmitted.modelArtifactRef
      modelRepositoryRef: String from GlobalModelEvaluationSubmitted.modelRepositoryRef
      modelFormat: String from GlobalModelEvaluationSubmitted.modelFormat
      modelHash: String from GlobalModelEvaluationSubmitted.modelHash
      modelSignatureRef: String? from GlobalModelEvaluationSubmitted.modelSignatureRef
      globalAccuracy: Decimal
    }

    event TrainingRoundCompleted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      globalAccuracy: Decimal
    }

    state Completed

    specification "Training Round Completion Requires Global Evaluation" {
      rule """
        A training round can be completed only after the aggregated global model has been evaluated.
      """

      scenario "Complete Round After Global Evaluation" {
        given GlobalModelEvaluationSubmitted {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
          globalAccuracy = 0.91
        }
        when CompleteTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
          globalAccuracy = 0.91
        }
        then TrainingRoundCompleted
      }

      scenario "Reject Round Completion Without Global Evaluation" {
        given GlobalModelUpdated {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
        }
        when CompleteTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
        }
        then reject "Global Model Evaluation Required"
      }
    }
  }

  slice FailTrainingRound {
    actor AggregationRuntime

    automation FailRoundWhenRejectedUpdatesBreakQuorum {
      on ModelUpdateSubmissionRejected
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    automation FailRoundWhenRuntimeExecutionFailureBreaksQuorum {
      on RoundExecutionFailed
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    automation FailRoundWhenContributionDeadlineMissed {
      on TrainingRoundStarted
      condition roundContributionTimedOut == true
      emits FailTrainingRound
    }

    command FailTrainingRound {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      failureReason: String
    }

    event TrainingRoundFailed {
      trainingJobId: UUID id technical from FailTrainingRound.trainingJobId
      trainingRunConfigurationId: UUID from FailTrainingRound.trainingRunConfigurationId
      featureSchemaId: UUID from FailTrainingRound.featureSchemaId
      roundId: UUID from FailTrainingRound.roundId
      selectedRuntimeCount: Int from FailTrainingRound.selectedRuntimeCount
      minimumNodesPerRound: Int from FailTrainingRound.minimumNodesPerRound
      failureReason: String from FailTrainingRound.failureReason
    }

    state Failed
  }

  slice TrainingRoundProgress {
    readmodel TrainingRoundProgress[] {
      trainingJobId: UUID id
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID id
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into round progress."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into round progress."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into round progress."
      }
      roundNumber: Int
      state: TrainingRound.State
      participantSelectionRef: String?
      selectedEligibleRuntimeCount: Int
      selectedRuntimeCount: Int
      targetRuntimeCount: Int
      executionPlanIssuedCount: Int
      roundExecutionStartedCount: Int
      submittedModelUpdateCount: Int
      rejectedUpdateCount: Int
      acceptedModelUpdateCount: Int
      acceptedUpdateCount: Int
      pendingUpdateCount: Int
      failedRoundExecutionCount: Int
      completedRoundExecutionCount: Int
      quorumMet: Boolean
      quorumStatus: String
      minimumNodesPerRound: Int?
      aggregationReady: Boolean
      secureAggregationRequired: Boolean
      secureAggregationStatus: String?
      evaluationComplete: Boolean
      progressPercent: Int
      currentPhase: String
      nextAction: String?
      blockedReason: String?
      delayedReason: String?
      roundStartedAt: DateTime?
      contributionDeadlineAt: DateTime?
      aggregationStartedAt: DateTime?
      evaluationSubmittedAt: DateTime?
      completedAt: DateTime?
      failedAt: DateTime?
      aggregationProvider: String?
      sourceModelVersionId: UUID?
      sourceModelArtifactRef: String?
      modelRepositoryRef: String?
      modelHash: String?
      artifactRefs: String[]
      rejectedUpdateReasons: String[]
      aggregatedModelVersionId: UUID?
      aggregatedModelArtifactRef: String?
      globalAccuracy: Decimal?
      globalFairnessScore: Decimal?
      failureReason: String?
      subscribe TrainingJobCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingRoundParticipantsSelected
      subscribe TrainingRoundStarted
      subscribe RoundGlobalModelPublished
      subscribe ParticipantExecutionPlanIssued
      subscribe RoundExecutionStarted
      subscribe RoundExecutionCompleted
      subscribe RoundExecutionFailed
      subscribe ModelUpdateSubmissionReceived
      subscribe ModelUpdateSubmissionAccepted
      subscribe ModelUpdateSubmissionRejected
      subscribe SecureAggregationRequested
      subscribe GlobalModelUpdated
      subscribe GlobalModelEvaluationSubmitted
      subscribe TrainingRoundCompleted
      subscribe TrainingRoundFailed
    }
  }

  concept TrainingRound {
    state ParticipantsSelected
    state Running
    state CollectingUpdates
    state Aggregating
    state EvaluatingGlobalModel
    state Completed
    state Failed

    slice SelectTrainingRoundParticipants
    slice StartTrainingRound
    slice PublishRoundGlobalModel
    slice SubmitModelUpdateSubmission
    slice EvaluateModelUpdateSubmission
    slice RequestSecureAggregation
    slice CompleteSecureAggregation
    slice SubmitGlobalModelEvaluation
    slice CompleteTrainingRound
    slice FailTrainingRound
    slice TrainingRoundProgress
  }

  concept ParticipantExecutionPlan {
    state PlanGenerated
    state PlanSigned
    state PlanIssued

    slice GenerateParticipantExecutionPlan
    slice SignParticipantExecutionPlan
    slice IssueParticipantExecutionPlan
  }
}

context ModelLifecycle {
  note "Model lifecycle starts after training has produced a final evaluated candidate."

  risk "A model can be promoted without a reproducibility package, model card, or approved evaluation report."
  risk "Rollback decisions may lose lineage if previous production versions are not captured."
  metric modelApprovalLeadTime
  metric productionRollbackRate

  slice RegisterCandidateModel {
    startsLifecycle
    reactsTo TrainingJobCompleted

    automation RegisterFinalModelWhenTrainingJobCompleted {
      on TrainingJobCompleted
      emits RegisterCandidateModel
    }

    command RegisterCandidateModel {
      modelVersionId: UUID id technical
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      modelHash: String
      evaluationReportId: UUID
      lineageRef: String
      finalGlobalAccuracy: Decimal
    }

    event ModelCandidateRegistered {
      modelVersionId: UUID id technical
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      modelHash: String
      evaluationReportId: UUID
      lineageRef: String
      finalGlobalAccuracy: Decimal
    }

    state Candidate
  }

  slice RecordModelEvaluationPackage {
    actor GovernanceReviewer
    ui ModelApprovalScreen
    reactsTo ModelCandidateRegistered

    command RecordModelEvaluationPackage {
      modelVersionId: UUID id technical
      trainingJobId: UUID
      evaluationReportId: UUID
      experimentId: UUID
      hyperparameterSnapshotId: UUID
      reproducibilityManifestId: UUID
      modelCardId: UUID
      baselineModelVersionId: UUID?
    }

    event ModelEvaluationPackageRecorded {
      modelVersionId: UUID id technical from RecordModelEvaluationPackage.modelVersionId
      trainingJobId: UUID from RecordModelEvaluationPackage.trainingJobId
      evaluationReportId: UUID from RecordModelEvaluationPackage.evaluationReportId
      experimentId: UUID from RecordModelEvaluationPackage.experimentId
      hyperparameterSnapshotId: UUID from RecordModelEvaluationPackage.hyperparameterSnapshotId
      reproducibilityManifestId: UUID from RecordModelEvaluationPackage.reproducibilityManifestId
      modelCardId: UUID from RecordModelEvaluationPackage.modelCardId
      baselineModelVersionId: UUID? from RecordModelEvaluationPackage.baselineModelVersionId
    }

    state EvaluationPackaged

    specification "Model Approval Requires Evaluation Package" {
      rule """
        A model candidate must have an evaluation report, reproducibility manifest, hyperparameter snapshot, and model card before governance approval.
      """

      scenario "Record Complete Evaluation Package" {
        given ModelCandidateRegistered {
          modelVersionId = "model-1"
          evaluationReportId = "report-1"
        }
        when RecordModelEvaluationPackage {
          modelVersionId = "model-1"
          reproducibilityManifestId = "manifest-1"
          modelCardId = "card-1"
        }
        then ModelEvaluationPackageRecorded
      }
    }
  }

  slice ApproveModel {
    actor GovernanceReviewer
    ui ModelApprovalScreen
    reactsTo ModelEvaluationPackageRecorded

    command ApproveModel {
      modelVersionId: UUID id technical
      approvalNote: String?
    }

    event ModelApproved {
      modelVersionId: UUID id technical
      approvalNote: String?
    }

    state Approved

    specification "Only Evaluation Packaged Models Can Be Approved" {
      rule """
        A model can be approved only after its evaluation package has been recorded.
      """

      scenario "Approve Evaluation Packaged Model" {
        given ModelEvaluationPackageRecorded {
          modelVersionId = "model-1"
          evaluationReportId = "report-1"
          reproducibilityManifestId = "manifest-1"
          modelCardId = "card-1"
        }
        when ApproveModel {
          modelVersionId = "model-1"
        }
        then ModelApproved
      }

      scenario "Reject Candidate Without Evaluation Package" {
        given ModelCandidateRegistered {
          modelVersionId = "model-1"
          evaluationReportId = "report-1"
        }
        when ApproveModel {
          modelVersionId = "model-1"
        }
        then reject "Model Evaluation Package Required"
      }
    }
  }

  slice PromoteModelToProduction {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelApproved

    command PromoteModelToProduction {
      modelVersionId: UUID id technical
      releaseChannel: String
      deploymentTarget: String
    }

    event ModelPromotedToProduction {
      modelVersionId: UUID id technical
      releaseChannel: String
      deploymentTarget: String
    }

    state Production

    specification "Only Approved Models Can Be Promoted To Production" {
      rule """
        A model version can be promoted to production only after governance approval.
      """

      scenario "Promote Approved Model" {
        given ModelApproved {
          modelVersionId = "model-1"
        }
        when PromoteModelToProduction {
          modelVersionId = "model-1"
          releaseChannel = "stable"
          deploymentTarget = "production"
        }
        then ModelPromotedToProduction
      }

      scenario "Reject Unapproved Model Promotion" {
        given ModelEvaluationPackageRecorded {
          modelVersionId = "model-1"
        }
        when PromoteModelToProduction {
          modelVersionId = "model-1"
          releaseChannel = "stable"
          deploymentTarget = "production"
        }
        then reject "Model Approval Required"
      }
    }
  }

  slice RollbackModelVersion {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelPromotedToProduction

    command RollbackModelVersion {
      modelVersionId: UUID id technical
      previousModelVersionId: UUID
      rollbackReason: String
    }

    event ModelVersionRolledBack {
      modelVersionId: UUID id technical
      previousModelVersionId: UUID
      rollbackReason: String
    }

    state RolledBack
  }

  slice RetireModelVersion {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelPromotedToProduction

    command RetireModelVersion {
      modelVersionId: UUID id technical
      retirementReason: String
    }

    event ModelVersionRetired {
      modelVersionId: UUID id technical
      retirementReason: String
    }

    state Retired
  }

  slice ModelVersionCatalog {
    readmodel ModelVersionCatalog[] {
      modelVersionId: UUID id
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the model version catalog."
      }
      modelHash: String
      evaluationReportId: UUID
      lineageRef: String
      finalGlobalAccuracy: Decimal
      state: ModelVersion.State
      releaseChannel: String?
      deploymentTarget: String?
      previousModelVersionId: UUID?
      experimentId: UUID?
      hyperparameterSnapshotId: UUID?
      reproducibilityManifestId: UUID?
      modelCardId: UUID?
      baselineModelVersionId: UUID?
      hasEvaluationPackage: Boolean
      approvalStatus: String
      releaseStatus: String
      isProduction: Boolean
      canRecordEvaluationPackage: Boolean
      canApprove: Boolean
      canPromoteToProduction: Boolean
      canRollback: Boolean
      canRetire: Boolean
      blockedReason: String?
      subscribe TrainingJobCreated
      subscribe ModelCandidateRegistered
      subscribe ModelEvaluationPackageRecorded
      subscribe ModelApproved
      subscribe ModelPromotedToProduction
      subscribe ModelVersionRolledBack
      subscribe ModelVersionRetired
    }
  }

  concept ModelVersion {
    state Candidate
    state EvaluationPackaged
    state Approved
    state Production
    state RolledBack
    state Retired

    slice RegisterCandidateModel
    slice RecordModelEvaluationPackage
    slice ApproveModel
    slice PromoteModelToProduction
    slice RollbackModelVersion
    slice RetireModelVersion
    slice ModelVersionCatalog
  }
}

context RuntimeMonitoring {
  note "Runtime operations separates low-frequency runtime state changes, node inventory changes, latest telemetry views, training alerts, and append only audit records. High-frequency heartbeat and resource samples are telemetry, not event-sourced domain events."

  risk "Operational alerts without acknowledgement or resolution tracking can hide node degradation during training."
  risk "Audit records without payload hashes and source event classification weaken compliance evidence."
  metric runtimeAlertMeanTimeToAcknowledge
  metric auditTrailCompleteness

  slice RuntimeTelemetryLatest {
    readmodel RuntimeTelemetryLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID?
      trainingJobId: UUID?
      roundExecutionId: UUID?
      cpuLoad: Decimal?
      gpuLoad: Decimal?
      memoryLoad: Decimal?
      lastHeartbeatAt: DateTime?
      telemetryRetentionPolicy: String
    }
  }

  slice DetectRuntimeAgentOffline {
    startsLifecycle

    automation DetectOfflineRuntimeAgentFromTelemetry {
      condition heartbeatMissingBeyondThreshold == true
      emits DetectRuntimeAgentOffline
    }

    command DetectRuntimeAgentOffline {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      lastHeartbeatAt: DateTime
      offlineReason: String
    }

    event RuntimeAgentOfflineDetected {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      lastHeartbeatAt: DateTime
      offlineReason: String
    }

    state Offline
  }

  slice MarkRuntimeAgentRecovered {
    reactsTo RuntimeAgentOfflineDetected

    automation MarkRecoveredRuntimeAgentFromTelemetry {
      condition heartbeatObservedAfterOffline == true
      emits MarkRuntimeAgentRecovered
    }

    command MarkRuntimeAgentRecovered {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      recoveryReason: String?
    }

    event RuntimeAgentRecovered {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      recoveryReason: String?
    }

    state Healthy
  }

  slice DetectRuntimeNodeResourcePressure {
    startsLifecycle

    automation DetectResourcePressureFromTelemetry {
      condition latestGpuLoad > 95
      emits DetectRuntimeNodeResourcePressure
    }

    command DetectRuntimeNodeResourcePressure {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      trainingJobId: UUID?
      pressureType: String
      observedValue: Decimal
      thresholdValue: Decimal
    }

    event RuntimeNodeResourcePressureDetected {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      trainingJobId: UUID?
      pressureType: String
      observedValue: Decimal
      thresholdValue: Decimal
    }

    state PressureDetected
  }

  slice RecordRuntimeNodeInventory {
    startsLifecycle
    reactsTo AgentRuntimeNodeInventoryReported

    automation RecordRuntimeNodeInventoryWhenAgentReported {
      on AgentRuntimeNodeInventoryReported
      emits RecordRuntimeNodeInventory
    }

    command RecordRuntimeNodeInventory {
      nodeId: UUID id technical
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String              // CONTROL_PLANE / WORKER
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
    }

    event RuntimeNodeInventoryReported {
      nodeId: UUID id technical
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
    }

    state Reported
  }

  slice RuntimeNodeInventoryView {
    readmodel RuntimeNodeInventoryView[] {
      nodeId: UUID id
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime node inventory view."
      }
      runtimeName: String? derived {
        from RuntimeInstallationPlanCreated.runtimeName
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime display name into the runtime node inventory view."
      }
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      recordedAt: DateTime
      subscribe OrganizationRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeNodeInventoryReported
    }
  }

  slice RuntimeNodeResourceLatest {
    readmodel RuntimeNodeResourceLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
      telemetryRetentionPolicy: String
    }
  }

  slice DetectRuntimeNodeCapacityChange {
    startsLifecycle

    automation DetectCapacityChangeFromResourceTelemetry {
      condition allocatableCapacityChanged == true
      emits DetectRuntimeNodeCapacityChange
    }

    command DetectRuntimeNodeCapacityChange {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      previousCapacityHash: String?
      currentCapacityHash: String
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
    }

    event RuntimeNodeCapacityChanged {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      previousCapacityHash: String?
      currentCapacityHash: String
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
    }

    state CapacityChanged
  }

  slice RuntimeHealthDashboard {
    readmodel RuntimeHealthDashboard[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID
      trainingJobId: UUID?
      roundExecutionId: UUID?
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into the runtime health dashboard."
      }
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the runtime health dashboard."
      }
      cpuLoad: Decimal
      gpuLoad: Decimal
      memoryLoad: Decimal
      nodeReady: Boolean?
      availableCpuCores: Int?
      availableMemoryGb: Int?
      availableGpuCount: Int?
      runningPodCount: Int?
      podCapacity: Int?
      healthStatus: String
      lastHeartbeatAt: DateTime
      lastResourceSnapshotAt: DateTime?
      subscribe FederationCreated
      subscribe TrainingJobCreated
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
      subscribe RuntimeNodeResourcePressureDetected
      subscribe RuntimeNodeCapacityChanged
      subscribe RuntimeNodeInventoryReported
      subscribe TrainingAlertRaised
    }
  }

  concept NodeRuntimeHealth {
    state Healthy
    state Offline

    slice RuntimeTelemetryLatest
    slice DetectRuntimeAgentOffline
    slice MarkRuntimeAgentRecovered
    slice RuntimeHealthDashboard
  }

  concept RuntimeNodeResourcePressure {
    state PressureDetected

    slice DetectRuntimeNodeResourcePressure
  }

  concept RuntimeNodeCapacity {
    state CapacityChanged

    slice DetectRuntimeNodeCapacityChange
  }

  concept RuntimeNodeInventory {
    state Reported

    slice RecordRuntimeNodeInventory
    slice RuntimeNodeInventoryView
  }

  concept RuntimeNodeResourceTelemetry {
    slice RuntimeNodeResourceLatest
  }

  slice RaiseTrainingAlert {
    startsLifecycle
    reactsTo RuntimeNodeResourcePressureDetected

    automation RaiseAlertOnNodeResourcePressure {
      on RuntimeNodeResourcePressureDetected
      emits RaiseTrainingAlert
    }

    command RaiseTrainingAlert {
      alertId: UUID id generated technical
      nodeId: UUID from RuntimeNodeResourcePressureDetected.nodeId
      trainingJobId: UUID? from RuntimeNodeResourcePressureDetected.trainingJobId
      severity: String
      message: String
    }

    event TrainingAlertRaised {
      alertId: UUID id technical
      nodeId: UUID
      trainingJobId: UUID?
      severity: String
      message: String
    }

    state Raised
  }

  slice TrainingAlertCatalog {
    readmodel TrainingAlertCatalog[] {
      alertId: UUID id
      nodeId: UUID
      trainingJobId: UUID?
      orchestratorNodeName: String? derived {
        from RuntimeNodeInventoryReported.orchestratorNodeName
        rule "Lookup by nodeId and denormalize the runtime node display name into the training alert catalog."
      }
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the training alert catalog."
      }
      severity: String
      message: String
      state: TrainingAlert.State
      subscribe RuntimeNodeInventoryReported
      subscribe TrainingJobCreated
      subscribe TrainingAlertRaised
    }
  }

  concept TrainingAlert {
    state Raised

    slice RaiseTrainingAlert
    slice TrainingAlertCatalog
  }

  slice AppendAuditTrail {
    startsLifecycle
    reactsTo TrainingAlertRaised

    automation AuditCriticalTrainingEvents {
      on TrainingAlertRaised
      emits AppendAuditTrail
    }

    automation AuditFederationActivated {
      on FederationActivated
      emits AppendAuditTrail
    }

    automation AuditFederationSuspended {
      on FederationSuspended
      emits AppendAuditTrail
    }

    automation AuditFederationReactivated {
      on FederationReactivated
      emits AppendAuditTrail
    }

    automation AuditParticipantJoined {
      on ParticipantJoined
      emits AppendAuditTrail
    }

    automation AuditParticipantSuspended {
      on ParticipantSuspended
      emits AppendAuditTrail
    }

    automation AuditDatasetApproval {
      on DatasetApprovedForTraining
      emits AppendAuditTrail
    }

    automation AuditDatasetApprovalRevoked {
      on DatasetTrainingApprovalRevoked
      emits AppendAuditTrail
    }

    automation AuditTrainingJobSubmitted {
      on TrainingJobSubmitted
      emits AppendAuditTrail
    }

    automation AuditModelPromotedToProduction {
      on ModelPromotedToProduction
      emits AppendAuditTrail
    }

    command AppendAuditTrail {
      auditRecordId: UUID id generated technical
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
    }

    event AuditTrailAppended {
      auditRecordId: UUID id technical
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
    }

    state Appended
  }

  slice AuditRecordLog {
    readmodel AuditRecordLog[] {
      auditRecordId: UUID id
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
      subscribe AuditTrailAppended
    }
  }

  concept AuditRecord {
    state Appended

    slice AppendAuditTrail
    slice AuditRecordLog
  }
}
context RuntimeGovernance {
  note "Runtime governance owns stable RuntimeIdentity, public keys, admission, capability, attestation summary, quarantine, revocation, and federation runtime grants. Runtime private keys, local paths, credentials, node scheduling, and data-plane connectivity stay inside participant runtime infrastructure."
  note "Provisioned runtime infrastructure is not automatically admitted. Network reachability is not business authorization. Training eligibility uses RuntimeIdentity and FederationRuntimeGrant, never node inventory."

  risk "A provisioned runtime can be mistaken for an admitted training participant."
  risk "Control-plane compromise must not expose runtime private keys or local dataset credentials."
  metric runtimeAdmissionLeadTime
  metric runtimePublicKeyRotationFailureRate

  slice RequestRuntimeAdmission {
    startsLifecycle
    actor RuntimeAgent
    reactsTo RuntimeAgentInstallationSucceeded

    command RequestRuntimeAdmission {
      runtimeAdmissionId: UUID id generated technical
      runtimeInfrastructureId: UUID from RuntimeAgentInstallationSucceeded.runtimeInfrastructureId
      runtimeInstanceId: UUID generated technical
      organizationId: UUID derived from RuntimeInstallationPlanCreated.organizationId by runtimeInfrastructureId
      runtimeName: String derived from RuntimeInstallationPlanCreated.runtimeName by runtimeInfrastructureId
      requestedAt: DateTime
    }

    event RuntimeAdmissionRequested {
      runtimeAdmissionId: UUID id technical
      runtimeInfrastructureId: UUID
      runtimeInstanceId: UUID
      organizationId: UUID
      runtimeName: String
      requestedAt: DateTime
    }

    state Requested
  }

  slice RegisterRuntimePublicKey {
    actor RuntimeAgent
    reactsTo RuntimeAdmissionRequested

    command RegisterRuntimePublicKey {
      runtimeAdmissionId: UUID id technical from RuntimeAdmissionRequested.runtimeAdmissionId
      runtimeInstanceId: UUID from RuntimeAdmissionRequested.runtimeInstanceId
      organizationId: UUID from RuntimeAdmissionRequested.organizationId
      publicKey: String
      keyFingerprint: String
      keyVersion: Int
      registeredAt: DateTime
      expiresAt: DateTime?
    }

    event RuntimePublicKeyRegistered {
      runtimeAdmissionId: UUID id technical
      runtimeInstanceId: UUID
      organizationId: UUID
      publicKey: String
      keyFingerprint: String
      keyVersion: Int
      registeredAt: DateTime
      expiresAt: DateTime?
    }

    state PublicKeyRegistered
  }

  slice ApproveRuntimeByOrganization {
    actor OrganizationAdmin
    ui RuntimeAdmissionScreen confirm
    reactsTo RuntimePublicKeyRegistered

    command ApproveRuntimeByOrganization {
      runtimeAdmissionId: UUID id technical
      organizationId: UUID
      approvalNote: String?
      approvedAt: DateTime
    }

    event RuntimeApprovedByOrganization {
      runtimeAdmissionId: UUID id technical
      organizationId: UUID
      approvalNote: String?
      approvedAt: DateTime
    }

    state OrganizationApproved
  }

  slice VerifyRuntimeIdentity {
    actor SecurityReviewer
    ui RuntimeAdmissionScreen
    reactsTo RuntimeApprovedByOrganization
    port

    automation VerifyRuntimeIdentityAfterOrganizationApproval {
      on RuntimeApprovedByOrganization
      emits VerifyRuntimeIdentity
    }

    command VerifyRuntimeIdentity {
      runtimeAdmissionId: UUID id technical
      runtimeInstanceId: UUID derived from RuntimeAdmissionRequested.runtimeInstanceId by runtimeAdmissionId
      publicKeyFingerprint: String derived from RuntimePublicKeyRegistered.keyFingerprint by runtimeAdmissionId
      verificationPassed: Boolean
      verifiedAt: DateTime?
      failedAt: DateTime?
      failureReason: String?
    }

    event RuntimeIdentityVerified {
      runtimeAdmissionId: UUID id technical
      runtimeInstanceId: UUID
      publicKeyFingerprint: String
      verifiedAt: DateTime
    }

    event RuntimeAdmissionRejected {
      runtimeAdmissionId: UUID id technical
      runtimeInstanceId: UUID
      failedAt: DateTime
      failureReason: String
    }

    state PlatformVerified
  }

  slice AdmitRuntime {
    startsLifecycle

    actor SecurityReviewer
    ui RuntimeAdmissionScreen
    reactsTo RuntimeIdentityVerified

    automation AdmitRuntimeWhenIdentityVerified {
      on RuntimeIdentityVerified
      emits AdmitRuntime
    }

    command AdmitRuntime {
      runtimeId: UUID id generated technical
      runtimeAdmissionId: UUID from RuntimeIdentityVerified.runtimeAdmissionId
      runtimeInstanceId: UUID from RuntimeIdentityVerified.runtimeInstanceId
      organizationId: UUID derived from RuntimeAdmissionRequested.organizationId by runtimeAdmissionId
      runtimeName: String derived from RuntimeAdmissionRequested.runtimeName by runtimeAdmissionId
      publicKey: String derived from RuntimePublicKeyRegistered.publicKey by runtimeAdmissionId
      keyFingerprint: String from RuntimeIdentityVerified.publicKeyFingerprint
      keyVersion: Int derived from RuntimePublicKeyRegistered.keyVersion by runtimeAdmissionId
      admittedAt: DateTime
      trustLevel: String dictionary "RUNTIME_TRUST_LEVEL"
    }

    event RuntimeAdmitted {
      runtimeId: UUID id technical
      runtimeAdmissionId: UUID
      runtimeInstanceId: UUID
      organizationId: UUID
      runtimeName: String
      publicKey: String
      keyFingerprint: String
      keyVersion: Int
      admittedAt: DateTime
      trustLevel: String dictionary "RUNTIME_TRUST_LEVEL"
    }

    state Admitted
  }

  slice RotateRuntimePublicKey {
    actor RuntimeAgent
    ui RuntimeIdentityScreen
    reactsTo RuntimeAdmitted

    command RotateRuntimePublicKey {
      runtimeId: UUID id technical
      currentKeyFingerprint: String
      newPublicKey: String
      newKeyFingerprint: String
      newKeyVersion: Int
      rotationSignature: String
      requestedAt: DateTime
      activatesAt: DateTime
      expiresAt: DateTime?
    }

    event RuntimePublicKeyRotated {
      runtimeId: UUID id technical
      previousKeyFingerprint: String from RotateRuntimePublicKey.currentKeyFingerprint
      publicKey: String from RotateRuntimePublicKey.newPublicKey
      keyFingerprint: String from RotateRuntimePublicKey.newKeyFingerprint
      keyVersion: Int from RotateRuntimePublicKey.newKeyVersion
      requestedAt: DateTime from RotateRuntimePublicKey.requestedAt
      activatesAt: DateTime from RotateRuntimePublicKey.activatesAt
      expiresAt: DateTime? from RotateRuntimePublicKey.expiresAt
    }

    state KeyRotated
  }

  slice RevokeRuntimeIdentity {
    actor SecurityReviewer
    ui RuntimeIdentityScreen confirm
    reactsTo RuntimeAdmitted

    command RevokeRuntimeIdentity {
      runtimeId: UUID id technical
      revocationReason: String
      revokedAt: DateTime
    }

    event RuntimeIdentityRevoked {
      runtimeId: UUID id technical
      revocationReason: String
      revokedAt: DateTime
    }

    state Revoked
  }

  slice QuarantineRuntime {
    actor SecurityReviewer
    ui RuntimeIdentityScreen confirm
    reactsTo RuntimeAdmitted

    command QuarantineRuntime {
      runtimeId: UUID id technical
      quarantineReason: String
      quarantinedAt: DateTime
    }

    event RuntimeQuarantined {
      runtimeId: UUID id technical
      quarantineReason: String
      quarantinedAt: DateTime
    }

    state Quarantined
  }

  slice RegisterRuntimeCapability {
    startsLifecycle
    actor RuntimeAgent
    reactsTo RuntimeAdmitted

    command RegisterRuntimeCapability {
      runtimeCapabilityId: UUID id generated technical
      runtimeId: UUID
      capabilityType: String dictionary "RUNTIME_CAPABILITY_TYPE"
      capabilityValue: String
      evidenceType: String?
      observedAt: DateTime
      expiresAt: DateTime?
    }

    event RuntimeCapabilityRegistered {
      runtimeCapabilityId: UUID id technical
      runtimeId: UUID
      capabilityType: String dictionary "RUNTIME_CAPABILITY_TYPE"
      capabilityValue: String
      evidenceType: String?
      observedAt: DateTime
      expiresAt: DateTime?
    }

    state Declared
  }

  slice VerifyRuntimeCapability {
    actor SecurityReviewer
    ui RuntimeCapabilityScreen
    reactsTo RuntimeCapabilityRegistered

    command VerifyRuntimeCapability {
      runtimeCapabilityId: UUID id technical
      runtimeId: UUID
      verified: Boolean
      verificationNote: String?
      verifiedAt: DateTime
    }

    event RuntimeCapabilityVerified {
      runtimeCapabilityId: UUID id technical
      runtimeId: UUID
      verifiedAt: DateTime
      verificationNote: String?
    }

    event RuntimeCapabilityRevoked {
      runtimeCapabilityId: UUID id technical
      runtimeId: UUID
      revokedAt: DateTime from VerifyRuntimeCapability.verifiedAt
      revocationReason: String from VerifyRuntimeCapability.verificationNote
    }

    state Verified
  }

  slice GrantFederationRuntimeAccess {
    startsLifecycle
    actor FederationOwner
    ui FederationRuntimeGrantScreen
    reactsTo RuntimeAdmitted

    command GrantFederationRuntimeAccess {
      grantId: UUID id generated technical
      federationId: UUID
      organizationId: UUID
      runtimeId: UUID
      allowedCapabilities: String[]
      validFrom: DateTime
      validUntil: DateTime?
      policyVersion: String
    }

    event FederationRuntimeAccessGranted {
      grantId: UUID id technical
      federationId: UUID
      organizationId: UUID
      runtimeId: UUID
      allowedCapabilities: String[]
      validFrom: DateTime
      validUntil: DateTime?
      policyVersion: String
    }

    state Granted
  }

  slice RevokeFederationRuntimeAccess {
    actor FederationOwner
    ui FederationRuntimeGrantScreen confirm
    reactsTo FederationRuntimeAccessGranted

    command RevokeFederationRuntimeAccess {
      grantId: UUID id technical
      federationId: UUID
      runtimeId: UUID
      revocationReason: String
      revokedAt: DateTime
    }

    event FederationRuntimeAccessRevoked {
      grantId: UUID id technical
      federationId: UUID
      runtimeId: UUID
      revocationReason: String
      revokedAt: DateTime
    }

    state Revoked
  }

  slice RuntimeIdentityCatalog {
    readmodel RuntimeIdentityCatalog[] {
      runtimeId: UUID id
      runtimeAdmissionId: UUID
      runtimeInstanceId: UUID
      organizationId: UUID
      organizationName: String? derived from OrganizationRegistered.organizationName by organizationId
      runtimeName: String
      publicKey: String
      keyFingerprint: String
      keyVersion: Int
      trustLevel: String dictionary "RUNTIME_TRUST_LEVEL"
      admissionStatus: String
      admittedAt: DateTime?
      revokedAt: DateTime?
      quarantineReason: String?
      subscribe OrganizationRegistered
      subscribe RuntimeAdmissionRequested
      subscribe RuntimePublicKeyRegistered
      subscribe RuntimeApprovedByOrganization
      subscribe RuntimeIdentityVerified
      subscribe RuntimeAdmissionRejected
      subscribe RuntimeAdmitted
      subscribe RuntimePublicKeyRotated
      subscribe RuntimeIdentityRevoked
      subscribe RuntimeQuarantined
    }
  }

  slice RuntimeCapabilityCatalog {
    readmodel RuntimeCapabilityCatalog[] {
      runtimeCapabilityId: UUID id
      runtimeId: UUID
      capabilityType: String dictionary "RUNTIME_CAPABILITY_TYPE"
      capabilityValue: String
      evidenceType: String?
      capabilityStatus: String
      observedAt: DateTime
      verifiedAt: DateTime?
      expiresAt: DateTime?
      subscribe RuntimeCapabilityRegistered
      subscribe RuntimeCapabilityVerified
      subscribe RuntimeCapabilityRevoked
    }
  }

  slice FederationRuntimeGrantCatalog {
    readmodel FederationRuntimeGrantCatalog[] {
      grantId: UUID id
      federationId: UUID
      organizationId: UUID
      runtimeId: UUID
      allowedCapabilities: String[]
      grantStatus: String
      policyVersion: String
      validFrom: DateTime
      validUntil: DateTime?
      revokedAt: DateTime?
      revocationReason: String?
      subscribe FederationRuntimeAccessGranted
      subscribe FederationRuntimeAccessRevoked
    }
  }

  concept RuntimeAdmission {
    state Requested
    state PublicKeyRegistered
    state OrganizationApproved
    state PlatformVerified
    state Rejected

    slice RequestRuntimeAdmission
    slice RegisterRuntimePublicKey
    slice ApproveRuntimeByOrganization
    slice VerifyRuntimeIdentity
  }

  concept RuntimeIdentity {
    state Admitted
    state KeyRotated
    state Revoked
    state Quarantined

    slice AdmitRuntime
    slice RotateRuntimePublicKey
    slice RevokeRuntimeIdentity
    slice QuarantineRuntime
    slice RuntimeIdentityCatalog
  }

  concept RuntimeCapability {
    state Declared
    state Verified
    state Revoked

    slice RegisterRuntimeCapability
    slice VerifyRuntimeCapability
    slice RuntimeCapabilityCatalog
  }

  concept FederationRuntimeGrant {
    state Granted
    state Revoked

    slice GrantFederationRuntimeAccess
    slice RevokeFederationRuntimeAccess
    slice FederationRuntimeGrantCatalog
  }
}

context SecureAggregation {
  note "Secure aggregation owns aggregation sessions and protocol state. It does not generate platform-held participant private keys or distribute raw key material. Runtime participants or an external secure aggregation provider produce protocol evidence and protected artifacts."

  risk "Aggregation can complete with insufficient masked updates or without protocol proof."
  metric secureAggregationCompletionLatency

  slice CreateSecureAggregationSession {
    startsLifecycle
    reactsTo SecureAggregationRequested

    automation CreateSessionWhenAggregationRequested {
      on SecureAggregationRequested
      emits CreateSecureAggregationSession
    }

    command CreateSecureAggregationSession {
      secureAggregationSessionId: UUID id generated technical
      trainingJobId: UUID from SecureAggregationRequested.trainingJobId
      trainingRunConfigurationId: UUID from SecureAggregationRequested.trainingRunConfigurationId
      roundId: UUID from SecureAggregationRequested.roundId
      aggregationProvider: String from SecureAggregationRequested.aggregationProvider
      requiredParticipantCount: Int from SecureAggregationRequested.acceptedModelUpdateCount
      createdAt: DateTime
    }

    event SecureAggregationSessionCreated {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      aggregationProvider: String
      requiredParticipantCount: Int
      createdAt: DateTime
    }

    state Planned
  }

  slice LockSecureAggregationParticipants {
    reactsTo SecureAggregationSessionCreated

    automation LockParticipantsWhenSessionCreated {
      on SecureAggregationSessionCreated
      emits LockSecureAggregationParticipants
    }

    command LockSecureAggregationParticipants {
      secureAggregationSessionId: UUID id technical
      participantSnapshotRef: String
      lockedParticipantCount: Int
      lockedAt: DateTime
    }

    event SecureAggregationParticipantsLocked {
      secureAggregationSessionId: UUID id technical
      participantSnapshotRef: String
      lockedParticipantCount: Int
      lockedAt: DateTime
    }

    state KeyAgreement
  }

  slice RecordParticipantKeyAgreement {
    actor SecureAggregationService
    reactsTo SecureAggregationParticipantsLocked

    command RecordParticipantKeyAgreement {
      secureAggregationSessionId: UUID id technical
      runtimeId: UUID
      keyAgreementEvidenceRef: String
      completedAt: DateTime
    }

    event ParticipantKeyAgreementCompleted {
      secureAggregationSessionId: UUID id technical
      runtimeId: UUID
      keyAgreementEvidenceRef: String
      completedAt: DateTime
    }

    state CollectingMaskedUpdates
  }

  slice RecordMaskedModelUpdate {
    actor SecureAggregationService
    reactsTo ModelUpdateSubmissionAccepted

    command RecordMaskedModelUpdate {
      secureAggregationSessionId: UUID id technical
      submissionId: UUID
      runtimeId: UUID
      artifactDigest: String
      receivedAt: DateTime
    }

    event MaskedModelUpdateReceived {
      secureAggregationSessionId: UUID id technical
      submissionId: UUID
      runtimeId: UUID
      artifactDigest: String
      receivedAt: DateTime
    }
  }

  slice CompleteSecureAggregationSession {
    actor SecureAggregationService
    reactsTo MaskedModelUpdateReceived

    command CompleteSecureAggregationSession {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelHash: String
      aggregationProofRef: String
      completedAt: DateTime
    }

    event SecureAggregationCompleted {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelHash: String
      aggregationProofRef: String
      completedAt: DateTime
    }

    state Completed
  }

  slice FailSecureAggregationSession {
    actor SecureAggregationService
    reactsTo SecureAggregationSessionCreated

    command FailSecureAggregationSession {
      secureAggregationSessionId: UUID id technical
      failureReason: String
      failedAt: DateTime
    }

    event SecureAggregationFailed {
      secureAggregationSessionId: UUID id technical
      failureReason: String
      failedAt: DateTime
    }

    state Failed
  }

  slice SecureAggregationSessionCatalog {
    readmodel SecureAggregationSessionCatalog[] {
      secureAggregationSessionId: UUID id
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      aggregationProvider: String
      requiredParticipantCount: Int
      lockedParticipantCount: Int?
      receivedMaskedUpdateCount: Int
      aggregatedModelVersionId: UUID?
      modelArtifactRef: String?
      modelHash: String?
      aggregationProofRef: String?
      state: SecureAggregationSession.State
      failureReason: String?
      createdAt: DateTime
      completedAt: DateTime?
      failedAt: DateTime?
      subscribe SecureAggregationSessionCreated
      subscribe SecureAggregationParticipantsLocked
      subscribe ParticipantKeyAgreementCompleted
      subscribe MaskedModelUpdateReceived
      subscribe SecureAggregationCompleted
      subscribe SecureAggregationFailed
    }
  }

  concept SecureAggregationSession {
    state Planned
    state KeyAgreement
    state CollectingMaskedUpdates
    state Completed
    state Failed

    slice CreateSecureAggregationSession
    slice LockSecureAggregationParticipants
    slice RecordParticipantKeyAgreement
    slice RecordMaskedModelUpdate
    slice CompleteSecureAggregationSession
    slice FailSecureAggregationSession
    slice SecureAggregationSessionCatalog
  }
}
  deployment FLDictionaryBackend {
    includes DictionaryMaintenance
  }

  deployment FLPlatformBackend {
    includes OrganizationManagement
    includes FederationManagement
    includes DatasetGovernance
    includes ModelRepository
    includes TrainingOrchestration
    includes ModelLifecycle
    includes RuntimeMonitoring
    includes RuntimeGovernance
    includes SecureAggregation
    includes RuntimeProvisioning
  }

  deployment FLRuntimeAgent {
    includes RuntimeAgentOperations
  }

  context RuntimeAgentOperations {
    note "Runtime agent operations is a separate deployable that runs inside participant infrastructure and executes dispatched training jobs with local data and local secrets."

    risk "Agent jobs can leak local credentials if secret references are materialized outside the participant boundary."
    risk "Runtime engine jobs can remain running after platform cancellation unless local job lifecycle is tracked explicitly."
    metric agentRuntimeJobFailureRate
    metric agentRuntimeJobStartupLatency

    integration RoundRuntimeEngine {
      source RoundExecution
      target RuntimeEngine
      reactsTo RoundExecutionStarted
      emits CompleteRoundExecution
      emits FailRoundExecution
      emits SubmitAgentLocalModelUpdate
    }

    integration PlatformDatasetMetadataReporting {
      source RuntimeDatasetMetadata
      target DatasetGovernance
      reactsTo AgentDatasetMetadataReported
      emits RecordRuntimeDatasetMetadata
    }

    integration PlatformRoundUpdateReporting {
      source RoundExecution
      target TrainingOrchestration
      reactsTo AgentLocalModelUpdateSubmitted
      emits SubmitModelUpdateSubmission
    }

    integration PlatformRuntimeInfrastructureConnectionReporting {
      source AgentRuntimeInfrastructureConnection
      target RuntimeProvisioning
      reactsTo AgentRuntimeConnectionEstablished
      emits RecordRuntimeConnectionEstablished
    }

    integration PlatformRuntimeNodeInventoryReporting {
      source AgentRuntimeNodeInventory
      target RuntimeMonitoring
      reactsTo AgentRuntimeNodeInventoryReported
      emits RecordRuntimeNodeInventory
    }

  slice RegisterAgentDataConnector {
    startsLifecycle
    actor RuntimeAgent
    reactsTo RuntimeConnectionEstablished

    automation RegisterConnectorWhenRuntimeConnected {
      on RuntimeConnectionEstablished
      emits RegisterAgentDataConnector
    }

    command RegisterAgentDataConnector {
      dataConnectorId: UUID id generated technical
      runtimeAgentId: UUID
      connectorName: String
      connectorType: String
      connectorRef: String
      credentialRef: String
      secretRefType: String
      storageLocationRef: String
      supportedDataFormats: String[]
      agentConnectorHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
    }

    event AgentDataConnectorRegistered {
      dataConnectorId: UUID id technical
      runtimeAgentId: UUID
      connectorName: String
      connectorType: String
      connectorRef: String
      credentialRef: String
      secretRefType: String
      storageLocationRef: String
      supportedDataFormats: String[]
      agentConnectorHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      registeredAt: DateTime
    }

    state Registered
  }

  slice AgentDataConnectorCatalog {
    readmodel AgentDataConnectorCatalog[] {
      dataConnectorId: UUID id
      runtimeAgentId: UUID
      connectorName: String
      connectorType: String
      connectorRef: String
      credentialRef: String
      secretRefType: String
      storageLocationRef: String
      supportedDataFormats: String[]
      agentConnectorHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      registeredAt: DateTime
      subscribe AgentDataConnectorRegistered
    }
  }

  concept AgentDataConnector {
    state Registered

    slice RegisterAgentDataConnector
    slice AgentDataConnectorCatalog
  }

  slice ProbeAgentDataConnectorAccess {
    startsLifecycle
    reactsTo AgentDataConnectorRegistered

    automation ProbeConnectorAccessAfterRegistration {
      on AgentDataConnectorRegistered
      emits ProbeAgentDataConnectorAccess
    }

    command ProbeAgentDataConnectorAccess {
      agentDataConnectorProbeId: UUID id generated technical
      dataConnectorId: UUID
      runtimeAgentId: UUID
      validationMode: String
    }

    event AgentDataConnectorAccessProbed {
      agentDataConnectorProbeId: UUID id technical
      dataConnectorId: UUID
      runtimeId: UUID
      readable: Boolean
      writable: Boolean
      validationReportId: UUID
      verifiedAt: DateTime
    }

    state Probed
  }

  slice AgentDataConnectorAccessProbeCatalog {
    readmodel AgentDataConnectorAccessProbeCatalog[] {
      agentDataConnectorProbeId: UUID id
      dataConnectorId: UUID
      runtimeAgentId: UUID
      connectorName: String? derived {
        from AgentDataConnectorRegistered.connectorName
        rule "Lookup by dataConnectorId and denormalize the data connector display name into the access probe catalog."
      }
      readable: Boolean
      writable: Boolean
      validationReportId: UUID
      verifiedAt: DateTime
      subscribe AgentDataConnectorRegistered
      subscribe AgentDataConnectorAccessProbed
    }
  }

  concept AgentDataConnectorAccessProbe {
    state Probed

    slice ProbeAgentDataConnectorAccess
    slice AgentDataConnectorAccessProbeCatalog
  }

  slice ConfigureAgentDatasetAccessProfile {
    startsLifecycle
    actor NodeOperator
    ui AgentDatasetAccessProfileScreen
    reactsTo AgentDataConnectorRegistered

    command ConfigureAgentDatasetAccessProfile {
      agentDatasetAccessProfileId: UUID id generated technical
      datasetId: UUID
      runtimeAgentId: UUID
      dataConnectorId: UUID
      agentDataAccessHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      dataFormat: String
      readerPlugin: String
      readMode: String
      materializationMode: String
    }

    event AgentDatasetAccessProfileConfigured {
      agentDatasetAccessProfileId: UUID id technical
      datasetId: UUID
      runtimeAgentId: UUID
      dataConnectorId: UUID
      agentDataAccessHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      dataFormat: String
      readerPlugin: String
      readMode: String
      materializationMode: String
    }

    state Configured
  }

  slice AgentDatasetAccessProfileCatalog {
    readmodel AgentDatasetAccessProfileCatalog[] {
      agentDatasetAccessProfileId: UUID id
      datasetId: UUID
      runtimeAgentId: UUID
      dataConnectorId: UUID
      datasetName: String? derived {
        from DatasetDeclared.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the agent dataset access profile catalog."
      }
      connectorName: String? derived {
        from AgentDataConnectorRegistered.connectorName
        rule "Lookup by dataConnectorId and denormalize the data connector display name into the agent dataset access profile catalog."
      }
      agentDataAccessHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      dataFormat: String
      readerPlugin: String
      readMode: String
      materializationMode: String
      configuredAt: DateTime
      subscribe DatasetDeclared
      subscribe AgentDataConnectorRegistered
      subscribe AgentDatasetAccessProfileConfigured
    }
  }

  concept AgentDatasetAccessProfile {
    state Configured

    slice ConfigureAgentDatasetAccessProfile
    slice AgentDatasetAccessProfileCatalog
  }

  slice ProfileAgentDataset {
    startsLifecycle
    reactsTo AgentDatasetAccessProfileConfigured

    automation ProfileDatasetWhenAccessProfileConfigured {
      on AgentDatasetAccessProfileConfigured
      emits ProfileAgentDataset
    }

    command ProfileAgentDataset {
      metadataReportId: UUID id generated technical
      datasetId: UUID from AgentDatasetAccessProfileConfigured.datasetId
      organizationId: UUID derived from DatasetDeclared.organizationId by datasetId
      runtimeId: UUID from AgentDatasetAccessProfileConfigured.runtimeAgentId
      featureSchemaId: UUID derived from DatasetDeclared.featureSchemaId by datasetId
    }

    event AgentDatasetMetadataReported {
      metadataReportId: UUID id technical
      datasetId: UUID
      organizationId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean
      labelCompatible: Boolean
      missingValueRate: Decimal
      duplicateRate: Decimal
      qualityScore: Decimal
      nonIidScore: Decimal
      classBalanceScore: Decimal?
      statisticsRef: String?
      profiledAt: DateTime
    }

    state Reported
  }

  slice RuntimeDatasetMetadataCatalog {
    readmodel RuntimeDatasetMetadataCatalog[] {
      metadataReportId: UUID id
      datasetId: UUID
      organizationId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      datasetName: String? derived {
        from DatasetDeclared.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the agent dataset metadata catalog."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the agent dataset metadata catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the agent dataset metadata catalog."
      }
      featureSchemaVersion: String? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the agent dataset metadata catalog."
      }
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean
      labelCompatible: Boolean
      missingValueRate: Decimal
      duplicateRate: Decimal
      qualityScore: Decimal
      nonIidScore: Decimal
      classBalanceScore: Decimal?
      statisticsRef: String?
      profiledAt: DateTime
      subscribe DatasetDeclared
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe AgentDatasetMetadataReported
    }
  }

  concept RuntimeDatasetMetadata {
    state Reported

    slice ProfileAgentDataset
    slice RuntimeDatasetMetadataCatalog
  }

  slice ValidateAgentDatasetAccess {
    startsLifecycle
    reactsTo AgentDatasetAccessProfileConfigured

    automation ValidateDatasetAccessWhenProfileConfigured {
      on AgentDatasetAccessProfileConfigured
      emits ValidateAgentDatasetAccess
    }

    command ValidateAgentDatasetAccess {
      datasetAccessValidationId: UUID id generated technical
      datasetId: UUID from AgentDatasetAccessProfileConfigured.datasetId
      runtimeId: UUID from AgentDatasetAccessProfileConfigured.runtimeAgentId
    }

    event AgentDatasetAccessValidated {
      datasetAccessValidationId: UUID id technical
      datasetId: UUID
      runtimeId: UUID
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationReportId: UUID
      validatedAt: DateTime
    }

    state Validated
  }

  slice AgentDatasetAccessValidationCatalog {
    readmodel AgentDatasetAccessValidationCatalog[] {
      datasetAccessValidationId: UUID id
      datasetId: UUID
      runtimeId: UUID
      datasetName: String? derived {
        from DatasetDeclared.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the agent dataset access validation catalog."
      }
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationReportId: UUID
      validatedAt: DateTime
      subscribe DatasetDeclared
      subscribe AgentDatasetAccessValidated
    }
  }

  concept AgentDatasetAccessValidation {
    state Validated

    slice ValidateAgentDatasetAccess
    slice AgentDatasetAccessValidationCatalog
  }

  slice ReceiveParticipantExecutionPlan {
    startsLifecycle
    reactsTo ParticipantExecutionPlanIssued

    automation ReceiveExecutionPlanWhenIssued {
      on ParticipantExecutionPlanIssued
      emits ReceiveParticipantExecutionPlan
    }

    command ReceiveParticipantExecutionPlan {
      executionPlanId: UUID id technical from ParticipantExecutionPlanIssued.executionPlanId
      executionSessionId: UUID from ParticipantExecutionPlanIssued.executionSessionId
      trainingJobId: UUID from ParticipantExecutionPlanIssued.trainingJobId
      trainingRunConfigurationId: UUID from ParticipantExecutionPlanIssued.trainingRunConfigurationId
      featureSchemaId: UUID from ParticipantExecutionPlanIssued.featureSchemaId
      roundId: UUID from ParticipantExecutionPlanIssued.roundId
      roundNumber: Int from ParticipantExecutionPlanIssued.roundNumber
      runtimeId: UUID from ParticipantExecutionPlanIssued.runtimeId
      organizationId: UUID from ParticipantExecutionPlanIssued.organizationId
      baseModelArtifactRef: String from ParticipantExecutionPlanIssued.baseModelArtifactRef
      baseModelDigest: String from ParticipantExecutionPlanIssued.baseModelDigest
      aggregationPublicKey: String? from ParticipantExecutionPlanIssued.aggregationPublicKey
      nonce: String from ParticipantExecutionPlanIssued.nonce
      expiresAt: DateTime from ParticipantExecutionPlanIssued.expiresAt
      signature: String from ParticipantExecutionPlanIssued.signature
      receivedAt: DateTime
    }

    event ExecutionPlanReceived {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelArtifactRef: String
      baseModelDigest: String
      aggregationPublicKey: String?
      nonce: String
      expiresAt: DateTime
      signature: String
      receivedAt: DateTime
    }

    state PlanReceived
  }

  slice AcceptExecutionPlan {
    reactsTo ExecutionPlanReceived

    automation AcceptExecutionPlanWhenLocalPolicyPassed {
      on ExecutionPlanReceived
      condition localExecutionPolicyPassed == true
      emits AcceptExecutionPlan
    }

    command AcceptExecutionPlan {
      executionPlanId: UUID id technical from ExecutionPlanReceived.executionPlanId
      executionSessionId: UUID from ExecutionPlanReceived.executionSessionId
      trainingJobId: UUID from ExecutionPlanReceived.trainingJobId
      runtimeId: UUID from ExecutionPlanReceived.runtimeId
      acceptedAt: DateTime
    }

    event ExecutionPlanAccepted {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      runtimeId: UUID
      acceptedAt: DateTime
    }

    state PlanAccepted
  }

  slice RejectExecutionPlan {
    actor RuntimeAgent
    reactsTo ExecutionPlanReceived

    command RejectExecutionPlan {
      executionPlanId: UUID id technical
      executionSessionId: UUID from ExecutionPlanReceived.executionSessionId
      trainingJobId: UUID from ExecutionPlanReceived.trainingJobId
      runtimeId: UUID from ExecutionPlanReceived.runtimeId
      rejectionReason: String
      rejectedAt: DateTime
    }

    event ExecutionPlanRejected {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      runtimeId: UUID
      rejectionReason: String
      rejectedAt: DateTime
    }

    state PlanRejected
  }

  slice StartRoundExecution {
    reactsTo ExecutionPlanAccepted

    automation StartRoundExecutionWhenPlanAccepted {
      on ExecutionPlanAccepted
      emits StartRoundExecution
    }

    command StartRoundExecution {
      roundExecutionId: UUID id generated technical
      executionSessionId: UUID from ExecutionPlanAccepted.executionSessionId
      executionPlanId: UUID from ExecutionPlanAccepted.executionPlanId
      trainingJobId: UUID from ExecutionPlanAccepted.trainingJobId
      trainingRunConfigurationId: UUID derived from ExecutionPlanReceived.trainingRunConfigurationId by executionPlanId
      roundId: UUID derived from ExecutionPlanReceived.roundId by executionPlanId
      roundNumber: Int derived from ExecutionPlanReceived.roundNumber by executionPlanId
      runtimeId: UUID from ExecutionPlanAccepted.runtimeId
      organizationId: UUID derived from ExecutionPlanReceived.organizationId by executionPlanId
      featureSchemaId: UUID derived from ExecutionPlanReceived.featureSchemaId by executionPlanId
      baseModelArtifactRef: String derived from ExecutionPlanReceived.baseModelArtifactRef by executionPlanId
      baseModelDigest: String derived from ExecutionPlanReceived.baseModelDigest by executionPlanId
      startedAt: DateTime
    }

    event RoundExecutionStarted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelArtifactRef: String
      baseModelDigest: String
      startedAt: DateTime
    }

    state Running
  }

  slice CompleteRoundExecution {
    reactsTo RoundExecutionStarted

    command CompleteRoundExecution {
      roundExecutionId: UUID id technical
      executionSessionId: UUID from RoundExecutionStarted.executionSessionId
      executionPlanId: UUID from RoundExecutionStarted.executionPlanId
      trainingJobId: UUID from RoundExecutionStarted.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionStarted.trainingRunConfigurationId
      roundId: UUID from RoundExecutionStarted.roundId
      runtimeId: UUID from RoundExecutionStarted.runtimeId
      completedAt: DateTime
    }

    event RoundExecutionCompleted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      completedAt: DateTime
    }

    state Completed
  }

  slice FailRoundExecution {
    reactsTo RoundExecutionStarted

    command FailRoundExecution {
      roundExecutionId: UUID id technical
      executionSessionId: UUID from RoundExecutionStarted.executionSessionId
      executionPlanId: UUID from RoundExecutionStarted.executionPlanId
      trainingJobId: UUID from RoundExecutionStarted.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionStarted.trainingRunConfigurationId
      roundId: UUID from RoundExecutionStarted.roundId
      runtimeId: UUID from RoundExecutionStarted.runtimeId
      failureReason: String
      failedAt: DateTime
    }

    event RoundExecutionFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      failureReason: String
      failedAt: DateTime
    }

    state Failed
  }

  slice SubmitAgentLocalModelUpdate {
    reactsTo RoundExecutionCompleted

    command SubmitAgentLocalModelUpdate {
      modelUpdateSubmissionId: UUID id generated technical
      executionSessionId: UUID from RoundExecutionCompleted.executionSessionId
      executionPlanId: UUID from RoundExecutionCompleted.executionPlanId
      roundExecutionId: UUID from RoundExecutionCompleted.roundExecutionId
      trainingJobId: UUID from RoundExecutionCompleted.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionCompleted.trainingRunConfigurationId
      roundId: UUID from RoundExecutionCompleted.roundId
      runtimeId: UUID from RoundExecutionCompleted.runtimeId
      featureSchemaId: UUID derived from RoundExecutionStarted.featureSchemaId by roundExecutionId
      localModelVersionId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      trainingLoss: Decimal
      submittedAt: DateTime
    }

    event AgentLocalModelUpdateSubmitted {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      roundExecutionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      trainingLoss: Decimal
      submittedAt: DateTime
    }

    state UpdateSubmitted
  }

  slice RoundExecutionCatalog {
    readmodel RoundExecutionCatalog[] {
      roundExecutionId: UUID id
      executionSessionId: UUID?
      executionPlanId: UUID?
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int?
      organizationId: UUID?
      runtimeId: UUID
      state: RoundExecution.State
      featureSchemaId: UUID?
      baseModelArtifactRef: String?
      baseModelDigest: String?
      updateArtifactId: UUID?
      artifactRef: String?
      artifactDigest: String?
      trainingLoss: Decimal?
      receivedAt: DateTime?
      acceptedAt: DateTime?
      rejectedAt: DateTime?
      startedAt: DateTime?
      completedAt: DateTime?
      failedAt: DateTime?
      submittedAt: DateTime?
      failureReason: String?
      rejectionReason: String?
      subscribe ParticipantExecutionPlanIssued
      subscribe ExecutionPlanReceived
      subscribe ExecutionPlanAccepted
      subscribe ExecutionPlanRejected
      subscribe RoundExecutionStarted
      subscribe RoundExecutionCompleted
      subscribe RoundExecutionFailed
      subscribe AgentLocalModelUpdateSubmitted
    }
  }

  concept RoundExecution {
    state PlanReceived
    state PlanAccepted
    state PlanRejected
    state Running
    state Completed
    state Failed
    state UpdateSubmitted

    slice ReceiveParticipantExecutionPlan
    slice AcceptExecutionPlan
    slice RejectExecutionPlan
    slice StartRoundExecution
    slice CompleteRoundExecution
    slice FailRoundExecution
    slice SubmitAgentLocalModelUpdate
    slice RoundExecutionCatalog
  }

  slice RecordRuntimeInstanceStarted {
    startsLifecycle

    actor RuntimeAgent

    command RecordRuntimeInstanceStarted {
      runtimeAgentId: UUID id technical
      runtimeInfrastructureId: UUID
      agentVersion: String
      podName: String?
      imageRef: String
      startedAt: DateTime
    }

    event RuntimeInstanceStarted {
      runtimeAgentId: UUID id technical
      runtimeInfrastructureId: UUID
      agentVersion: String
      podName: String?
      imageRef: String
      startedAt: DateTime
    }

    state Started
  }

  slice ReportRuntimeInstanceSelfCheckPassed {
    actor RuntimeAgent
    reactsTo RuntimeInstanceStarted

    automation ReportReadyAfterConfigurationFetchAndSelfCheck {
      on RuntimeInstanceStarted
      condition runtimeAgentReadyProbePassed == true
      emits ReportRuntimeInstanceSelfCheckPassed
    }

    command ReportRuntimeInstanceSelfCheckPassed {
      runtimeAgentId: UUID id technical from RuntimeInstanceStarted.runtimeAgentId
      runtimeInfrastructureId: UUID from RuntimeInstanceStarted.runtimeInfrastructureId
      agentVersion: String from RuntimeInstanceStarted.agentVersion
      startedAt: DateTime from RuntimeInstanceStarted.startedAt
      readyAt: DateTime
    }

    event RuntimeInstanceSelfCheckPassed {
      runtimeAgentId: UUID id technical
      runtimeInfrastructureId: UUID
      agentVersion: String
      startedAt: DateTime
      readyAt: DateTime
    }

    state Ready
  }

  concept RuntimeAgentLifecycle {
    state Started
    state Ready

    slice RecordRuntimeInstanceStarted
    slice ReportRuntimeInstanceSelfCheckPassed
  }

  slice ReportRuntimeInstanceConnected {
    startsLifecycle
    reactsTo RuntimeInstanceSelfCheckPassed

    automation ReportRuntimeInstanceConnectedAfterSelfCheck {
      on RuntimeInstanceSelfCheckPassed
      condition runtimeInfrastructureReachable == true
      emits ReportRuntimeInstanceConnected
    }

    command ReportRuntimeInstanceConnected {
      runtimeInfrastructureId: UUID id technical from RuntimeInstanceSelfCheckPassed.runtimeInfrastructureId
      runtimeAgentId: UUID from RuntimeInstanceSelfCheckPassed.runtimeAgentId
      connectedAt: DateTime
    }

    event AgentRuntimeConnectionEstablished {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      connectedAt: DateTime
    }

    state Connected
  }

  slice AgentRuntimeInfrastructureConnectionCatalog {
    readmodel AgentRuntimeInfrastructureConnectionCatalog[] {
      runtimeInfrastructureId: UUID id
      runtimeAgentId: UUID
      connectedAt: DateTime
      subscribe AgentRuntimeConnectionEstablished
    }
  }

  concept AgentRuntimeInfrastructureConnection {
    state Connected

    slice ReportRuntimeInstanceConnected
    slice AgentRuntimeInfrastructureConnectionCatalog
  }

  slice AgentRuntimeTelemetryLatest {
    readmodel AgentRuntimeTelemetryLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID?
      trainingJobId: UUID?
      roundExecutionId: UUID?
      cpuLoad: Decimal?
      gpuLoad: Decimal?
      memoryLoad: Decimal?
      lastHeartbeatAt: DateTime?
      telemetryRetentionPolicy: String
    }
  }

  concept AgentRuntimeTelemetry {
    slice AgentRuntimeTelemetryLatest
  }

  slice ReportAgentRuntimeNodeInventory {
    startsLifecycle

    automation ReportNodeInventoryWhenInventoryChanged {
      condition runtimeNodeInventoryChanged == true
      emits ReportAgentRuntimeNodeInventory
    }

    command ReportAgentRuntimeNodeInventory {
      runtimeNodeInventoryReportId: UUID id generated technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String              // CONTROL_PLANE / WORKER
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
    }

    event AgentRuntimeNodeInventoryReported {
      runtimeNodeInventoryReportId: UUID id technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
    }

    state Reported
  }

  slice AgentRuntimeNodeInventoryCatalog {
    readmodel AgentRuntimeNodeInventoryCatalog[] {
      runtimeNodeInventoryReportId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the agent runtime node inventory catalog."
      }
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      subscribe OrganizationRegistered
      subscribe AgentRuntimeNodeInventoryReported
    }
  }

  concept AgentRuntimeNodeInventory {
    state Reported

    slice ReportAgentRuntimeNodeInventory
    slice AgentRuntimeNodeInventoryCatalog
  }

  slice AgentRuntimeNodeResourceLatest {
    readmodel AgentRuntimeNodeResourceLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
      telemetryRetentionPolicy: String
    }
  }

  concept AgentRuntimeNodeResourceTelemetry {
    slice AgentRuntimeNodeResourceLatest
  }


  }
}
