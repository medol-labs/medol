  slice ReceiveParticipantExecutionPlan {
    startsLifecycle
    reactsTo ParticipantExecutionPlanDispatched

    automation ReceiveExecutionPlanWhenDispatched {
      on ParticipantExecutionPlanDispatched
      emits ReceiveParticipantExecutionPlan
    }

    command ReceiveParticipantExecutionPlan {
      executionPlanId: UUID id technical from ParticipantExecutionPlanDispatched.executionPlanId
      executionSessionId: UUID from ParticipantExecutionPlanDispatched.executionSessionId
      trainingJobId: UUID from ParticipantExecutionPlanDispatched.trainingJobId
      trainingRunConfigurationId: UUID from ParticipantExecutionPlanDispatched.trainingRunConfigurationId
      featureSchemaId: UUID from ParticipantExecutionPlanDispatched.featureSchemaId
      roundId: UUID from ParticipantExecutionPlanDispatched.roundId
      roundNumber: Int from ParticipantExecutionPlanDispatched.roundNumber
      runtimeId: UUID from ParticipantExecutionPlanDispatched.runtimeId
      organizationId: UUID from ParticipantExecutionPlanDispatched.organizationId
      baseModelId: UUID from ParticipantExecutionPlanDispatched.baseModelId
      baseModelArtifactUri: String from ParticipantExecutionPlanDispatched.baseModelArtifactUri
      baseModelRegistryRef: String from ParticipantExecutionPlanDispatched.baseModelRegistryRef
      baseModelFormat: String from ParticipantExecutionPlanDispatched.baseModelFormat
      baseModelArtifactDigest: String from ParticipantExecutionPlanDispatched.baseModelArtifactDigest
      baseModelSignatureUri: String? from ParticipantExecutionPlanDispatched.baseModelSignatureUri
    }

    event ExecutionPlanReceived {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
    }

    state PlanReceived
  }

  slice AcceptExecutionPlan {
    reactsTo ExecutionPlanReceived
    port

    automation AcceptExecutionPlanWhenExecutionPlanReceived {
      on ExecutionPlanReceived
      emits AcceptExecutionPlan
    }

    command AcceptExecutionPlan {
      executionPlanId: UUID id technical from ExecutionPlanReceived.executionPlanId
      executionSessionId: UUID from ExecutionPlanReceived.executionSessionId
      trainingJobId: UUID from ExecutionPlanReceived.trainingJobId
      trainingRunConfigurationId: UUID from ExecutionPlanReceived.trainingRunConfigurationId
      featureSchemaId: UUID from ExecutionPlanReceived.featureSchemaId
      roundId: UUID from ExecutionPlanReceived.roundId
      roundNumber: Int from ExecutionPlanReceived.roundNumber
      runtimeId: UUID from ExecutionPlanReceived.runtimeId
      organizationId: UUID from ExecutionPlanReceived.organizationId
      baseModelId: UUID from ExecutionPlanReceived.baseModelId
      baseModelArtifactUri: String from ExecutionPlanReceived.baseModelArtifactUri
      baseModelRegistryRef: String from ExecutionPlanReceived.baseModelRegistryRef
      baseModelFormat: String from ExecutionPlanReceived.baseModelFormat
      baseModelArtifactDigest: String from ExecutionPlanReceived.baseModelArtifactDigest
      baseModelSignatureUri: String? from ExecutionPlanReceived.baseModelSignatureUri
    }

    event ExecutionPlanAccepted {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      localExecutionRequirementsSatisfied: Boolean
      runtimeIdentityMatched: Boolean
      runtimeDatasetBindingAvailable: Boolean
      datasetAccessValidated: Boolean
      baseModelAvailable: Boolean
      trainingConfigurationSupported: Boolean
      runtimeResourceAvailable: Boolean
      runtimeAgentIdle: Boolean
    }

    event ExecutionPlanRejected {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      localExecutionRequirementsSatisfied: Boolean
      runtimeIdentityMatched: Boolean
      runtimeDatasetBindingAvailable: Boolean
      datasetAccessValidated: Boolean
      baseModelAvailable: Boolean
      trainingConfigurationSupported: Boolean
      runtimeResourceAvailable: Boolean
      runtimeAgentIdle: Boolean
      rejectionReasons: String[]
    }

    state PlanAccepted

    specification "Execution Plan Local Acceptance Outcome" {
      rule """
        When a participant execution plan is received, the runtime agent performs a local readiness check before starting any training work. The check verifies that the plan targets this runtime, the required dataset binding exists, dataset access has already been validated, the base model is available, the requested training configuration is supported, sufficient local resources are available, and the runtime agent is idle. The port records exactly one outcome: ExecutionPlanAccepted when all local requirements are satisfied, or ExecutionPlanRejected with rejection reasons when any requirement fails.
      """

      scenario "Execution Plan Accepted" {
        given ExecutionPlanReceived {
          executionPlanId = "execution-plan-1"
        }
        when AcceptExecutionPlan {
          executionPlanId = "execution-plan-1"
        }
        then ExecutionPlanAccepted
      }

      scenario "Execution Plan Rejected" {
        given ExecutionPlanReceived {
          executionPlanId = "execution-plan-2"
        }
        when AcceptExecutionPlan {
          executionPlanId = "execution-plan-2"
        }
        then ExecutionPlanRejected
      }
    }
  }

  slice StartRoundExecution {
    reactsTo ExecutionPlanAccepted
    port

    automation StartRoundExecutionWhenPlanAccepted {
      on ExecutionPlanAccepted
      emits StartRoundExecution
    }

    command StartRoundExecution {
      roundExecutionId: UUID id generated technical
      executionSessionId: UUID from ExecutionPlanAccepted.executionSessionId
      executionPlanId: UUID from ExecutionPlanAccepted.executionPlanId
      trainingJobId: UUID from ExecutionPlanAccepted.trainingJobId
      trainingRunConfigurationId: UUID from ExecutionPlanAccepted.trainingRunConfigurationId
      roundId: UUID from ExecutionPlanAccepted.roundId
      roundNumber: Int from ExecutionPlanAccepted.roundNumber
      runtimeId: UUID from ExecutionPlanAccepted.runtimeId
      organizationId: UUID from ExecutionPlanAccepted.organizationId
      featureSchemaId: UUID from ExecutionPlanAccepted.featureSchemaId
      baseModelId: UUID from ExecutionPlanAccepted.baseModelId
      baseModelArtifactUri: String from ExecutionPlanAccepted.baseModelArtifactUri
      baseModelRegistryRef: String from ExecutionPlanAccepted.baseModelRegistryRef
      baseModelFormat: String from ExecutionPlanAccepted.baseModelFormat
      baseModelArtifactDigest: String from ExecutionPlanAccepted.baseModelArtifactDigest
      baseModelSignatureUri: String? from ExecutionPlanAccepted.baseModelSignatureUri
      runtimeEngineJobId: String
    }

    event RoundExecutionStarted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      runtimeEngineJobId: String
    }

    event RoundExecutionStartFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      runtimeEngineJobId: String?
      failureReason: String
    }

    state Running

    specification "Round Execution Runtime Engine Start Outcome" {
      rule """
        Starting a round execution is responsible for launching the local runtime engine on demand for this participant round, not for calling a pre-existing always-on engine. The adapter prepares the local training workspace and configuration, starts the matching runtime engine service, process, or container, submits the local model training job to that engine, and records the created runtimeEngineJobId. The port records exactly one outcome: RoundExecutionStarted when the runtime engine is running and the training job has been accepted, or RoundExecutionStartFailed when environment preparation, engine startup, model loading, resource allocation, or training job submission fails.
      """

      scenario "Round Execution Started" {
        given ExecutionPlanAccepted {
          executionPlanId = "execution-plan-1"
        }
        when StartRoundExecution {
          executionPlanId = "execution-plan-1"
        }
        then RoundExecutionStarted
      }

      scenario "Round Execution Start Failed" {
        given ExecutionPlanAccepted {
          executionPlanId = "execution-plan-2"
        }
        when StartRoundExecution {
          executionPlanId = "execution-plan-2"
        }
        then RoundExecutionStartFailed
      }
    }
  }

  slice CompleteRoundExecution {
    reactsTo RoundExecutionStarted

    command CompleteRoundExecution {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      runtimeEngineJobId: String
    }

    event RoundExecutionCompleted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      runtimeEngineJobId: String
    }

    state Completed
  }

  slice FailRoundExecution {
    reactsTo RoundExecutionStarted

    command FailRoundExecution {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      runtimeEngineJobId: String?
      failureReason: String
    }

    event RoundExecutionFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      runtimeEngineJobId: String?
      failureReason: String
    }

    state Failed
  }

