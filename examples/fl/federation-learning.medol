  }

  slice RetryRoundExecutionAfterRuntimeFailure {
    actor NodeOperator
    ui RoundExecutionScreen
    reactsTo RoundExecutionFailed
    port

    command RetryRoundExecutionAfterRuntimeFailure {
      roundExecutionId: UUID id technical
      executionSessionId: UUID from RoundExecutionFailed.executionSessionId
      executionPlanId: UUID from RoundExecutionFailed.executionPlanId
      trainingJobId: UUID from RoundExecutionFailed.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionFailed.trainingRunConfigurationId
      roundId: UUID from RoundExecutionFailed.roundId
