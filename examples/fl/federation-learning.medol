domain FederationLearningPlatform {
context OrganizationManagement {
  
  note "Organization management owns organization lifecycle and runtime-discovered compute node availability."

  risk "Inactive organizations can be invited into federations if organization lifecycle state is not enforced."
  risk "Disabled compute nodes can still be selected for training if runtime-discovered node availability is not enforced."
  metric organizationActivationLeadTime
  metric availableComputeNodeCoverage

  enum OrganizationType {
    HOSPITAL
    RESEARCH_INSTITUTE
    PUBLIC_HEALTH_AGENCY
    LABORATORY
    REHABILITATION_CENTER
  }

  slice RegisterOrganization {
    startsLifecycle

    tags {
      organizationName = normalize(organizationName)
    }

    actor OrganizationAdmin
    ui OrganizationRegistrationScreen

    command RegisterOrganization {
      organizationId: UUID id generated technical
      organizationName: String
      organizationType: OrganizationType
      contactEmail: String
    }

    event OrganizationRegistered {
      organizationId: UUID id technical
      organizationName: String
      organizationType: OrganizationType
      contactEmail: String
    }

    state Registered

    specification "Organization Name Unique" {
      rule """
        Organization names must be unique.
      """

      expression {
        unique Organization.organizationName
      }

      scenario "Reject Duplicate Organization" {
        given OrganizationRegistered {
          organizationName = "Acme"
        }
        when RegisterOrganization {
          organizationName = "Acme"
        }
        then reject "Organization Already Exists"
      }
    }
  }

  slice ActivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationRegistered

    command ActivateOrganization {
      organizationId: UUID id technical
      activationNote: String?
    }

    event OrganizationActivated {
      organizationId: UUID id technical
      activationNote: String?
    }

    state Active
  }

  slice DeactivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationActivated

    command DeactivateOrganization {
      organizationId: UUID id technical
      deactivationReason: String
    }

    event OrganizationDeactivated {
      organizationId: UUID id technical
      deactivationReason: String
    }

    state Deactivated
  }

  slice ReactivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationDeactivated

    command ReactivateOrganization {
      organizationId: UUID id technical
      reactivationReason: String
    }

    event OrganizationReactivated {
      organizationId: UUID id technical
      reactivationReason: String
    }

    state Active
  }

  slice OrganizationDirectory {
    ui OrganizationDirectory

    readmodel OrganizationDirectory[] {
      organizationId: UUID id
      organizationName: String
      organizationType: OrganizationType
      state: Organization.State
      availableComputeNodeCount: Int
      approvedDatasetCount: Int
      subscribe OrganizationRegistered
      subscribe OrganizationActivated
      subscribe OrganizationDeactivated
      subscribe OrganizationReactivated
      subscribe ComputeNodeRegistered
      subscribe ComputeNodeDisabled
      subscribe ComputeNodeEnabled
      subscribe DatasetApprovedForTraining
    }
  }

  concept Organization {
    state Registered
    state Active
    state Deactivated

    slice RegisterOrganization
    slice ActivateOrganization
    slice DeactivateOrganization
    slice ReactivateOrganization
    slice OrganizationDirectory
  }

  slice SyncComputeNodeRegistration {
    startsLifecycle

    tags {
      nodeId
      organizationId
      runtimeAgentId
    }

    reactsTo RuntimeNodeInventoryReported

    automation SyncNodeWhenRuntimeNodeInventoryReported {
      on RuntimeNodeInventoryReported
      emits SyncComputeNodeRegistration
    }

    command SyncComputeNodeRegistration {
      nodeId: UUID id technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String?
      syncedAt: DateTime generated technical
    }

    event ComputeNodeRegistered {
      nodeId: UUID id technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String?
      syncedAt: DateTime
    }

    state Available
  }

  slice ComputeNodeCatalog {
    readmodel ComputeNodeCatalog[] {
      nodeId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        lookup key organizationId
        source event OrganizationRegistered
        source field organizationName
        target field organizationName
        cache projection OrganizationDirectory
        missing policy keep
        rule "Lookup by organizationId and denormalize the organization display name into the compute node catalog."
      }
      infrastructureName: String? derived {
        from RuntimeInfrastructureRegistered.infrastructureName
        lookup key runtimeInfrastructureId
        source event RuntimeInfrastructureRegistered
        source field infrastructureName
        target field infrastructureName
        cache projection RuntimeInfrastructureCatalog
        missing policy keep
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime infrastructure display name into the compute node catalog."
      }
      orchestratorNodeName: String?
      availabilityStatus: String
      disabledReason: String?
      lastSyncedAt: DateTime
      lastDisabledAt: DateTime?
      lastEnabledAt: DateTime?
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructureRegistered
      subscribe ComputeNodeRegistered
      subscribe ComputeNodeDisabled
      subscribe ComputeNodeEnabled
    }
  }

  slice DisableComputeNode {
    actor OrganizationAdmin
    ui ComputeNodeCatalog confirm
    reactsTo ComputeNodeRegistered

    command DisableComputeNode {
      nodeId: UUID id technical
      disabledReason: String
      disabledAt: DateTime generated technical
    }

    event ComputeNodeDisabled {
      nodeId: UUID id technical
      organizationId: UUID derived {
        from ComputeNode.organizationId
        rule "Carry the owning organization for organization-level node availability counts."
      }
      disabledReason: String
      disabledAt: DateTime
    }

    state Disabled
  }

  slice EnableComputeNode {
    actor OrganizationAdmin
    ui ComputeNodeCatalog
    reactsTo ComputeNodeDisabled

    command EnableComputeNode {
      nodeId: UUID id technical
      enableReason: String
      enabledAt: DateTime generated technical
    }

    event ComputeNodeEnabled {
      nodeId: UUID id technical
      organizationId: UUID derived {
        from ComputeNode.organizationId
        rule "Carry the owning organization for organization-level node availability counts."
      }
      enableReason: String
      enabledAt: DateTime
    }

    state Available
  }

  concept ComputeNode {
    state Available
    state Disabled

    slice SyncComputeNodeRegistration
    slice DisableComputeNode
    slice EnableComputeNode
    slice ComputeNodeCatalog
  }

}

context FederationManagement {
  note "Federation management owns federations and federation membership governance."

  risk "Inactive organizations joining a federation can compromise model governance and data sharing agreements."
  risk "Federation training can proceed with too few available organization-owned compute nodes if eligibility is not enforced."
  metric participantApprovalLeadTime
  metric federationActivationLeadTime

  slice CreateFederation {
    startsLifecycle

    tags {
      federationName
    }

    actor PlatformAdmin
    ui FederationSetupScreen form

    command CreateFederation {
      federationId: UUID id generated technical
      federationName: String
      description: String
      minimumParticipantCount: Int
    }

    event FederationCreated {
      federationId: UUID id technical
      federationName: String
      description: String
      minimumParticipantCount: Int
    }

    state Draft

    specification "Federation Name Unique" {
      rule """
        Federation names must be unique.
      """

      expression {
        unique Federation.federationName
      }

      scenario "Reject Duplicate Federation" {
        given FederationCreated {
          federationName = "B"
        }
        when CreateFederation {
          federationName = "B"
        }
        then reject "Federation Already Exists"
      }
    }
  }

  slice ActivateFederation {
    actor PlatformAdmin
    ui FederationSetupScreen
    reactsTo FederationCreated

    command ActivateFederation {
      federationId: UUID id technical
      activationNote: String?
    }

    event FederationActivated {
      federationId: UUID id technical
      activationNote: String?
    }

    state Active
  }

  slice SuspendFederation {
    actor PlatformAdmin
    ui FederationSetupScreen confirm
    reactsTo FederationActivated

    command SuspendFederation {
      federationId: UUID id technical
      suspensionReason: String
    }

    event FederationSuspended {
      federationId: UUID id technical
      suspensionReason: String
    }

    state Suspended
  }

  slice ReactivateFederation {
    actor PlatformAdmin
    ui FederationSetupScreen
    reactsTo FederationSuspended

    command ReactivateFederation {
      federationId: UUID id technical
      reactivationReason: String
    }

    event FederationReactivated {
      federationId: UUID id technical
      reactivationReason: String
    }

    state Active
  }

  slice FederationOverview {
    reactsTo ParticipantJoined

    readmodel FederationOverview[] {
      federationId: UUID id
      federationName: String
      state: Federation.State
      minimumParticipantCount: Int
      activeMemberCount: Int
      // 计算逻辑 TODO
      pendingInvitationCount: Int
      availableComputeNodeCount: Int
      activeTrainingJobCount: Int
      subscribe FederationCreated
      subscribe FederationActivated
      subscribe FederationSuspended
      subscribe FederationReactivated
      subscribe ParticipantInvited
      subscribe ParticipantJoined
      subscribe ParticipantRejected
      subscribe ParticipantInvitationRevoked
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe ComputeNodeRegistered
      subscribe ComputeNodeDisabled
      subscribe ComputeNodeEnabled
      subscribe TrainingJobSubmitted
    }
  }

  slice InviteParticipant {
    // 这里怎么也是 start TODO 
    startsLifecycle

    actor FederationOwner
    ui ParticipantInvitationScreen dialog
    reactsTo FederationCreated

    tags {
      federationId
      organizationId
    }

    command InviteParticipant {
      federationId: UUID id technical
      organizationId: UUID
      invitationNote: String
    }

    event ParticipantInvited {
      federationId: UUID id technical
      organizationId: UUID
      invitationNote: String
    }

    state Invited
  }


  slice FederationMembershipDirectory {
    reactsTo ParticipantInvited

    readmodel FederationMembershipDirectory[] {
      federationId: UUID id
      organizationId: UUID id
      federationName: String? derived {
        from FederationCreated.federationName
        lookup key federationId
        source event FederationCreated
        source field federationName
        target field federationName
        cache projection FederationOverview
        missing policy keep
        rule "Lookup by federationId and denormalize the federation display name into the membership directory."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        lookup key organizationId
        source event OrganizationRegistered
        source field organizationName
        target field organizationName
        cache projection OrganizationDirectory
        missing policy keep
        rule "Lookup by organizationId and denormalize the organization display name into the membership directory."
      }
      membershipStatus: String
      invitationNote: String?
      approvalNote: String?
      subscribe FederationCreated
      subscribe ParticipantInvited
      subscribe ParticipantJoined
      subscribe ParticipantRejected
      subscribe ParticipantInvitationRevoked
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe OrganizationRegistered
      subscribe OrganizationActivated
    }
  }

  slice ApproveParticipant {
    actor GovernanceReviewer
    // 这里也需要 tags 吗  TODO
    tags {
      federationId
      organizationId
    }

    ui MembershipReviewScreen dialog
    reactsTo ParticipantInvited

    command ApproveParticipant {
      federationId: UUID id technical
      organizationId: UUID
      approvalNote: String?
    }

    event ParticipantJoined {
      federationId: UUID id technical
      organizationId: UUID
      approvalNote: String?
    }

    specification "Only Invited Active Organizations Join Federation" {
      rule """
        A participant can join only after the organization is active and has an outstanding invitation for the target federation.
      """

      scenario "Approve Invited Participant" {
        given ParticipantInvited {
          federationId = "fed-1"
          organizationId = "org-1"
        }
        when ApproveParticipant {
          federationId = "fed-1"
          organizationId = "org-1"
        }
        then ParticipantJoined
      }

      scenario "Reject Uninvited Participant Approval" {
        when ApproveParticipant {
          federationId = "fed-1"
          organizationId = "org-2"
        }
        then reject "Participant Invitation Required"
      }
    }

    state Active
  }

  slice RejectParticipant {
    actor GovernanceReviewer

    ui MembershipReviewScreen dialog
    reactsTo ParticipantInvited

    tags {
      federationId
      organizationId
    }

    command RejectParticipant {
      federationId: UUID id technical
      organizationId: UUID
      rejectionReason: String
    }

    event ParticipantRejected {
      federationId: UUID id technical
      organizationId: UUID
      rejectionReason: String
    }

    state Rejected
  }
  // 什么情况下可以撤销，已被使用能否撤销 TODO
  slice RevokeParticipantInvitation {
    actor FederationOwner
    ui ParticipantInvitationScreen confirm
    reactsTo ParticipantInvited

    tags {
      federationId
      organizationId
    }

    command RevokeParticipantInvitation {
      federationId: UUID id technical
      organizationId: UUID
      revokeReason: String
    }

    event ParticipantInvitationRevoked {
      federationId: UUID id technical
      organizationId: UUID
      revokeReason: String
    }

    state InvitationRevoked
  }

  slice SuspendParticipant {
    actor GovernanceReviewer
    ui MembershipReviewScreen dialog
    reactsTo ParticipantJoined

    tags {
      federationId
      organizationId
    }

    command SuspendParticipant {
      federationId: UUID id technical
      organizationId: UUID
      suspensionReason: String
    }

    event ParticipantSuspended {
      federationId: UUID id technical
      organizationId: UUID
      suspensionReason: String
    }

    state Suspended
  }

  slice RemoveParticipant {
    actor GovernanceReviewer
    ui MembershipReviewScreen confirm
    reactsTo ParticipantSuspended

    tags {
      federationId
      organizationId
    }

    command RemoveParticipant {
      federationId: UUID id technical
      organizationId: UUID
      removalReason: String
    }

    event ParticipantRemoved {
      federationId: UUID id technical
      organizationId: UUID
      removalReason: String
    }

    state Removed
  }


  concept Federation {
    state Draft
    state Active
    state Suspended

    slice CreateFederation
    slice ActivateFederation
    slice SuspendFederation
    slice ReactivateFederation
    slice FederationOverview
  }

  concept FederationMembership {
    state Invited
    state Active
    state Rejected
    state InvitationRevoked
    state Suspended
    state Removed

    slice InviteParticipant
    slice ApproveParticipant
    slice RejectParticipant
    slice RevokeParticipantInvitation
    slice SuspendParticipant
    slice RemoveParticipant
    slice FederationMembershipDirectory
  }

}

context DictionaryMaintenance {
  note "Dictionary maintenance owns dynamic option dictionaries used by platform contexts. Business contexts store valueCode and query DictionaryValueCatalog by dictionaryCode for display and selection."

  risk "Runtime option changes can invalidate pending installation plans if dictionary values are removed instead of disabled."
  risk "Duplicate dictionary value codes can cause inconsistent command payloads across deployables."
  metric dictionaryValueActivationLatency

  type DictionaryCode = String
  type DictionaryValueCode = String
  type DisplayOrder = Int {
    range 0..999999
  }

  slice RegisterDictionary {
    startsLifecycle

    actor PlatformAdmin
    ui DictionaryCatalogScreen

    tags {
      dictionaryId
      dictionaryCode
    }

    command RegisterDictionary {
      dictionaryId: UUID id generated technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      ownerContext: String
      description: String?
      multiTenant: Boolean
      registeredAt: DateTime generated technical
    }

    event DictionaryRegistered {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      ownerContext: String
      description: String?
      multiTenant: Boolean
      registeredAt: DateTime
    }

    state Registered
  }

  slice UpdateDictionary {
    actor PlatformAdmin
    ui DictionaryCatalogScreen
    reactsTo DictionaryRegistered

    tags {
      dictionaryId
      dictionaryCode
    }

    command UpdateDictionary {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      ownerContext: String
      description: String?
      multiTenant: Boolean
      updatedAt: DateTime generated technical
    }

    event DictionaryUpdated {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      ownerContext: String
      description: String?
      multiTenant: Boolean
      updatedAt: DateTime
    }
  }

  slice ArchiveDictionary {
    actor PlatformAdmin
    ui DictionaryCatalogScreen confirm
    reactsTo DictionaryRegistered

    tags {
      dictionaryId
      dictionaryCode
    }

    command ArchiveDictionary {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      archiveReason: String
      archivedAt: DateTime generated technical
    }

    event DictionaryArchived {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      archiveReason: String
      archivedAt: DateTime
    }

    state Archived
  }

  slice DictionaryCatalog {
    readmodel DictionaryCatalog[] {
      dictionaryId: UUID id
      dictionaryCode: DictionaryCode query
      dictionaryName: String
      ownerContext: String
      description: String?
      multiTenant: Boolean
      state: Dictionary.State
      registeredAt: DateTime
      updatedAt: DateTime?
      archivedAt: DateTime?
      archiveReason: String?
      subscribe DictionaryRegistered
      subscribe DictionaryUpdated
      subscribe DictionaryArchived
    }
  }

  slice AddDictionaryValue {
    startsLifecycle

    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryRegistered

    tags {
      dictionaryValueId
      dictionaryCode
      valueCode
    }

    command AddDictionaryValue {
      dictionaryValueId: UUID id generated technical
      dictionaryId: UUID
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
      effectiveFrom: DateTime?
      effectiveUntil: DateTime?
      addedAt: DateTime generated technical
    }

    event DictionaryValueAdded {
      dictionaryValueId: UUID id technical
      dictionaryId: UUID
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
      effectiveFrom: DateTime?
      effectiveUntil: DateTime?
      addedAt: DateTime
    }

    state Active
  }

  slice UpdateDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryValueAdded

    tags {
      dictionaryValueId
      dictionaryCode
      valueCode
    }

    command UpdateDictionaryValue {
      dictionaryValueId: UUID id technical
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
      effectiveFrom: DateTime?
      effectiveUntil: DateTime?
      updatedAt: DateTime generated technical
    }

    event DictionaryValueUpdated {
      dictionaryValueId: UUID id technical
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
      effectiveFrom: DateTime?
      effectiveUntil: DateTime?
      updatedAt: DateTime
    }
  }

  slice DisableDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen confirm
    reactsTo DictionaryValueAdded

    tags {
      dictionaryValueId
      dictionaryCode
      valueCode
    }

    command DisableDictionaryValue {
      dictionaryValueId: UUID id technical
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      disabledReason: String
      disabledAt: DateTime generated technical
    }

    event DictionaryValueDisabled {
      dictionaryValueId: UUID id technical
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      disabledReason: String
      disabledAt: DateTime
    }

    state Disabled
  }

  slice EnableDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryValueDisabled

    tags {
      dictionaryValueId
      dictionaryCode
      valueCode
    }

    command EnableDictionaryValue {
      dictionaryValueId: UUID id technical
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      enabledAt: DateTime generated technical
    }

    event DictionaryValueEnabled {
      dictionaryValueId: UUID id technical
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      enabledAt: DateTime
    }

    state Active
  }

  slice DictionaryValueCatalog {
    readmodel DictionaryValueCatalog[] {
      dictionaryProvider DictionaryValueCatalog {
        code dictionaryCode
        value valueCode
        label displayName
        active active
        state state
        order displayOrder
      }
      dictionaryValueId: UUID id
      dictionaryId: UUID
      dictionaryCode: DictionaryCode query
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean query
      effectiveFrom: DateTime?
      effectiveUntil: DateTime?
      state: DictionaryValue.State
      addedAt: DateTime
      updatedAt: DateTime?
      disabledAt: DateTime?
      disabledReason: String?
      enabledAt: DateTime?
      subscribe DictionaryValueAdded
      subscribe DictionaryValueUpdated
      subscribe DictionaryValueDisabled
      subscribe DictionaryValueEnabled
    }
  }

  concept Dictionary {
    state Registered
    state Archived

    slice RegisterDictionary
    slice UpdateDictionary
    slice ArchiveDictionary
    slice DictionaryCatalog
  }

  concept DictionaryValue {
    state Active
    state Disabled

    slice AddDictionaryValue
    slice UpdateDictionaryValue
    slice DisableDictionaryValue
    slice EnableDictionaryValue
    slice DictionaryValueCatalog
  }
}

context RuntimeOnboarding {
  note "Runtime onboarding owns organization-specific network endpoints, bootstrap configuration, runtime infrastructure connection, and access revocation. K3s is treated as one orchestrator implementation, not as a domain concept."

  risk "Organizations can receive wrong platform endpoints and fail to connect runtime infrastructure."
  risk "Leaked bootstrap tokens can allow unauthorized infrastructure to join the platform."
  metric runtimeBootstrapSuccessRate
  metric runtimeInfrastructureConnectionLatency

  slice ConfigureOrganizationNetworkProfile {
    startsLifecycle

    actor PlatformAdmin
    ui OrganizationNetworkProfileScreen
    reactsTo OrganizationActivated

    tags {
      organizationId
      profileName = normalize(profileName)
    }

    command ConfigureOrganizationNetworkProfile {
      networkProfileId: UUID id generated technical
      organizationId: UUID
      profileName: String
      connectivityMode: String dictionary "RUNTIME_CONNECTIVITY_MODE"
      platformApiEndpoint: String
      runtimeControlEndpoint: String  // 对组织暴露的运行时控制入口，可映射到 k3s/k8s/其他
      registryEndpoint: String
      artifactStoreEndpoint: String?
      caBundleRef: String
      allowedCidrs: String[]
      tlsSanNames: String[]
    }

    event OrganizationNetworkProfileConfigured {
      networkProfileId: UUID id technical
      organizationId: UUID
      profileName: String
      connectivityMode: String dictionary "RUNTIME_CONNECTIVITY_MODE"
      platformApiEndpoint: String
      runtimeControlEndpoint: String
      registryEndpoint: String
      artifactStoreEndpoint: String?
      caBundleRef: String
      allowedCidrs: String[]
      tlsSanNames: String[]
    }

    state Configured
  }

  slice OrganizationNetworkProfileCatalog {
    readmodel OrganizationNetworkProfileCatalog[] {
      networkProfileId: UUID id
      organizationId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        lookup key organizationId
        source event OrganizationRegistered
        source field organizationName
        target field organizationName
        cache projection OrganizationDirectory
        missing policy keep
        rule "Lookup by organizationId and denormalize the organization display name into the network profile catalog."
      }
      profileName: String
      connectivityMode: String dictionary "RUNTIME_CONNECTIVITY_MODE"
      platformApiEndpoint: String
      runtimeControlEndpoint: String
      registryEndpoint: String
      artifactStoreEndpoint: String?
      caBundleRef: String
      allowedCidrs: String[]
      tlsSanNames: String[]
      state: OrganizationNetworkProfile.State
      subscribe OrganizationRegistered
      subscribe OrganizationNetworkProfileConfigured
    }
  }

  slice CreateRuntimeInstallationPlan {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo OrganizationNetworkProfileConfigured

    tags {
      runtimeInstallationPlanId
      organizationId
      networkProfileId
    }

    command CreateRuntimeInstallationPlan {
      runtimeInstallationPlanId: UUID id generated technical
      organizationId: UUID
      networkProfileId: UUID
      infrastructureName: String
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      architecture: String
      expectedNodeCount: Int
      expectedGpuNodeCount: Int?
      expectedCpuCoreCount: Int?
      expectedMemoryGb: Int?
      nodeLabels: String[]
      plannedAt: DateTime generated technical
    }

    event RuntimeInstallationPlanCreated {
      runtimeInstallationPlanId: UUID id technical
      organizationId: UUID
      networkProfileId: UUID
      infrastructureName: String
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      architecture: String
      expectedNodeCount: Int
      expectedGpuNodeCount: Int?
      expectedCpuCoreCount: Int?
      expectedMemoryGb: Int?
      nodeLabels: String[]
      plannedAt: DateTime
    }

    state Planned
  }

  slice IssueRuntimeBootstrapToken {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeBootstrapTokenScreen
    reactsTo RuntimeInstallationPlanCreated

    tags {
      organizationId
      networkProfileId
      runtimeInstallationPlanId
    }

    command IssueRuntimeBootstrapToken {
      bootstrapTokenId: UUID id generated technical
      organizationId: UUID
      networkProfileId: UUID
      runtimeInstallationPlanId: UUID
      tokenName: String
      tokenFingerprint: String generated technical
      tokenHash: String generated technical
      allowedCidrs: String[]
      maxUseCount: Int
      issuedAt: DateTime generated technical
      expiresAt: DateTime
    }

    event RuntimeBootstrapTokenIssued {
      bootstrapTokenId: UUID id technical
      organizationId: UUID
      networkProfileId: UUID
      runtimeInstallationPlanId: UUID
      tokenName: String
      tokenFingerprint: String
      tokenHash: String
      allowedCidrs: String[]
      maxUseCount: Int
      issuedAt: DateTime
      expiresAt: DateTime
    }

    state Issued
  }

  slice RevokeRuntimeBootstrapToken {
    actor SecurityReviewer
    ui RuntimeBootstrapTokenScreen confirm
    reactsTo RuntimeBootstrapTokenIssued

    command RevokeRuntimeBootstrapToken {
      bootstrapTokenId: UUID id technical
      organizationId: UUID
      revokeReason: String
      revokedAt: DateTime generated technical
    }

    event RuntimeBootstrapTokenRevoked {
      bootstrapTokenId: UUID id technical
      organizationId: UUID
      revokeReason: String
      revokedAt: DateTime
    }

    state Revoked
  }

  slice RequestRuntimeBootstrapConfig {
    startsLifecycle

    actor RuntimeInstaller
    reactsTo RuntimeBootstrapTokenIssued

    tags {
      organizationId
      bootstrapTokenId
      runtimeInstallationPlanId
    }

    command RequestRuntimeBootstrapConfig {
      bootstrapRequestId: UUID id generated technical
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      requesterIp: String
      machineFingerprint: String
      hostname: String
      architecture: String
      osName: String
      osVersion: String
      cpuModel: String?
      gpuModel: String?
      requestedAt: DateTime generated technical
    }

    event RuntimeBootstrapConfigRequested {
      bootstrapRequestId: UUID id technical
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      requesterIp: String
      machineFingerprint: String
      hostname: String
      architecture: String
      osName: String
      osVersion: String
      cpuModel: String?
      gpuModel: String?
      requestedAt: DateTime
    }

    state Requested

    specification "Bootstrap Request Must Match Network Policy" {
      rule """
        Runtime bootstrap configuration can be requested only when the requester IP is allowed by the organization's network profile and the bootstrap token is valid.
      """

      scenario "Reject Bootstrap From Disallowed Network" {
        given OrganizationNetworkProfileConfigured {
          organizationId = "org-1"
          allowedCidrs = "10.20.0.0/16"
        }
        when RequestRuntimeBootstrapConfig {
          organizationId = "org-1"
          requesterIp = "172.16.1.9"
        }
        then reject "Requester Network Not Allowed"
      }

      scenario "Reject Revoked Bootstrap Token" {
        given RuntimeBootstrapTokenRevoked {
          bootstrapTokenId = "token-1"
        }
        when RequestRuntimeBootstrapConfig {
          bootstrapTokenId = "token-1"
        }
        then reject "Bootstrap Token Revoked"
      }
    }
  }

  slice IssueRuntimeBootstrapConfig {
    reactsTo RuntimeBootstrapConfigRequested

    automation IssueConfigWhenBootstrapRequestAccepted {
      on RuntimeBootstrapConfigRequested
      emits IssueRuntimeBootstrapConfig
    }

    command IssueRuntimeBootstrapConfig {
      bootstrapRequestId: UUID id technical
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      runtimeInfrastructureId: UUID generated technical
      networkProfileId: UUID
      infrastructureName: String
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      platformApiEndpoint: String
      runtimeControlEndpoint: String
      registryEndpoint: String
      artifactStoreEndpoint: String?
      caBundleRef: String
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      expectedNodeCount: Int
      architecture: String
      nodeLabels: String[]
      joinCredentialRef: String?
      issuedAt: DateTime generated technical
    }

    event RuntimeBootstrapConfigIssued {
      bootstrapRequestId: UUID id technical
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      runtimeInfrastructureId: UUID
      networkProfileId: UUID
      infrastructureName: String
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      platformApiEndpoint: String
      runtimeControlEndpoint: String
      registryEndpoint: String
      artifactStoreEndpoint: String?
      caBundleRef: String
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      expectedNodeCount: Int
      architecture: String
      nodeLabels: String[]
      joinCredentialRef: String?
      issuedAt: DateTime
    }

    state ConfigIssued
  }

  slice RejectRuntimeBootstrapRequest {
    actor SecurityReviewer
    ui RuntimeBootstrapRequestScreen
    reactsTo RuntimeBootstrapConfigRequested

    command RejectRuntimeBootstrapRequest {
      bootstrapRequestId: UUID id technical
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      rejectionReason: String
      rejectedAt: DateTime generated technical
    }

    event RuntimeBootstrapRequestRejected {
      bootstrapRequestId: UUID id technical
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      rejectionReason: String
      rejectedAt: DateTime
    }

    state Rejected
  }

  slice RuntimeInstallationPlanCatalog {
    readmodel RuntimeInstallationPlanCatalog[] {
      runtimeInstallationPlanId: UUID id
      organizationId: UUID
      networkProfileId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime installation plan catalog."
      }
      networkProfileName: String? derived {
        from OrganizationNetworkProfileConfigured.profileName
        rule "Lookup by networkProfileId and denormalize the network profile display name into the runtime installation plan catalog."
      }
      infrastructureName: String
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
      architecture: String
      expectedNodeCount: Int
      expectedGpuNodeCount: Int?
      expectedCpuCoreCount: Int?
      expectedMemoryGb: Int?
      nodeLabels: String[]
      planStatus: String
      bootstrapTokenId: UUID?
      runtimeInfrastructureId: UUID?
      observedNodeCount: Int?
      plannedAt: DateTime
      lastConnectedAt: DateTime?
      subscribe OrganizationRegistered
      subscribe OrganizationNetworkProfileConfigured
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeBootstrapTokenIssued
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructureConnected
    }
  }

  slice RuntimeBootstrapTokenCatalog {
    readmodel RuntimeBootstrapTokenCatalog[] {
      bootstrapTokenId: UUID id
      organizationId: UUID
      networkProfileId: UUID
      runtimeInstallationPlanId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the bootstrap token catalog."
      }
      networkProfileName: String? derived {
        from OrganizationNetworkProfileConfigured.profileName
        rule "Lookup by networkProfileId and denormalize the network profile display name into the bootstrap token catalog."
      }
      infrastructureName: String? derived {
        from RuntimeInstallationPlanCreated.infrastructureName
        rule "Lookup by runtimeInstallationPlanId and denormalize the planned infrastructure display name into the bootstrap token catalog."
      }
      tokenName: String
      tokenFingerprint: String
      state: RuntimeBootstrapToken.State
      allowedCidrs: String[]
      maxUseCount: Int
      requestCount: Int
      issuedAt: DateTime
      expiresAt: DateTime
      revokedAt: DateTime?
      revokeReason: String?
      subscribe OrganizationRegistered
      subscribe OrganizationNetworkProfileConfigured
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeBootstrapTokenIssued
      subscribe RuntimeBootstrapTokenRevoked
      subscribe RuntimeBootstrapConfigRequested
    }
  }

  slice RuntimeBootstrapRequestCatalog {
    readmodel RuntimeBootstrapRequestCatalog[] {
      bootstrapRequestId: UUID id
      organizationId: UUID
      bootstrapTokenId: UUID
      runtimeInstallationPlanId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the bootstrap request catalog."
      }
      bootstrapTokenName: String? derived {
        from RuntimeBootstrapTokenIssued.tokenName
        rule "Lookup by bootstrapTokenId and denormalize the bootstrap token display name into the bootstrap request catalog."
      }
      infrastructureName: String? derived {
        from RuntimeInstallationPlanCreated.infrastructureName
        rule "Lookup by runtimeInstallationPlanId and denormalize the planned infrastructure display name into the bootstrap request catalog."
      }
      state: RuntimeBootstrapRequest.State
      requesterIp: String
      machineFingerprint: String
      hostname: String
      architecture: String
      osName: String
      osVersion: String
      cpuModel: String?
      gpuModel: String?
      installProfile: String? dictionary "RUNTIME_INSTALL_PROFILE"
      orchestratorType: String? dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      expectedNodeCount: Int?
      requestedAt: DateTime
      issuedAt: DateTime?
      rejectedAt: DateTime?
      rejectionReason: String?
      subscribe OrganizationRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeBootstrapTokenIssued
      subscribe RuntimeBootstrapConfigRequested
      subscribe RuntimeBootstrapConfigIssued
      subscribe RuntimeBootstrapRequestRejected
    }
  }

  slice RegisterRuntimeInfrastructure {
    startsLifecycle

    reactsTo RuntimeBootstrapConfigIssued

    automation RegisterInfrastructureWhenBootstrapConfigIssued {
      condition expectedNodeCount > 0
      emits RegisterRuntimeInfrastructure
    }

    tags {
      organizationId
      runtimeInstallationPlanId
      runtimeInfrastructureId
    }

    command RegisterRuntimeInfrastructure {
      runtimeInfrastructureId: UUID id technical from RuntimeBootstrapConfigIssued.runtimeInfrastructureId
      organizationId: UUID from RuntimeBootstrapConfigIssued.organizationId
      networkProfileId: UUID from RuntimeBootstrapConfigIssued.networkProfileId
      runtimeInstallationPlanId: UUID from RuntimeBootstrapConfigIssued.runtimeInstallationPlanId
      infrastructureName: String from RuntimeBootstrapConfigIssued.infrastructureName
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE" from RuntimeBootstrapConfigIssued.infrastructureType
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE" from RuntimeBootstrapConfigIssued.orchestratorType
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION" from RuntimeBootstrapConfigIssued.orchestratorVersion
      controlPlaneEndpointRef: String?
      expectedNodeCount: Int from RuntimeBootstrapConfigIssued.expectedNodeCount
      architecture: String from RuntimeBootstrapConfigIssued.architecture
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE" from RuntimeBootstrapConfigIssued.installProfile
    }

    event RuntimeInfrastructureRegistered {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      networkProfileId: UUID
      runtimeInstallationPlanId: UUID
      infrastructureName: String
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      controlPlaneEndpointRef: String?
      expectedNodeCount: Int
      architecture: String
      installProfile: String dictionary "RUNTIME_INSTALL_PROFILE"
    }

    state Registered
  }

  slice ReportRuntimeInfrastructureConnected {
    reactsTo AgentRuntimeInfrastructureConnectionReported

    command ReportRuntimeInfrastructureConnected {
      runtimeInfrastructureId: UUID id technical from AgentRuntimeInfrastructureConnectionReported.runtimeInfrastructureId
      organizationId: UUID from AgentRuntimeInfrastructureConnectionReported.organizationId
      runtimeInstallationPlanId: UUID from AgentRuntimeInfrastructureConnectionReported.runtimeInstallationPlanId
      runtimeAgentId: UUID from AgentRuntimeInfrastructureConnectionReported.runtimeAgentId
      connectedAt: DateTime from AgentRuntimeInfrastructureConnectionReported.connectedAt
      observedNodeCount: Int from AgentRuntimeInfrastructureConnectionReported.observedNodeCount
      availableCpuCores: Int from AgentRuntimeInfrastructureConnectionReported.availableCpuCores
      availableMemoryGb: Int from AgentRuntimeInfrastructureConnectionReported.availableMemoryGb
      availableGpuCount: Int from AgentRuntimeInfrastructureConnectionReported.availableGpuCount
    }

    event RuntimeInfrastructureConnected {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
    }

    state Connected
  }

  slice RevokeRuntimeInfrastructureAccess {
    actor SecurityReviewer
    ui OrganizationNetworkProfileScreen confirm
    reactsTo RuntimeInfrastructureConnected

    command RevokeRuntimeInfrastructureAccess {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      revokeReason: String
      revokedBy: String
    }

    event RuntimeInfrastructureAccessRevoked {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      revokeReason: String
      revokedBy: String
    }

    state Revoked
  }

  slice RuntimeInfrastructureAccessView {
    readmodel RuntimeInfrastructureAccessView[] {
      runtimeInfrastructureId: UUID id
      organizationId: UUID
      networkProfileId: UUID
      runtimeInstallationPlanId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime infrastructure access view."
      }
      networkProfileName: String? derived {
        from OrganizationNetworkProfileConfigured.profileName
        rule "Lookup by networkProfileId and denormalize the network profile display name into the runtime infrastructure access view."
      }
      infrastructureName: String? derived {
        from RuntimeInfrastructureRegistered.infrastructureName
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime infrastructure display name into the access view."
      }
      platformApiEndpoint: String
      runtimeControlEndpoint: String
      registryEndpoint: String
      orchestratorType: String dictionary "RUNTIME_ORCHESTRATOR_TYPE"
      orchestratorVersion: String? dictionary "RUNTIME_ORCHESTRATOR_VERSION"
      infrastructureType: String dictionary "RUNTIME_INFRASTRUCTURE_TYPE"
      expectedNodeCount: Int
      observedNodeCount: Int?
      availableCpuCores: Int?
      availableMemoryGb: Int?
      availableGpuCount: Int?
      connectedAt: DateTime?
      state: RuntimeInfrastructure.State
      subscribe OrganizationRegistered
      subscribe OrganizationNetworkProfileConfigured
      subscribe RuntimeBootstrapConfigIssued
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructureConnected
      subscribe RuntimeInfrastructureAccessRevoked
    }
  }

  concept OrganizationNetworkProfile {
    state Configured

    slice ConfigureOrganizationNetworkProfile
    slice OrganizationNetworkProfileCatalog
  }

  concept RuntimeInstallationPlan {
    state Planned

    slice CreateRuntimeInstallationPlan
    slice RuntimeInstallationPlanCatalog
  }

  concept RuntimeBootstrapToken {
    state Issued
    state Revoked

    slice IssueRuntimeBootstrapToken
    slice RevokeRuntimeBootstrapToken
    slice RuntimeBootstrapTokenCatalog
  }

  concept RuntimeBootstrapRequest {
    state Requested
    state ConfigIssued
    state Rejected

    slice RequestRuntimeBootstrapConfig
    slice IssueRuntimeBootstrapConfig
    slice RejectRuntimeBootstrapRequest
    slice RuntimeBootstrapRequestCatalog
  }

  concept RuntimeInfrastructure {
    state Registered
    state Connected
    state Revoked

    slice RegisterRuntimeInfrastructure
    slice ReportRuntimeInfrastructureConnected
    slice RevokeRuntimeInfrastructureAccess
    slice RuntimeInfrastructureAccessView
  }
}

context DatasetGovernance {
  note "Dataset governance separates feature schemas, organization-declared dataset records, runtime-agent-reported dataset metadata, dataset access validation evidence, and train evaluation bundles. Runtime agents own data connectors, local access profiles, and credentials inside participant infrastructure."

  risk "Datasets may be approved despite schema drift, privacy sensitivity, or non IID skew that invalidates training assumptions."
  risk "Validated dataset access can remain selectable after governance revocation unless blocked explicitly."
  metric datasetContractValidationFailureRate
  metric runtimeDatasetAccessValidationLatency

  integration RuntimeAgentDatasetAccess {
    source Dataset
    target RuntimeAgent
    reactsTo DatasetAccessValidationRequested
    emits ValidateAgentDatasetAccess
  }

  integration RuntimeAgentDatasetProfiling {
    source Dataset
    target RuntimeAgent
    reactsTo DatasetProfilingRequested
    emits ProfileAgentDataset
  }

  slice DefineFeatureSchema {
    startsLifecycle

    tags {
      featureDomain
      version
    }

    actor DataSteward
    ui FeatureSchemaEditor
  
    command DefineFeatureSchema {
      featureSchemaId: UUID id generated technical
      featureDomain: String
      // 版本怎么来，不能是用户填写 TODO
      version: Int
      features: FeatureDefinition[]
    }
  
    event FeatureSchemaDefined {
      featureSchemaId: UUID id technical
      featureDomain: String
      version: Int
      featureCount: Int derived {
        from DefineFeatureSchema.features
        rule "Count entries in the features collection."
      }
    }
  
    state Draft
  
    specification "Feature Schema Domain Version Unique" {
      rule """
        A feature schema is uniquely identified by the combination of its domain and version. Two schemas within the same domain cannot share a version.
      """
  
      expression {
        unique (FeatureSchema.featureDomain, FeatureSchema.version)
      }
  
      scenario "Reject Duplicate Feature Schema Version" {
        given FeatureSchemaPublished {
          featureDomain = "CreditRisk"
          version = 1
        }
        when DefineFeatureSchema {
          featureDomain = "CreditRisk"
          version = 1
        }
        then reject "Feature Schema Version Already Exists"
      }
    }
  }

  slice PublishFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaDefined
  
    command PublishFeatureSchema {
      featureSchemaId: UUID id technical
      publishNote: String?
    }
  
    event FeatureSchemaPublished {
      featureSchemaId: UUID id technical
      featureDomain: String derived {
        from FeatureSchema.featureDomain
        rule "Carry the schema domain from the defined feature schema."
      }
      version: Int derived {
        from FeatureSchema.version
        rule "Carry the schema version from the defined feature schema."
      }
      publishNote: String?
    }
  
    state Published
  
    specification "Only Draft Schemas Can Be Published" {
      rule """
        A feature schema can be published only from the Draft lifecycle state.
      """
  
      scenario "Publish Draft Schema" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-1"
          featureDomain = "CreditRisk"
          version = 1
        }
        when PublishFeatureSchema {
          featureSchemaId = "schema-1"
        }
        then FeatureSchemaPublished
      }
    }
  }
  
  slice DeprecateFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command DeprecateFeatureSchema {
      featureSchemaId: UUID id technical
      deprecationReason: String
    }
  
    event FeatureSchemaDeprecated {
      featureSchemaId: UUID id technical
      deprecationReason: String
    }
  
    state Deprecated
  }
  
  slice RetireFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaDeprecated
  
    command RetireFeatureSchema {
      featureSchemaId: UUID id technical
      retirementReason: String
    }
  
    event FeatureSchemaRetired {
      featureSchemaId: UUID id technical
      retirementReason: String
    }
  
    state Retired
  }
  
  // 确认逻辑（升级版本？） TODO
  slice SupersedeFeatureSchemaVersion {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command SupersedeFeatureSchemaVersion {
      featureSchemaId: UUID id technical
      supersededByFeatureSchemaId: UUID
      supersessionReason: String?
    }
  
    event FeatureSchemaVersionSuperseded {
      featureSchemaId: UUID id technical
      supersededByFeatureSchemaId: UUID
      featureDomain: String
      supersededVersion: Int
      supersessionReason: String?
      supersededAt: DateTime
    }
  
    specification "Supersede Published Schema With Newer Version" {
      rule """
        Only schemas in the Published state can be superseded, and the superseding schema must belong to the same domain and have a higher version.
      """
  
      scenario "Supersede Older Version" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-1"
          featureDomain = "CreditRisk"
          version = 1
        }
        given FeatureSchemaDefined {
          featureSchemaId = "schema-2"
          featureDomain = "CreditRisk"
          version = 2
        }
        when SupersedeFeatureSchemaVersion {
          featureSchemaId = "schema-1"
          supersededByFeatureSchemaId = "schema-2"
        }
        then FeatureSchemaVersionSuperseded
      }
    }
  }
  
  slice MarkCurrentRecommendedFeatureSchemaVersion {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command MarkCurrentRecommendedFeatureSchemaVersion {
      featureSchemaId: UUID id technical
      recommendationNote: String?
    }
  
    event CurrentRecommendedFeatureSchemaVersionMarked {
      featureSchemaId: UUID id technical
      featureDomain: String derived {
        from FeatureSchema.featureDomain
        rule "Use the schema domain as the recommendation boundary."
      }
      recommendedVersion: Int derived {
        from FeatureSchema.version
        rule "Expose the recommended schema version for catalog projection."
      }
      recommendedAt: DateTime
      recommendationNote: String?
    }
  
    specification "Only One Recommended Version Per Domain" {
      rule """
        For each domain, at most one feature schema version is marked as the current recommended version. Marking a new version as recommended must clear the previous recommended version in the same domain.
      """
  
      scenario "Mark New Recommended Version" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-2"
          featureDomain = "CreditRisk"
          version = 2
        }
        when MarkCurrentRecommendedFeatureSchemaVersion {
          featureSchemaId = "schema-2"
        }
        then CurrentRecommendedFeatureSchemaVersionMarked
      }
    }
  }
  
  slice CurrentRecommendedFeatureSchemaCatalog {
    readmodel CurrentRecommendedFeatureSchemaCatalog[] {
      featureDomain: String id
      recommendedFeatureSchemaId: UUID
      recommendedVersion: Int
      // TODO 统一处理时间与操作人
      recommendedAt: DateTime
      recommendationNote: String?
      subscribe CurrentRecommendedFeatureSchemaVersionMarked
    }
  }

  // 缺少 FeatureShcema 详情查看 readmodel TODO
  slice FeatureSchemaCatalog {
    readmodel FeatureSchemaCatalog[] {
      featureSchemaId: UUID id
      featureDomain: String
      version: Int
      featureCount: Int
      schemaStatus: String
      supersededByFeatureSchemaId: UUID?
      recommendedForDomain: Boolean
      subscribe FeatureSchemaDefined
      subscribe FeatureSchemaPublished
      subscribe FeatureSchemaDeprecated
      subscribe FeatureSchemaRetired
      subscribe FeatureSchemaVersionSuperseded
      subscribe CurrentRecommendedFeatureSchemaVersionMarked
    }
  }

  concept FeatureSchema {
    state Draft
    state Published
    state Deprecated
    state Retired
  
    slice DefineFeatureSchema
    slice PublishFeatureSchema
    slice DeprecateFeatureSchema
    slice RetireFeatureSchema
    slice FeatureSchemaCatalog
    slice SupersedeFeatureSchemaVersion
    slice MarkCurrentRecommendedFeatureSchemaVersion
    slice CurrentRecommendedFeatureSchemaCatalog
  }

  slice RegisterDataset {
    startsLifecycle

    actor DataOwner
    ui DatasetRegistrationScreen
    reactsTo FeatureSchemaPublished
  
    command RegisterDataset {
      datasetId: UUID id generated technical
      // 用户填写？数据拥有者添加本身即所属组织 TODO
      organizationId: UUID
      runtimeAgentId: UUID
      // 一个数据集是否能对应多个 feature schema
      featureSchemaId: UUID
      // 这是什么 TODO
      labelSchemaId: UUID
      datasetName: String
      // 应该来自枚举 TODO
      datasetType: String
      // 什么意思 TODO
      datasetUsage: String
      sensitivityLevel: String
      // 是否要标识，有没有用 TODO
      containsPII: Boolean
      region: String
      agentDatasetHandle: String
    }
  
    event DatasetRegistered {
      datasetId: UUID id technical
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      labelSchemaId: UUID
      datasetName: String
      datasetType: String
      datasetUsage: String
      sensitivityLevel: String
      containsPII: Boolean
      region: String
      agentDatasetHandle: String
    }
  
    state Registered
  }

  slice RequestRuntimeDatasetProfiling {
    reactsTo DatasetRegistered

    automation RequestDatasetProfilingWhenDatasetRegistered {
      on DatasetRegistered
      emits RequestRuntimeDatasetProfiling
    }

    command RequestRuntimeDatasetProfiling {
      datasetId: UUID id technical from DatasetRegistered.datasetId
      organizationId: UUID from DatasetRegistered.organizationId
      runtimeAgentId: UUID from DatasetRegistered.runtimeAgentId
      featureSchemaId: UUID from DatasetRegistered.featureSchemaId
      labelSchemaId: UUID from DatasetRegistered.labelSchemaId
      agentDatasetHandle: String from DatasetRegistered.agentDatasetHandle
      profilingProfile: String?
      requestedAt: DateTime generated technical
    }

    event DatasetProfilingRequested {
      datasetId: UUID id technical
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      labelSchemaId: UUID
      agentDatasetHandle: String
      profilingProfile: String?
      requestedAt: DateTime
    }

    state ProfilingRequested
  }

  slice RecordRuntimeDatasetMetadata {
    reactsTo AgentDatasetMetadataReported

    automation RecordDatasetMetadataWhenAgentReported {
      on AgentDatasetMetadataReported
      emits RecordRuntimeDatasetMetadata
    }

    command RecordRuntimeDatasetMetadata {
      metadataReportId: UUID id technical from AgentDatasetMetadataReported.metadataReportId
      datasetId: UUID from AgentDatasetMetadataReported.datasetId
      organizationId: UUID from AgentDatasetMetadataReported.organizationId
      runtimeAgentId: UUID from AgentDatasetMetadataReported.runtimeAgentId
      featureSchemaId: UUID from AgentDatasetMetadataReported.featureSchemaId
      labelSchemaId: UUID from AgentDatasetMetadataReported.labelSchemaId
      sampleCount: Int from AgentDatasetMetadataReported.sampleCount
      featureCount: Int from AgentDatasetMetadataReported.featureCount
      schemaCompatible: Boolean from AgentDatasetMetadataReported.schemaCompatible
      labelCompatible: Boolean from AgentDatasetMetadataReported.labelCompatible
      missingValueRate: Decimal from AgentDatasetMetadataReported.missingValueRate
      duplicateRate: Decimal from AgentDatasetMetadataReported.duplicateRate
      qualityScore: Decimal from AgentDatasetMetadataReported.qualityScore
      nonIidScore: Decimal from AgentDatasetMetadataReported.nonIidScore
      classBalanceScore: Decimal? from AgentDatasetMetadataReported.classBalanceScore
      statisticsRef: String? from AgentDatasetMetadataReported.statisticsRef
      profiledAt: DateTime from AgentDatasetMetadataReported.profiledAt
    }

    event DatasetMetadataReported {
      metadataReportId: UUID id technical
      datasetId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      labelSchemaId: UUID
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean
      labelCompatible: Boolean
      missingValueRate: Decimal
      duplicateRate: Decimal
      qualityScore: Decimal
      nonIidScore: Decimal
      classBalanceScore: Decimal?
      statisticsRef: String?
      profiledAt: DateTime
    }

    state MetadataReported
  }

  slice ValidateDatasetContract {
    reactsTo DatasetMetadataReported
  
    automation ValidateDatasetContractAutomatically {
      condition sampleCount > 0
      emits ValidateDatasetContract
    }
  
    command ValidateDatasetContract {
      datasetId: UUID id technical from DatasetMetadataReported.datasetId
      metadataReportId: UUID from DatasetMetadataReported.metadataReportId
      featureSchemaId: UUID from DatasetMetadataReported.featureSchemaId
      labelSchemaId: UUID from DatasetMetadataReported.labelSchemaId
      validationProfile: String?
      validatedAt: DateTime generated technical
    }

    event DatasetContractValidated {
      datasetId: UUID id technical
      featureSchemaId: UUID
      labelSchemaId: UUID
      metadataReportId: UUID
      schemaCompatible: Boolean from DatasetMetadataReported.schemaCompatible
      labelCompatible: Boolean from DatasetMetadataReported.labelCompatible
      qualityScore: Decimal from DatasetMetadataReported.qualityScore
      nonIidScore: Decimal from DatasetMetadataReported.nonIidScore
      validatedAt: DateTime
    }
  
    state ContractValidated
  }

  slice RejectDatasetForTraining {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetContractValidated

    command RejectDatasetForTraining {
      datasetId: UUID id technical
      rejectionReason: String
    }

    event DatasetRejectedForTraining {
      datasetId: UUID id technical
      rejectionReason: String
    }

    state Rejected
  }

  slice ApproveDatasetForTraining {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetContractValidated

    command ApproveDatasetForTraining {
      datasetId: UUID id technical
      allowedFederatedUse: String
      expiresAt: DateTime
    }

    event DatasetApprovedForTraining {
      datasetId: UUID id technical
      organizationId: UUID derived {
        from Dataset.organizationId
        rule "Carry the owning organization for organization-level approved dataset counts."
      }
      allowedFederatedUse: String
      expiresAt: DateTime
    }

    specification "Only Validated Quality Datasets Are Approved" {
      rule """
        A dataset can be approved only after contract validation succeeds and the validation profile reports acceptable quality and schema compatibility.
      """

      scenario "Approve Validated Dataset" {
        given DatasetContractValidated {
          datasetId = "dataset-1"
          schemaCompatible = true
          labelCompatible = true
          qualityScore = 0.86
        }
        when ApproveDatasetForTraining {
          datasetId = "dataset-1"
        }
        then DatasetApprovedForTraining
      }

      scenario "Reject Approval Before Contract Validation" {
        when ApproveDatasetForTraining {
          datasetId = "dataset-2"
        }
        then reject "Dataset Contract Validation Required"
      }
    }

    state Approved
  }

  // 是否需要 TODO
  slice ExpireDatasetTrainingApproval {
    reactsTo DatasetApprovedForTraining

    automation ExpireDatasetApprovalWhenPastExpiry {
      condition expiresAt < now
      emits ExpireDatasetTrainingApproval
    }

    command ExpireDatasetTrainingApproval {
      datasetId: UUID id technical
      expiredAt: DateTime
    }

    event DatasetTrainingApprovalExpired {
      datasetId: UUID id technical
      expiredAt: DateTime
    }

    state ApprovalExpired
  }

  slice RevokeDatasetTrainingApproval {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetApprovedForTraining

    command RevokeDatasetTrainingApproval {
      datasetId: UUID id technical
      revokeReason: String
    }

    event DatasetTrainingApprovalRevoked {
      datasetId: UUID id technical
      revokeReason: String
    }

    state ApprovalRevoked
  }

  slice DatasetCapability {
    readmodel DatasetCapability[] {
      datasetId: UUID id
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the dataset capability catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the dataset capability catalog."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the dataset capability catalog."
      }
      datasetName: String
      datasetUsage: String
      sampleCount: Int?
      featureCount: Int?
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      metadataReportId: UUID?
      statisticsRef: String?
      metadataStatus: String
      approvalStatus: String
      expiresAt: DateTime?
      approved: Boolean
      lastProfiledAt: DateTime?
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe DatasetRegistered
      subscribe DatasetProfilingRequested
      subscribe DatasetMetadataReported
      subscribe DatasetContractValidated
      subscribe DatasetRejectedForTraining
      subscribe DatasetApprovedForTraining
      subscribe DatasetTrainingApprovalExpired
      subscribe DatasetTrainingApprovalRevoked
    }
  }

  concept Dataset {
    state Registered
    state ProfilingRequested
    state MetadataReported
    state ContractValidated
    state Approved
    state Rejected
    state ApprovalExpired
    state ApprovalRevoked

    slice RegisterDataset
    slice RequestRuntimeDatasetProfiling
    slice RecordRuntimeDatasetMetadata
    slice ValidateDatasetContract
    slice RejectDatasetForTraining
    slice ApproveDatasetForTraining
    slice ExpireDatasetTrainingApproval
    slice RevokeDatasetTrainingApproval
    slice DatasetCapability
  }

  slice RequestRuntimeDatasetAccessValidation {
    startsLifecycle
    reactsTo DatasetApprovedForTraining

    automation RequestDatasetAccessValidationWhenDatasetApproved {
      on DatasetApprovedForTraining
      emits RequestRuntimeDatasetAccessValidation
    }

    command RequestRuntimeDatasetAccessValidation {
      datasetAccessValidationId: UUID id generated technical
      datasetId: UUID from DatasetApprovedForTraining.datasetId
      organizationId: UUID from DatasetApprovedForTraining.organizationId
      runtimeAgentId: UUID derived {
        from Dataset.runtimeAgentId
        rule "Route validation to the runtime agent that owns the dataset handle."
      }
      agentDatasetHandle: String derived {
        from Dataset.agentDatasetHandle
        rule "Use the opaque agent-side dataset handle without exposing connector configuration."
      }
      validationMode: String
      requestedAt: DateTime generated technical
    }

    event DatasetAccessValidationRequested {
      datasetAccessValidationId: UUID id technical
      datasetId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      agentDatasetHandle: String
      validationMode: String
      requestedAt: DateTime
    }

    state ValidationRequested
  }

  slice CompleteRuntimeDatasetAccessValidation {
    reactsTo AgentDatasetAccessValidated

    automation CompleteDatasetAccessValidationWhenAgentValidated {
      on AgentDatasetAccessValidated
      emits CompleteRuntimeDatasetAccessValidation
    }

    command CompleteRuntimeDatasetAccessValidation {
      datasetAccessValidationId: UUID id technical from AgentDatasetAccessValidated.datasetAccessValidationId
      datasetId: UUID from AgentDatasetAccessValidated.datasetId
      runtimeAgentId: UUID from AgentDatasetAccessValidated.runtimeAgentId
      readable: Boolean from AgentDatasetAccessValidated.readable
      schemaReadable: Boolean from AgentDatasetAccessValidated.schemaReadable
      sampleBatchReadable: Boolean from AgentDatasetAccessValidated.sampleBatchReadable
      validationReportId: UUID from AgentDatasetAccessValidated.validationReportId
      validatedAt: DateTime from AgentDatasetAccessValidated.validatedAt
    }

    event RuntimeDatasetAccessValidated {
      datasetAccessValidationId: UUID id technical
      datasetId: UUID
      runtimeAgentId: UUID
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationReportId: UUID
      validatedAt: DateTime
    }

    state Validated
  }

  slice BlockRuntimeDatasetAccess {
    actor ComplianceOfficer
    ui DatasetAccessValidationScreen confirm
    reactsTo RuntimeDatasetAccessValidated

    command BlockRuntimeDatasetAccess {
      datasetAccessValidationId: UUID id technical
      datasetId: UUID
      runtimeAgentId: UUID
      violationReason: String
      blockedBy: String
    }

    event DatasetAccessBlocked {
      datasetAccessValidationId: UUID id technical from BlockRuntimeDatasetAccess.datasetAccessValidationId
      datasetId: UUID from BlockRuntimeDatasetAccess.datasetId
      runtimeAgentId: UUID from BlockRuntimeDatasetAccess.runtimeAgentId
      violationReason: String from BlockRuntimeDatasetAccess.violationReason
      blockedBy: String from BlockRuntimeDatasetAccess.blockedBy
    }

    state AccessBlocked

    specification "Blocked Dataset Access Cannot Be Used For Training" {
      rule """
        Blocked dataset access validation evidence must not be selected by any future training job or node participation request.
      """

      scenario "Block Violating Dataset Access" {
        given RuntimeDatasetAccessValidated {
          datasetAccessValidationId = "access-1"
          readable = true
        }
        when BlockRuntimeDatasetAccess {
          datasetAccessValidationId = "access-1"
          violationReason = "Policy Revoked"
        }
        then DatasetAccessBlocked
      }
    }
  }

  slice DatasetRuntimeAccessCatalog {
    readmodel DatasetRuntimeAccessCatalog[] {
      datasetAccessValidationId: UUID id
      datasetId: UUID
      runtimeAgentId: UUID
      datasetName: String? derived {
        from DatasetRegistered.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the runtime access catalog."
      }
      agentDatasetHandle: String
      validationMode: String
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationReportId: UUID?
      accessStatus: String
      blockedReason: String?
      requestedAt: DateTime
      validatedAt: DateTime?
      subscribe DatasetRegistered
      subscribe DatasetAccessValidationRequested
      subscribe RuntimeDatasetAccessValidated
      subscribe DatasetAccessBlocked
    }
  }

  concept RuntimeDatasetAccessValidation {
    state ValidationRequested
    state Validated
    state AccessBlocked

    slice RequestRuntimeDatasetAccessValidation
    slice CompleteRuntimeDatasetAccessValidation
    slice BlockRuntimeDatasetAccess
    slice DatasetRuntimeAccessCatalog
  }

  value FeatureDefinition {
    featureName: String
    // 数据类型也不能由用户填写 TODO
    dataType: String
    // TODO 这是什么
    shape: Int[]?
    nullable: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
    isIdentifier: Boolean
    isSensitive: Boolean
    encodingStrategy: String?
    featureTags: String[]
  }
  
  value LabelDefinition {
    labelName: String
    dataType: String
    cardinality: Int
    classLabels: String[]?
    isMultilabel: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
  }
}

context ModelRepository {
  note "Model repository owns pullable model artifact references used by training orchestration and runtime agents."

  risk "Runtime agents can pull stale or tampered models if artifact hashes and repository references are not snapshotted with the training run."
  risk "Aggregated round models can lose lineage if their producing training job and round are not recorded."
  metric modelArtifactRegistrationLatency
  metric modelArtifactPullFailureRate

  slice RegisterModelArtifact {
    startsLifecycle

    actor MLOpsEngineer
    ui ModelRepositoryScreen

    command RegisterModelArtifact {
      modelVersionId: UUID id generated technical
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      modelSizeBytes: Int?
      sourceType: String
      registeredBy: String
      registeredAt: DateTime generated technical
    }

    event ModelArtifactRegistered {
      modelVersionId: UUID id technical
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      modelSizeBytes: Int?
      sourceType: String
      registeredBy: String
      registeredAt: DateTime
    }

    state Registered

    specification "Model Artifact Must Be Pullable And Verifiable" {
      rule """
        A model artifact registered for training must include a repository reference, an artifact reference, a model format, and a content hash so runtime agents can pull and verify it.
      """

      scenario "Register Pullable Model Artifact" {
        when RegisterModelArtifact {
          modelVersionId = "model-1"
          modelRepositoryRef = "model-repo"
          modelArtifactRef = "models/model-1"
          modelFormat = "ONNX"
          modelHash = "sha256:abc"
          sourceType = "INITIAL"
        }
        then ModelArtifactRegistered
      }
    }
  }

  slice ModelArtifactCatalog {
    readmodel ModelArtifactCatalog[] {
      modelVersionId: UUID id
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      modelSizeBytes: Int?
      sourceType: String?
      trainingJobId: UUID?
      roundId: UUID?
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the model artifact catalog."
      }
      state: ModelArtifact.State
      registeredAt: DateTime?
      subscribe TrainingJobCreated
      subscribe ModelArtifactRegistered
      subscribe GlobalModelUpdated
    }
  }

  concept ModelArtifact {
    state Registered

    slice RegisterModelArtifact
    slice ModelArtifactCatalog
  }
}

context TrainingOrchestration {
  note "Training orchestration owns job intent, participant eligibility, runtime dispatch, and each round of distributed training and evaluation."

  risk "Training can stall when started participant runtimes fall below quorum or when secure aggregation is requested before enough evaluated updates exist."
  risk "Poisoned local updates can degrade the global model if anomaly checks are not modeled as a first class decision."
  metric nodeDropoutRate
  metric roundCompletionLatency
  metric globalAccuracyGap

  integration SecureAggregationProvider {
    source TrainingRound
    target SecureAggregationService
    reactsTo SecureAggregationRequested
    emits CompleteSecureAggregation
  }

  integration ParticipantRoundRuntime {
    source TrainingRound
    target RuntimeAgent
    reactsTo AgentRoundContributionRequested
    emits PullRoundGlobalModel
  }

  integration AggregationNodeRuntime {
    source TrainingRound
    target AggregationRuntime
    reactsTo GlobalModelUpdated
    emits SubmitGlobalModelEvaluation
  }

  integration ParticipantRuntimeAgent {
    source TrainingJob
    target RuntimeAgent
    reactsTo TrainingRuntimeDispatched
    emits AcceptAgentRuntimeJob
  }

  slice DefineTrainingRunConfiguration {
    startsLifecycle

    actor MLOpsEngineer
    ui TrainingRunConfigurationScreen

    command DefineTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id generated technical
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      strategyName: String
      // 可选枚举 TODO
      aggregationAlgorithm: String
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String
      lossFunction: String
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
    }

    event TrainingRunConfigurationDefined {
      trainingRunConfigurationId: UUID id technical
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      initialModelArtifactRef: String derived {
        from ModelArtifact.modelArtifactRef
        rule "Snapshot the initial model artifact pull reference selected from the model repository."
      }
      initialModelRepositoryRef: String derived {
        from ModelArtifact.modelRepositoryRef
        rule "Snapshot the model repository reference so runtime agents can pull the initial global model."
      }
      initialModelFormat: String derived {
        from ModelArtifact.modelFormat
        rule "Snapshot the model format needed by the runtime engine."
      }
      initialModelHash: String derived {
        from ModelArtifact.modelHash
        rule "Snapshot the content hash used by runtime agents to verify the pulled model."
      }
      initialModelSignatureRef: String? derived {
        from ModelArtifact.modelSignatureRef
        rule "Snapshot the optional signature used to verify model provenance."
      }
      strategyName: String
      aggregationAlgorithm: String
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String
      lossFunction: String
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      dpNoiseMultiplier: Decimal?
      dpClipNorm: Decimal?
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      failureToleranceRatio: Decimal
    }

    state Draft
  }

  slice ValidateTrainingRunConfiguration {
    reactsTo TrainingRunConfigurationDefined

    automation ValidateTrainingRunConfigurationAutomatically {
      condition maxRounds > 0
      emits ValidateTrainingRunConfiguration
    }

    command ValidateTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id technical
      validationProfile: String
    }

    event TrainingRunConfigurationValidated {
      trainingRunConfigurationId: UUID id technical from ValidateTrainingRunConfiguration.trainingRunConfigurationId
      valid: Boolean
      validationReportId: UUID
      effectiveMinimumNodesPerRound: Int derived {
        from TrainingRunConfiguration.minimumNodesPerRound, TrainingRunConfiguration.failureToleranceRatio
        rule "Derive the effective runtime quorum from the selected strategy and failure tolerance."
      }
    }

    state Validated

    specification "Training Configuration Must Be Runnable" {
      rule """
        A training run configuration must define a positive round budget, a feasible runtime quorum, and privacy parameters when differential privacy is enabled.
      """

      scenario "Validate Runnable Configuration" {
        given TrainingRunConfigurationDefined {
          trainingRunConfigurationId = "cfg-1"
          maxRounds = 10
          minimumNodesPerRound = 3
        }
        when ValidateTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-1"
        }
        then TrainingRunConfigurationValidated
      }

      scenario "Reject Empty Round Budget" {
        given TrainingRunConfigurationDefined {
          trainingRunConfigurationId = "cfg-2"
          maxRounds = 0
        }
        when ValidateTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-2"
        }
        then reject "Positive Round Budget Required"
      }
    }
  }

  slice LockTrainingRunConfiguration {
    reactsTo TrainingJobSubmitted

    automation LockConfigurationWhenTrainingSubmitted {
      on TrainingJobSubmitted
      emits LockTrainingRunConfiguration
    }

    command LockTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id technical
      trainingJobId: UUID
      lockedBy: String
    }

    event TrainingRunConfigurationLocked {
      trainingRunConfigurationId: UUID id technical
      trainingJobId: UUID
      lockedBy: String
    }

    state Locked
  }
  // 具体配置 TODO
  slice TrainingRunConfigurationCatalog {
    readmodel TrainingRunConfigurationCatalog[] {
      trainingRunConfigurationId: UUID id
      federationId: UUID
      featureSchemaId: UUID
      initialModelVersionId: UUID
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into the training run configuration catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the training run configuration catalog."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the training run configuration catalog."
      }
      initialModelArtifactRef: String
      initialModelRepositoryRef: String
      initialModelFormat: String
      initialModelHash: String
      initialModelSignatureRef: String?
      strategyName: String
      aggregationAlgorithm: String
      maxRounds: Int
      minimumNodesPerRound: Int
      secureAggregationRequired: Boolean
      differentialPrivacyEnabled: Boolean
      minimumAccuracy: Decimal
      state: TrainingRunConfiguration.State
      subscribe FederationCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingRunConfigurationDefined
      subscribe TrainingRunConfigurationValidated
      subscribe TrainingRunConfigurationLocked
    }
  }

  concept TrainingRunConfiguration {
    state Draft
    state Validated
    state Locked

    slice DefineTrainingRunConfiguration
    slice ValidateTrainingRunConfiguration
    slice LockTrainingRunConfiguration
    slice TrainingRunConfigurationCatalog
  }

  slice CreateTrainingJob {
    startsLifecycle

    actor ResearchLead
    ui TrainingJobCreationScreen
    reactsTo TrainingRunConfigurationValidated

    // Participating organizations are resolved from federation membership and runtime readiness.
    command CreateTrainingJob {
      trainingJobId: UUID id generated technical
      federationId: UUID
      trainingRunConfigurationId: UUID
      objective: String
      targetMetric: String
    }

    event TrainingJobCreated {
      trainingJobId: UUID id technical
      federationId: UUID
      featureSchemaId: UUID derived {
        from TrainingRunConfiguration.featureSchemaId
        rule "Use the feature schema selected in the validated training run configuration."
      }
      trainingRunConfigurationId: UUID
      objective: String
      targetMetric: String
    }

    state Draft

    specification "Training Job Requires Validated Configuration And Runtime Access" {
      rule """
        A training job can be created only from a validated training run configuration. Runtime agents match local datasets by the configuration's feature schema when work is dispatched.
      """

      scenario "Create Training Job With Validated Inputs" {
        given TrainingRunConfigurationValidated {
          trainingRunConfigurationId = "config-1"
        }
        when CreateTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then TrainingJobCreated
      }

      scenario "Reject Training Job Without Validated Configuration" {
        when CreateTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then reject "Validated Training Configuration Required"
      }
    }
  }

  slice SubmitTrainingJob {
    actor ResearchLead
    ui TrainingSubmissionScreen
    reactsTo TrainingJobCreated

    command SubmitTrainingJob {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
    }

    event TrainingJobSubmitted {
      trainingJobId: UUID id technical from SubmitTrainingJob.trainingJobId
      federationId: UUID derived {
        from TrainingJob.federationId
        rule "Carry the federation boundary so eligible participants and compute nodes are resolved from federation membership at submission time."
      }
      trainingRunConfigurationId: UUID from SubmitTrainingJob.trainingRunConfigurationId
      featureSchemaId: UUID derived {
        from TrainingJob.featureSchemaId
        rule "Snapshot the feature schema so runtime agents can match their local datasets without platform-side dataset binding."
      }
      initialModelVersionId: UUID derived {
        from TrainingRunConfiguration.initialModelVersionId
        rule "Snapshot the initial model version selected by the training run configuration."
      }
      initialModelArtifactRef: String derived {
        from TrainingRunConfiguration.initialModelArtifactRef
        rule "Snapshot the initial model artifact pull reference for reproducible round one execution."
      }
      initialModelRepositoryRef: String derived {
        from TrainingRunConfiguration.initialModelRepositoryRef
        rule "Snapshot the model repository reference used by runtime agents to pull the initial model."
      }
      initialModelFormat: String derived {
        from TrainingRunConfiguration.initialModelFormat
        rule "Snapshot the initial model format used by runtime engines."
      }
      initialModelHash: String derived {
        from TrainingRunConfiguration.initialModelHash
        rule "Snapshot the initial model hash used by runtime agents to verify downloads."
      }
      initialModelSignatureRef: String? derived {
        from TrainingRunConfiguration.initialModelSignatureRef
        rule "Snapshot the optional initial model signature reference."
      }
      strategyName: String derived {
        from TrainingRunConfiguration.strategyName
        rule "Snapshot the validated training strategy name when the job is submitted."
      }
      aggregationAlgorithm: String derived {
        from TrainingRunConfiguration.aggregationAlgorithm
        rule "Snapshot the aggregation algorithm for runtime dispatch and audit."
      }
      maxRounds: Int derived {
        from TrainingRunConfiguration.maxRounds
        rule "Snapshot the configured round budget when the training job is submitted."
      }
      minimumNodesPerRound: Int derived {
        from TrainingRunConfiguration.minimumNodesPerRound
        rule "Snapshot the configured minimum runtime quorum when the training job is submitted."
      }
      roundTimeoutSeconds: Int derived {
        from TrainingRunConfiguration.roundTimeoutSeconds
        rule "Snapshot the round timeout for reproducible orchestration."
      }
      nodeResponseTimeoutSeconds: Int derived {
        from TrainingRunConfiguration.nodeResponseTimeoutSeconds
        rule "Snapshot the node response timeout for runtime scheduling."
      }
      localEpochs: Int derived {
        from TrainingRunConfiguration.localEpochs
        rule "Snapshot local training epochs for runtime payload construction."
      }
      batchSize: Int derived {
        from TrainingRunConfiguration.batchSize
        rule "Snapshot batch size for runtime payload construction."
      }
      learningRate: Decimal derived {
        from TrainingRunConfiguration.learningRate
        rule "Snapshot learning rate for runtime payload construction."
      }
      optimizer: String derived {
        from TrainingRunConfiguration.optimizer
        rule "Snapshot optimizer for runtime payload construction."
      }
      lossFunction: String derived {
        from TrainingRunConfiguration.lossFunction
        rule "Snapshot loss function for runtime payload construction."
      }
      gradientClippingNorm: Decimal? derived {
        from TrainingRunConfiguration.gradientClippingNorm
        rule "Snapshot optional gradient clipping for runtime payload construction."
      }
      secureAggregationRequired: Boolean derived {
        from TrainingRunConfiguration.secureAggregationRequired
        rule "Snapshot the secure aggregation requirement for round orchestration."
      }
      differentialPrivacyEnabled: Boolean derived {
        from TrainingRunConfiguration.differentialPrivacyEnabled
        rule "Snapshot the differential privacy toggle for runtime payload construction."
      }
      dpNoiseMultiplier: Decimal? derived {
        from TrainingRunConfiguration.dpNoiseMultiplier
        rule "Snapshot optional DP noise multiplier for runtime payload construction."
      }
      dpClipNorm: Decimal? derived {
        from TrainingRunConfiguration.dpClipNorm
        rule "Snapshot optional DP clip norm for runtime payload construction."
      }
      minimumAccuracy: Decimal derived {
        from TrainingRunConfiguration.minimumAccuracy
        rule "Snapshot the configured target accuracy when the training job is submitted."
      }
      minimumFairnessScore: Decimal? derived {
        from TrainingRunConfiguration.minimumFairnessScore
        rule "Snapshot optional minimum fairness target for evaluation."
      }
      failureToleranceRatio: Decimal derived {
        from TrainingRunConfiguration.failureToleranceRatio
        rule "Snapshot failure tolerance for quorum and retry decisions."
      }
    }

    state Submitted

    specification "Only Created Training Jobs Can Be Submitted" {
      rule """
        A training job can be submitted after it is created from a validated training run configuration. Dataset matching is delegated to each runtime agent using the selected feature schema.
      """

      scenario "Submit Created Training Job" {
        given TrainingJobCreated {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        when SubmitTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then TrainingJobSubmitted
      }

      scenario "Reject Unknown Training Job" {
        when SubmitTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then reject "Training Job Required"
      }
    }
  }

  slice DispatchTrainingRuntime {
    startsLifecycle
    reactsTo TrainingJobSubmitted

    tags {
      trainingJobId
      organizationId
      runtimeAgentId
    }

    automation DispatchRuntimeToEligibleParticipants {
      on TrainingJobSubmitted
      condition eligible == true
      emits DispatchTrainingRuntime
    }

    command DispatchTrainingRuntime {
      trainingJobId: UUID id technical from TrainingJobSubmitted.trainingJobId
      federationId: UUID from TrainingJobSubmitted.federationId
      trainingRunConfigurationId: UUID from TrainingJobSubmitted.trainingRunConfigurationId
      featureSchemaId: UUID from TrainingJobSubmitted.featureSchemaId
      organizationId: UUID derived {
        from TrainingParticipantEligibility.organizationId
        rule "Dispatch to eligible federation participants, not to platform-selected compute nodes."
      }
      runtimeAgentId: UUID derived {
        from TrainingParticipantEligibility.runtimeAgentId
        rule "Route the training job to the participant runtime agent; the agent owns concrete node scheduling."
      }
      runtimeInfrastructureId: UUID derived {
        from TrainingParticipantEligibility.runtimeInfrastructureId
        rule "Carry the participant runtime infrastructure boundary for audit and routing."
      }
      availableComputeNodeCount: Int derived {
        from TrainingParticipantEligibility.availableComputeNodeCount
        rule "Snapshot aggregate participant capacity without selecting a concrete node."
      }
      availableGpuCount: Int? derived {
        from TrainingParticipantEligibility.availableGpuCount
        rule "Snapshot aggregate GPU capacity without selecting a concrete node."
      }
      runtimeImageRef: String
      runtimePayloadRef: String
      artifactStoreRef: String
    }

    event TrainingRuntimeDispatched {
      trainingJobId: UUID id technical
      federationId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID
      availableComputeNodeCount: Int
      availableGpuCount: Int?
      runtimeImageRef: String
      runtimePayloadRef: String
      artifactStoreRef: String
      dispatchedAt: DateTime
    }

    state Dispatched

    specification "Runtime Dispatch Does Not Select A Compute Node" {
      rule """
        The platform dispatches a training job to an eligible participant runtime agent. Concrete k3s node scheduling is owned by the runtime agent and is reported back as runtime execution evidence.
      """

      scenario "Dispatch Training Runtime To Eligible Participant" {
        given TrainingJobSubmitted {
          trainingJobId = "job-1"
          federationId = "fed-1"
          trainingRunConfigurationId = "config-1"
          featureSchemaId = "schema-1"
        }
        when DispatchTrainingRuntime {
          trainingJobId = "job-1"
          runtimeAgentId = "agent-1"
        }
        then TrainingRuntimeDispatched
      }

      scenario "Reject Dispatch Without Eligible Participant" {
        given TrainingJobSubmitted {
          trainingJobId = "job-1"
          federationId = "fed-1"
          trainingRunConfigurationId = "config-1"
          featureSchemaId = "schema-1"
        }
        when DispatchTrainingRuntime {
          trainingJobId = "job-1"
          runtimeAgentId = "agent-1"
        }
        then reject "Eligible Runtime Participant Required"
      }
    }
  }

  slice RecordTrainingRuntimeStart {
    reactsTo AgentRuntimeJobStarted

    tags {
      trainingJobId
      runtimeAgentId
    }

    automation RecordRuntimeStartWhenAgentStarted {
      on AgentRuntimeJobStarted
      emits RecordTrainingRuntimeStart
    }

    command RecordTrainingRuntimeStart {
      trainingJobId: UUID id technical from AgentRuntimeJobStarted.trainingJobId
      trainingRunConfigurationId: UUID from AgentRuntimeJobStarted.trainingRunConfigurationId
      organizationId: UUID from AgentRuntimeJobStarted.organizationId
      runtimeAgentId: UUID from AgentRuntimeJobStarted.runtimeAgentId
      runtimeInfrastructureId: UUID from AgentRuntimeJobStarted.runtimeInfrastructureId
      runtimeJobId: UUID from AgentRuntimeJobStarted.runtimeJobId
      scheduledNodeId: UUID? from AgentRuntimeJobStarted.scheduledNodeId
      orchestratorNodeName: String? from AgentRuntimeJobStarted.orchestratorNodeName
      featureSchemaId: UUID from AgentRuntimeJobStarted.featureSchemaId
      matchedTrainingDatasetHandle: String? from AgentRuntimeJobStarted.matchedTrainingDatasetHandle
      matchedEvaluationDatasetHandle: String? from AgentRuntimeJobStarted.matchedEvaluationDatasetHandle
      startedAt: DateTime from AgentRuntimeJobStarted.startedAt
    }

    event TrainingRuntimeStarted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID
      runtimeJobId: UUID
      scheduledNodeId: UUID?
      orchestratorNodeName: String?
      featureSchemaId: UUID
      matchedTrainingDatasetHandle: String?
      matchedEvaluationDatasetHandle: String?
      startedAt: DateTime
    }

    state Running
  }
  
  slice RecordTrainingRuntimeCompletion {
    reactsTo AgentRuntimeJobCompleted

    tags {
      trainingJobId
      runtimeAgentId
    }

    automation RecordRuntimeCompletionWhenAgentCompleted {
      on AgentRuntimeJobCompleted
      emits RecordTrainingRuntimeCompletion
    }

    command RecordTrainingRuntimeCompletion {
      trainingJobId: UUID id technical from AgentRuntimeJobCompleted.trainingJobId
      trainingRunConfigurationId: UUID from AgentRuntimeJobCompleted.trainingRunConfigurationId
      organizationId: UUID from AgentRuntimeJobCompleted.organizationId
      runtimeAgentId: UUID from AgentRuntimeJobCompleted.runtimeAgentId
      runtimeInfrastructureId: UUID from AgentRuntimeJobCompleted.runtimeInfrastructureId
      runtimeJobId: UUID from AgentRuntimeJobCompleted.runtimeJobId
      scheduledNodeId: UUID? from AgentRuntimeJobCompleted.scheduledNodeId
      orchestratorNodeName: String? from AgentRuntimeJobCompleted.orchestratorNodeName
      localUpdateArtifactRef: String? from AgentRuntimeJobCompleted.localUpdateArtifactRef
      metricsArtifactRef: String? from AgentRuntimeJobCompleted.metricsArtifactRef
      runtimeStatus: String from AgentRuntimeJobCompleted.runtimeStatus
      completedAt: DateTime from AgentRuntimeJobCompleted.completedAt
    }

    event TrainingRuntimeCompleted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID
      runtimeJobId: UUID
      scheduledNodeId: UUID?
      orchestratorNodeName: String?
      localUpdateArtifactRef: String?
      metricsArtifactRef: String?
      runtimeStatus: String
      completedAt: DateTime
    }

    state Completed
  }

  slice RecordTrainingRuntimeFailure {
    reactsTo AgentRuntimeJobFailed

    tags {
      trainingJobId
      runtimeAgentId
    }

    automation RecordRuntimeFailureWhenAgentFailed {
      on AgentRuntimeJobFailed
      emits RecordTrainingRuntimeFailure
    }

    command RecordTrainingRuntimeFailure {
      trainingJobId: UUID id technical from AgentRuntimeJobFailed.trainingJobId
      trainingRunConfigurationId: UUID from AgentRuntimeJobFailed.trainingRunConfigurationId
      organizationId: UUID from AgentRuntimeJobFailed.organizationId
      runtimeAgentId: UUID from AgentRuntimeJobFailed.runtimeAgentId
      runtimeInfrastructureId: UUID from AgentRuntimeJobFailed.runtimeInfrastructureId
      runtimeJobId: UUID? from AgentRuntimeJobFailed.runtimeJobId
      scheduledNodeId: UUID? from AgentRuntimeJobFailed.scheduledNodeId
      orchestratorNodeName: String? from AgentRuntimeJobFailed.orchestratorNodeName
      failureReason: String from AgentRuntimeJobFailed.failureReason
      failedAt: DateTime from AgentRuntimeJobFailed.failedAt
    }

    event TrainingRuntimeFailed {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID
      runtimeJobId: UUID?
      scheduledNodeId: UUID?
      orchestratorNodeName: String?
      failureReason: String
      failedAt: DateTime
    }

    state Failed
  }

  slice TrainingParticipantEligibility {
    reactsTo TrainingJobSubmitted

    readmodel TrainingParticipantEligibility[] {
      trainingJobId: UUID id
      federationId: UUID
      organizationId: UUID
      runtimeAgentId: UUID?
      runtimeInfrastructureId: UUID?
      featureSchemaId: UUID
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into participant eligibility."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into participant eligibility."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into participant eligibility."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into participant eligibility."
      }
      participantStatus: String
      readinessStatus: String
      availableComputeNodeCount: Int
      healthyComputeNodeCount: Int
      runtimeInfrastructureConnected: Boolean
      runtimeHealthy: Boolean
      resourceSnapshotReady: Boolean
      availableGpuCount: Int?
      matchedDatasetMetadataReady: Boolean
      eligible: Boolean
      eligibilityReason: String?
      ineligibleReasons: String[]
      canDispatchRuntime: Boolean
      canStartRoundContribution: Boolean
      runtimeDispatched: Boolean
      runtimeStarted: Boolean
      runtimeCompleted: Boolean
      lastHeartbeatAt: DateTime?
      lastResourceSnapshotAt: DateTime?
      subscribe FederationCreated
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe TrainingJobSubmitted
      subscribe ParticipantJoined
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe ComputeNodeRegistered
      subscribe ComputeNodeDisabled
      subscribe ComputeNodeEnabled
      subscribe RuntimeInfrastructureConnected
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
      subscribe RuntimeNodeResourcePressureDetected
      subscribe RuntimeNodeCapacityChanged
      subscribe DatasetMetadataReported
      subscribe DatasetContractValidated
      subscribe DatasetApprovedForTraining
      subscribe TrainingRuntimeDispatched
      subscribe TrainingRuntimeStarted
      subscribe TrainingRuntimeCompleted
      subscribe TrainingRuntimeFailed
    }
  }

  slice TrainingRuntimeExecutionCatalog {
    readmodel TrainingRuntimeExecutionCatalog[] {
      trainingJobId: UUID id
      trainingRunConfigurationId: UUID
      organizationId: UUID id
      runtimeAgentId: UUID id
      runtimeInfrastructureId: UUID?
      runtimeJobId: UUID?
      featureSchemaId: UUID
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the runtime execution catalog."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime execution catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the runtime execution catalog."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the runtime execution catalog."
      }
      state: TrainingRuntimeExecution.State
      availableComputeNodeCount: Int?
      availableGpuCount: Int?
      scheduledNodeId: UUID?
      orchestratorNodeName: String?
      matchedTrainingDatasetHandle: String?
      matchedEvaluationDatasetHandle: String?
      runtimeImageRef: String?
      runtimePayloadRef: String?
      artifactStoreRef: String?
      runtimeStatus: String
      localUpdateArtifactRef: String?
      metricsArtifactRef: String?
      failureReason: String?
      dispatchedAt: DateTime?
      startedAt: DateTime?
      completedAt: DateTime?
      failedAt: DateTime?
      subscribe TrainingJobCreated
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe TrainingRuntimeDispatched
      subscribe TrainingRuntimeStarted
      subscribe TrainingRuntimeCompleted
      subscribe TrainingRuntimeFailed
    }
  }

  slice TrackTrainingJobRunning {
    reactsTo TrainingRoundStarted

    automation MarkTrainingJobRunningWhenRoundStarts {
      on TrainingRoundStarted
      emits MarkTrainingJobRunning
    }

    command MarkTrainingJobRunning {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
    }

    event TrainingJobRunning {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
    }

    state Running
  }

  slice PauseTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingJobRunning

    command PauseTrainingJob {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      pauseReason: String
      requestedBy: String
    }

    event TrainingJobPaused {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      pauseReason: String
      requestedBy: String
    }

    state Paused
  }

  slice ResumeTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingJobPaused

    command ResumeTrainingJob {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      resumeReason: String?
      requestedBy: String
    }

    event TrainingJobResumed {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      resumeReason: String?
      requestedBy: String
    }

    state Running
  }

  slice CancelTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingJobRunning

    command CancelTrainingJob {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      cancelReason: String?
    }

    event TrainingJobCanceled {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      cancelReason: String?
    }

    state Canceled
  }

  slice ScheduleNextTrainingRound {
    reactsTo TrainingRoundCompleted

    automation SelectNextRoundParticipantsWhenTrainingShouldContinue {
      condition shouldStartNextRound == true
      emits SelectTrainingRoundParticipants
    }
  }

  slice CompleteTrainingJob {
    reactsTo TrainingRoundCompleted

    automation CompleteJobWhenRoundBudgetExhausted {
      condition currentRoundNumber >= maxRounds
      emits CompleteTrainingJob
    }

    automation CompleteJobWhenGlobalMetricReached {
      condition globalAccuracy >= minimumAccuracy
      emits CompleteTrainingJob
    }

    command CompleteTrainingJob {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      finalRoundId: UUID
      finalModelVersionId: UUID
      stopReason: String
    }

    event TrainingJobCompleted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      finalRoundId: UUID
      finalModelVersionId: UUID
      stopReason: String
    }

    state Completed
  }

  slice TrainingJobDashboard {
    readmodel TrainingJobDashboard[] {
      trainingJobId: UUID id
      federationId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into the training job dashboard."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the training job dashboard."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the training job dashboard."
      }
      objective: String
      targetMetric: String
      strategyName: String?
      aggregationAlgorithm: String?
      secureAggregationRequired: Boolean?
      state: TrainingJob.State
      workflowStage: String
      workflowStep: Int
      nextAction: String?
      availableActions: String[]
      blockedReason: String?
      canSubmit: Boolean
      canStartRound: Boolean
      canPause: Boolean
      canResume: Boolean
      canCancel: Boolean
      canComplete: Boolean
      currentRoundNumber: Int
      startedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      roundProgressPercent: Int
      globalAccuracy: Decimal?
      finalModelVersionId: UUID?
      stopReason: String?
      subscribe FederationCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingJobCreated
      subscribe TrainingJobSubmitted
      subscribe TrainingRuntimeDispatched
      subscribe TrainingRuntimeStarted
      subscribe TrainingJobRunning
      subscribe TrainingJobPaused
      subscribe TrainingJobResumed
      subscribe TrainingJobCanceled
      subscribe TrainingRoundStarted
      subscribe TrainingRoundCompleted
      subscribe TrainingJobCompleted
    }
  }

  concept TrainingJob {
    state Draft
    state Submitted
    state Running
    state Paused
    state Canceled
    state Completed

    slice CreateTrainingJob
    slice SubmitTrainingJob
    slice TrainingParticipantEligibility
    slice TrackTrainingJobRunning
    slice PauseTrainingJob
    slice ResumeTrainingJob
    slice CancelTrainingJob
    slice ScheduleNextTrainingRound
    slice CompleteTrainingJob
    slice TrainingJobDashboard
  }

  concept TrainingRuntimeExecution {
    state Dispatched
    state Running
    state Completed
    state Failed

    slice DispatchTrainingRuntime
    slice RecordTrainingRuntimeStart
    slice RecordTrainingRuntimeCompletion
    slice RecordTrainingRuntimeFailure
    slice TrainingRuntimeExecutionCatalog
  }

  slice SelectTrainingRoundParticipants {
    startsLifecycle
    reactsTo TrainingRuntimeStarted

    automation SelectInitialRoundParticipantsWhenRuntimePoolReady {
      condition startedRuntimeCount >= minimumNodesPerRound
      emits SelectTrainingRoundParticipants
    }

    command SelectTrainingRoundParticipants {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID generated technical
      roundNumber: Int
      minimumNodesPerRound: Int
      startedRuntimeCount: Int
      selectedRuntimeCount: Int
      participantSelectionRef: String
      selectionPolicy: String
      selectedAt: DateTime generated technical
    }

    event TrainingRoundParticipantsSelected {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      minimumNodesPerRound: Int
      startedRuntimeCount: Int
      selectedRuntimeCount: Int
      participantSelectionRef: String
      selectionPolicy: String
      selectedAt: DateTime
    }

    state ParticipantsSelected

    specification "Training Round Participants Are Snapshotted Per Round" {
      rule """
        Each training round starts from a participant snapshot. Runtimes that start after a round has begun cannot join that round, but they can be selected for a later round when the policy allows dynamic round snapshots.
      """

      scenario "Select Participants When Runtime Pool Reaches Quorum" {
        given TrainingRuntimeStarted {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          runtimeAgentId = "agent-1"
        }
        when SelectTrainingRoundParticipants {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundNumber = 1
          minimumNodesPerRound = 3
          startedRuntimeCount = 4
          selectedRuntimeCount = 3
          selectionPolicy = "ROUND_SNAPSHOT"
        }
        then TrainingRoundParticipantsSelected
      }

      scenario "Reject Participant Snapshot Below Quorum" {
        given TrainingRuntimeStarted {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          runtimeAgentId = "agent-1"
        }
        when SelectTrainingRoundParticipants {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundNumber = 1
          minimumNodesPerRound = 3
          startedRuntimeCount = 2
          selectedRuntimeCount = 2
          selectionPolicy = "ROUND_SNAPSHOT"
        }
        then reject "Round Participant Quorum Required"
      }
    }
  }

  slice StartTrainingRound {
    reactsTo TrainingRoundParticipantsSelected

    automation StartRoundWhenParticipantsSelected {
      on TrainingRoundParticipantsSelected
      condition selectedRuntimeCount >= minimumNodesPerRound
      emits StartTrainingRound
    }

    command StartTrainingRound {
      trainingJobId: UUID id technical from TrainingRoundParticipantsSelected.trainingJobId
      trainingRunConfigurationId: UUID from TrainingRoundParticipantsSelected.trainingRunConfigurationId
      featureSchemaId: UUID from TrainingRoundParticipantsSelected.featureSchemaId
      roundId: UUID from TrainingRoundParticipantsSelected.roundId
      roundNumber: Int from TrainingRoundParticipantsSelected.roundNumber
      participantSelectionRef: String from TrainingRoundParticipantsSelected.participantSelectionRef
      selectedRuntimeCount: Int from TrainingRoundParticipantsSelected.selectedRuntimeCount
    }

    event TrainingRoundStarted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      participantSelectionRef: String
      selectedRuntimeCount: Int
    }

    state Running

    specification "Training Round Requires Selected Runtime Quorum" {
      rule """
        A training round can start only from a selected participant snapshot whose selected runtime count satisfies the configured runtime quorum.
      """

      scenario "Start Round With Selected Runtime Quorum" {
        given TrainingRoundParticipantsSelected {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 3
          minimumNodesPerRound = 3
        }
        when StartTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 3
        }
        then TrainingRoundStarted
      }

      scenario "Reject Round Start Below Quorum" {
        given TrainingRoundParticipantsSelected {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 2
          minimumNodesPerRound = 3
        }
        when StartTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 2
        }
        then reject "Selected Runtime Quorum Required"
      }
    }
  }

  slice PublishRoundGlobalModel {
    reactsTo TrainingRoundStarted

    automation PublishRoundGlobalModelWhenRoundStarts {
      on TrainingRoundStarted
      emits PublishRoundGlobalModel
    }

    command PublishRoundGlobalModel {
      trainingJobId: UUID id technical from TrainingRoundStarted.trainingJobId
      trainingRunConfigurationId: UUID from TrainingRoundStarted.trainingRunConfigurationId
      featureSchemaId: UUID from TrainingRoundStarted.featureSchemaId
      roundId: UUID from TrainingRoundStarted.roundId
      roundNumber: Int from TrainingRoundStarted.roundNumber
      participantSelectionRef: String from TrainingRoundStarted.participantSelectionRef
      sourceModelVersionId: UUID derived {
        from TrainingJobSubmitted.initialModelVersionId, TrainingRoundCompleted.aggregatedModelVersionId
        rule "Round one uses the initial model snapshot from the submitted training job; later rounds use the aggregated model from the previous completed round."
      }
      sourceModelArtifactRef: String derived {
        from TrainingJobSubmitted.initialModelArtifactRef, TrainingRoundCompleted.modelArtifactRef
        rule "Publish the artifact reference that selected runtime agents can pull for this round."
      }
      modelRepositoryRef: String derived {
        from TrainingJobSubmitted.initialModelRepositoryRef, TrainingRoundCompleted.modelRepositoryRef
        rule "Publish the model repository reference used by runtime agents for pulling the round model."
      }
      modelFormat: String derived {
        from TrainingJobSubmitted.initialModelFormat, TrainingRoundCompleted.modelFormat
        rule "Publish the model format expected by the runtime engine."
      }
      modelHash: String derived {
        from TrainingJobSubmitted.initialModelHash, TrainingRoundCompleted.modelHash
        rule "Publish the content hash that runtime agents must verify after pulling the model."
      }
      modelSignatureRef: String? derived {
        from TrainingJobSubmitted.initialModelSignatureRef, TrainingRoundCompleted.modelSignatureRef
        rule "Publish the optional model signature reference for provenance verification."
      }
      targetRuntimeCount: Int from TrainingRoundStarted.selectedRuntimeCount
    }

    event RoundGlobalModelPublished {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      participantSelectionRef: String
      sourceModelVersionId: UUID
      sourceModelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      targetRuntimeCount: Int
    }

    state CollectingUpdates
  }

  slice RequestAgentRoundContribution {
    reactsTo RoundGlobalModelPublished

    automation RequestSelectedAgentRoundContribution {
      on RoundGlobalModelPublished
      condition runtimeAgentSelected == true
      emits RequestAgentRoundContribution
    }

    command RequestAgentRoundContribution {
      roundContributionRequestId: UUID id generated technical
      trainingJobId: UUID from RoundGlobalModelPublished.trainingJobId
      trainingRunConfigurationId: UUID from RoundGlobalModelPublished.trainingRunConfigurationId
      featureSchemaId: UUID from RoundGlobalModelPublished.featureSchemaId
      roundId: UUID from RoundGlobalModelPublished.roundId
      roundNumber: Int from RoundGlobalModelPublished.roundNumber
      runtimeAgentId: UUID derived {
        from TrainingRoundParticipantsSelected.participantSelectionRef
        rule "Fan out the round request to each runtime agent contained in the selected participant snapshot."
      }
      organizationId: UUID derived {
        from TrainingRoundParticipantsSelected.participantSelectionRef
        rule "Carry the participant organization for audit without selecting a concrete compute node."
      }
      globalModelVersionId: UUID from RoundGlobalModelPublished.sourceModelVersionId
      globalModelArtifactRef: String from RoundGlobalModelPublished.sourceModelArtifactRef
      modelRepositoryRef: String from RoundGlobalModelPublished.modelRepositoryRef
      modelFormat: String from RoundGlobalModelPublished.modelFormat
      modelHash: String from RoundGlobalModelPublished.modelHash
      modelSignatureRef: String? from RoundGlobalModelPublished.modelSignatureRef
      runtimePayloadRef: String?
      artifactStoreRef: String?
      requestedAt: DateTime generated technical
    }

    event AgentRoundContributionRequested {
      roundContributionRequestId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeAgentId: UUID
      organizationId: UUID
      globalModelVersionId: UUID
      globalModelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      runtimePayloadRef: String?
      artifactStoreRef: String?
      requestedAt: DateTime
    }
  }

  slice SubmitLocalModelUpdate {
    actor RuntimeAgent
    reactsTo AgentLocalModelUpdateSubmitted

    command SubmitLocalModelUpdate {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      agentRoundContributionId: UUID?
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      localUpdateArtifactRef: String?
      trainingLoss: Decimal
    }

    event LocalModelUpdateSubmitted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      agentRoundContributionId: UUID?
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      localUpdateArtifactRef: String?
      trainingLoss: Decimal
    }
  }

  slice RejectPoisonedLocalUpdate {
    actor AggregationRuntime
    reactsTo LocalModelUpdateSubmitted

    command RejectPoisonedLocalUpdate {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      updateArtifactId: UUID
      anomalyScore: Decimal
      rejectionReason: String
    }

    event LocalModelUpdateRejected {
      trainingJobId: UUID id technical from RejectPoisonedLocalUpdate.trainingJobId
      trainingRunConfigurationId: UUID from RejectPoisonedLocalUpdate.trainingRunConfigurationId
      roundId: UUID from RejectPoisonedLocalUpdate.roundId
      nodeId: UUID from RejectPoisonedLocalUpdate.nodeId
      updateArtifactId: UUID from RejectPoisonedLocalUpdate.updateArtifactId
      anomalyScore: Decimal from RejectPoisonedLocalUpdate.anomalyScore
      rejectionReason: String from RejectPoisonedLocalUpdate.rejectionReason
    }

    specification "Poisoned Local Updates Are Excluded" {
      rule """
        A local model update with an anomaly score above the configured policy threshold must be rejected and excluded from secure aggregation quorum counts.
      """

      scenario "Reject Anomalous Update" {
        given LocalModelUpdateSubmitted {
          trainingJobId = "job-1"
          roundId = "round-1"
          nodeId = "node-1"
          updateArtifactId = "artifact-1"
          trainingLoss = 99.0
        }
        when RejectPoisonedLocalUpdate {
          trainingJobId = "job-1"
          roundId = "round-1"
          nodeId = "node-1"
          anomalyScore = 0.98
        }
        then LocalModelUpdateRejected
      }
    }
  }

  slice SubmitLocalModelEvaluation {
    actor RuntimeAgent
    reactsTo AgentLocalModelEvaluationSubmitted

    command SubmitLocalModelEvaluation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      agentRoundContributionId: UUID?
      localModelVersionId: UUID
      featureSchemaId: UUID
      metricsArtifactRef: String?
      localAccuracy: Decimal
      localFairnessScore: Decimal
    }

    event LocalModelEvaluationSubmitted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      agentRoundContributionId: UUID?
      localModelVersionId: UUID
      featureSchemaId: UUID
      metricsArtifactRef: String?
      localAccuracy: Decimal
      localFairnessScore: Decimal
    }
  }

  slice RequestSecureAggregation {
    reactsTo LocalModelEvaluationSubmitted

    automation RequestAggregationWhenEvaluatedUpdatesComplete {
      condition evaluatedUpdateCount >= 3
      emits RequestSecureAggregation
    }

    command RequestSecureAggregation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      evaluatedUpdateCount: Int
      aggregationProvider: String
    }

    event SecureAggregationRequested {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      evaluatedUpdateCount: Int
      aggregationProvider: String
    }

    state Aggregating
  }

  slice CompleteSecureAggregation {
    reactsTo SecureAggregationRequested

    command CompleteSecureAggregation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      requestId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
    }

    event GlobalModelUpdated {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      requestId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
    }

    state EvaluatingGlobalModel
  }

  slice SubmitGlobalModelEvaluation {
    reactsTo GlobalModelUpdated

    command SubmitGlobalModelEvaluation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String from GlobalModelUpdated.modelArtifactRef
      modelRepositoryRef: String from GlobalModelUpdated.modelRepositoryRef
      modelFormat: String from GlobalModelUpdated.modelFormat
      modelHash: String from GlobalModelUpdated.modelHash
      modelSignatureRef: String? from GlobalModelUpdated.modelSignatureRef
      globalAccuracy: Decimal
      globalFairnessScore: Decimal
    }

    event GlobalModelEvaluationSubmitted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      globalAccuracy: Decimal
      globalFairnessScore: Decimal
    }
  }

  slice CompleteTrainingRound {
    reactsTo GlobalModelEvaluationSubmitted

    automation FinishRoundAfterGlobalModelEvaluated {
      on GlobalModelEvaluationSubmitted
      emits CompleteTrainingRound
    }

    command CompleteTrainingRound {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String from GlobalModelEvaluationSubmitted.modelArtifactRef
      modelRepositoryRef: String from GlobalModelEvaluationSubmitted.modelRepositoryRef
      modelFormat: String from GlobalModelEvaluationSubmitted.modelFormat
      modelHash: String from GlobalModelEvaluationSubmitted.modelHash
      modelSignatureRef: String? from GlobalModelEvaluationSubmitted.modelSignatureRef
      globalAccuracy: Decimal
    }

    event TrainingRoundCompleted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
      modelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      globalAccuracy: Decimal
    }

    state Completed

    specification "Training Round Completion Requires Global Evaluation" {
      rule """
        A training round can be completed only after the aggregated global model has been evaluated.
      """

      scenario "Complete Round After Global Evaluation" {
        given GlobalModelEvaluationSubmitted {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
          globalAccuracy = 0.91
        }
        when CompleteTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
          globalAccuracy = 0.91
        }
        then TrainingRoundCompleted
      }

      scenario "Reject Round Completion Without Global Evaluation" {
        given GlobalModelUpdated {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
        }
        when CompleteTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelVersionId = "model-1"
        }
        then reject "Global Model Evaluation Required"
      }
    }
  }

  slice FailTrainingRoundOnQuorumLoss {
    actor AggregationRuntime
    reactsTo LocalModelUpdateRejected

    command FailTrainingRoundOnQuorumLoss {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      failureReason: String
    }

    event TrainingRoundFailed {
      trainingJobId: UUID id technical from FailTrainingRoundOnQuorumLoss.trainingJobId
      trainingRunConfigurationId: UUID from FailTrainingRoundOnQuorumLoss.trainingRunConfigurationId
      featureSchemaId: UUID from FailTrainingRoundOnQuorumLoss.featureSchemaId
      roundId: UUID from FailTrainingRoundOnQuorumLoss.roundId
      selectedRuntimeCount: Int from FailTrainingRoundOnQuorumLoss.selectedRuntimeCount
      minimumNodesPerRound: Int from FailTrainingRoundOnQuorumLoss.minimumNodesPerRound
      failureReason: String from FailTrainingRoundOnQuorumLoss.failureReason
    }

    state Failed
  }

  slice TrainingRoundProgress {
    readmodel TrainingRoundProgress[] {
      trainingJobId: UUID id
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID id
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into round progress."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into round progress."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into round progress."
      }
      roundNumber: Int
      state: TrainingRound.State
      participantSelectionRef: String?
      startedRuntimeCount: Int
      selectedRuntimeCount: Int
      targetRuntimeCount: Int
      submittedUpdateCount: Int
      rejectedUpdateCount: Int
      evaluatedUpdateCount: Int
      pendingUpdateCount: Int
      quorumMet: Boolean
      aggregationReady: Boolean
      evaluationComplete: Boolean
      progressPercent: Int
      currentPhase: String
      nextAction: String?
      blockedReason: String?
      aggregationProvider: String?
      sourceModelVersionId: UUID?
      sourceModelArtifactRef: String?
      modelRepositoryRef: String?
      modelHash: String?
      aggregatedModelVersionId: UUID?
      globalAccuracy: Decimal?
      globalFairnessScore: Decimal?
      failureReason: String?
      subscribe TrainingJobCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingRoundParticipantsSelected
      subscribe TrainingRoundStarted
      subscribe RoundGlobalModelPublished
      subscribe AgentRoundContributionRequested
      subscribe LocalModelUpdateSubmitted
      subscribe LocalModelEvaluationSubmitted
      subscribe LocalModelUpdateRejected
      subscribe SecureAggregationRequested
      subscribe GlobalModelUpdated
      subscribe GlobalModelEvaluationSubmitted
      subscribe TrainingRoundCompleted
      subscribe TrainingRoundFailed
    }
  }

  concept TrainingRound {
    state ParticipantsSelected
    state Running
    state CollectingUpdates
    state Aggregating
    state EvaluatingGlobalModel
    state Completed
    state Failed

    slice SelectTrainingRoundParticipants
    slice StartTrainingRound
    slice PublishRoundGlobalModel
    slice RequestAgentRoundContribution
    slice SubmitLocalModelUpdate
    slice RejectPoisonedLocalUpdate
    slice SubmitLocalModelEvaluation
    slice RequestSecureAggregation
    slice CompleteSecureAggregation
    slice SubmitGlobalModelEvaluation
    slice CompleteTrainingRound
    slice FailTrainingRoundOnQuorumLoss
    slice TrainingRoundProgress
  }
}

context ModelLifecycle {
  note "Model lifecycle starts after training has produced a final evaluated candidate."

  risk "A model can be promoted without a reproducibility package, model card, or approved evaluation report."
  risk "Rollback decisions may lose lineage if previous production versions are not captured."
  metric modelApprovalLeadTime
  metric productionRollbackRate

  slice RegisterCandidateModel {
    startsLifecycle
    reactsTo TrainingJobCompleted

    automation RegisterFinalModelWhenTrainingJobCompleted {
      on TrainingJobCompleted
      emits RegisterCandidateModel
    }

    command RegisterCandidateModel {
      modelVersionId: UUID id technical
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      modelHash: String
      evaluationReportId: UUID
      lineageRef: String
      finalGlobalAccuracy: Decimal
    }

    event ModelCandidateRegistered {
      modelVersionId: UUID id technical
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      modelHash: String
      evaluationReportId: UUID
      lineageRef: String
      finalGlobalAccuracy: Decimal
    }

    state Candidate
  }

  slice RecordModelEvaluationPackage {
    actor GovernanceReviewer
    ui ModelApprovalScreen
    reactsTo ModelCandidateRegistered

    command RecordModelEvaluationPackage {
      modelVersionId: UUID id technical
      trainingJobId: UUID
      evaluationReportId: UUID
      experimentId: UUID
      hyperparameterSnapshotId: UUID
      reproducibilityManifestId: UUID
      modelCardId: UUID
      baselineModelVersionId: UUID?
    }

    event ModelEvaluationPackageRecorded {
      modelVersionId: UUID id technical from RecordModelEvaluationPackage.modelVersionId
      trainingJobId: UUID from RecordModelEvaluationPackage.trainingJobId
      evaluationReportId: UUID from RecordModelEvaluationPackage.evaluationReportId
      experimentId: UUID from RecordModelEvaluationPackage.experimentId
      hyperparameterSnapshotId: UUID from RecordModelEvaluationPackage.hyperparameterSnapshotId
      reproducibilityManifestId: UUID from RecordModelEvaluationPackage.reproducibilityManifestId
      modelCardId: UUID from RecordModelEvaluationPackage.modelCardId
      baselineModelVersionId: UUID? from RecordModelEvaluationPackage.baselineModelVersionId
    }

    state EvaluationPackaged

    specification "Model Approval Requires Evaluation Package" {
      rule """
        A model candidate must have an evaluation report, reproducibility manifest, hyperparameter snapshot, and model card before governance approval.
      """

      scenario "Record Complete Evaluation Package" {
        given ModelCandidateRegistered {
          modelVersionId = "model-1"
          evaluationReportId = "report-1"
        }
        when RecordModelEvaluationPackage {
          modelVersionId = "model-1"
          reproducibilityManifestId = "manifest-1"
          modelCardId = "card-1"
        }
        then ModelEvaluationPackageRecorded
      }
    }
  }

  slice ApproveModel {
    actor GovernanceReviewer
    ui ModelApprovalScreen
    reactsTo ModelEvaluationPackageRecorded

    command ApproveModel {
      modelVersionId: UUID id technical
      approvalNote: String?
    }

    event ModelApproved {
      modelVersionId: UUID id technical
      approvalNote: String?
    }

    state Approved

    specification "Only Evaluation Packaged Models Can Be Approved" {
      rule """
        A model can be approved only after its evaluation package has been recorded.
      """

      scenario "Approve Evaluation Packaged Model" {
        given ModelEvaluationPackageRecorded {
          modelVersionId = "model-1"
          evaluationReportId = "report-1"
          reproducibilityManifestId = "manifest-1"
          modelCardId = "card-1"
        }
        when ApproveModel {
          modelVersionId = "model-1"
        }
        then ModelApproved
      }

      scenario "Reject Candidate Without Evaluation Package" {
        given ModelCandidateRegistered {
          modelVersionId = "model-1"
          evaluationReportId = "report-1"
        }
        when ApproveModel {
          modelVersionId = "model-1"
        }
        then reject "Model Evaluation Package Required"
      }
    }
  }

  slice PromoteModelToProduction {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelApproved

    command PromoteModelToProduction {
      modelVersionId: UUID id technical
      releaseChannel: String
      deploymentTarget: String
    }

    event ModelPromotedToProduction {
      modelVersionId: UUID id technical
      releaseChannel: String
      deploymentTarget: String
    }

    state Production

    specification "Only Approved Models Can Be Promoted To Production" {
      rule """
        A model version can be promoted to production only after governance approval.
      """

      scenario "Promote Approved Model" {
        given ModelApproved {
          modelVersionId = "model-1"
        }
        when PromoteModelToProduction {
          modelVersionId = "model-1"
          releaseChannel = "stable"
          deploymentTarget = "production"
        }
        then ModelPromotedToProduction
      }

      scenario "Reject Unapproved Model Promotion" {
        given ModelEvaluationPackageRecorded {
          modelVersionId = "model-1"
        }
        when PromoteModelToProduction {
          modelVersionId = "model-1"
          releaseChannel = "stable"
          deploymentTarget = "production"
        }
        then reject "Model Approval Required"
      }
    }
  }

  slice RollbackModelVersion {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelPromotedToProduction

    command RollbackModelVersion {
      modelVersionId: UUID id technical
      previousModelVersionId: UUID
      rollbackReason: String
      requestedBy: String
    }

    event ModelVersionRolledBack {
      modelVersionId: UUID id technical
      previousModelVersionId: UUID
      rollbackReason: String
      requestedBy: String
    }

    state RolledBack
  }

  slice RetireModelVersion {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelPromotedToProduction

    command RetireModelVersion {
      modelVersionId: UUID id technical
      retirementReason: String
      requestedBy: String
    }

    event ModelVersionRetired {
      modelVersionId: UUID id technical
      retirementReason: String
      requestedBy: String
    }

    state Retired
  }

  slice ModelVersionCatalog {
    readmodel ModelVersionCatalog[] {
      modelVersionId: UUID id
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the model version catalog."
      }
      modelHash: String
      evaluationReportId: UUID
      lineageRef: String
      finalGlobalAccuracy: Decimal
      state: ModelVersion.State
      releaseChannel: String?
      deploymentTarget: String?
      previousModelVersionId: UUID?
      experimentId: UUID?
      hyperparameterSnapshotId: UUID?
      reproducibilityManifestId: UUID?
      modelCardId: UUID?
      baselineModelVersionId: UUID?
      hasEvaluationPackage: Boolean
      approvalStatus: String
      releaseStatus: String
      isProduction: Boolean
      canRecordEvaluationPackage: Boolean
      canApprove: Boolean
      canPromoteToProduction: Boolean
      canRollback: Boolean
      canRetire: Boolean
      blockedReason: String?
      subscribe TrainingJobCreated
      subscribe ModelCandidateRegistered
      subscribe ModelEvaluationPackageRecorded
      subscribe ModelApproved
      subscribe ModelPromotedToProduction
      subscribe ModelVersionRolledBack
      subscribe ModelVersionRetired
    }
  }

  concept ModelVersion {
    state Candidate
    state EvaluationPackaged
    state Approved
    state Production
    state RolledBack
    state Retired

    slice RegisterCandidateModel
    slice RecordModelEvaluationPackage
    slice ApproveModel
    slice PromoteModelToProduction
    slice RollbackModelVersion
    slice RetireModelVersion
    slice ModelVersionCatalog
  }
}

context RuntimeOperations {
  note "Runtime operations separates low-frequency runtime state changes, node inventory changes, latest telemetry views, training alerts, and append only audit records. High-frequency heartbeat and resource samples are telemetry, not event-sourced domain events."

  risk "Operational alerts without acknowledgement or resolution tracking can hide node degradation during training."
  risk "Audit records without payload hashes and source event classification weaken compliance evidence."
  metric runtimeAlertMeanTimeToAcknowledge
  metric auditTrailCompleteness

  integration ComputeNodeRegistrationSync {
    source RuntimeNodeInventory
    target OrganizationManagement
    reactsTo RuntimeNodeInventoryReported
    emits SyncComputeNodeRegistration
  }

  slice RuntimeTelemetryLatest {
    readmodel RuntimeTelemetryLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID?
      trainingJobId: UUID?
      agentRuntimeJobId: UUID?
      cpuLoad: Decimal?
      gpuLoad: Decimal?
      memoryLoad: Decimal?
      lastHeartbeatAt: DateTime?
      telemetryRetentionPolicy: String
    }
  }

  slice DetectRuntimeAgentOffline {
    startsLifecycle

    automation DetectOfflineRuntimeAgentFromTelemetry {
      condition heartbeatMissingBeyondThreshold == true
      emits DetectRuntimeAgentOffline
    }

    command DetectRuntimeAgentOffline {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      lastHeartbeatAt: DateTime
      offlineDetectedAt: DateTime generated technical
      offlineReason: String
    }

    event RuntimeAgentOfflineDetected {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      lastHeartbeatAt: DateTime
      offlineDetectedAt: DateTime
      offlineReason: String
    }

    state Offline
  }

  slice MarkRuntimeAgentRecovered {
    reactsTo RuntimeAgentOfflineDetected

    automation MarkRecoveredRuntimeAgentFromTelemetry {
      condition heartbeatObservedAfterOffline == true
      emits MarkRuntimeAgentRecovered
    }

    command MarkRuntimeAgentRecovered {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      recoveredAt: DateTime generated technical
      recoveryReason: String?
    }

    event RuntimeAgentRecovered {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      recoveredAt: DateTime
      recoveryReason: String?
    }

    state Healthy
  }

  slice DetectRuntimeNodeResourcePressure {
    startsLifecycle

    automation DetectResourcePressureFromTelemetry {
      condition latestGpuLoad > 95
      emits DetectRuntimeNodeResourcePressure
    }

    command DetectRuntimeNodeResourcePressure {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      trainingJobId: UUID?
      pressureType: String
      observedValue: Decimal
      thresholdValue: Decimal
      detectedAt: DateTime generated technical
    }

    event RuntimeNodeResourcePressureDetected {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      trainingJobId: UUID?
      pressureType: String
      observedValue: Decimal
      thresholdValue: Decimal
      detectedAt: DateTime
    }

    state PressureDetected
  }

  slice RecordRuntimeNodeInventory {
    startsLifecycle
    reactsTo AgentRuntimeNodeInventoryReported

    automation RecordRuntimeNodeInventoryWhenAgentReported {
      on AgentRuntimeNodeInventoryReported
      emits RecordRuntimeNodeInventory
    }

    tags {
      nodeId
      organizationId
      runtimeInfrastructureId
      runtimeAgentId
    }

    command RecordRuntimeNodeInventory {
      nodeId: UUID id technical
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String              // CONTROL_PLANE / WORKER
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      recordedAt: DateTime generated technical
    }

    event RuntimeNodeInventoryReported {
      nodeId: UUID id technical
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      recordedAt: DateTime
    }

    state Reported
  }

  slice RuntimeNodeInventoryView {
    readmodel RuntimeNodeInventoryView[] {
      nodeId: UUID id
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the runtime node inventory view."
      }
      infrastructureName: String? derived {
        from RuntimeInfrastructureRegistered.infrastructureName
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime infrastructure display name into the runtime node inventory view."
      }
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      recordedAt: DateTime
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeNodeInventoryReported
    }
  }

  slice RuntimeNodeResourceLatest {
    readmodel RuntimeNodeResourceLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
      telemetryRetentionPolicy: String
    }
  }

  slice DetectRuntimeNodeCapacityChange {
    startsLifecycle

    automation DetectCapacityChangeFromResourceTelemetry {
      condition allocatableCapacityChanged == true
      emits DetectRuntimeNodeCapacityChange
    }

    command DetectRuntimeNodeCapacityChange {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      previousCapacityHash: String?
      currentCapacityHash: String
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      changedAt: DateTime generated technical
    }

    event RuntimeNodeCapacityChanged {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      previousCapacityHash: String?
      currentCapacityHash: String
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      changedAt: DateTime
    }

    state CapacityChanged
  }

  slice RuntimeHealthDashboard {
    readmodel RuntimeHealthDashboard[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID
      trainingJobId: UUID?
      agentRuntimeJobId: UUID?
      federationName: String? derived {
        from FederationCreated.federationName
        rule "Lookup by federationId and denormalize the federation display name into the runtime health dashboard."
      }
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the runtime health dashboard."
      }
      cpuLoad: Decimal
      gpuLoad: Decimal
      memoryLoad: Decimal
      nodeReady: Boolean?
      availableCpuCores: Int?
      availableMemoryGb: Int?
      availableGpuCount: Int?
      runningPodCount: Int?
      podCapacity: Int?
      healthStatus: String
      lastHeartbeatAt: DateTime
      lastResourceSnapshotAt: DateTime?
      subscribe FederationCreated
      subscribe TrainingJobCreated
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
      subscribe RuntimeNodeResourcePressureDetected
      subscribe RuntimeNodeCapacityChanged
      subscribe RuntimeNodeInventoryReported
      subscribe TrainingAlertRaised
    }
  }

  concept NodeRuntimeHealth {
    state Healthy
    state Offline

    slice RuntimeTelemetryLatest
    slice DetectRuntimeAgentOffline
    slice MarkRuntimeAgentRecovered
    slice RuntimeHealthDashboard
  }

  concept RuntimeNodeResourcePressure {
    state PressureDetected

    slice DetectRuntimeNodeResourcePressure
  }

  concept RuntimeNodeCapacity {
    state CapacityChanged

    slice DetectRuntimeNodeCapacityChange
  }

  concept RuntimeNodeInventory {
    state Reported

    slice RecordRuntimeNodeInventory
    slice RuntimeNodeInventoryView
  }

  concept RuntimeNodeResourceTelemetry {
    slice RuntimeNodeResourceLatest
  }

  slice RaiseTrainingAlert {
    startsLifecycle
    reactsTo RuntimeNodeResourcePressureDetected

    automation RaiseAlertOnNodeResourcePressure {
      on RuntimeNodeResourcePressureDetected
      emits RaiseTrainingAlert
    }

    command RaiseTrainingAlert {
      alertId: UUID id generated technical
      nodeId: UUID from RuntimeNodeResourcePressureDetected.nodeId
      trainingJobId: UUID? from RuntimeNodeResourcePressureDetected.trainingJobId
      severity: String
      message: String
    }

    event TrainingAlertRaised {
      alertId: UUID id technical
      nodeId: UUID
      trainingJobId: UUID?
      severity: String
      message: String
    }

    state Raised
  }

  slice TrainingAlertCatalog {
    readmodel TrainingAlertCatalog[] {
      alertId: UUID id
      nodeId: UUID
      trainingJobId: UUID?
      orchestratorNodeName: String? derived {
        from RuntimeNodeInventoryReported.orchestratorNodeName
        rule "Lookup by nodeId and denormalize the runtime node display name into the training alert catalog."
      }
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the training alert catalog."
      }
      severity: String
      message: String
      state: TrainingAlert.State
      subscribe RuntimeNodeInventoryReported
      subscribe TrainingJobCreated
      subscribe TrainingAlertRaised
    }
  }

  concept TrainingAlert {
    state Raised

    slice RaiseTrainingAlert
    slice TrainingAlertCatalog
  }

  slice AppendAuditTrail {
    startsLifecycle
    reactsTo TrainingAlertRaised

    automation AuditCriticalTrainingEvents {
      on TrainingAlertRaised
      emits AppendAuditTrail
    }

    automation AuditFederationActivated {
      on FederationActivated
      emits AppendAuditTrail
    }

    automation AuditFederationSuspended {
      on FederationSuspended
      emits AppendAuditTrail
    }

    automation AuditFederationReactivated {
      on FederationReactivated
      emits AppendAuditTrail
    }

    automation AuditParticipantJoined {
      on ParticipantJoined
      emits AppendAuditTrail
    }

    automation AuditParticipantSuspended {
      on ParticipantSuspended
      emits AppendAuditTrail
    }

    automation AuditDatasetApproval {
      on DatasetApprovedForTraining
      emits AppendAuditTrail
    }

    automation AuditDatasetApprovalRevoked {
      on DatasetTrainingApprovalRevoked
      emits AppendAuditTrail
    }

    automation AuditTrainingJobSubmitted {
      on TrainingJobSubmitted
      emits AppendAuditTrail
    }

    automation AuditModelPromotedToProduction {
      on ModelPromotedToProduction
      emits AppendAuditTrail
    }

    automation AuditComputeNodeDisabled {
      on ComputeNodeDisabled
      emits AppendAuditTrail
    }

    automation AuditComputeNodeEnabled {
      on ComputeNodeEnabled
      emits AppendAuditTrail
    }

    command AppendAuditTrail {
      auditRecordId: UUID id generated technical
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
    }

    event AuditTrailAppended {
      auditRecordId: UUID id technical
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
    }

    state Appended
  }

  slice AuditRecordLog {
    readmodel AuditRecordLog[] {
      auditRecordId: UUID id
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
      subscribe AuditTrailAppended
    }
  }

  concept AuditRecord {
    state Appended

    slice AppendAuditTrail
    slice AuditRecordLog
  }
}
context KeyAndAttestationManagement {
    note "Key and attestation management owns node attestation reports and secure aggregation key material. Dataset access credentials remain inside runtime agent infrastructure."

    risk "Expired attestation or revoked key material can allow an unsafe node to continue participating in training."
    risk "Secure aggregation key compromise can expose participant updates or invalidate aggregation results."
    metric attestationVerificationFailureRate
    metric keyRotationLeadTime

  slice GenerateNodeKey {
    startsLifecycle
    actor SecurityReviewer
    ui NodeKeyManagementScreen
    reactsTo ComputeNodeRegistered

    command GenerateNodeKey {
      nodeKeyId: UUID id generated technical
      nodeId: UUID
      keyAlgorithm: String
      keyPurpose: String
      publicKeyRef: String
      keyExpiresAt: DateTime
    }

    event NodeKeyGenerated {
      nodeKeyId: UUID id technical
      nodeId: UUID
      keyAlgorithm: String
      keyPurpose: String
      publicKeyRef: String
      keyExpiresAt: DateTime
    }

    state Generated
  }

  slice DistributeNodeKey {
    reactsTo NodeKeyGenerated

    automation DistributeKeyWhenGenerated {
      on NodeKeyGenerated
      emits DistributeNodeKey
    }

    command DistributeNodeKey {
      nodeKeyId: UUID id technical
      nodeId: UUID
      distributionChannel: String
      deliveredAt: DateTime
    }

    event NodeKeyDistributed {
      nodeKeyId: UUID id technical
      nodeId: UUID
      distributionChannel: String
      deliveredAt: DateTime
    }

    state Distributed
  }

  slice ActivateNodeKey {
    actor NodeOperator
    ui NodeKeyManagementScreen
    reactsTo NodeKeyDistributed

    command ActivateNodeKey {
      nodeKeyId: UUID id technical
      nodeId: UUID
      activationNote: String?
    }

    event NodeKeyActivated {
      nodeKeyId: UUID id technical
      nodeId: UUID
      activationNote: String?
    }

    state Active
  }

  slice RevokeNodeKey {
    actor SecurityReviewer
    ui NodeKeyManagementScreen
    reactsTo NodeKeyActivated

    command RevokeNodeKey {
      nodeKeyId: UUID id technical
      nodeId: UUID
      revocationReason: String
    }

    event NodeKeyRevoked {
      nodeKeyId: UUID id technical
      nodeId: UUID
      revocationReason: String
    }

    state Revoked
  }

  slice ExpireNodeKey {
    reactsTo NodeKeyActivated

    automation ExpireNodeKeyWhenPastExpiry {
      condition keyExpiresAt < now
      emits ExpireNodeKey
    }

    command ExpireNodeKey {
      nodeKeyId: UUID id technical
      nodeId: UUID
      expiredAt: DateTime
    }

    event NodeKeyExpired {
      nodeKeyId: UUID id technical
      nodeId: UUID
      expiredAt: DateTime
    }

    state Expired
  }

  slice NodeKeyCatalog {
    readmodel NodeKeyCatalog[] {
      nodeKeyId: UUID id
      nodeId: UUID
      orchestratorNodeName: String? derived {
        from ComputeNodeRegistered.orchestratorNodeName
        rule "Lookup by nodeId and denormalize the compute node display name into the node key catalog."
      }
      keyAlgorithm: String
      keyPurpose: String
      publicKeyRef: String
      keyExpiresAt: DateTime
      state: NodeEncryptionKey.State
      revokedReason: String?
      expiredAt: DateTime?
      subscribe ComputeNodeRegistered
      subscribe NodeKeyGenerated
      subscribe NodeKeyDistributed
      subscribe NodeKeyActivated
      subscribe NodeKeyRevoked
      subscribe NodeKeyExpired
    }
  }

  concept NodeEncryptionKey {
    state Generated
    state Distributed
    state Active
    state Revoked
    state Expired

    slice GenerateNodeKey
    slice DistributeNodeKey
    slice ActivateNodeKey
    slice RevokeNodeKey
    slice ExpireNodeKey
    slice NodeKeyCatalog
  }
  
    slice SubmitNodeAttestationReport {
      startsLifecycle
      actor NodeOperator
      ui NodeAttestationSubmissionScreen
      reactsTo ComputeNodeRegistered

      command SubmitNodeAttestationReport {
        attestationReportId: UUID id generated technical
        nodeId: UUID
        attestationType: String
        hardwareFingerprint: String
        measurementHash: String
        signedBy: String
        submittedAt: DateTime
        expiresAt: DateTime
      }

      event NodeAttestationReportSubmitted {
        attestationReportId: UUID id technical
        nodeId: UUID
        attestationType: String
        hardwareFingerprint: String
        measurementHash: String
        signedBy: String
        submittedAt: DateTime
        expiresAt: DateTime
      }

      state Submitted
    }

    slice VerifyNodeAttestationReport {
      actor SecurityReviewer
      ui NodeAttestationReviewScreen
      reactsTo NodeAttestationReportSubmitted

      command VerifyNodeAttestationReport {
        attestationReportId: UUID id technical
        nodeId: UUID
        verificationOutcome: String
        verificationNote: String?
      }

      event NodeAttestationReportVerified {
        attestationReportId: UUID id technical
        nodeId: UUID
        verificationOutcome: String
        verificationNote: String?
        verifiedAt: DateTime
      }

      state Verified
    }

    slice ExpireNodeAttestationReport {
      reactsTo NodeAttestationReportVerified

      automation ExpireAttestationWhenPastExpiry {
        condition expiresAt < now
        emits ExpireNodeAttestationReport
      }

      command ExpireNodeAttestationReport {
        attestationReportId: UUID id technical
        nodeId: UUID
        expiredAt: DateTime
      }

      event NodeAttestationReportExpired {
        attestationReportId: UUID id technical
        nodeId: UUID
        expiredAt: DateTime
      }

      state Expired
    }

    slice RevokeNodeAttestationReport {
      actor SecurityReviewer
      ui NodeAttestationReviewScreen
      reactsTo NodeAttestationReportVerified

      command RevokeNodeAttestationReport {
        attestationReportId: UUID id technical
        nodeId: UUID
        revokeReason: String
      }

      event NodeAttestationReportRevoked {
        attestationReportId: UUID id technical
        nodeId: UUID
        revokeReason: String
      }

      state Revoked
    }

    slice QuarantineNodeAfterAttestationFailure {
      actor SecurityReviewer
      ui NodeAttestationReviewScreen confirm
      reactsTo NodeAttestationReportRevoked

      command QuarantineNodeAfterAttestationFailure {
        attestationReportId: UUID id technical
        nodeId: UUID
        quarantineReason: String
        quarantinedBy: String
      }

      event NodeQuarantined {
        attestationReportId: UUID id technical from QuarantineNodeAfterAttestationFailure.attestationReportId
        nodeId: UUID from QuarantineNodeAfterAttestationFailure.nodeId
        quarantineReason: String from QuarantineNodeAfterAttestationFailure.quarantineReason
        quarantinedBy: String from QuarantineNodeAfterAttestationFailure.quarantinedBy
      }

      state Quarantined

      specification "Revoked Attestation Quarantines Node" {
        rule """
          Nodes with revoked attestation reports must be quarantined before they can be considered for future training participation.
        """

        scenario "Quarantine Revoked Attestation Node" {
          given NodeAttestationReportRevoked {
            attestationReportId = "att-1"
            nodeId = "node-1"
          }
          when QuarantineNodeAfterAttestationFailure {
            attestationReportId = "att-1"
            nodeId = "node-1"
          }
          then NodeQuarantined
        }
      }
    }

    slice NodeAttestationCatalog {
      readmodel NodeAttestationCatalog[] {
        attestationReportId: UUID id
        nodeId: UUID
        orchestratorNodeName: String? derived {
          from ComputeNodeRegistered.orchestratorNodeName
          rule "Lookup by nodeId and denormalize the compute node display name into the node attestation catalog."
        }
        attestationType: String
        verificationOutcome: String?
        verifiedAt: DateTime?
        submittedAt: DateTime
        expiresAt: DateTime
        state: NodeAttestationReport.State
        subscribe ComputeNodeRegistered
        subscribe NodeAttestationReportSubmitted
        subscribe NodeAttestationReportVerified
        subscribe NodeAttestationReportExpired
        subscribe NodeAttestationReportRevoked
        subscribe NodeQuarantined
      }
    }

    concept NodeAttestationReport {
      state Submitted
      state Verified
      state Expired
      state Revoked
      state Quarantined

      slice SubmitNodeAttestationReport
      slice VerifyNodeAttestationReport
      slice ExpireNodeAttestationReport
      slice RevokeNodeAttestationReport
      slice QuarantineNodeAfterAttestationFailure
      slice NodeAttestationCatalog
    }
  
    slice GenerateSecureAggregationKey {
      startsLifecycle
      actor MLOpsEngineer
      ui SecureAggregationKeyScreen
      reactsTo TrainingJobSubmitted

      command GenerateSecureAggregationKey {
        aggregationKeyId: UUID id generated technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        aggregationAlgorithm: String
        keyAlgorithm: String
        shareCount: Int
        quorumThreshold: Int
        generatedAt: DateTime
        expiresAt: DateTime
      }

      event SecureAggregationKeyGenerated {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        aggregationAlgorithm: String
        keyAlgorithm: String
        shareCount: Int
        quorumThreshold: Int
        generatedAt: DateTime
        expiresAt: DateTime
      }

      state Generated
    }

    slice DistributeKeyShare {
      actor MLOpsEngineer
      ui SecureAggregationKeyScreen
      reactsTo SecureAggregationKeyGenerated

      command DistributeKeyShare {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        nodeId: UUID
        shareIndex: Int
        shareMaterialRef: String
        distributedAt: DateTime
      }

      event SecureAggregationKeyShareDistributed {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        nodeId: UUID
        shareIndex: Int
        shareMaterialRef: String
        distributedAt: DateTime
      }

      state Distributed
    }

    slice MarkSecureAggregationKeyUsed {
      reactsTo GlobalModelUpdated

      automation MarkKeyUsedWhenAggregationCompletes {
        condition aggregatedModelVersionId != null
        emits MarkSecureAggregationKeyUsed
      }

      command MarkSecureAggregationKeyUsed {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        roundId: UUID
        usedAt: DateTime
      }

      event SecureAggregationKeyUsed {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        roundId: UUID
        usedAt: DateTime
      }

      state Used
    }

    slice RevokeSecureAggregationKey {
      actor SecurityReviewer
      ui SecureAggregationKeyScreen
      reactsTo SecureAggregationKeyGenerated

      command RevokeSecureAggregationKey {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        revokeReason: String
      }

      event SecureAggregationKeyRevoked {
        aggregationKeyId: UUID id technical
        trainingJobId: UUID
        revokeReason: String
      }

      state Revoked
    }

    slice SecureAggregationKeyCatalog {
      readmodel SecureAggregationKeyCatalog[] {
        aggregationKeyId: UUID id
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        trainingJobObjective: String? derived {
          from TrainingJobCreated.objective
          rule "Lookup by trainingJobId and denormalize the training job objective into the secure aggregation key catalog."
        }
        trainingStrategyName: String? derived {
          from TrainingRunConfigurationDefined.strategyName
          rule "Lookup by trainingRunConfigurationId and denormalize the strategy name into the secure aggregation key catalog."
        }
        aggregationAlgorithm: String
        keyAlgorithm: String
        shareCount: Int
        quorumThreshold: Int
        state: SecureAggregationKey.State
        generatedAt: DateTime
        expiresAt: DateTime
        subscribe TrainingJobCreated
        subscribe TrainingRunConfigurationDefined
        subscribe SecureAggregationKeyGenerated
        subscribe SecureAggregationKeyShareDistributed
        subscribe SecureAggregationKeyUsed
        subscribe SecureAggregationKeyRevoked
      }
    }

    concept SecureAggregationKey {
      state Generated
      state Distributed
      state Used
      state Revoked

      slice GenerateSecureAggregationKey
      slice DistributeKeyShare
      slice MarkSecureAggregationKeyUsed
      slice RevokeSecureAggregationKey
      slice SecureAggregationKeyCatalog
    }

  slice InitializeSecureAggregationRound {
    startsLifecycle
    reactsTo SecureAggregationRequested

    automation InitializeAggregationRoundWhenRequested {
      on SecureAggregationRequested
      emits InitializeSecureAggregationRound
    }

    command InitializeSecureAggregationRound {
      aggregationRoundId: UUID id generated technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      aggregationProvider: String
      shareAlgorithm: String
    }

    event SecureAggregationRoundInitialized {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      aggregationProvider: String
      shareAlgorithm: String
    }

    state Initialized
  }

  slice DistributeAggregationMaskShares {
    actor SecureAggregationService
    reactsTo SecureAggregationRoundInitialized

    command DistributeAggregationMaskShares {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      nodeId: UUID
      maskShareArtifactId: UUID
    }

    event AggregationMaskShareDistributed {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      nodeId: UUID
      maskShareArtifactId: UUID
    }

    state SharesDistributed
  }

  slice CollectAggregationMaskShares {
    actor SecureAggregationService
    reactsTo AggregationMaskShareDistributed

    command CollectAggregationMaskShares {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      collectedNodeCount: Int
    }

    event AggregationMaskSharesCollected {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      collectedNodeCount: Int
    }

    state SharesCollected
  }

  slice CompleteSecureAggregationDecrypt {
    reactsTo AggregationMaskSharesCollected

    automation CompleteDecryptionWhenSharesReady {
      condition collectedNodeCount >= 3
      emits CompleteSecureAggregationDecrypt
    }

    command CompleteSecureAggregationDecrypt {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
    }

    event SecureAggregationDecrypted {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      aggregatedModelVersionId: UUID
    }

    state Aggregated
  }

  slice RevokeSecureAggregationRound {
    actor SecurityReviewer
    ui SecureAggregationScreen
    reactsTo SecureAggregationRoundInitialized

    command RevokeSecureAggregationRound {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      revocationReason: String
    }

    event SecureAggregationRoundRevoked {
      aggregationRoundId: UUID id technical
      trainingJobId: UUID
      roundId: UUID
      revocationReason: String
    }

    state Revoked
  }

  slice SecureAggregationRoundCatalog {
    readmodel SecureAggregationRoundCatalog[] {
      aggregationRoundId: UUID id
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the secure aggregation round catalog."
      }
      trainingStrategyName: String? derived {
        from TrainingRunConfigurationDefined.strategyName
        rule "Lookup by trainingRunConfigurationId and denormalize the strategy name into the secure aggregation round catalog."
      }
      aggregationProvider: String
      shareAlgorithm: String
      collectedNodeCount: Int
      aggregatedModelVersionId: UUID?
      state: SecureAggregationRound.State
      revocationReason: String?
      subscribe TrainingJobCreated
      subscribe TrainingRunConfigurationDefined
      subscribe SecureAggregationRoundInitialized
      subscribe AggregationMaskShareDistributed
      subscribe AggregationMaskSharesCollected
      subscribe SecureAggregationDecrypted
      subscribe SecureAggregationRoundRevoked
    }
  }

  concept SecureAggregationRound {
    state Initialized
    state SharesDistributed
    state SharesCollected
    state Aggregated
    state Revoked

    slice InitializeSecureAggregationRound
    slice DistributeAggregationMaskShares
    slice CollectAggregationMaskShares
    slice CompleteSecureAggregationDecrypt
    slice RevokeSecureAggregationRound
    slice SecureAggregationRoundCatalog
  }
  }
  deployment FLDictionaryBackend {
    includes DictionaryMaintenance
  }

  deployment FLPlatformBackend {
    includes OrganizationManagement
    includes FederationManagement
    includes DatasetGovernance
    includes ModelRepository
    includes TrainingOrchestration
    includes ModelLifecycle
    includes RuntimeOperations
    includes KeyAndAttestationManagement
    includes RuntimeOnboarding
  }

  deployment FLRuntimeAgent {
    includes RuntimeAgentOperations
  }

  context RuntimeAgentOperations {
    note "Runtime agent operations is a separate deployable that runs inside participant infrastructure and executes dispatched training jobs with local data and local secrets."

    risk "Agent jobs can leak local credentials if secret references are materialized outside the participant boundary."
    risk "Runtime engine jobs can remain running after platform cancellation unless local job lifecycle is tracked explicitly."
    metric agentRuntimeJobFailureRate
    metric agentRuntimeJobStartupLatency

    integration TrainingRuntimeEngine {
      source AgentRuntimeJob
      target RuntimeEngine
      reactsTo AgentRuntimeJobStarted
      emits CompleteAgentRuntimeJob
      emits FailAgentRuntimeJob
    }

    integration RoundRuntimeEngine {
      source AgentRoundContribution
      target RuntimeEngine
      reactsTo AgentRoundContributionStarted
      emits SubmitAgentLocalModelUpdate
      emits SubmitAgentLocalModelEvaluation
    }

    integration PlatformTrainingOrchestration {
      source AgentRuntimeJob
      target TrainingOrchestration
      reactsTo AgentRuntimeJobStarted
      emits RecordTrainingRuntimeStart
      reactsTo AgentRuntimeJobCompleted
      emits RecordTrainingRuntimeCompletion
    }

    integration PlatformTrainingFailureReporting {
      source AgentRuntimeJob
      target TrainingOrchestration
      reactsTo AgentRuntimeJobFailed
      emits RecordTrainingRuntimeFailure
    }

    integration PlatformDatasetMetadataReporting {
      source AgentDatasetMetadata
      target DatasetGovernance
      reactsTo AgentDatasetMetadataReported
      emits RecordRuntimeDatasetMetadata
    }

    integration PlatformDatasetAccessValidationReporting {
      source AgentDatasetAccessValidation
      target DatasetGovernance
      reactsTo AgentDatasetAccessValidated
      emits CompleteRuntimeDatasetAccessValidation
    }

    integration PlatformRoundUpdateReporting {
      source AgentRoundContribution
      target TrainingOrchestration
      reactsTo AgentLocalModelUpdateSubmitted
      emits SubmitLocalModelUpdate
    }

    integration PlatformRoundEvaluationReporting {
      source AgentRoundContribution
      target TrainingOrchestration
      reactsTo AgentLocalModelEvaluationSubmitted
      emits SubmitLocalModelEvaluation
    }

    integration PlatformRuntimeInfrastructureConnectionReporting {
      source AgentRuntimeInfrastructureConnection
      target RuntimeOnboarding
      reactsTo AgentRuntimeInfrastructureConnectionReported
      emits ReportRuntimeInfrastructureConnected
    }

    integration PlatformRuntimeNodeInventoryReporting {
      source AgentRuntimeNodeInventory
      target RuntimeOperations
      reactsTo AgentRuntimeNodeInventoryReported
      emits RecordRuntimeNodeInventory
    }

  slice RegisterAgentDataConnector {
    startsLifecycle
    actor RuntimeAgent
    reactsTo RuntimeInfrastructureConnected

    automation RegisterConnectorWhenRuntimeConnected {
      on RuntimeInfrastructureConnected
      emits RegisterAgentDataConnector
    }

    command RegisterAgentDataConnector {
      dataConnectorId: UUID id generated technical
      runtimeAgentId: UUID
      connectorName: String
      connectorType: String
      connectorRef: String
      credentialRef: String
      secretRefType: String
      storageLocationRef: String
      supportedDataFormats: String[]
      agentConnectorHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
    }

    event AgentDataConnectorRegistered {
      dataConnectorId: UUID id technical
      runtimeAgentId: UUID
      connectorName: String
      connectorType: String
      connectorRef: String
      credentialRef: String
      secretRefType: String
      storageLocationRef: String
      supportedDataFormats: String[]
      agentConnectorHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      registeredAt: DateTime
    }

    state Registered
  }

  slice AgentDataConnectorCatalog {
    readmodel AgentDataConnectorCatalog[] {
      dataConnectorId: UUID id
      runtimeAgentId: UUID
      connectorName: String
      connectorType: String
      connectorRef: String
      credentialRef: String
      secretRefType: String
      storageLocationRef: String
      supportedDataFormats: String[]
      agentConnectorHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      registeredAt: DateTime
      subscribe AgentDataConnectorRegistered
    }
  }

  concept AgentDataConnector {
    state Registered

    slice RegisterAgentDataConnector
    slice AgentDataConnectorCatalog
  }

  slice ProbeAgentDataConnectorAccess {
    startsLifecycle
    reactsTo AgentDataConnectorRegistered

    automation ProbeConnectorAccessAfterRegistration {
      on AgentDataConnectorRegistered
      emits ProbeAgentDataConnectorAccess
    }

    command ProbeAgentDataConnectorAccess {
      agentDataConnectorProbeId: UUID id generated technical
      dataConnectorId: UUID
      runtimeAgentId: UUID
      validationMode: String
    }

    event AgentDataConnectorAccessProbed {
      agentDataConnectorProbeId: UUID id technical
      dataConnectorId: UUID
      runtimeAgentId: UUID
      readable: Boolean
      writable: Boolean
      validationReportId: UUID
      verifiedAt: DateTime
    }

    state Probed
  }

  slice AgentDataConnectorAccessProbeCatalog {
    readmodel AgentDataConnectorAccessProbeCatalog[] {
      agentDataConnectorProbeId: UUID id
      dataConnectorId: UUID
      runtimeAgentId: UUID
      connectorName: String? derived {
        from AgentDataConnectorRegistered.connectorName
        rule "Lookup by dataConnectorId and denormalize the data connector display name into the access probe catalog."
      }
      readable: Boolean
      writable: Boolean
      validationReportId: UUID
      verifiedAt: DateTime
      subscribe AgentDataConnectorRegistered
      subscribe AgentDataConnectorAccessProbed
    }
  }

  concept AgentDataConnectorAccessProbe {
    state Probed

    slice ProbeAgentDataConnectorAccess
    slice AgentDataConnectorAccessProbeCatalog
  }

  slice ConfigureAgentDatasetAccessProfile {
    startsLifecycle
    actor NodeOperator
    ui AgentDatasetAccessProfileScreen
    reactsTo AgentDataConnectorRegistered

    command ConfigureAgentDatasetAccessProfile {
      agentDatasetAccessProfileId: UUID id generated technical
      datasetId: UUID
      runtimeAgentId: UUID
      dataConnectorId: UUID
      agentDatasetHandle: String
      agentDataAccessHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      dataFormat: String
      readerPlugin: String
      readMode: String
      materializationMode: String
      configuredAt: DateTime generated technical
    }

    event AgentDatasetAccessProfileConfigured {
      agentDatasetAccessProfileId: UUID id technical
      datasetId: UUID
      runtimeAgentId: UUID
      dataConnectorId: UUID
      agentDatasetHandle: String
      agentDataAccessHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      dataFormat: String
      readerPlugin: String
      readMode: String
      materializationMode: String
      configuredAt: DateTime
    }

    state Configured
  }

  slice AgentDatasetAccessProfileCatalog {
    readmodel AgentDatasetAccessProfileCatalog[] {
      agentDatasetAccessProfileId: UUID id
      datasetId: UUID
      runtimeAgentId: UUID
      dataConnectorId: UUID
      datasetName: String? derived {
        from DatasetRegistered.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the agent dataset access profile catalog."
      }
      connectorName: String? derived {
        from AgentDataConnectorRegistered.connectorName
        rule "Lookup by dataConnectorId and denormalize the data connector display name into the agent dataset access profile catalog."
      }
      agentDatasetHandle: String
      agentDataAccessHandle: String
      localConnectionConfigRef: String?
      localCredentialRef: String?
      localMountPath: String?
      dataFormat: String
      readerPlugin: String
      readMode: String
      materializationMode: String
      configuredAt: DateTime
      subscribe DatasetRegistered
      subscribe AgentDataConnectorRegistered
      subscribe AgentDatasetAccessProfileConfigured
    }
  }

  concept AgentDatasetAccessProfile {
    state Configured

    slice ConfigureAgentDatasetAccessProfile
    slice AgentDatasetAccessProfileCatalog
  }

  slice ProfileAgentDataset {
    startsLifecycle
    reactsTo DatasetProfilingRequested

    automation ProfileDatasetWhenRequested {
      on DatasetProfilingRequested
      emits ProfileAgentDataset
    }

    command ProfileAgentDataset {
      metadataReportId: UUID id generated technical
      datasetId: UUID from DatasetProfilingRequested.datasetId
      organizationId: UUID from DatasetProfilingRequested.organizationId
      runtimeAgentId: UUID from DatasetProfilingRequested.runtimeAgentId
      featureSchemaId: UUID from DatasetProfilingRequested.featureSchemaId
      labelSchemaId: UUID from DatasetProfilingRequested.labelSchemaId
      agentDatasetHandle: String from DatasetProfilingRequested.agentDatasetHandle
      profilingProfile: String? from DatasetProfilingRequested.profilingProfile
    }

    event AgentDatasetMetadataReported {
      metadataReportId: UUID id technical
      datasetId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      labelSchemaId: UUID
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean
      labelCompatible: Boolean
      missingValueRate: Decimal
      duplicateRate: Decimal
      qualityScore: Decimal
      nonIidScore: Decimal
      classBalanceScore: Decimal?
      statisticsRef: String?
      profiledAt: DateTime
    }

    state Reported
  }

  slice AgentDatasetMetadataCatalog {
    readmodel AgentDatasetMetadataCatalog[] {
      metadataReportId: UUID id
      datasetId: UUID
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      labelSchemaId: UUID
      datasetName: String? derived {
        from DatasetRegistered.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the agent dataset metadata catalog."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the agent dataset metadata catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the agent dataset metadata catalog."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the agent dataset metadata catalog."
      }
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean
      labelCompatible: Boolean
      missingValueRate: Decimal
      duplicateRate: Decimal
      qualityScore: Decimal
      nonIidScore: Decimal
      classBalanceScore: Decimal?
      statisticsRef: String?
      profiledAt: DateTime
      subscribe DatasetRegistered
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe AgentDatasetMetadataReported
    }
  }

  concept AgentDatasetMetadata {
    state Reported

    slice ProfileAgentDataset
    slice AgentDatasetMetadataCatalog
  }

  slice ValidateAgentDatasetAccess {
    startsLifecycle
    reactsTo DatasetAccessValidationRequested

    automation ValidateDatasetAccessWhenRequested {
      on DatasetAccessValidationRequested
      emits ValidateAgentDatasetAccess
    }

    command ValidateAgentDatasetAccess {
      datasetAccessValidationId: UUID id technical from DatasetAccessValidationRequested.datasetAccessValidationId
      datasetId: UUID from DatasetAccessValidationRequested.datasetId
      runtimeAgentId: UUID from DatasetAccessValidationRequested.runtimeAgentId
      agentDatasetHandle: String from DatasetAccessValidationRequested.agentDatasetHandle
      validationMode: String from DatasetAccessValidationRequested.validationMode
    }

    event AgentDatasetAccessValidated {
      datasetAccessValidationId: UUID id technical
      datasetId: UUID
      runtimeAgentId: UUID
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationReportId: UUID
      validatedAt: DateTime
    }

    state Validated
  }

  slice AgentDatasetAccessValidationCatalog {
    readmodel AgentDatasetAccessValidationCatalog[] {
      datasetAccessValidationId: UUID id
      datasetId: UUID
      runtimeAgentId: UUID
      datasetName: String? derived {
        from DatasetRegistered.datasetName
        rule "Lookup by datasetId and denormalize the dataset display name into the agent dataset access validation catalog."
      }
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationReportId: UUID
      validatedAt: DateTime
      subscribe DatasetRegistered
      subscribe AgentDatasetAccessValidated
    }
  }

  concept AgentDatasetAccessValidation {
    state Validated

    slice ValidateAgentDatasetAccess
    slice AgentDatasetAccessValidationCatalog
  }

  slice PullRoundGlobalModel {
    startsLifecycle
    reactsTo AgentRoundContributionRequested

    automation PullRoundGlobalModelWhenContributionRequested {
      on AgentRoundContributionRequested
      emits PullRoundGlobalModel
    }

    command PullRoundGlobalModel {
      agentRoundContributionId: UUID id generated technical
      roundContributionRequestId: UUID from AgentRoundContributionRequested.roundContributionRequestId
      trainingJobId: UUID from AgentRoundContributionRequested.trainingJobId
      trainingRunConfigurationId: UUID from AgentRoundContributionRequested.trainingRunConfigurationId
      roundId: UUID from AgentRoundContributionRequested.roundId
      roundNumber: Int from AgentRoundContributionRequested.roundNumber
      organizationId: UUID from AgentRoundContributionRequested.organizationId
      runtimeAgentId: UUID from AgentRoundContributionRequested.runtimeAgentId
      featureSchemaId: UUID from AgentRoundContributionRequested.featureSchemaId
      globalModelVersionId: UUID from AgentRoundContributionRequested.globalModelVersionId
      globalModelArtifactRef: String from AgentRoundContributionRequested.globalModelArtifactRef
      modelRepositoryRef: String from AgentRoundContributionRequested.modelRepositoryRef
      modelFormat: String from AgentRoundContributionRequested.modelFormat
      modelHash: String from AgentRoundContributionRequested.modelHash
      modelSignatureRef: String? from AgentRoundContributionRequested.modelSignatureRef
      runtimePayloadRef: String? from AgentRoundContributionRequested.runtimePayloadRef
      artifactStoreRef: String? from AgentRoundContributionRequested.artifactStoreRef
      localModelCacheRef: String?
    }

    event AgentRoundGlobalModelPulled {
      agentRoundContributionId: UUID id technical
      roundContributionRequestId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      organizationId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      globalModelVersionId: UUID
      globalModelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      runtimePayloadRef: String?
      artifactStoreRef: String?
      localModelCacheRef: String?
      pulledAt: DateTime
    }

    state ModelPulled
  }

  slice StartAgentRoundContribution {
    reactsTo AgentRoundGlobalModelPulled

    automation StartRoundContributionAfterModelPulled {
      on AgentRoundGlobalModelPulled
      emits StartAgentRoundContribution
    }

    command StartAgentRoundContribution {
      agentRoundContributionId: UUID id technical from AgentRoundGlobalModelPulled.agentRoundContributionId
      roundContributionRequestId: UUID from AgentRoundGlobalModelPulled.roundContributionRequestId
      trainingJobId: UUID from AgentRoundGlobalModelPulled.trainingJobId
      trainingRunConfigurationId: UUID from AgentRoundGlobalModelPulled.trainingRunConfigurationId
      roundId: UUID from AgentRoundGlobalModelPulled.roundId
      roundNumber: Int from AgentRoundGlobalModelPulled.roundNumber
      organizationId: UUID from AgentRoundGlobalModelPulled.organizationId
      nodeId: UUID
      orchestratorNodeName: String?
      runtimeAgentId: UUID from AgentRoundGlobalModelPulled.runtimeAgentId
      featureSchemaId: UUID from AgentRoundGlobalModelPulled.featureSchemaId
      globalModelVersionId: UUID from AgentRoundGlobalModelPulled.globalModelVersionId
      globalModelArtifactRef: String from AgentRoundGlobalModelPulled.globalModelArtifactRef
      modelRepositoryRef: String from AgentRoundGlobalModelPulled.modelRepositoryRef
      modelFormat: String from AgentRoundGlobalModelPulled.modelFormat
      modelHash: String from AgentRoundGlobalModelPulled.modelHash
      modelSignatureRef: String? from AgentRoundGlobalModelPulled.modelSignatureRef
      runtimePayloadRef: String? from AgentRoundGlobalModelPulled.runtimePayloadRef
      artifactStoreRef: String? from AgentRoundGlobalModelPulled.artifactStoreRef
      localModelCacheRef: String? from AgentRoundGlobalModelPulled.localModelCacheRef
    }

    event AgentRoundContributionStarted {
      agentRoundContributionId: UUID id technical
      roundContributionRequestId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      organizationId: UUID
      nodeId: UUID
      orchestratorNodeName: String?
      runtimeAgentId: UUID
      featureSchemaId: UUID
      globalModelVersionId: UUID
      globalModelArtifactRef: String
      modelRepositoryRef: String
      modelFormat: String
      modelHash: String
      modelSignatureRef: String?
      runtimePayloadRef: String?
      artifactStoreRef: String?
      localModelCacheRef: String?
      startedAt: DateTime
    }

    state Running
  }

  slice SubmitAgentLocalModelUpdate {
    reactsTo AgentRoundContributionStarted

    command SubmitAgentLocalModelUpdate {
      agentRoundContributionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      localUpdateArtifactRef: String?
      trainingLoss: Decimal
    }

    event AgentLocalModelUpdateSubmitted {
      agentRoundContributionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      featureSchemaId: UUID
      localModelVersionId: UUID
      updateArtifactId: UUID
      localUpdateArtifactRef: String?
      trainingLoss: Decimal
      submittedAt: DateTime
    }

    state UpdateSubmitted
  }

  slice SubmitAgentLocalModelEvaluation {
    reactsTo AgentLocalModelUpdateSubmitted

    command SubmitAgentLocalModelEvaluation {
      agentRoundContributionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      localModelVersionId: UUID
      featureSchemaId: UUID
      metricsArtifactRef: String?
      localAccuracy: Decimal
      localFairnessScore: Decimal
    }

    event AgentLocalModelEvaluationSubmitted {
      agentRoundContributionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      nodeId: UUID
      runtimeAgentId: UUID
      localModelVersionId: UUID
      featureSchemaId: UUID
      metricsArtifactRef: String?
      localAccuracy: Decimal
      localFairnessScore: Decimal
      submittedAt: DateTime
    }

    state EvaluationSubmitted
  }

  slice AgentRoundContributionCatalog {
    readmodel AgentRoundContributionCatalog[] {
      agentRoundContributionId: UUID id
      roundContributionRequestId: UUID?
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int?
      organizationId: UUID?
      nodeId: UUID?
      orchestratorNodeName: String?
      runtimeAgentId: UUID
      state: AgentRoundContribution.State
      featureSchemaId: UUID
      trainingJobObjective: String? derived {
        from TrainingJobCreated.objective
        rule "Lookup by trainingJobId and denormalize the training job objective into the agent round contribution catalog."
      }
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the agent round contribution catalog."
      }
      featureDomain: String? derived {
        from FeatureSchemaDefined.featureDomain
        rule "Lookup by featureSchemaId and denormalize the feature schema domain into the agent round contribution catalog."
      }
      featureSchemaVersion: Int? derived {
        from FeatureSchemaDefined.version
        rule "Lookup by featureSchemaId and denormalize the feature schema version into the agent round contribution catalog."
      }
      globalModelVersionId: UUID?
      globalModelArtifactRef: String?
      modelRepositoryRef: String?
      modelFormat: String?
      modelHash: String?
      modelSignatureRef: String?
      localModelCacheRef: String?
      localModelVersionId: UUID?
      updateArtifactId: UUID?
      localUpdateArtifactRef: String?
      metricsArtifactRef: String?
      trainingLoss: Decimal?
      localAccuracy: Decimal?
      localFairnessScore: Decimal?
      pulledAt: DateTime?
      startedAt: DateTime?
      submittedAt: DateTime?
      subscribe TrainingJobCreated
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe AgentRoundGlobalModelPulled
      subscribe AgentRoundContributionStarted
      subscribe AgentLocalModelUpdateSubmitted
      subscribe AgentLocalModelEvaluationSubmitted
    }
  }

  concept AgentRoundContribution {
    state ModelPulled
    state Running
    state UpdateSubmitted
    state EvaluationSubmitted

    slice PullRoundGlobalModel
    slice StartAgentRoundContribution
    slice SubmitAgentLocalModelUpdate
    slice SubmitAgentLocalModelEvaluation
    slice AgentRoundContributionCatalog
  }

  slice ReportAgentRuntimeInfrastructureConnection {
    startsLifecycle
    reactsTo RuntimeInfrastructureRegistered

    automation ReportInfrastructureConnectionAfterSelfCheck {
      on RuntimeInfrastructureRegistered
      condition runtimeSelfCheckPassed == true
      emits ReportAgentRuntimeInfrastructureConnection
    }

    command ReportAgentRuntimeInfrastructureConnection {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
    }

    event AgentRuntimeInfrastructureConnectionReported {
      runtimeInfrastructureId: UUID id technical
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
    }

    state Reported
  }

  slice AgentRuntimeInfrastructureConnectionCatalog {
    readmodel AgentRuntimeInfrastructureConnectionCatalog[] {
      runtimeInfrastructureId: UUID id
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeAgentId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the agent runtime infrastructure connection catalog."
      }
      infrastructureName: String? derived {
        from RuntimeInfrastructureRegistered.infrastructureName
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime infrastructure display name into the agent runtime infrastructure connection catalog."
      }
      connectedAt: DateTime
      observedNodeCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructureRegistered
      subscribe AgentRuntimeInfrastructureConnectionReported
    }
  }

  concept AgentRuntimeInfrastructureConnection {
    state Reported

    slice ReportAgentRuntimeInfrastructureConnection
    slice AgentRuntimeInfrastructureConnectionCatalog
  }

  slice AgentRuntimeTelemetryLatest {
    readmodel AgentRuntimeTelemetryLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID?
      trainingJobId: UUID?
      agentRuntimeJobId: UUID?
      cpuLoad: Decimal?
      gpuLoad: Decimal?
      memoryLoad: Decimal?
      lastHeartbeatAt: DateTime?
      telemetryRetentionPolicy: String
    }
  }

  concept AgentRuntimeTelemetry {
    slice AgentRuntimeTelemetryLatest
  }

  slice ReportAgentRuntimeNodeInventory {
    startsLifecycle

    automation ReportNodeInventoryWhenInventoryChanged {
      condition runtimeNodeInventoryChanged == true
      emits ReportAgentRuntimeNodeInventory
    }

    command ReportAgentRuntimeNodeInventory {
      runtimeNodeInventoryReportId: UUID id generated technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String              // CONTROL_PLANE / WORKER
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
    }

    event AgentRuntimeNodeInventoryReported {
      runtimeNodeInventoryReportId: UUID id technical
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
    }

    state Reported
  }

  slice AgentRuntimeNodeInventoryCatalog {
    readmodel AgentRuntimeNodeInventoryCatalog[] {
      runtimeNodeInventoryReportId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String? derived {
        from OrganizationRegistered.organizationName
        rule "Lookup by organizationId and denormalize the organization display name into the agent runtime node inventory catalog."
      }
      infrastructureName: String? derived {
        from RuntimeInfrastructureRegistered.infrastructureName
        rule "Lookup by runtimeInfrastructureId and denormalize the runtime infrastructure display name into the agent runtime node inventory catalog."
      }
      orchestratorNodeName: String
      providerNodeId: String?
      nodeRole: String
      nodeReady: Boolean
      kubeletVersion: String?
      containerRuntimeVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructureRegistered
      subscribe AgentRuntimeNodeInventoryReported
    }
  }

  concept AgentRuntimeNodeInventory {
    state Reported

    slice ReportAgentRuntimeNodeInventory
    slice AgentRuntimeNodeInventoryCatalog
  }

  slice AgentRuntimeNodeResourceLatest {
    readmodel AgentRuntimeNodeResourceLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      orchestratorNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningPodCount: Int
      podCapacity: Int
      observedAt: DateTime
      telemetryRetentionPolicy: String
    }
  }

  concept AgentRuntimeNodeResourceTelemetry {
    slice AgentRuntimeNodeResourceLatest
  }

    slice AcceptAgentRuntimeJob {
      startsLifecycle
      reactsTo TrainingRuntimeDispatched

      automation AcceptRuntimeJobWhenDispatched {
        on TrainingRuntimeDispatched
        condition canAcceptRuntimeJob == true
        emits AcceptAgentRuntimeJob
      }

      command AcceptAgentRuntimeJob {
        agentRuntimeJobId: UUID id generated technical
        trainingJobId: UUID from TrainingRuntimeDispatched.trainingJobId
        trainingRunConfigurationId: UUID from TrainingRuntimeDispatched.trainingRunConfigurationId
        organizationId: UUID from TrainingRuntimeDispatched.organizationId
        runtimeAgentId: UUID from TrainingRuntimeDispatched.runtimeAgentId
        runtimeInfrastructureId: UUID from TrainingRuntimeDispatched.runtimeInfrastructureId
        featureSchemaId: UUID from TrainingRuntimeDispatched.featureSchemaId
        runtimeImageRef: String from TrainingRuntimeDispatched.runtimeImageRef
        runtimePayloadRef: String from TrainingRuntimeDispatched.runtimePayloadRef
        artifactStoreRef: String from TrainingRuntimeDispatched.artifactStoreRef
      }

      event AgentRuntimeJobAccepted {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        featureSchemaId: UUID
        runtimeImageRef: String
        runtimePayloadRef: String
        artifactStoreRef: String
      }

      state Accepted
    }

    slice StartAgentRuntimeJob {
      reactsTo AgentRuntimeJobAccepted

      automation StartRuntimeJobAfterAccepted {
        on AgentRuntimeJobAccepted
        emits StartAgentRuntimeJob
      }

      command StartAgentRuntimeJob {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        featureSchemaId: UUID
        runtimeJobId: UUID generated technical
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        runtimeImageRef: String
        runtimePayloadRef: String
        artifactStoreRef: String
        matchedTrainingDatasetHandle: String?
        matchedEvaluationDatasetHandle: String?
        localSecretRef: String
        localSecretRefType: String
        localDataMountPath: String?
      }

      event AgentRuntimeJobStarted {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        featureSchemaId: UUID
        runtimeJobId: UUID
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        runtimeImageRef: String
        runtimePayloadRef: String
        artifactStoreRef: String
        matchedTrainingDatasetHandle: String?
        matchedEvaluationDatasetHandle: String?
        localSecretRef: String
        localSecretRefType: String
        localDataMountPath: String?
        startedAt: DateTime
      }

      state Running
    }

    slice CompleteAgentRuntimeJob {
      reactsTo AgentRuntimeJobStarted

      command CompleteAgentRuntimeJob {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        runtimeJobId: UUID
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        localUpdateArtifactRef: String?
        metricsArtifactRef: String?
        runtimeStatus: String
        completedAt: DateTime
      }

      event AgentRuntimeJobCompleted {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        runtimeJobId: UUID
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        localUpdateArtifactRef: String?
        metricsArtifactRef: String?
        runtimeStatus: String
        completedAt: DateTime
      }

      state Completed
    }

    slice FailAgentRuntimeJob {
      reactsTo AgentRuntimeJobStarted

      command FailAgentRuntimeJob {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        runtimeJobId: UUID?
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        failureReason: String
        failedAt: DateTime
      }

      event AgentRuntimeJobFailed {
        agentRuntimeJobId: UUID id technical
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        runtimeJobId: UUID?
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        failureReason: String
        failedAt: DateTime
      }

      state Failed
    }

    slice AgentRuntimeJobCatalog {
      readmodel AgentRuntimeJobCatalog[] {
        agentRuntimeJobId: UUID id
        trainingJobId: UUID
        trainingRunConfigurationId: UUID
        organizationId: UUID
        runtimeAgentId: UUID
        runtimeInfrastructureId: UUID
        runtimeJobId: UUID?
        scheduledNodeId: UUID?
        orchestratorNodeName: String?
        featureSchemaId: UUID
        trainingJobObjective: String? derived {
          from TrainingJobCreated.objective
          rule "Lookup by trainingJobId and denormalize the training job objective into the agent runtime job catalog."
        }
        organizationName: String? derived {
          from OrganizationRegistered.organizationName
          rule "Lookup by organizationId and denormalize the organization display name into the agent runtime job catalog."
        }
        featureDomain: String? derived {
          from FeatureSchemaDefined.featureDomain
          rule "Lookup by featureSchemaId and denormalize the feature schema domain into the agent runtime job catalog."
        }
        featureSchemaVersion: Int? derived {
          from FeatureSchemaDefined.version
          rule "Lookup by featureSchemaId and denormalize the feature schema version into the agent runtime job catalog."
        }
        runtimeImageRef: String
        runtimePayloadRef: String
        artifactStoreRef: String
        matchedTrainingDatasetHandle: String?
        matchedEvaluationDatasetHandle: String?
        localSecretRefType: String?
        localDataMountPath: String?
        runtimeStatus: String
        localUpdateArtifactRef: String?
        metricsArtifactRef: String?
        failureReason: String?
        startedAt: DateTime?
        completedAt: DateTime?
        failedAt: DateTime?
        subscribe TrainingJobCreated
        subscribe OrganizationRegistered
        subscribe FeatureSchemaDefined
        subscribe AgentRuntimeJobAccepted
        subscribe AgentRuntimeJobStarted
        subscribe AgentRuntimeJobCompleted
        subscribe AgentRuntimeJobFailed
      }
    }

    concept AgentRuntimeJob {
      state Accepted
      state Running
      state Completed
      state Failed

      slice AcceptAgentRuntimeJob
      slice StartAgentRuntimeJob
      slice CompleteAgentRuntimeJob
      slice FailAgentRuntimeJob
      slice AgentRuntimeJobCatalog
    }
  }
}
