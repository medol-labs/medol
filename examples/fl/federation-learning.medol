      roundExecutionId: UUID id technical
      executionSessionId: UUID from RoundExecutionStartFailed.executionSessionId
      executionPlanId: UUID from RoundExecutionStartFailed.executionPlanId
      trainingJobId: UUID from RoundExecutionStartFailed.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionStartFailed.trainingRunConfigurationId
      roundId: UUID from RoundExecutionStartFailed.roundId
      roundNumber: Int from RoundExecutionStartFailed.roundNumber
      runtimeId: UUID from RoundExecutionStartFailed.runtimeId
      organizationId: UUID from RoundExecutionStartFailed.organizationId
      featureSchemaId: UUID from RoundExecutionStartFailed.featureSchemaId
      baseModelId: UUID from RoundExecutionStartFailed.baseModelId
      runtimeEngineJobId: String
      retryReason: String
    }

    event RoundExecutionStartRetryStarted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      runtimeEngineJobId: String
      retryReason: String
    }

    event RoundExecutionStartRetryFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      runtimeEngineJobId: String?
      retryReason: String
      failureReason: String
    }

    state Retried
  }

  slice RetryRoundExecutionAfterRuntimeFailure {
    actor NodeOperator
    ui RoundExecutionScreen
    reactsTo RoundExecutionFailed
    port

    command RetryRoundExecutionAfterRuntimeFailure {
      roundExecutionId: UUID id technical
      executionSessionId: UUID from RoundExecutionFailed.executionSessionId
      executionPlanId: UUID from RoundExecutionFailed.executionPlanId
      trainingJobId: UUID from RoundExecutionFailed.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionFailed.trainingRunConfigurationId
      roundId: UUID from RoundExecutionFailed.roundId
      roundNumber: Int derived from RoundExecutionStarted.roundNumber by roundExecutionId
      runtimeId: UUID from RoundExecutionFailed.runtimeId
      organizationId: UUID derived from RoundExecutionStarted.organizationId by roundExecutionId
      featureSchemaId: UUID derived from RoundExecutionStarted.featureSchemaId by roundExecutionId
      baseModelId: UUID derived from RoundExecutionStarted.baseModelId by roundExecutionId
      runtimeEngineJobId: String
      retryReason: String
    }

    event RoundExecutionRuntimeRetryStarted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      runtimeEngineJobId: String
      retryReason: String
    }

    event RoundExecutionRuntimeRetryFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      runtimeEngineJobId: String?
      retryReason: String
      failureReason: String
    }

    state Retried
  }

  slice SubmitAgentLocalModelUpdate {
    reactsTo RoundExecutionCompleted
    port

    automation SubmitLocalModelUpdateWhenRoundExecutionCompleted {
      on RoundExecutionCompleted
      emits SubmitAgentLocalModelUpdate
    }

    command SubmitAgentLocalModelUpdate {
      modelUpdateSubmissionId: UUID id generated technical
      executionSessionId: UUID from RoundExecutionCompleted.executionSessionId
      executionPlanId: UUID from RoundExecutionCompleted.executionPlanId
      roundExecutionId: UUID from RoundExecutionCompleted.roundExecutionId
      trainingJobId: UUID from RoundExecutionCompleted.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionCompleted.trainingRunConfigurationId
      roundId: UUID from RoundExecutionCompleted.roundId
      runtimeId: UUID from RoundExecutionCompleted.runtimeId
      featureSchemaId: UUID derived from RoundExecutionStarted.featureSchemaId by roundExecutionId
      localModelId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      trainingLoss: Decimal
    }

    event AgentLocalModelUpdateSubmitted {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      roundExecutionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      localModelId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      trainingLoss: Decimal
    }

    state UpdateSubmitted
  }

  slice ReleaseRuntimeEngineJobAfterCompletion {
    reactsTo RoundExecutionCompleted
    port

    automation ReleaseRuntimeEngineJobWhenRoundExecutionCompleted {
      on RoundExecutionCompleted
