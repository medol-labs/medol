      }
      datasetUsage: String
      metadataStatus: String
      contractStatus: String
      approvalStatus: String
      accessStatus: String
      runtimeStatus: String
      overallReadiness: String
      readyForTraining: Boolean
      canBeSelectedForTraining: Boolean
      readinessScore: Int
      missingRequirements: String[]
      blockingReasons: String[]
      warnings: String[]
      sampleCount: Int?
      featureCount: Int?
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
      metadataReportId: UUID?
      datasetAccessValidationId: UUID?
      readable: Boolean?
      schemaReadable: Boolean?
      sampleBatchReadable: Boolean?
      lastProfiledAt: DateTime?
      lastAccessValidatedAt: DateTime?
