      runtimeId: UUID from RoundExecutionFailed.runtimeId
      organizationId: UUID derived from RoundExecutionStarted.organizationId by roundExecutionId
      featureSchemaId: UUID derived from RoundExecutionStarted.featureSchemaId by roundExecutionId
      baseModelId: UUID derived from RoundExecutionStarted.baseModelId by roundExecutionId
      runtimeEngineJobId: String
      retryReason: String
    }

    event RoundExecutionRuntimeRetryStarted {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      runtimeEngineJobId: String
      retryReason: String
    }

    event RoundExecutionRuntimeRetryFailed {
      roundExecutionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      baseModelId: UUID
      runtimeEngineJobId: String?
      retryReason: String
      failureReason: String
    }

    state Retried
  }

  slice SubmitAgentLocalModelUpdate {
    port

    automation SubmitLocalModelUpdateWhenRoundExecutionCompleted {
      on RoundExecutionCompleted
      emits SubmitAgentLocalModelUpdate
    }

    command SubmitAgentLocalModelUpdate {
      modelUpdateSubmissionId: UUID id generated technical
      executionSessionId: UUID from RoundExecutionCompleted.executionSessionId
      executionPlanId: UUID from RoundExecutionCompleted.executionPlanId
      roundExecutionId: UUID from RoundExecutionCompleted.roundExecutionId
      trainingJobId: UUID from RoundExecutionCompleted.trainingJobId
      trainingRunConfigurationId: UUID from RoundExecutionCompleted.trainingRunConfigurationId
      roundId: UUID from RoundExecutionCompleted.roundId
      runtimeId: UUID from RoundExecutionCompleted.runtimeId
      featureSchemaId: UUID from RoundExecutionCompleted.featureSchemaId
      secureAggregationRequired: Boolean from RoundExecutionCompleted.secureAggregationRequired
      secureAggregationSessionId: UUID? from RoundExecutionCompleted.secureAggregationSessionId
      encryptionScheme: String? from RoundExecutionCompleted.encryptionScheme
      publicKeyVersion: String? from RoundExecutionCompleted.publicKeyVersion
      runtimeEngineJobId: String from RoundExecutionCompleted.runtimeEngineJobId
      localModelId: UUID
      updateArtifactId: UUID
      artifactRef: String from RoundExecutionCompleted.modelUpdateArtifactRef
      artifactDigest: String from RoundExecutionCompleted.modelUpdateArtifactDigest
      updateProtectionType: String from RoundExecutionCompleted.updateProtectionType
      trainingLoss: Decimal from RoundExecutionCompleted.trainingLoss
    }

    event AgentLocalModelUpdateSubmitted {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      roundExecutionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      runtimeEngineJobId: String
      localModelId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      updateProtectionType: String dictionary "MODEL_UPDATE_PROTECTION_TYPE"
      trainingLoss: Decimal
    }

    state UpdateSubmitted
  }

  slice ReleaseRuntimeEngineJobAfterCompletion {
    reactsTo AgentLocalModelUpdateSubmitted
    port

    automation ReleaseRuntimeEngineJobWhenLocalModelUpdateSubmitted {
      on AgentLocalModelUpdateSubmitted
      emits ReleaseRuntimeEngineJobAfterCompletion
    }

    command ReleaseRuntimeEngineJobAfterCompletion {
      roundExecutionId: UUID id technical from AgentLocalModelUpdateSubmitted.roundExecutionId
      runtimeEngineJobId: String from AgentLocalModelUpdateSubmitted.runtimeEngineJobId
    }

    event RuntimeEngineJobReleased {
      roundExecutionId: UUID id technical
      runtimeEngineJobId: String
    }

    state RuntimeEngineReleased
  }

  slice ReleaseRuntimeEngineJobAfterFailure {
    reactsTo RoundExecutionFailed
    port

    automation ReleaseRuntimeEngineJobWhenRoundExecutionFailed {
      on RoundExecutionFailed
      emits ReleaseRuntimeEngineJobAfterFailure
    }

    command ReleaseRuntimeEngineJobAfterFailure {
      roundExecutionId: UUID id technical from RoundExecutionFailed.roundExecutionId
      runtimeEngineJobId: String? from RoundExecutionFailed.runtimeEngineJobId
    }

    event RuntimeEngineJobReleaseFailedOrSkipped {
      roundExecutionId: UUID id technical
      runtimeEngineJobId: String?
      runtimeEngineReleaseFailureReason: String?
    }

    state RuntimeEngineReleaseHandled
  }

  slice ReleaseRuntimeEngineJobAfterStartFailure {
    reactsTo RoundExecutionStartFailed
    port

    automation ReleaseRuntimeEngineJobWhenStartFailed {
      on RoundExecutionStartFailed
      emits ReleaseRuntimeEngineJobAfterStartFailure
    }

    command ReleaseRuntimeEngineJobAfterStartFailure {
      roundExecutionId: UUID id technical from RoundExecutionStartFailed.roundExecutionId
      runtimeEngineJobId: String? from RoundExecutionStartFailed.runtimeEngineJobId
    }

    event RuntimeEngineJobReleaseFailedOrSkippedAfterStartFailure {
      roundExecutionId: UUID id technical
      runtimeEngineJobId: String?
      runtimeEngineReleaseFailureReason: String?
    }

    state RuntimeEngineReleaseHandled
  }

  slice ReleaseRuntimeEngineJobAfterRetryFailure {
    reactsTo RoundExecutionStartRetryFailed
    port

    automation ReleaseRuntimeEngineJobWhenStartRetryFailed {
      on RoundExecutionStartRetryFailed
      emits ReleaseRuntimeEngineJobAfterRetryFailure
    }

    command ReleaseRuntimeEngineJobAfterRetryFailure {
      roundExecutionId: UUID id technical from RoundExecutionStartRetryFailed.roundExecutionId
      runtimeEngineJobId: String? from RoundExecutionStartRetryFailed.runtimeEngineJobId
    }

    event RuntimeEngineJobReleaseFailedOrSkippedAfterRetry {
      roundExecutionId: UUID id technical
      runtimeEngineJobId: String?
      runtimeEngineReleaseFailureReason: String?
    }

    state RuntimeEngineReleaseHandled
  }

  slice ReleaseRuntimeEngineJobAfterRuntimeRetryFailure {
    reactsTo RoundExecutionRuntimeRetryFailed
    port

    automation ReleaseRuntimeEngineJobWhenRuntimeRetryFailed {
      on RoundExecutionRuntimeRetryFailed
      emits ReleaseRuntimeEngineJobAfterRuntimeRetryFailure
    }

    command ReleaseRuntimeEngineJobAfterRuntimeRetryFailure {
      roundExecutionId: UUID id technical from RoundExecutionRuntimeRetryFailed.roundExecutionId
      runtimeEngineJobId: String? from RoundExecutionRuntimeRetryFailed.runtimeEngineJobId
    }

    event RuntimeEngineJobReleaseFailedOrSkippedAfterRuntimeRetry {
      roundExecutionId: UUID id technical
      runtimeEngineJobId: String?
      runtimeEngineReleaseFailureReason: String?
    }

    state RuntimeEngineReleaseHandled
  }

  slice RoundExecutionCatalog {
    readmodel RoundExecutionCatalog[] {
      roundExecutionId: UUID id
      executionSessionId: UUID?
      executionPlanId: UUID?
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundNumber: Int?
      organizationId: UUID?
      runtimeId: UUID
      state: RoundExecution.State
      featureSchemaId: UUID?
      baseModelId: UUID?
      runtimeEngineJobId: String?
      runtimeEngineObservedStatus: String?
      runtimeEngineObservationAt: DateTime?
      localUpdateArtifactRef: String?
      metricsArtifactRef: String?
      localExecutionRequirementsSatisfied: Boolean?
      runtimeIdentityMatched: Boolean?
      runtimeDatasetBindingAvailable: Boolean?
      datasetAccessValidated: Boolean?
      baseModelAvailable: Boolean?
      trainingConfigurationSupported: Boolean?
      runtimeResourceAvailable: Boolean?
      runtimeAgentIdle: Boolean?
      updateArtifactId: UUID?
      artifactRef: String?
      artifactDigest: String?
      trainingLoss: Decimal?
      receivedAt: DateTime?
      acceptedAt: DateTime?
      rejectedAt: DateTime?
      startedAt: DateTime?
      completedAt: DateTime?
      failedAt: DateTime?
      submittedAt: DateTime?
      failureReason: String?
      retryReason: String?
      runtimeEngineReleased: Boolean?
      runtimeEngineReleaseFailureReason: String?
      rejectionReasons: String[]
      subscribe ParticipantExecutionPlanDispatched
      subscribe ExecutionPlanReceived
      subscribe ExecutionPlanAccepted
      subscribe ExecutionPlanRejected
      subscribe RoundExecutionStarted
      subscribe RoundExecutionStartFailed
      subscribe RuntimeEngineJobObserved
      subscribe RoundExecutionStartRetryStarted
      subscribe RoundExecutionStartRetryFailed
      subscribe RoundExecutionCompleted
      subscribe RoundExecutionFailed
      subscribe RoundExecutionRuntimeRetryStarted
      subscribe RoundExecutionRuntimeRetryFailed
      subscribe AgentLocalModelUpdateSubmitted
      subscribe RuntimeEngineJobReleased
      subscribe RuntimeEngineJobReleaseFailedOrSkipped
      subscribe RuntimeEngineJobReleaseFailedOrSkippedAfterStartFailure
      subscribe RuntimeEngineJobReleaseFailedOrSkippedAfterRetry
      subscribe RuntimeEngineJobReleaseFailedOrSkippedAfterRuntimeRetry
    }
  }

  concept RoundExecution {
    state PlanReceived
    state PlanAccepted
    state PlanRejected
    state Running
    state StartFailed
    state Retried
    state Completed
    state Failed
    state UpdateSubmitted
    state RuntimeEngineReleased
    state RuntimeEngineReleaseHandled

    slice ReceiveParticipantExecutionPlan
    slice AcceptExecutionPlan
    slice StartRoundExecution
    slice ObserveRuntimeEngineJob
    slice CompleteRoundExecution
    slice FailRoundExecution
    slice RetryRoundExecutionAfterStartFailure
    slice RetryRoundExecutionAfterRuntimeFailure
    slice SubmitAgentLocalModelUpdate
    slice ReleaseRuntimeEngineJobAfterCompletion
    slice ReleaseRuntimeEngineJobAfterFailure
    slice ReleaseRuntimeEngineJobAfterStartFailure
    slice ReleaseRuntimeEngineJobAfterRetryFailure
    slice ReleaseRuntimeEngineJobAfterRuntimeRetryFailure
    slice RoundExecutionCatalog
  }

  slice LoadRuntimeAgentBootstrapConfiguration {
    startsLifecycle
    ui LoadRuntimeAgentBootstrapConfigurationConfirm confirm
    actor RuntimeAgent
    port

    command LoadRuntimeAgentBootstrapConfiguration {
      bootstrapRequestId: UUID id generated technical
    }

    event RuntimeAgentBootstrapConfigurationLoaded {
      runtimeAgentId: UUID id technical
      runtimeInfrastructureId: UUID
      agentVersion: String
      bootstrapConfigurationLoaded: Boolean
    }

    event RuntimeAgentBootstrapConfigurationLoadFailed {
      bootstrapRequestId: UUID id technical
      failureReason: String
    }

    state BootstrapLoaded

    specification "Runtime Agent Startup Bootstrap Configuration" {
      rule """
        Runtime agent startup begins by loading bootstrap configuration from environment variables, mounted files, or platform-issued startup material. The configuration must provide the stable runtimeAgentId generated when RuntimeInfrastructure was registered, the matching runtimeInfrastructureId, and the agent version. A successful load starts the runtime-agent lifecycle; a missing or invalid configuration records a bootstrap failure and must not create a new random runtimeAgentId.
      """

      scenario "Load Runtime Agent Bootstrap Configuration" {
        when LoadRuntimeAgentBootstrapConfiguration {
        }
        then RuntimeAgentBootstrapConfigurationLoaded
      }

      scenario "Reject Missing Runtime Agent Bootstrap Configuration" {
        when LoadRuntimeAgentBootstrapConfiguration {
        }
        then RuntimeAgentBootstrapConfigurationLoadFailed
      }
    }
  }

  slice ReportRuntimeAgentStarted {
    reactsTo RuntimeAgentBootstrapConfigurationLoaded

    actor RuntimeAgent

    automation ReportRuntimeAgentStartedWhenBootstrapConfigurationLoaded {
      on RuntimeAgentBootstrapConfigurationLoaded
      emits ReportRuntimeAgentStarted
    }

    command ReportRuntimeAgentStarted {
      runtimeAgentId: UUID id technical from RuntimeAgentBootstrapConfigurationLoaded.runtimeAgentId
      runtimeInfrastructureId: UUID from RuntimeAgentBootstrapConfigurationLoaded.runtimeInfrastructureId
      agentVersion: String from RuntimeAgentBootstrapConfigurationLoaded.agentVersion
    }

    event RuntimeAgentStarted {
      runtimeAgentId: UUID id technical
      runtimeInfrastructureId: UUID
      agentVersion: String
    }

    state Started
  }


  slice ReportRuntimeInstanceSelfCheckPassed {
    actor RuntimeAgent
    reactsTo RuntimeAgentStarted

    automation ReportReadyAfterConfigurationFetchAndSelfCheck {
      on RuntimeAgentStarted
      condition runtimeAgentSelfCheckPassed == true
      emits ReportRuntimeInstanceSelfCheckPassed
    }

    command ReportRuntimeInstanceSelfCheckPassed {
      runtimeAgentId: UUID id technical from RuntimeAgentStarted.runtimeAgentId
      runtimeInfrastructureId: UUID from RuntimeAgentStarted.runtimeInfrastructureId
      agentVersion: String from RuntimeAgentStarted.agentVersion
      runtimeAgentSelfCheckPassed: Boolean
      configurationLoaded: Boolean
      secretStoreAccessible: Boolean
      runtimeEngineAdapterReady: Boolean
      modelRepositoryClientReady: Boolean
      localDatasetBindingStoreReady: Boolean
      workingDirectoryWritable: Boolean
    }

    event RuntimeInstanceSelfCheckPassed {
      runtimeAgentId: UUID id technical
      runtimeInfrastructureId: UUID
      agentVersion: String
      runtimeAgentSelfCheckPassed: Boolean
      configurationLoaded: Boolean
      secretStoreAccessible: Boolean
      runtimeEngineAdapterReady: Boolean
      modelRepositoryClientReady: Boolean
      localDatasetBindingStoreReady: Boolean
      workingDirectoryWritable: Boolean
    }

    state Ready
  }

  slice RuntimeAgentLifecycleCatalog {
    readmodel RuntimeAgentLifecycleCatalog[] {
      runtimeAgentId: UUID id
      runtimeInfrastructureId: UUID
      agentVersion: String
      lifecycleStatus: String
      bootstrapConfigurationLoaded: Boolean?
      bootstrapFailureReason: String?
      runtimeAgentSelfCheckPassed: Boolean?
      configurationLoaded: Boolean?
      secretStoreAccessible: Boolean?
      runtimeEngineAdapterReady: Boolean?
      modelRepositoryClientReady: Boolean?
      localDatasetBindingStoreReady: Boolean?
      workingDirectoryWritable: Boolean?
      bootstrappedAt: DateTime?
      bootstrapFailedAt: DateTime?
      startedAt: DateTime?
      readyAt: DateTime?
      subscribe RuntimeAgentBootstrapConfigurationLoaded
      subscribe RuntimeAgentBootstrapConfigurationLoadFailed
      subscribe RuntimeAgentStarted
      subscribe RuntimeInstanceSelfCheckPassed
    }
  }

  concept RuntimeAgentLifecycle {
    state BootstrapLoaded
    state Started
    state Ready

    slice LoadRuntimeAgentBootstrapConfiguration
    slice ReportRuntimeAgentStarted
    slice ReportRuntimeInstanceSelfCheckPassed
    slice RuntimeAgentLifecycleCatalog
  }

  slice ReportRuntimeInstanceConnected {
    startsLifecycle
    reactsTo RuntimeInstanceSelfCheckPassed
    // Calls platform POST /runtimeinfrastructure/recordruntimeconnectionestablished to notify that the runtime agent is online.
    port

    automation ReportRuntimeInstanceConnectedAfterSelfCheck {
      on RuntimeInstanceSelfCheckPassed
      emits ReportRuntimeInstanceConnected
    }

    command ReportRuntimeInstanceConnected {
      runtimeInfrastructureId: UUID id technical from RuntimeInstanceSelfCheckPassed.runtimeInfrastructureId
      runtimeAgentId: UUID from RuntimeInstanceSelfCheckPassed.runtimeAgentId
      runtimeAgentEndpoint: String
      endpointScope: String dictionary "RUNTIME_AGENT_ENDPOINT_SCOPE"
      runtimePlatformConnectionReady: Boolean
      platformApiReachable: Boolean
      agentAuthenticationSucceeded: Boolean
      controlChannelEstablished: Boolean
      heartbeatAccepted: Boolean
    }

    event AgentRuntimeConnectionReportFailed {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      runtimePlatformConnectionReady: Boolean
      platformApiReachable: Boolean
      agentAuthenticationSucceeded: Boolean
      controlChannelEstablished: Boolean
      heartbeatAccepted: Boolean
      failureReason: String
      retryable: Boolean?
    }

    event AgentRuntimeConnectionEstablished {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      runtimeAgentEndpoint: String
      endpointScope: String dictionary "RUNTIME_AGENT_ENDPOINT_SCOPE"
      runtimePlatformConnectionReady: Boolean
      platformApiReachable: Boolean
      agentAuthenticationSucceeded: Boolean
      controlChannelEstablished: Boolean
      heartbeatAccepted: Boolean
    }

    state Connected

    specification "Runtime Agent Platform Connection Reporting Outcome" {
      rule """
        After the runtime instance self-check passes, the runtime agent reports its connection status to the platform by calling POST /runtimeinfrastructure/recordruntimeconnectionestablished. The platform records RuntimeConnectionEstablished only after that command succeeds. The local agent must record AgentRuntimeConnectionReportFailed when the platform API is unreachable, authentication fails, the control channel cannot be established, the heartbeat is rejected, or the platform command is rejected.
      """

      scenario "Report Runtime Instance Connected" {
        given RuntimeInstanceSelfCheckPassed {
          runtimeInfrastructureId = "runtime-infra-1"
          runtimeAgentId = "runtime-agent-1"
        }
        when ReportRuntimeInstanceConnected {
          runtimeInfrastructureId = "runtime-infra-1"
          runtimeAgentId = "runtime-agent-1"
          runtimeAgentEndpoint = "http://localhost:8082"
          endpointScope = "LOCAL"
          runtimePlatformConnectionReady = true
          platformApiReachable = true
          agentAuthenticationSucceeded = true
          controlChannelEstablished = true
          heartbeatAccepted = true
        }
        then AgentRuntimeConnectionEstablished
      }

      scenario "Report Runtime Instance Connection Failed" {
        given RuntimeInstanceSelfCheckPassed {
          runtimeInfrastructureId = "runtime-infra-2"
          runtimeAgentId = "runtime-agent-2"
        }
        when ReportRuntimeInstanceConnected {
          runtimeInfrastructureId = "runtime-infra-2"
          runtimeAgentId = "runtime-agent-2"
          runtimeAgentEndpoint = "http://localhost:8083"
          endpointScope = "LOCAL"
          runtimePlatformConnectionReady = false
          platformApiReachable = false
          agentAuthenticationSucceeded = false
          controlChannelEstablished = false
          heartbeatAccepted = false
        }
        then AgentRuntimeConnectionReportFailed
      }
    }
  }

  slice AgentRuntimeInfrastructureConnectionCatalog {
    readmodel AgentRuntimeInfrastructureConnectionCatalog[] {
      runtimeInfrastructureId: UUID id
      runtimeAgentId: UUID
      runtimePlatformConnectionReady: Boolean
      platformApiReachable: Boolean
      agentAuthenticationSucceeded: Boolean
      controlChannelEstablished: Boolean
      heartbeatAccepted: Boolean
      connectedAt: DateTime
      connectionReportFailedAt: DateTime?
      connectionReportFailureReason: String?
      connectionReportRetryable: Boolean?
      subscribe AgentRuntimeConnectionEstablished
      subscribe AgentRuntimeConnectionReportFailed
    }
  }

  concept AgentRuntimeInfrastructureConnection {
    state Connected
    state ConnectionReportFailed

    slice ReportRuntimeInstanceConnected
    slice AgentRuntimeInfrastructureConnectionCatalog
  }

  slice AgentRuntimeTelemetryLatest {
    readmodel AgentRuntimeTelemetryLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID?
      trainingJobId: UUID?
      roundExecutionId: UUID?
      cpuLoad: Decimal?
      gpuLoad: Decimal?
      memoryLoad: Decimal?
      lastHeartbeatAt: DateTime?
      telemetryRetentionPolicy: String
    }
  }

  concept AgentRuntimeTelemetry {
    slice AgentRuntimeTelemetryLatest
  }

  slice ReportAgentRuntimeNodeInventory {
    startsLifecycle

    automation ReportNodeInventoryWhenInventoryChanged {
      condition runtimeNodeInventoryChanged == true
      emits ReportAgentRuntimeNodeInventory
    }

    command ReportAgentRuntimeNodeInventory {
      runtimeNodeInventoryReportId: UUID id generated technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      runtimeName: String?
      runtimeNodeName: String
      infrastructureNodeId: String?
      runtimeNodeRole: String
      nodeReady: Boolean
      runtimeEngineVersion: String?
      containerEngineVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
    }

    event AgentRuntimeNodeInventoryReported {
      runtimeNodeInventoryReportId: UUID id technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      runtimeName: String?
      runtimeNodeName: String
      infrastructureNodeId: String?
      runtimeNodeRole: String
      nodeReady: Boolean
      runtimeEngineVersion: String?
      containerEngineVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
    }

    state Reported
  }

  slice AgentRuntimeNodeInventoryCatalog {
    readmodel AgentRuntimeNodeInventoryCatalog[] {
      runtimeNodeInventoryReportId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String?
      runtimeNodeName: String
      infrastructureNodeId: String?
      runtimeNodeRole: String
      nodeReady: Boolean
      runtimeEngineVersion: String?
      containerEngineVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      subscribe OrganizationRegistered
      subscribe AgentRuntimeNodeInventoryReported
    }
  }

  concept AgentRuntimeNodeInventory {
    state Reported

    slice ReportAgentRuntimeNodeInventory
    slice AgentRuntimeNodeInventoryCatalog
  }

  slice AgentRuntimeNodeResourceLatest {
    readmodel AgentRuntimeNodeResourceLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      runtimeNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningWorkloadCount: Int
      workloadCapacity: Int
      observedAt: DateTime
      telemetryRetentionPolicy: String
    }
  }

  concept AgentRuntimeNodeResourceTelemetry {
    slice AgentRuntimeNodeResourceLatest
  }


  }

  deployment FederationLearningSupport {
    includes DictionaryMaintenance
    includes FileUpload
  }

  deployment FederationLearningPlatform {
    includes OrganizationManagement
    includes FederationManagement
    includes DatasetGovernance
    includes ModelRepository
    includes TrainingOrchestration
    includes ModelLifecycle
    includes RuntimeMonitoring
    includes RuntimeGovernance
    includes SecureAggregation
    includes RuntimeProvisioning
  }

  deployment FederationLearningRuntimeAgent {
    includes RuntimeAgentOperations
  }

  frontend FederationLearningConsole {
    includes OrganizationManagement from FederationLearningPlatform
    includes FederationManagement from FederationLearningPlatform
    includes DictionaryMaintenance from FederationLearningSupport
    includes FileUpload from FederationLearningSupport
    includes RuntimeProvisioning from FederationLearningPlatform
    includes DatasetGovernance from FederationLearningPlatform
    includes ModelRepository from FederationLearningPlatform
    includes TrainingOrchestration from FederationLearningPlatform
    includes ModelLifecycle from FederationLearningPlatform
    includes RuntimeMonitoring from FederationLearningPlatform
    includes RuntimeGovernance from FederationLearningPlatform
    includes SecureAggregation from FederationLearningPlatform
    includes IdentityAccessManagement from FederationLearningSupport
  }

  frontend FederationLearningParticipantConsole {
    includes RuntimeAgentOperations from FederationLearningRuntimeAgent
    includes IdentityAccessManagement from FederationLearningRuntimeAgent
  }
}
