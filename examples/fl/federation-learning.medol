import identity-access-management as PlatformIam deploy FederationLearningSupport
import identity-access-management as ParticipantIam deploy FederationLearningRuntimeAgent

domain FederationLearningPlatform {
context OrganizationManagement {
  
  note "Organization management owns organization lifecycle and runtime-discovered compute node availability."

  risk "Inactive organizations can be invited into federations if organization lifecycle state is not enforced."
  risk "Disabled compute nodes can still be selected for training if runtime-discovered node availability is not enforced."
  metric organizationActivationLeadTime
  metric runtimeIdentityCoverage

  enum OrganizationType {
    HOSPITAL
    RESEARCH_INSTITUTE
    PUBLIC_HEALTH_AGENCY
    LABORATORY
    REHABILITATION_CENTER
  }

  slice RegisterOrganization {
    startsLifecycle

    tags {
      organizationName = normalize(organizationName)
    }

    actor OrganizationAdmin
    ui OrganizationRegistrationScreen

    command RegisterOrganization {
      organizationId: UUID id generated technical
      organizationName: String
      organizationType: OrganizationType
      contactEmail: String
    }

    event OrganizationRegistered {
      organizationId: UUID id technical
      organizationName: String
      organizationType: OrganizationType
      contactEmail: String
    }

    state Registered

    specification "Organization Name Unique" {
      rule """
        Organization names must be unique.
      """

      expression {
        unique Organization.organizationName
      }

      scenario "Reject Duplicate Organization" {
        given OrganizationRegistered {
          organizationName = "Acme"
        }
        when RegisterOrganization {
          organizationName = "Acme"
        }
        then reject "Organization Already Exists"
      }
    }
  }

  slice ActivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationRegistered

    command ActivateOrganization {
      organizationId: UUID id technical
      activationNote: String?
    }

    event OrganizationActivated {
      organizationId: UUID id technical
      activationNote: String?
    }

    state Active
  }

  slice DeactivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationActivated

    command DeactivateOrganization {
      organizationId: UUID id technical
      deactivationReason: String
    }

    event OrganizationDeactivated {
      organizationId: UUID id technical
      deactivationReason: String
    }

    state Deactivated
  }

  slice ReactivateOrganization {
    actor PlatformAdmin
    ui OrganizationAdminScreen
    reactsTo OrganizationDeactivated

    command ReactivateOrganization {
      organizationId: UUID id technical
      reactivationReason: String
    }

    event OrganizationReactivated {
      organizationId: UUID id technical
      reactivationReason: String
    }

    state Active
  }

  slice OrganizationDirectory {
    ui OrganizationDirectory

    readmodel OrganizationDirectory[] {
      organizationId: UUID id
      organizationName: String display
      organizationType: OrganizationType
      state: Organization.State
      approvedDatasetCount: Int
      subscribe OrganizationRegistered
      subscribe OrganizationActivated
      subscribe OrganizationDeactivated
      subscribe OrganizationReactivated
      subscribe DatasetApprovedForTraining
    }
  }

  slice BindUserAccountToOrganization {
    startsLifecycle
    actor PlatformAdmin
    ui OrganizationAdminScreen

    command BindUserAccountToOrganization {
      userOrganizationMembershipId: UUID id generated technical
      userAccountId: UUID from UserAccountCatalog.userAccountId
      username: String? derived from UserAccountCatalog.username by userAccountId
      organizationId: UUID from OrganizationDirectory.organizationId
      organizationName: String? derived from OrganizationDirectory.organizationName by organizationId
      organizationUserRole: String?
    }

    event UserAccountBoundToOrganization {
      userOrganizationMembershipId: UUID id technical
      userAccountId: UUID
      username: String?
      organizationId: UUID
      organizationName: String?
      organizationUserRole: String?
    }

    state Active

    specification "User Account Organization Binding Unique" {
      rule """
        A user account can be bound to the same business organization only once.
      """

      expression {
        unique (UserOrganizationMembership.userAccountId, UserOrganizationMembership.organizationId)
      }

      scenario "Reject Duplicate User Organization Binding" {
        given UserAccountBoundToOrganization {
          userAccountId = "11111111-1111-4111-8111-111111111111"
          organizationId = "22222222-2222-4222-8222-222222222222"
        }
        when BindUserAccountToOrganization {
          userAccountId = "11111111-1111-4111-8111-111111111111"
          organizationId = "22222222-2222-4222-8222-222222222222"
        }
        then reject "User account is already bound to this organization."
      }
    }
  }

  slice UserOrganizationMembershipDirectory {
    ui OrganizationAdminScreen

    readmodel UserOrganizationMembershipDirectory[] {
      userOrganizationMembershipId: UUID id
      userAccountId: UUID
      username: String?
      organizationId: UUID
      organizationName: String?
      organizationUserRole: String?
      state: UserOrganizationMembership.State
      subscribe UserAccountBoundToOrganization
      subscribe UserAccountRegistered
      subscribe OrganizationRegistered
    }
  }

  concept Organization {
    state Registered
    state Active
    state Deactivated

    slice RegisterOrganization
    slice ActivateOrganization
    slice DeactivateOrganization
    slice ReactivateOrganization
    slice OrganizationDirectory
  }

  concept UserOrganizationMembership {
    state Active

    slice BindUserAccountToOrganization
    slice UserOrganizationMembershipDirectory
  }

}

context FederationManagement {
  note "Federation management owns federations and federation membership governance."

  risk "Inactive organizations joining a federation can compromise model governance and data sharing agreements."
  risk "Federation training can proceed with too few available organization-owned compute nodes if eligibility is not enforced."
  metric participantApprovalLeadTime
  metric federationActivationLeadTime

  slice CreateFederation {
    startsLifecycle

    tags {
      federationName
    }

    actor PlatformAdmin
    ui FederationSetupScreen form

    command CreateFederation {
      federationId: UUID id generated technical
      federationName: String
      description: String
      minimumParticipantCount: Int
    }

    event FederationCreated {
      federationId: UUID id technical
      federationName: String
      description: String
      minimumParticipantCount: Int
    }

    state Draft

    specification "Federation Name Unique" {
      rule """
        Federation names must be unique.
      """

      expression {
        unique Federation.federationName
      }

      scenario "Reject Duplicate Federation" {
        given FederationCreated {
          federationName = "B"
        }
        when CreateFederation {
          federationName = "B"
        }
        then reject "Federation Already Exists"
      }
    }
  }

  slice ActivateFederation {
    actor PlatformAdmin
    ui FederationSetupScreen
    reactsTo FederationCreated

    command ActivateFederation {
      federationId: UUID id technical
      activationNote: String?
    }

    event FederationActivated {
      federationId: UUID id technical
      activationNote: String?
    }

    state Active
  }

  slice SuspendFederation {
    actor PlatformAdmin
    ui FederationSetupScreen confirm
    reactsTo FederationActivated

    command SuspendFederation {
      federationId: UUID id technical
      suspensionReason: String
    }

    event FederationSuspended {
      federationId: UUID id technical
      suspensionReason: String
    }

    state Suspended
  }

  slice ReactivateFederation {
    actor PlatformAdmin
    ui FederationSetupScreen
    reactsTo FederationSuspended

    command ReactivateFederation {
      federationId: UUID id technical
      reactivationReason: String
    }

    event FederationReactivated {
      federationId: UUID id technical
      reactivationReason: String
    }

    state Active
  }

  slice FederationOverview {
    reactsTo ParticipantJoined

    readmodel FederationOverview[] {
      federationId: UUID id
      federationName: String display
      state: Federation.State
      minimumParticipantCount: Int
      activeMemberCount: Int
      pendingInvitationCount: Int
      activeRuntimeCount: Int
      activeTrainingJobCount: Int
      subscribe FederationCreated
      subscribe FederationActivated
      subscribe FederationSuspended
      subscribe FederationReactivated
      subscribe ParticipantInvited
      subscribe ParticipantJoined
      subscribe ParticipantRejected
      subscribe ParticipantInvitationRevoked
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe RuntimeIdentityActivated
      subscribe RuntimeIdentityRevoked
      subscribe TrainingJobSubmitted
    }
  }

  slice InviteParticipant {
    startsLifecycle

    tags {
      federationId
      organizationId
    }

    actor FederationOwner
    ui ParticipantInvitationScreen dialog
    reactsTo FederationCreated

    command InviteParticipant {
      federationId: UUID id technical
      federationName: String? derived from FederationOverview.federationName by federationId
      organizationId: UUID
      organizationName: String? derived from OrganizationDirectory.organizationName by organizationId
      invitationNote: String
    }

    event ParticipantInvited {
      federationId: UUID id technical
      federationName: String?
      organizationId: UUID
      organizationName: String?
      invitationNote: String
    }

    state Invited
  }


  slice FederationMembershipDirectory {
    reactsTo ParticipantInvited

    readmodel FederationMembershipDirectory[] {
      federationId: UUID id
      organizationId: UUID id
      federationName: String?
      organizationName: String?
      membershipStatus: String
      invitationNote: String?
      approvalNote: String?
      subscribe FederationCreated
      subscribe ParticipantInvited
      subscribe ParticipantJoined
      subscribe ParticipantRejected
      subscribe ParticipantInvitationRevoked
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe OrganizationRegistered
      subscribe OrganizationActivated
    }
  }

  slice ApproveParticipant {
    actor GovernanceReviewer

    ui MembershipReviewScreen dialog
    reactsTo ParticipantInvited

    command ApproveParticipant {
      federationId: UUID id technical
      federationName: String? from ParticipantInvited.federationName
      organizationId: UUID
      organizationName: String? from ParticipantInvited.organizationName
      approvalNote: String?
    }

    event ParticipantJoined {
      federationId: UUID id technical
      federationName: String?
      organizationId: UUID
      organizationName: String?
      approvalNote: String?
    }

    specification "Only Invited Active Organizations Join Federation" {
      rule """
        A participant can join only after the organization is active and has an outstanding invitation for the target federation.
      """

      scenario "Approve Invited Participant" {
        given ParticipantInvited {
          federationId = "fed-1"
          organizationId = "org-1"
        }
        when ApproveParticipant {
          federationId = "fed-1"
          organizationId = "org-1"
        }
        then ParticipantJoined
      }

      scenario "Reject Uninvited Participant Approval" {
        when ApproveParticipant {
          federationId = "fed-1"
          organizationId = "org-2"
        }
        then reject "Participant Invitation Required"
      }
    }

    state Active
  }

  slice RejectParticipant {
    actor GovernanceReviewer

    ui MembershipReviewScreen dialog
    reactsTo ParticipantInvited

    command RejectParticipant {
      federationId: UUID id technical
      federationName: String? from ParticipantInvited.federationName
      organizationId: UUID
      organizationName: String? from ParticipantInvited.organizationName
      rejectionReason: String
    }

    event ParticipantRejected {
      federationId: UUID id technical
      federationName: String?
      organizationId: UUID
      organizationName: String?
      rejectionReason: String
    }

    state Rejected
  }
  // 什么情况下可以撤销，已被使用能否撤销 TODO
  slice RevokeParticipantInvitation {
    actor FederationOwner
    ui ParticipantInvitationScreen confirm
    reactsTo ParticipantInvited

    command RevokeParticipantInvitation {
      federationId: UUID id technical
      federationName: String? from ParticipantInvited.federationName
      organizationId: UUID
      organizationName: String? from ParticipantInvited.organizationName
      revokeReason: String
    }

    event ParticipantInvitationRevoked {
      federationId: UUID id technical
      federationName: String?
      organizationId: UUID
      organizationName: String?
      revokeReason: String
    }

    state InvitationRevoked
  }

  slice SuspendParticipant {
    actor GovernanceReviewer
    ui MembershipReviewScreen dialog
    reactsTo ParticipantJoined

    command SuspendParticipant {
      federationId: UUID id technical
      federationName: String? from ParticipantJoined.federationName
      organizationId: UUID
      organizationName: String? from ParticipantJoined.organizationName
      suspensionReason: String
    }

    event ParticipantSuspended {
      federationId: UUID id technical
      federationName: String?
      organizationId: UUID
      organizationName: String?
      suspensionReason: String
    }

    state Suspended
  }

  slice RemoveParticipant {
    actor GovernanceReviewer
    ui MembershipReviewScreen confirm
    reactsTo ParticipantSuspended

    command RemoveParticipant {
      federationId: UUID id technical
      federationName: String? from ParticipantSuspended.federationName
      organizationId: UUID
      organizationName: String? from ParticipantSuspended.organizationName
      removalReason: String
    }

    event ParticipantRemoved {
      federationId: UUID id technical
      federationName: String?
      organizationId: UUID
      organizationName: String?
      removalReason: String
    }

    state Removed
  }


  concept Federation {
    state Draft
    state Active
    state Suspended

    slice CreateFederation
    slice ActivateFederation
    slice SuspendFederation
    slice ReactivateFederation
    slice FederationOverview
  }

  concept FederationMembership {
    state Invited
    state Active
    state Rejected
    state InvitationRevoked
    state Suspended
    state Removed

    slice InviteParticipant
    slice ApproveParticipant
    slice RejectParticipant
    slice RevokeParticipantInvitation
    slice SuspendParticipant
    slice RemoveParticipant
    slice FederationMembershipDirectory
  }

}

context DictionaryMaintenance {
  note "Dictionary maintenance owns dynamic option dictionaries used by platform contexts. Business contexts store valueCode and query DictionaryValueCatalog by dictionaryCode for display and selection."

  risk "Runtime option changes can invalidate pending installation plans if dictionary values are removed instead of disabled."
  risk "Duplicate dictionary value codes can cause inconsistent command payloads across deployables."
  metric dictionaryValueActivationLatency

  type DictionaryCode = String
  type DictionaryValueCode = String
  type DisplayOrder = Int {
    range 0..999999
  }

  slice RegisterDictionary {
    startsLifecycle

    actor PlatformAdmin
    ui DictionaryCatalogScreen

    tags {
      dictionaryCode
    }

    command RegisterDictionary {
      dictionaryId: UUID id generated technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      description: String?
    }

    event DictionaryRegistered {
      dictionaryId: UUID id technical
      dictionaryCode: DictionaryCode
      dictionaryName: String
      description: String?
    }

    state Registered

    specification "Dictionary Code Unique" {
      rule """
        FederDictionary Codes must be unique.
      """

      expression {
        unique Dictionary.dictionaryCode
      }

      scenario "Reject Duplicate Dictionary" {
        given DictionaryRegistered {
          dictionaryCode = "B"
        }
        when RegisterDictionary {
          dictionaryCode = "B"
        }
        then reject "Dictionary Already Exists"
      }
    }
  }

  slice UpdateDictionary {
    actor PlatformAdmin
    ui DictionaryCatalogScreen
    reactsTo DictionaryRegistered

    command UpdateDictionary {
      dictionaryId: UUID id technical
      dictionaryName: String
      description: String?
    }

    event DictionaryUpdated {
      dictionaryId: UUID id technical
      dictionaryName: String
      description: String?
    }
  }

  slice ArchiveDictionary {
    actor PlatformAdmin
    ui DictionaryCatalogScreen confirm
    reactsTo DictionaryRegistered

    command ArchiveDictionary {
      dictionaryId: UUID id technical
      archiveReason: String
    }

    event DictionaryArchived {
      dictionaryId: UUID id technical
      archiveReason: String
    }

    state Archived
  }

  slice DictionaryCatalog {
    readmodel DictionaryCatalog[] {
      dictionaryId: UUID id
      dictionaryCode: DictionaryCode query
      dictionaryName: String
      description: String?
      state: Dictionary.State
      registeredAt: DateTime
      updatedAt: DateTime?
      archivedAt: DateTime?
      archiveReason: String?
      subscribe DictionaryRegistered
      subscribe DictionaryUpdated
      subscribe DictionaryArchived
    }
  }

  slice AddDictionaryValue {
    startsLifecycle

    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryRegistered

    tags {
      dictionaryCode
      valueCode
    }

    command AddDictionaryValue {
      dictionaryValueId: UUID id generated technical
      dictionaryId: UUID
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
    }

    event DictionaryValueAdded {
      dictionaryValueId: UUID id technical
      dictionaryId: UUID
      dictionaryCode: DictionaryCode
      valueCode: DictionaryValueCode
      displayName: String
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean
    }

    state Active
  }

  slice DisableDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen confirm
    reactsTo DictionaryValueAdded

    command DisableDictionaryValue {
      dictionaryValueId: UUID id technical
      disabledReason: String
    }

    event DictionaryValueDisabled {
      dictionaryValueId: UUID id technical
      disabledReason: String
    }

    state Disabled
  }

  slice EnableDictionaryValue {
    actor PlatformAdmin
    ui DictionaryValueCatalogScreen
    reactsTo DictionaryValueDisabled

    command EnableDictionaryValue {
      dictionaryValueId: UUID id technical
      enableReason: String
    }

    event DictionaryValueEnabled {
      dictionaryValueId: UUID id technical
      enableReason: String
    }

    state Active
  }

  slice DictionaryValueCatalog {
    readmodel DictionaryValueCatalog[] {
      dictionaryProvider DictionaryValueCatalog {
        code dictionaryCode
        value valueCode
        label displayName
        active active
        state state
        order displayOrder
      }
      dictionaryValueId: UUID id
      dictionaryId: UUID
      dictionaryCode: DictionaryCode query
      valueCode: DictionaryValueCode
      displayName: String display
      displayOrder: DisplayOrder?
      description: String?
      active: Boolean query
      state: DictionaryValue.State
      addedAt: DateTime
      updatedAt: DateTime?
      disabledAt: DateTime?
      disabledReason: String?
      enabledAt: DateTime?
      subscribe DictionaryValueAdded
      subscribe DictionaryValueDisabled
      subscribe DictionaryValueEnabled
    }
  }

  concept Dictionary {
    state Registered
    state Archived

    slice RegisterDictionary
    slice UpdateDictionary
    slice ArchiveDictionary
    slice DictionaryCatalog
  }

  concept DictionaryValue {
    state Active
    state Disabled

    slice AddDictionaryValue
    slice DisableDictionaryValue
    slice EnableDictionaryValue
    slice DictionaryValueCatalog
  }
}

context FileUpload {
  note "FileUpload is the shared persistent file-storage boundary. It stores uploaded content through a replaceable storage adapter, records each uploaded file, exposes an authenticated content URI, and applies optional retention through expiresAt. Business domains reference the uploaded file record instead of creating another physical storage tier."

  risk "Stored files can leak sensitive model or dataset content if retention, ownership, authorization, and content validation are not enforced."
  risk "Business references can become invalid if retention expires a file that is still referenced by a domain record."
  metric fileUploadLatency
  metric fileUploadFailureRate

  slice UploadFile {
    startsLifecycle

    actor PlatformUser
    ui FileUploadDialog

    command UploadFile {
      fileId: UUID id generated technical
      uploadedFile: String uploadFile
      originalFileName: String technical
      contentType: String? technical
      sizeBytes: Long? technical
      fileLocation: String technical
      checksum: String? technical
      expiresAt: DateTime technical
      purpose: String
    }

    event FileUploaded {
      fileId: UUID id technical
      originalFileName: String display
      contentType: String?
      sizeBytes: Long?
      purpose: String
      fileLocation: String
      checksum: String?
      expiresAt: DateTime
    }

    state Available

    specification "Uploaded File Is Persisted And Recorded" {
      rule """
        A file field uploads the selected content through the FileUpload deployment. The storage adapter persists the bytes in its configured backend, computes checksum metadata, assigns an authenticated content URI, and records the upload under fileId. Business domains keep the returned reference and own its business meaning. expiresAt is the retention policy for the same stored object.
      """

      scenario "Upload File For Model Import" {
        when UploadFile {
          fileId = "file-1"
          uploadedFile = "file://credit-risk-initial.onnx"
          originalFileName = "credit-risk-initial.onnx"
          contentType = "application/octet-stream"
          sizeBytes = 2048
          fileLocation = "file://uploads/file-1/credit-risk-initial.onnx"
          checksum = "sha256:model"
          expiresAt = "2026-07-25T12:00:00"
          purpose = "MODEL_ARTIFACT_IMPORT"
        }
        then FileUploaded
      }
    }
  }

  slice MarkFileReferenced {
    actor PlatformService
    reactsTo FileUploaded

    command MarkFileReferenced {
      fileId: UUID id technical
      referencedByContext: String
      referencedByCommand: String
      referencedByCommandId: UUID?
    }

    event FileReferenced {
      fileId: UUID id technical
      referencedByContext: String
      referencedByCommand: String
      referencedByCommandId: UUID?
    }

    state Referenced

    specification "Referenced File Is Protected From User Discard" {
      rule """
        A file is marked referenced when a business record accepts its fileId. Referencing does not copy the bytes into another storage tier; it records which business operation relies on the shared stored object. Physical cleanup remains controlled by expiresAt and reference-aware storage management.
      """

      scenario "Mark File Referenced By Model Import" {
        given FileUploaded {
          fileId = "file-1"
        }
        when MarkFileReferenced {
          fileId = "file-1"
          referencedByContext = "ModelRepository"
          referencedByCommand = "RegisterModelArtifact"
        }
        then FileReferenced
      }
    }
  }

  slice DownloadFile {
    actor PlatformUser
    ui UploadedFileCatalogScreen
    reactsTo FileUploaded
    port

    command DownloadFile {
      fileId: UUID id technical
    }

    event FileDownloadAuthorized {
      fileId: UUID id technical
      originalFileName: String
      contentType: String?
      sizeBytes: Long?
      downloadUri: String
    }

    specification "Only Available Stored Files Can Be Downloaded" {
      rule """
        DownloadFile resolves an authenticated content URI through the configured FileUpload storage adapter. The command carries only fileId; original file metadata and downloadUri are resolved from UploadedFile state and the storage backend. File bytes are streamed by the download resource and are never copied into an Axon command or event. Referenced files remain downloadable, while discarded or expired files are rejected.
      """

      scenario "Authorize Available File Download" {
        given FileUploaded {
          fileId = "file-1"
          originalFileName = "credit-risk-initial.onnx"
          contentType = "application/octet-stream"
          sizeBytes = 2048
          fileLocation = "file://uploads/file-1/credit-risk-initial.onnx"
        }
        when DownloadFile {
          fileId = "file-1"
        }
        then FileDownloadAuthorized
      }

      scenario "Reject Expired File Download" {
        given FileExpired {
          fileId = "file-2"
        }
        when DownloadFile {
          fileId = "file-2"
        }
        then error "File is not available for download."
      }
    }
  }

  slice DiscardFile {
    actor PlatformUser
    ui FileUploadDialog
    reactsTo FileUploaded

    command DiscardFile {
      fileId: UUID id technical
      discardReason: String?
    }

    event FileDiscarded {
      fileId: UUID id technical
      discardReason: String?
    }

    state Discarded

    specification "Only Unreferenced Files Can Be Discarded" {
      rule """
        A user can discard an uploaded file while no business record references it. Discarding records the removal request and prevents later business commands from using the file location.
      """

      scenario "Discard Unreferenced File" {
        given FileUploaded {
          fileId = "file-1"
        }
        when DiscardFile {
          fileId = "file-1"
          discardReason = "Wrong file selected."
        }
        then FileDiscarded
      }

      scenario "Reject Discard After Consumption" {
        given FileReferenced {
          fileId = "file-2"
        }
        when DiscardFile {
          fileId = "file-2"
        }
        then reject "File Is Referenced"
      }
    }
  }

  slice ExpireFile {
    reactsTo FileUploaded

    automation ExpireFileWhenRetentionElapsed {
      on FileUploaded
      condition fileExpired == true
      emits ExpireFile
    }

    command ExpireFile {
      fileId: UUID id technical
      expiredAt: DateTime
      expirationReason: String
    }

    event FileExpired {
      fileId: UUID id technical
      expiredAt: DateTime
      expirationReason: String
    }

    state Expired

    specification "Expired File Cannot Be Referenced" {
      rule """
        An uploaded file expires when its configured expiresAt is reached. Expiration prevents later use of the file location and allows the configured storage adapter to remove that stored object.
      """

      scenario "Expire Uploaded File" {
        given FileUploaded {
          fileId = "file-1"
        }
        when ExpireFile {
          fileId = "file-1"
          expirationReason = "Retention window elapsed."
        }
        then FileExpired
      }

      scenario "Reject Consumption After Expiration" {
        given FileExpired {
          fileId = "file-2"
        }
        when MarkFileReferenced {
          fileId = "file-2"
          referencedByContext = "ModelRepository"
          referencedByCommand = "RegisterModelArtifact"
        }
        then reject "File Expired"
      }
    }
  }

  slice UploadedFileCatalog {
    readmodel UploadedFileCatalog[] {
      fileId: UUID id
      originalFileName: String display
      contentType: String?
      sizeBytes: Long?
      purpose: String query
      fileLocation: String
      checksum: String?
      state: UploadedFile.State
      uploadedAt: DateTime?
      referencedAt: DateTime?
      referencedByContext: String?
      referencedByCommand: String?
      referencedByCommandId: UUID?
      discardedAt: DateTime?
      discardReason: String?
      expiresAt: DateTime?
      expiredAt: DateTime?
      expirationReason: String?
      subscribe FileUploaded
      subscribe FileReferenced
      subscribe FileDiscarded
      subscribe FileExpired
    }
  }

  concept UploadedFile {
    state Available
    state Referenced
    state Discarded
    state Expired

    slice UploadFile
    slice MarkFileReferenced
    slice DownloadFile
    slice DiscardFile
    slice ExpireFile
    slice UploadedFileCatalog
  }
}

context RuntimeProvisioning {
  note "Runtime onboarding owns runtime installation planning, bootstrap configuration, runtime environment registration, agent installation, readiness, connection reporting, and access revocation. K3s, Kubernetes, Docker Compose, and host process runtimes are installation targets, not separate domain concepts."
  note "Runtime bootstrap and agent installation material is support configuration, not domain state: the platform backend adapter reads platform.runtime.bootstrap.publicBaseAddress, platform.runtime.agent.platformApiBaseAddress, platform.runtime.agent.controlApiBaseAddress, platform.runtime.agent.containerRegistry, platform.runtime.agent.trustBundleSecretName, and platform.runtime.agent.accessGrantSecretPrefix from deployment config or a secret store. Commands, events, and read models keep only runtimeInstallationPlanId, runtimeInfrastructurePackageId, and generated access grant IDs."

  risk "Organizations can receive wrong runtime installation guidance and fail to connect runtime infrastructure."
  risk "Leaked bootstrap tokens can allow unauthorized infrastructure to join the platform."
  metric runtimeBootstrapSuccessRate
  metric runtimeInfrastructureConnectionLatency

  external RuntimeAgent {
    kind runtime-agent
    protocol http
    capabilities {
      command RequestDatasetAccess
      event DatasetAccessValidated
    }
  }

  slice RegisterRuntimeInfrastructurePackage {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeInfrastructurePackageCatalogScreen

    tags {
      packageName = normalize(packageName)
      packageVersion
    }

    command RegisterRuntimeInfrastructurePackage {
      runtimeInfrastructurePackageId: UUID id generated technical
      packageName: String display
      packageVersion: String
      // 安装包支持的 runtime 环境类型；真实包地址、签名、secret 由平台包服务按 packageId 解析。
      runtimeEnvironmentType: String dictionary "RUNTIME_ENVIRONMENT_TYPE"
    }

    event RuntimeInfrastructurePackageRegistered {
      runtimeInfrastructurePackageId: UUID id technical
      packageName: String
      packageVersion: String
      runtimeEnvironmentType: String dictionary "RUNTIME_ENVIRONMENT_TYPE"
    }

    state Registered
  }

  slice RuntimeInfrastructurePackageCatalog {
    readmodel RuntimeInfrastructurePackageCatalog[] {
      runtimeInfrastructurePackageId: UUID id
      packageName: String display
      packageVersion: String
      runtimeEnvironmentType: String dictionary "RUNTIME_ENVIRONMENT_TYPE"
      state: RuntimeInfrastructurePackage.State
      subscribe RuntimeInfrastructurePackageRegistered
    }
  }

  // Runtime installation plan describes how an organization runtime will be onboarded.
  // PlatformAdmin selects a platform-maintained infrastructure package; RuntimeInstaller follows the generated bootstrap command to prepare K3s, Docker Compose, or local runtime.
  // After infrastructure registration and verification, the platform requests runtime agent installation according to this plan.
  slice CreateRuntimeInstallationPlan {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo OrganizationActivated
    port

    tags {
      organizationId
    }

    command CreateRuntimeInstallationPlan {
      runtimeInstallationPlanId: UUID id generated technical
      runtimeInfrastructureId: UUID generated technical
      organizationId: UUID
      organizationName: String? derived from OrganizationDirectory.organizationName by organizationId
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructurePackageCatalog.packageName by runtimeInfrastructurePackageId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructurePackageCatalog.packageVersion by runtimeInfrastructurePackageId
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" derived from RuntimeInfrastructurePackageCatalog.runtimeEnvironmentType by runtimeInfrastructurePackageId
      runtimeName: String
      // agent 安装责任模式，表达是平台自动请求安装，还是仅生成指引由人工执行。
      // 例：PLATFORM_MANAGED、MANUAL_GUIDED。
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
    }

    event RuntimeInstallationPlanCreated {
      runtimeInstallationPlanId: UUID id technical
      runtimeInfrastructureId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      bootstrapCommand: Text portOutput
      nodeLabelCommand: Text portOutput
      nodeTaintCommand: Text portOutput
      runtimeAgentNodeSelectorYaml: Text portOutput
      runtimeAgentTolerationsYaml: Text portOutput
      bootstrapConfigYaml: Text portOutput
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
    }

    state Planned
  }

  slice RuntimeInstallationPlanCatalog {
    ui RuntimeInstallationPlanScreen

    readmodel RuntimeInstallationPlanCatalog[] {
      runtimeInstallationPlanId: UUID id
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      planStatus: String
      runtimeInfrastructureId: UUID?
      preparedAt: DateTime?
      preparedNodeCount: Int?
      observedNodeCount: Int?
      runtimeAgentId: UUID?
      runtimeAgentVersion: String?
      plannedAt: DateTime
      verifiedAt: DateTime?
      verificationFailedAt: DateTime?
      verificationFailureReason: String?
      agentReadyAt: DateTime?
      agentDeploymentFailedAt: DateTime?
      agentDeploymentFailureReason: String?
      agentDeploymentRetryFailedAt: DateTime?
      agentDeploymentRetryFailureReason: String?
      lastConnectedAt: DateTime?
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructurePackageRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructurePlanned
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructurePrepared
      subscribe RuntimeInfrastructureVerified
      subscribe RuntimeInfrastructureVerificationFailed
      subscribe RuntimeInfrastructureVerificationRetrySucceeded
      subscribe RuntimeInfrastructureVerificationRetryFailed
      subscribe RuntimeAgentInstallationSucceeded
      subscribe RuntimeAgentInstallationFailed
      subscribe RuntimeAgentDeploymentRetrySucceeded
      subscribe RuntimeAgentDeploymentRetryFailed
      subscribe RuntimeConnectionEstablished
    }
  }

  slice RuntimeInstallationGuide {
    actor RuntimeInstaller
    ui RuntimeInstallationGuideScreen
    reactsTo RuntimeInstallationPlanCreated

    readmodel RuntimeInstallationGuide[] {
      runtimeInstallationPlanId: UUID id
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID?
      runtimeInfrastructureState: RuntimeInfrastructure.State?
      runtimeInfrastructurePackageId: UUID?
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      organizationName: String?
      runtimeName: String?
      bootstrapCommand: Text
      nodeLabelCommand: Text
      nodeTaintCommand: Text
      runtimeAgentNodeSelectorYaml: Text
      runtimeAgentTolerationsYaml: Text
      bootstrapConfigYaml: Text
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      agentInstallMode: String? dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int?
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructurePackageRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructurePlanned
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructurePrepared
      subscribe RuntimeInfrastructureVerified
      subscribe RuntimeInfrastructureVerificationFailed
      subscribe RuntimeInfrastructureVerificationRetrySucceeded
      subscribe RuntimeInfrastructureVerificationRetryFailed
    }
  }

  slice PlanRuntimeInfrastructure {
    startsLifecycle

    actor PlatformAdmin
    reactsTo RuntimeInstallationPlanCreated

    automation PlanRuntimeInfrastructureWhenInstallationPlanCreated {
      on RuntimeInstallationPlanCreated
      emits PlanRuntimeInfrastructure
    }

    command PlanRuntimeInfrastructure {
      runtimeInfrastructureId: UUID id technical from RuntimeInstallationPlanCreated.runtimeInfrastructureId
      runtimeInstallationPlanId: UUID technical from RuntimeInstallationPlanCreated.runtimeInstallationPlanId
      organizationId: UUID from RuntimeInstallationPlanCreated.organizationId
      organizationName: String? from RuntimeInstallationPlanCreated.organizationName
      runtimeInfrastructurePackageId: UUID from RuntimeInstallationPlanCreated.runtimeInfrastructurePackageId
      runtimeInfrastructurePackageName: String? from RuntimeInstallationPlanCreated.runtimeInfrastructurePackageName
      runtimeInfrastructurePackageVersion: String? from RuntimeInstallationPlanCreated.runtimeInfrastructurePackageVersion
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" from RuntimeInstallationPlanCreated.runtimeEnvironmentType
      runtimeName: String from RuntimeInstallationPlanCreated.runtimeName
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" from RuntimeInstallationPlanCreated.agentInstallMode
      expectedNodeCount: Int from RuntimeInstallationPlanCreated.expectedNodeCount
    }

    event RuntimeInfrastructurePlanned {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
    }

    state Planned
  }

  slice RegisterRuntimeInfrastructure {
    actor RuntimeInstaller
    reactsTo RuntimeInfrastructurePlanned

    command RegisterRuntimeInfrastructure {
      runtimeInfrastructureId: UUID id technical from RuntimeInfrastructurePlanned.runtimeInfrastructureId
      runtimeInstallationPlanId: UUID technical from RuntimeInfrastructurePlanned.runtimeInstallationPlanId
      organizationId: UUID from RuntimeInfrastructurePlanned.organizationId
      organizationName: String? from RuntimeInfrastructurePlanned.organizationName
      runtimeInfrastructurePackageId: UUID from RuntimeInfrastructurePlanned.runtimeInfrastructurePackageId
      runtimeInfrastructurePackageName: String? from RuntimeInfrastructurePlanned.runtimeInfrastructurePackageName
      runtimeInfrastructurePackageVersion: String? from RuntimeInfrastructurePlanned.runtimeInfrastructurePackageVersion
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" from RuntimeInfrastructurePlanned.runtimeEnvironmentType
      runtimeName: String from RuntimeInfrastructurePlanned.runtimeName
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" from RuntimeInfrastructurePlanned.agentInstallMode
      expectedNodeCount: Int from RuntimeInfrastructurePlanned.expectedNodeCount
      runtimeAgentId: UUID generated technical
    }

    event RuntimeInfrastructureRegistered {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      runtimeAgentId: UUID technical
    }

    state Registered
  }

  slice ConfirmRuntimeInfrastructurePrepared {
    actor RuntimeInstaller
    ui RuntimeInstallationGuideScreen
    reactsTo RuntimeInfrastructureRegistered

    command ConfirmRuntimeInfrastructurePrepared {
      runtimeInfrastructureId: UUID id technical from RuntimeInfrastructureRegistered.runtimeInfrastructureId
      runtimeInstallationPlanId: UUID technical from RuntimeInfrastructureRegistered.runtimeInstallationPlanId
      organizationId: UUID from RuntimeInfrastructureRegistered.organizationId
      organizationName: String? from RuntimeInfrastructureRegistered.organizationName
      runtimeInfrastructurePackageId: UUID from RuntimeInfrastructureRegistered.runtimeInfrastructurePackageId
      runtimeInfrastructurePackageName: String? from RuntimeInfrastructureRegistered.runtimeInfrastructurePackageName
      runtimeInfrastructurePackageVersion: String? from RuntimeInfrastructureRegistered.runtimeInfrastructurePackageVersion
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" from RuntimeInfrastructureRegistered.runtimeEnvironmentType
      runtimeName: String from RuntimeInfrastructureRegistered.runtimeName
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" from RuntimeInfrastructureRegistered.agentInstallMode
      expectedNodeCount: Int from RuntimeInfrastructureRegistered.expectedNodeCount
      runtimeAgentId: UUID technical from RuntimeInfrastructureRegistered.runtimeAgentId
      preparedNodeCount: Int
      preparationNotes: String?
    }

    event RuntimeInfrastructurePrepared {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      runtimeAgentId: UUID technical
      preparedNodeCount: Int
      preparationNotes: String?
    }

    state Prepared

    specification "Runtime Infrastructure Prepared Before Verification" {
      rule """
        Runtime infrastructure registration records the planned participant infrastructure only. Verification and platform-managed runtime agent deployment must wait until the runtime installer confirms that the K3s agent node has joined the target cluster and the generated labels and taints have been applied.
      """

      scenario "Confirm Runtime Infrastructure Prepared" {
        given RuntimeInfrastructureRegistered {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        when ConfirmRuntimeInfrastructurePrepared {
          runtimeInfrastructureId = "runtime-infra-1"
          preparedNodeCount = 1
          preparationNotes = "K3s agent joined and node scheduling labels were applied."
        }
        then RuntimeInfrastructurePrepared
      }
    }
  }

  slice VerifyRuntimeInfrastructure {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo RuntimeInfrastructurePrepared
    port

    automation VerifyInfrastructureWhenPrepared {
      on RuntimeInfrastructurePrepared
      emits VerifyRuntimeInfrastructure
    }

    command VerifyRuntimeInfrastructure {
      runtimeInfrastructureId: UUID id technical from RuntimeInfrastructurePrepared.runtimeInfrastructureId
      runtimeInstallationPlanId: UUID technical from RuntimeInfrastructurePrepared.runtimeInstallationPlanId
      organizationId: UUID from RuntimeInfrastructurePrepared.organizationId
      organizationName: String? from RuntimeInfrastructurePrepared.organizationName
      runtimeInfrastructurePackageId: UUID from RuntimeInfrastructurePrepared.runtimeInfrastructurePackageId
      runtimeInfrastructurePackageName: String? from RuntimeInfrastructurePrepared.runtimeInfrastructurePackageName
      runtimeInfrastructurePackageVersion: String? from RuntimeInfrastructurePrepared.runtimeInfrastructurePackageVersion
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" from RuntimeInfrastructurePrepared.runtimeEnvironmentType
      runtimeName: String from RuntimeInfrastructurePrepared.runtimeName
      expectedNodeCount: Int from RuntimeInfrastructurePrepared.expectedNodeCount
      runtimeAgentId: UUID technical from RuntimeInfrastructurePrepared.runtimeAgentId
    }

    event RuntimeInfrastructureVerified {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      runtimeAgentId: UUID technical
      agentInstallMode: String portOutput dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      observedNodeCount: Int portOutput
    }

    event RuntimeInfrastructureVerificationFailed {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      runtimeAgentId: UUID technical
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      observedNodeCount: Int? portOutput
      failureReason: String portOutput
    }

    state Verified

    specification "Runtime Infrastructure Verification Outcome" {
      rule """
        Runtime infrastructure verification runs once after the runtime installer confirms that the participant node has joined the target runtime infrastructure and the generated scheduling labels and taints have been applied. The verification processor resolves the selected runtime infrastructure package and records exactly one outcome: RuntimeInfrastructureVerified when the runtime environment is usable, or RuntimeInfrastructureVerificationFailed when required checks fail.
      """

      scenario "Runtime Infrastructure Verification Passed" {
        given RuntimeInfrastructurePrepared {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        when VerifyRuntimeInfrastructure {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        then RuntimeInfrastructureVerified
      }

      scenario "Runtime Infrastructure Verification Failed" {
        given RuntimeInfrastructurePrepared {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when VerifyRuntimeInfrastructure {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        then RuntimeInfrastructureVerificationFailed
      }
    }
  }

  slice DeployRuntimeAgent {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo RuntimeInfrastructureVerified
    port

    automation DeployRuntimeAgentWhenInfrastructureVerified {
      on RuntimeInfrastructureVerified
      condition agentInstallMode == "PLATFORM_MANAGED"
      emits DeployRuntimeAgent
    }

    automation DeployRuntimeAgentWhenInfrastructureVerificationRetrySucceeded {
      on RuntimeInfrastructureVerificationRetrySucceeded
      condition agentInstallMode == "PLATFORM_MANAGED"
      emits DeployRuntimeAgent
    }

    command DeployRuntimeAgent {
      runtimeAgentId: UUID technical derived from RuntimeInfrastructureAccessView.runtimeAgentId by runtimeInfrastructureId
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical derived from RuntimeInfrastructureAccessView.runtimeInstallationPlanId by runtimeInfrastructureId
      organizationId: UUID derived from RuntimeInfrastructureAccessView.organizationId by runtimeInfrastructureId
      organizationName: String? derived from RuntimeInfrastructureAccessView.organizationName by runtimeInfrastructureId
      runtimeInfrastructurePackageId: UUID derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageId by runtimeInfrastructureId
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageName by runtimeInfrastructureId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageVersion by runtimeInfrastructureId
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" derived from RuntimeInfrastructureAccessView.runtimeEnvironmentType by runtimeInfrastructureId
      runtimeName: String derived from RuntimeInfrastructureAccessView.runtimeName by runtimeInfrastructureId
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" derived from RuntimeInfrastructureAccessView.agentInstallMode by runtimeInfrastructureId
      expectedNodeCount: Int derived from RuntimeInfrastructureAccessView.expectedNodeCount by runtimeInfrastructureId
    }

    event RuntimeAgentInstallationSucceeded {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      runtimeAgentId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      agentVersion: String
    }

    event RuntimeAgentInstallationFailed {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      runtimeAgentId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      failureReason: String
    }

    state AgentReady

    specification "Runtime Agent Deployment Outcome" {
      rule """
        Runtime agent deployment runs automatically after the runtime infrastructure is verified when the selected installation mode is platform managed. The deployment service deploys the agent workload to the target infrastructure and records exactly one outcome: RuntimeAgentInstallationSucceeded when the agent starts and passes its readiness checks, or RuntimeAgentInstallationFailed when deployment or readiness fails.
      """

      scenario "Runtime Agent Deployment Succeeded" {
        given RuntimeInfrastructureVerified {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        when DeployRuntimeAgent {
          runtimeInfrastructureId = "runtime-infra-1"
        }
        then RuntimeAgentInstallationSucceeded
      }

      scenario "Runtime Agent Deployment Failed" {
        given RuntimeInfrastructureVerified {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when DeployRuntimeAgent {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        then RuntimeAgentInstallationFailed
      }
    }
  }

  slice RetryRuntimeInfrastructureVerification {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen confirm
    port

    command RetryRuntimeInfrastructureVerification {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical derived from RuntimeInfrastructureAccessView.runtimeInstallationPlanId by runtimeInfrastructureId
      organizationId: UUID derived from RuntimeInfrastructureAccessView.organizationId by runtimeInfrastructureId
      organizationName: String? derived from RuntimeInfrastructureAccessView.organizationName by runtimeInfrastructureId
      runtimeInfrastructurePackageId: UUID derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageId by runtimeInfrastructureId
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageName by runtimeInfrastructureId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageVersion by runtimeInfrastructureId
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" derived from RuntimeInfrastructureAccessView.runtimeEnvironmentType by runtimeInfrastructureId
      runtimeName: String derived from RuntimeInfrastructureAccessView.runtimeName by runtimeInfrastructureId
      runtimeAgentId: UUID technical derived from RuntimeInfrastructureAccessView.runtimeAgentId by runtimeInfrastructureId
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" derived from RuntimeInfrastructureAccessView.agentInstallMode by runtimeInfrastructureId
      expectedNodeCount: Int derived from RuntimeInfrastructureAccessView.expectedNodeCount by runtimeInfrastructureId
      currentRuntimeInfrastructureState: RuntimeInfrastructure.State derived from RuntimeInfrastructureAccessView.state by runtimeInfrastructureId
      retryReason: String
    }

    event RuntimeInfrastructureVerificationRetrySucceeded {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      runtimeAgentId: UUID technical
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      observedNodeCount: Int portOutput
      retryReason: String
    }

    event RuntimeInfrastructureVerificationRetryFailed {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      runtimeAgentId: UUID technical
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      observedNodeCount: Int? portOutput
      retryReason: String
      failureReason: String portOutput
    }

    state Verified

    specification "Runtime Infrastructure Verification Retry Outcome" {
      rule """
        A platform admin can retry runtime infrastructure verification after fixing external runtime preparation problems such as missing Kubernetes node labels, unavailable nodes, registry access, or scheduler RBAC. The retry is allowed only from the VerificationFailed state and records exactly one new outcome without rewriting the original failed verification event.
      """

      scenario "Runtime Infrastructure Verification Retry Succeeded" {
        given RuntimeInfrastructureVerificationFailed {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when RetryRuntimeInfrastructureVerification {
          runtimeInfrastructureId = "runtime-infra-2"
          currentRuntimeInfrastructureState = "VerificationFailed"
          retryReason = "Retry after applying runtime scheduling labels and RBAC."
        }
        then RuntimeInfrastructureVerificationRetrySucceeded
      }

      scenario "Runtime Infrastructure Verification Retry Failed" {
        given RuntimeInfrastructureVerificationFailed {
          runtimeInfrastructureId = "runtime-infra-3"
        }
        when RetryRuntimeInfrastructureVerification {
          runtimeInfrastructureId = "runtime-infra-3"
          currentRuntimeInfrastructureState = "VerificationFailed"
          retryReason = "Retry after adding the participant node."
        }
        then RuntimeInfrastructureVerificationRetryFailed
      }

      scenario "Reject Runtime Infrastructure Verification Retry While Verified" {
        given RuntimeInfrastructureVerified {
          runtimeInfrastructureId = "runtime-infra-4"
        }
        when RetryRuntimeInfrastructureVerification {
          runtimeInfrastructureId = "runtime-infra-4"
          currentRuntimeInfrastructureState = "Verified"
          retryReason = "Retry already verified infrastructure."
        }
        then reject "Runtime Infrastructure Verification Retry Not Allowed"
      }
    }
  }

  slice RetryRuntimeAgentDeployment {
    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen confirm
    port

    command RetryRuntimeAgentDeployment {
      runtimeAgentId: UUID technical derived from RuntimeInfrastructureAccessView.runtimeAgentId by runtimeInfrastructureId
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical derived from RuntimeInfrastructureAccessView.runtimeInstallationPlanId by runtimeInfrastructureId
      organizationId: UUID derived from RuntimeInfrastructureAccessView.organizationId by runtimeInfrastructureId
      organizationName: String? derived from RuntimeInfrastructureAccessView.organizationName by runtimeInfrastructureId
      runtimeInfrastructurePackageId: UUID derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageId by runtimeInfrastructureId
      runtimeInfrastructurePackageName: String? derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageName by runtimeInfrastructureId
      runtimeInfrastructurePackageVersion: String? derived from RuntimeInfrastructureAccessView.runtimeInfrastructurePackageVersion by runtimeInfrastructureId
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE" derived from RuntimeInfrastructureAccessView.runtimeEnvironmentType by runtimeInfrastructureId
      runtimeName: String derived from RuntimeInfrastructureAccessView.runtimeName by runtimeInfrastructureId
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" derived from RuntimeInfrastructureAccessView.agentInstallMode by runtimeInfrastructureId
      expectedNodeCount: Int derived from RuntimeInfrastructureAccessView.expectedNodeCount by runtimeInfrastructureId
      currentRuntimeInfrastructureState: RuntimeInfrastructure.State derived from RuntimeInfrastructureAccessView.state by runtimeInfrastructureId
      retryReason: String
    }

    event RuntimeAgentDeploymentRetrySucceeded {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      runtimeAgentId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      agentVersion: String
    }

    event RuntimeAgentDeploymentRetryFailed {
      runtimeInfrastructureId: UUID id technical
      runtimeInstallationPlanId: UUID technical
      runtimeAgentId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      runtimeName: String
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      failureReason: String
    }

    state AgentReady

    specification "Runtime Agent Deployment Retry Outcome" {
      rule """
        The runtime installation plan screen exposes a retry deployment action only when the current runtime infrastructure state is RuntimeAgentFailed or Offline. A platform admin manually triggers the same platform-managed deployment port from the page; no human installs the agent on the server. The retry records exactly one outcome: RuntimeAgentDeploymentRetrySucceeded when the agent becomes ready, or RuntimeAgentDeploymentRetryFailed when deployment or readiness fails again.
      """

      scenario "Runtime Agent Deployment Retry Succeeded After Failed Deployment" {
        given RuntimeAgentInstallationFailed {
          runtimeInfrastructureId = "runtime-infra-2"
        }
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-2"
          currentRuntimeInfrastructureState = "RuntimeAgentFailed"
          retryReason = "Retry after fixing registry credentials."
        }
        then RuntimeAgentDeploymentRetrySucceeded
      }

      scenario "Runtime Agent Deployment Retry Succeeded After Offline" {
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-3"
          currentRuntimeInfrastructureState = "Offline"
          retryReason = "Reconnect runtime agent."
        }
        then RuntimeAgentDeploymentRetrySucceeded
      }

      scenario "Runtime Agent Deployment Retry Failed" {
        given RuntimeAgentInstallationFailed {
          runtimeInfrastructureId = "runtime-infra-4"
        }
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-4"
          currentRuntimeInfrastructureState = "RuntimeAgentFailed"
          retryReason = "Retry after transient failure."
        }
        then RuntimeAgentDeploymentRetryFailed
      }

      scenario "Reject Runtime Agent Deployment Retry While Connected" {
        given RuntimeConnectionEstablished {
          runtimeInfrastructureId = "runtime-infra-5"
        }
        when RetryRuntimeAgentDeployment {
          runtimeInfrastructureId = "runtime-infra-5"
          currentRuntimeInfrastructureState = "Connected"
          retryReason = "Force redeploy."
        }
        then reject "Runtime Agent Deployment Retry Not Allowed"
      }
    }
  }

  slice RecordRuntimeConnectionEstablished {
    reactsTo AgentRuntimeConnectionEstablished

    command RecordRuntimeConnectionEstablished {
      runtimeInfrastructureId: UUID id technical from AgentRuntimeConnectionEstablished.runtimeInfrastructureId
      runtimeAgentId: UUID from AgentRuntimeConnectionEstablished.runtimeAgentId
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE" derived from RuntimeInfrastructureAccessView.agentInstallMode by runtimeInfrastructureId
      organizationId: UUID derived from RuntimeInfrastructureAccessView.organizationId by runtimeInfrastructureId
      organizationName: String? derived from RuntimeInfrastructureAccessView.organizationName by runtimeInfrastructureId
      runtimeName: String derived from RuntimeInfrastructureAccessView.runtimeName by runtimeInfrastructureId
      runtimeAgentEndpoint: String from AgentRuntimeConnectionEstablished.runtimeAgentEndpoint
      endpointScope: String dictionary "RUNTIME_AGENT_ENDPOINT_SCOPE" from AgentRuntimeConnectionEstablished.endpointScope
    }

    event RuntimeConnectionEstablished {
      runtimeInfrastructureId: UUID id technical
      runtimeAgentId: UUID
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      organizationId: UUID
      organizationName: String?
      runtimeName: String
      runtimeAgentEndpoint: String
      endpointScope: String dictionary "RUNTIME_AGENT_ENDPOINT_SCOPE"
    }

    state Connected
  }

  slice RuntimeAgentEndpointCatalog {
    readmodel RuntimeAgentEndpointCatalog[] {
      runtimeAgentId: UUID id
      runtimeId: UUID?
      runtimeInfrastructureId: UUID
      organizationId: UUID
      runtimeName: String
      runtimeAgentEndpoint: String
      endpointScope: String dictionary "RUNTIME_AGENT_ENDPOINT_SCOPE"
      connectionStatus: String
      connectedAt: DateTime?
      activatedAt: DateTime?
      subscribe RuntimeConnectionEstablished
      subscribe RuntimeIdentityActivated
      subscribe RuntimeIdentityRevoked
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
    }
  }

  slice RuntimeInfrastructureAccessView {
    readmodel RuntimeInfrastructureAccessView[] {
      runtimeInfrastructureId: UUID id
      organizationId: UUID
      runtimeInstallationPlanId: UUID
      runtimeInfrastructurePackageId: UUID
      runtimeInfrastructurePackageName: String?
      runtimeInfrastructurePackageVersion: String?
      organizationName: String?
      runtimeName: String?
      runtimeEnvironmentType: String? dictionary "RUNTIME_ENVIRONMENT_TYPE"
      agentInstallMode: String dictionary "RUNTIME_AGENT_INSTALL_MODE"
      expectedNodeCount: Int
      runtimeAgentId: UUID?
      runtimeAgentVersion: String?
      infrastructurePreparedAt: DateTime?
      preparedNodeCount: Int?
      infrastructureVerifiedAt: DateTime?
      infrastructureVerificationFailedAt: DateTime?
      infrastructureVerificationFailureReason: String?
      agentReadyAt: DateTime?
      agentDeploymentFailedAt: DateTime?
      agentDeploymentFailureReason: String?
      agentDeploymentRetryFailedAt: DateTime?
      agentDeploymentRetryFailureReason: String?
      connectedAt: DateTime?
      state: RuntimeInfrastructure.State
      subscribe OrganizationRegistered
      subscribe RuntimeInfrastructurePackageRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructurePlanned
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeInfrastructurePrepared
      subscribe RuntimeInfrastructureVerified
      subscribe RuntimeInfrastructureVerificationFailed
      subscribe RuntimeInfrastructureVerificationRetrySucceeded
      subscribe RuntimeInfrastructureVerificationRetryFailed
      subscribe RuntimeAgentInstallationSucceeded
      subscribe RuntimeAgentInstallationFailed
      subscribe RuntimeAgentDeploymentRetrySucceeded
      subscribe RuntimeAgentDeploymentRetryFailed
      subscribe RuntimeConnectionEstablished
    }
  }

  concept RuntimeInstallationPlan {
    state Planned

    slice CreateRuntimeInstallationPlan
    slice RuntimeInstallationPlanCatalog
    slice RuntimeInstallationGuide
  }

  concept RuntimeInfrastructurePackage {
    state Registered

    slice RegisterRuntimeInfrastructurePackage
    slice RuntimeInfrastructurePackageCatalog
  }

  concept RuntimeInfrastructure {
    state Planned
    state Registered
    state Prepared
    state Verified
    state VerificationFailed
    state AgentReady
    state RuntimeAgentFailed
    state Offline
    state Connected

    slice PlanRuntimeInfrastructure
    slice RegisterRuntimeInfrastructure
    slice ConfirmRuntimeInfrastructurePrepared
    slice VerifyRuntimeInfrastructure
    slice DeployRuntimeAgent
    slice RetryRuntimeInfrastructureVerification
    slice RetryRuntimeAgentDeployment
    slice RecordRuntimeConnectionEstablished
    slice RuntimeAgentEndpointCatalog
    slice RuntimeInfrastructureAccessView
  }
}

context DatasetGovernance {
  note "Dataset governance separates feature schemas, platform-recorded runtime dataset metadata, dataset access validation evidence, and train evaluation bundles. Runtime agents own dataset declarations, data connectors, local access profiles, and credentials inside participant infrastructure."

  risk "Datasets may be approved despite schema drift, privacy sensitivity, or non IID skew that invalidates training assumptions."
  risk "Validated dataset access can remain selectable after governance revocation unless blocked explicitly."
  metric datasetContractValidationFailureRate
  metric runtimeDatasetAccessValidationLatency

  slice DefineFeatureSchema {
    startsLifecycle

    tags {
      featureDomain
      version
    }

    actor DataSteward
    ui FeatureSchemaEditor
  
    command DefineFeatureSchema {
      featureSchemaId: UUID id generated technical
      featureDomain: String
      version: String generated technical
      dataModality: String dictionary "FEATURE_SCHEMA_DATA_MODALITY"
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
    }
  
    event FeatureSchemaDefined {
      featureSchemaId: UUID id technical
      featureDomain: String
      version: String
      dataModality: String dictionary "FEATURE_SCHEMA_DATA_MODALITY"
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
      featureCount: Int derived {
        from DefineFeatureSchema.features
        rule "Count entries in the features collection."
      }
    }
  
    state Draft
  
    specification "Feature Schema Domain Version Unique" {
      rule """
        A feature schema is uniquely identified by the combination of its domain and system-assigned version. Two schemas within the same domain cannot share a version, and users do not manually type the next version. The schema data modality describes whether the feature list represents tabular columns or logical inputs for unstructured data such as text, image, audio, document, or embedding datasets.
      """
  
      expression {
        unique (FeatureSchema.featureDomain, FeatureSchema.version)
      }
  
      scenario "Reject Duplicate Feature Schema Version" {
        given FeatureSchemaDefined {
          featureDomain = "CreditRisk"
          version = "1.0.0"
        }
        when DefineFeatureSchema {
          featureDomain = "CreditRisk"
          version = "1.0.0"
        }
        then reject "Feature Schema Version Already Exists"
      }
    }
  }

  slice PublishFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaDefined
  
    command PublishFeatureSchema {
      featureSchemaId: UUID id technical
      publishNote: String?
    }
  
    event FeatureSchemaPublished {
      featureSchemaId: UUID id technical
      publishNote: String?
    }
  
    state Published
  
    specification "Only Draft Schemas Can Be Published" {
      rule """
        A feature schema can be published only from the Draft lifecycle state.
      """
  
      scenario "Publish Draft Schema" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-1"
        }
        when PublishFeatureSchema {
          featureSchemaId = "schema-1"
        }
        then FeatureSchemaPublished
      }
    }
  }
  
  slice DeprecateFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command DeprecateFeatureSchema {
      featureSchemaId: UUID id technical
      deprecationReason: String
    }
  
    event FeatureSchemaDeprecated {
      featureSchemaId: UUID id technical
      deprecationReason: String
    }
  
    state Deprecated
  }
  
  slice RetireFeatureSchema {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaDeprecated
  
    command RetireFeatureSchema {
      featureSchemaId: UUID id technical
      retirementReason: String
    }
  
    event FeatureSchemaRetired {
      featureSchemaId: UUID id technical
      retirementReason: String
    }
  
    state Retired
  }
  
  // 确认逻辑（升级版本？） TODO
  slice SupersedeFeatureSchemaVersion {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command SupersedeFeatureSchemaVersion {
      featureSchemaId: UUID id technical
      supersededByFeatureSchemaId: UUID
      supersessionReason: String?
    }
  
    event FeatureSchemaVersionSuperseded {
      featureSchemaId: UUID id technical
      supersededByFeatureSchemaId: UUID
      featureDomain: String
      supersededVersion: String
      supersessionReason: String?
    }
  
    specification "Supersede Published Schema With Newer Version" {
      rule """
        Only schemas in the Published state can be superseded, and the superseding schema must belong to the same domain and have a later system-assigned version according to schema version ordering.
      """
  
      scenario "Supersede Older Version" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-1"
          featureDomain = "CreditRisk"
          version = "1.0.0"
        }
        given FeatureSchemaDefined {
          featureSchemaId = "schema-2"
          featureDomain = "CreditRisk"
          version = "1.1.0"
        }
        when SupersedeFeatureSchemaVersion {
          featureSchemaId = "schema-1"
          supersededByFeatureSchemaId = "schema-2"
        }
        then FeatureSchemaVersionSuperseded
      }
    }
  }
  
  slice MarkCurrentRecommendedFeatureSchemaVersion {
    actor DataSteward
    ui FeatureSchemaEditor confirm
    reactsTo FeatureSchemaPublished
  
    command MarkCurrentRecommendedFeatureSchemaVersion {
      featureSchemaId: UUID id technical
      recommendationNote: String?
    }
  
    event CurrentRecommendedFeatureSchemaVersionMarked {
      featureSchemaId: UUID id technical
      featureDomain: String derived {
        from FeatureSchema.featureDomain
        rule "Use the schema domain as the recommendation boundary."
      }
      recommendedVersion: String derived {
        from FeatureSchema.version
        rule "Expose the recommended schema version for catalog projection."
      }
      recommendationNote: String?
    }
  
    specification "Only One Recommended Version Per Domain" {
      rule """
        For each domain, at most one feature schema version is marked as the current recommended version. Marking a new version as recommended must clear the previous recommended version in the same domain.
      """
  
      scenario "Mark New Recommended Version" {
        given FeatureSchemaDefined {
          featureSchemaId = "schema-2"
          featureDomain = "CreditRisk"
          version = "1.1.0"
        }
        when MarkCurrentRecommendedFeatureSchemaVersion {
          featureSchemaId = "schema-2"
        }
        then CurrentRecommendedFeatureSchemaVersionMarked
      }
    }
  }
  
  slice CurrentRecommendedFeatureSchemaCatalog {
    readmodel CurrentRecommendedFeatureSchemaCatalog[] {
      featureDomain: String id
      recommendedFeatureSchemaId: UUID
      recommendedVersion: String
      recommendedAt: DateTime
      recommendationNote: String?
      subscribe CurrentRecommendedFeatureSchemaVersionMarked
    }
  }

  slice FeatureSchemaCatalog {
    readmodel FeatureSchemaCatalog[] {
      featureSchemaId: UUID id
      featureDomain: String display
      version: String
      dataModality: String dictionary "FEATURE_SCHEMA_DATA_MODALITY"
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
      featureCount: Int
      schemaStatus: String
      supersededByFeatureSchemaId: UUID?
      recommendedForDomain: Boolean
      subscribe FeatureSchemaDefined
      subscribe FeatureSchemaPublished
      subscribe FeatureSchemaDeprecated
      subscribe FeatureSchemaRetired
      subscribe FeatureSchemaVersionSuperseded
      subscribe CurrentRecommendedFeatureSchemaVersionMarked
    }
  }

  concept FeatureSchema {
    state Draft
    state Published
    state Deprecated
    state Retired
  
    slice DefineFeatureSchema
    slice PublishFeatureSchema
    slice DeprecateFeatureSchema
    slice RetireFeatureSchema
    slice FeatureSchemaCatalog
    slice SupersedeFeatureSchemaVersion
    slice MarkCurrentRecommendedFeatureSchemaVersion
    slice CurrentRecommendedFeatureSchemaCatalog
  }

  slice RecordRuntimeDatasetMetadata {
    startsLifecycle
    reactsTo AgentDatasetMetadataReported

    automation RecordDatasetMetadataWhenAgentReported {
      on AgentDatasetMetadataReported
      emits RecordRuntimeDatasetMetadata
    }

    command RecordRuntimeDatasetMetadata {
      runtimeDatasetBindingId: UUID id technical from AgentDatasetMetadataReported.runtimeDatasetBindingId
      metadataReportId: UUID from AgentDatasetMetadataReported.metadataReportId
      datasetId: UUID from AgentDatasetMetadataReported.datasetId
      organizationId: UUID from AgentDatasetMetadataReported.organizationId
      organizationName: String? from AgentDatasetMetadataReported.organizationName
      runtimeId: UUID from AgentDatasetMetadataReported.runtimeId
      runtimeName: String? from AgentDatasetMetadataReported.runtimeName
      featureSchemaId: UUID from AgentDatasetMetadataReported.featureSchemaId
      featureDomain: String? from AgentDatasetMetadataReported.featureDomain
      featureSchemaVersion: String? from AgentDatasetMetadataReported.featureSchemaVersion
      datasetName: String from AgentDatasetMetadataReported.datasetName
      sampleCount: Int from AgentDatasetMetadataReported.sampleCount
      featureCount: Int from AgentDatasetMetadataReported.featureCount
      schemaCompatible: Boolean? from AgentDatasetMetadataReported.schemaCompatible
      labelCompatible: Boolean? from AgentDatasetMetadataReported.labelCompatible
      missingValueRate: Decimal? from AgentDatasetMetadataReported.missingValueRate
      duplicateRate: Decimal? from AgentDatasetMetadataReported.duplicateRate
      qualityScore: Decimal? from AgentDatasetMetadataReported.qualityScore
      nonIidScore: Decimal? from AgentDatasetMetadataReported.nonIidScore
      classBalanceScore: Decimal? from AgentDatasetMetadataReported.classBalanceScore
    }

    event DatasetMetadataReported {
      runtimeDatasetBindingId: UUID id technical
      metadataReportId: UUID
      datasetId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeId: UUID
      runtimeName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      datasetName: String
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      missingValueRate: Decimal?
      duplicateRate: Decimal?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
    }

    state MetadataReported
  }

  slice RecordRuntimeDatasetReprofiledMetadata {
    reactsTo AgentDatasetReprofiled

    automation RecordDatasetMetadataWhenAgentReprofiled {
      on AgentDatasetReprofiled
      emits RecordRuntimeDatasetReprofiledMetadata
    }

    command RecordRuntimeDatasetReprofiledMetadata {
      runtimeDatasetBindingId: UUID id technical from AgentDatasetReprofiled.runtimeDatasetBindingId
      metadataReportId: UUID from AgentDatasetReprofiled.metadataReportId
      datasetId: UUID from AgentDatasetReprofiled.datasetId
      organizationId: UUID from AgentDatasetReprofiled.organizationId
      organizationName: String? from AgentDatasetReprofiled.organizationName
      runtimeId: UUID from AgentDatasetReprofiled.runtimeId
      runtimeName: String? from AgentDatasetReprofiled.runtimeName
      featureSchemaId: UUID from AgentDatasetReprofiled.featureSchemaId
      featureDomain: String? from AgentDatasetReprofiled.featureDomain
      featureSchemaVersion: String? from AgentDatasetReprofiled.featureSchemaVersion
      datasetName: String from AgentDatasetReprofiled.datasetName
      sampleCount: Int from AgentDatasetReprofiled.sampleCount
      featureCount: Int from AgentDatasetReprofiled.featureCount
      schemaCompatible: Boolean? from AgentDatasetReprofiled.schemaCompatible
      labelCompatible: Boolean? from AgentDatasetReprofiled.labelCompatible
      missingValueRate: Decimal? from AgentDatasetReprofiled.missingValueRate
      duplicateRate: Decimal? from AgentDatasetReprofiled.duplicateRate
      qualityScore: Decimal? from AgentDatasetReprofiled.qualityScore
      nonIidScore: Decimal? from AgentDatasetReprofiled.nonIidScore
      classBalanceScore: Decimal? from AgentDatasetReprofiled.classBalanceScore
    }

    event DatasetMetadataReprofiled {
      runtimeDatasetBindingId: UUID id technical
      metadataReportId: UUID
      datasetId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeId: UUID
      runtimeName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      datasetName: String
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      missingValueRate: Decimal?
      duplicateRate: Decimal?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
    }

    state MetadataReported
  }

  slice RuntimeDatasetMetadataCatalog {
    readmodel RuntimeDatasetMetadataCatalog[] {
      runtimeDatasetBindingId: UUID id
      metadataReportId: UUID
      datasetId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeId: UUID
      runtimeName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      datasetName: String? display
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      missingValueRate: Decimal?
      duplicateRate: Decimal?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
      profilingStatus: String
      failureReason: String?
      profiledAt: DateTime?
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe DatasetMetadataReported
      subscribe DatasetMetadataReprofiled
      subscribe AgentDatasetProfilingFailed
      subscribe AgentDatasetReprofilingFailed
    }
  }

  concept RuntimeDatasetMetadata {
    state MetadataReported

    slice RecordRuntimeDatasetMetadata
    slice RecordRuntimeDatasetReprofiledMetadata
    slice RuntimeDatasetMetadataCatalog
  }

  value FeatureDefinition {
    featureName: String
    dataType: String dictionary "FEATURE_DATA_TYPE"
    required: Boolean
    nullable: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
    isIdentifier: Boolean
    isSensitive: Boolean
    encodingStrategy: String? dictionary "FEATURE_ENCODING_STRATEGY"
    featureTags: String[]
  }
  
  value LabelDefinition {
    labelName: String
    dataType: String dictionary "FEATURE_DATA_TYPE"
    cardinality: Int
    classLabels: String[]?
    isMultilabel: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
  }
}

context ModelRepository {
  note "Model repository owns model identity, versioning, lineage, and pullable artifact references used by training orchestration and runtime agents. FileUpload owns the underlying bytes and storage adapter; ModelArtifact owns their model-specific lifecycle and metadata."

  risk "Runtime agents can pull stale or tampered models if artifact URI, digest, registry, format, and signature are not snapshotted with the training run."
  risk "Aggregated round models can lose lineage if their producing training job and round are not recorded."
  metric modelArtifactRegistrationLatency
  metric modelArtifactPullFailureRate

  slice RegisterModelArtifact {
    startsLifecycle

    actor MLOpsEngineer
    ui ModelRepositoryScreen
    
    tags {
      modelName
      modelVersion
    }

    command RegisterModelArtifact {
      modelId: UUID id generated technical
      modelName: String display
      modelVersion: String
      modelDescription: String?
      sourceType: String dictionary "MODEL_ARTIFACT_SOURCE_TYPE"
      fileId: UUID? file
      modelFormat: String? dictionary "MODEL_FORMAT"
    }

    event ModelArtifactRegistered {
      modelId: UUID id technical
      modelName: String display
      modelVersion: String
      modelDescription: String?
      sourceType: String dictionary "MODEL_ARTIFACT_SOURCE_TYPE"
      modelArtifactUri: String
      modelRegistryRef: String
      modelFormat: String dictionary "MODEL_FORMAT"
      modelArtifactDigest: String
      modelSignatureUri: String?
      modelSizeBytes: Int?
    }

    state Registered

    specification "Model Artifact Must Be Pullable And Verifiable" {
      rule """
        Registering a model artifact is a port-backed operation over a file already persisted by FileUpload. modelName identifies the logical model, modelVersion identifies the business version under that model, and modelDescription captures the business purpose, training background, applicable scenarios, or limitations that operators need when selecting the model. The pair must be unique. modelId remains the system identity for one imported or trained artifact version. sourceType distinguishes externally uploaded artifacts from artifacts produced by federated training. fileId identifies the shared FileUpload record; ModelRepository does not create a second physical copy or a second storage subsystem. The adapter resolves FileUpload metadata and content URI, validates the model format, records digest and size, and marks the file reference after registration. modelArtifactUri remains the authenticated FileUpload content URI.

        unique (ModelArtifact.modelName, ModelArtifact.modelVersion)
      """

      scenario "Register Pullable Model Artifact" {
        when RegisterModelArtifact {
          modelId = "model-1"
          modelName = "credit-risk"
          modelVersion = "v1"
          modelDescription = "Baseline credit risk classifier for federated training"
          sourceType = "EXTERNAL"
          fileId = "file-1"
          modelFormat = "ONNX"
        }
        then ModelArtifactRegistered
      }
    }
  }

  slice ModelArtifactCatalog {
    readmodel ModelArtifactCatalog[] {
      modelId: UUID id
      modelName: String display
      modelVersion: String
      modelDescription: String?
      sourceType: String? dictionary "MODEL_ARTIFACT_SOURCE_TYPE"
      modelArtifactUri: String
      modelRegistryRef: String
      modelFormat: String dictionary "MODEL_FORMAT"
      modelArtifactDigest: String
      modelSignatureUri: String?
      modelSizeBytes: Int?
      trainingJobId: UUID?
      roundId: UUID?
      trainingJobObjective: String?
      state: ModelArtifact.State
      registeredAt: DateTime?
      subscribe TrainingJobCreated
      subscribe ModelArtifactRegistered
      subscribe FederatedModelArtifactRegistered
      subscribe GlobalModelUpdated
    }
  }

  slice DownloadModelArtifact {
    actor MLOpsEngineer
    ui ModelRepositoryScreen
    reactsTo ModelArtifactRegistered
    reactsTo FederatedModelArtifactRegistered
    port

    command DownloadModelArtifact {
      modelId: UUID id technical
    }

    event ModelArtifactDownloadAuthorized {
      modelId: UUID id technical
      modelName: String
      modelVersion: String
      modelFormat: String
      modelArtifactDigest: String
      downloadUri: String
    }

    specification "Registered Model Artifact Resolves To Stored File Download" {
      rule """
        DownloadModelArtifact accepts only modelId. The adapter loads the registered ModelArtifact snapshot, verifies that its referenced FileUpload object is still available, and returns an authenticated downloadUri. ModelRepository owns model identity, version, format, and digest; FileUpload remains responsible for streaming the underlying bytes. No model content is carried in the command or event.
      """

      scenario "Authorize Registered Model Artifact Download" {
        given ModelArtifactRegistered {
          modelId = "model-1"
          modelName = "credit-risk"
          modelVersion = "v1"
          modelFormat = "ONNX"
          modelArtifactDigest = "sha256:model"
          modelArtifactUri = "http://support/api/files/file-1/content"
        }
        when DownloadModelArtifact {
          modelId = "model-1"
        }
        then ModelArtifactDownloadAuthorized
      }

      scenario "Reject Missing Model Artifact Content" {
        given ModelArtifactRegistered {
          modelId = "model-2"
          modelName = "credit-risk"
          modelVersion = "v2"
          modelArtifactUri = "http://support/api/files/file-2/content"
        }
        when DownloadModelArtifact {
          modelId = "model-2"
        }
        then error "Model artifact content is not available for download."
      }
    }
  }

  slice RegisterFederatedModelArtifact {
    reactsTo GlobalModelUpdated

    automation RegisterFederatedModelWhenGlobalModelUpdated {
      on GlobalModelUpdated
      emits RegisterFederatedModelArtifact
    }

    command RegisterFederatedModelArtifact {
      modelId: UUID id technical from GlobalModelUpdated.aggregatedModelId
      modelName: String from GlobalModelUpdated.aggregatedModelName
      modelVersion: String from GlobalModelUpdated.aggregatedModelVersion
      modelDescription: String? from GlobalModelUpdated.aggregatedModelDescription
      sourceType: String from GlobalModelUpdated.modelSourceType
      modelArtifactUri: String from GlobalModelUpdated.aggregatedModelArtifactUri
      modelRegistryRef: String from GlobalModelUpdated.aggregatedModelRegistryRef
      modelFormat: String from GlobalModelUpdated.modelFormat
      modelArtifactDigest: String from GlobalModelUpdated.modelArtifactDigest
      modelSignatureUri: String? from GlobalModelUpdated.aggregatedModelSignatureUri
      modelSizeBytes: Int? from GlobalModelUpdated.aggregatedModelSizeBytes
      trainingJobId: UUID from GlobalModelUpdated.trainingJobId
      trainingJobObjective: String from GlobalModelUpdated.trainingJobObjective
      roundId: UUID from GlobalModelUpdated.roundId
    }

    event FederatedModelArtifactRegistered {
      modelId: UUID id technical
      modelName: String
      modelVersion: String
      modelDescription: String?
      sourceType: String
      modelArtifactUri: String
      modelRegistryRef: String
      modelFormat: String
      modelArtifactDigest: String
      modelSignatureUri: String?
      modelSizeBytes: Int?
      trainingJobId: UUID
      trainingJobObjective: String
      roundId: UUID
    }

    state Registered

    specification "Federated Round Model Is Registered From Managed Storage" {
      rule """
        A global model produced by the aggregation runtime is uploaded through the shared FileUpload storage boundary before GlobalModelUpdated is emitted. ModelArtifact registration records that file URI together with digest, format, size, producing training job, and round; it does not create a second storage area. The generated modelId is reused as both the upload record identifier and ModelArtifact identity for traceability.
      """

      scenario "Register Aggregated Round Model" {
        when RegisterFederatedModelArtifact
        then FederatedModelArtifactRegistered
      }
    }
  }

  concept ModelArtifact {
    state Registered

    slice RegisterModelArtifact
    slice RegisterFederatedModelArtifact
    slice DownloadModelArtifact
    slice ModelArtifactCatalog
  }
}

context TrainingOrchestration {
  note "Training orchestration owns job intent, participant eligibility, runtime dispatch, and each round of distributed training and evaluation."

  risk "Training can stall when started participant runtimes fall below quorum or when secure aggregation context preparation fails before execution plans are dispatched."
  risk "Poisoned local updates can degrade the global model if anomaly checks are not modeled as a first class decision."
  metric nodeDropoutRate
  metric roundCompletionLatency
  metric globalAccuracyGap

  integration SecureAggregationProvider {
    source TrainingRound
    target SecureAggregationService
    reactsTo SecureAggregationRequested
    emits PrepareHomomorphicEncryptionContext
    emits CompleteHomomorphicAggregationSession
  }

  integration ParticipantRoundRuntime {
    source TrainingRound
    target RuntimeAgent
    reactsTo ParticipantExecutionPlanDispatched
    emits ReceiveParticipantExecutionPlan
  }

  integration AggregationNodeRuntime {
    source TrainingRound
    target AggregationRuntime
    reactsTo GlobalModelUpdated
    emits SubmitGlobalModelEvaluation
  }

  slice DefineTrainingRunConfiguration {
    startsLifecycle

    actor MLOpsEngineer
    ui TrainingRunConfigurationScreen

    command DefineTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id generated technical
      configurationName: String display
      federationId: UUID
      federationName: String? derived from FederationOverview.federationName by federationId
      featureSchemaId: UUID
      featureDomain: String? derived from FeatureSchemaCatalog.featureDomain by featureSchemaId
      featureSchemaVersion: String? derived from FeatureSchemaCatalog.version by featureSchemaId
      initialModelId: UUID from ModelArtifactCatalog.modelId
      initialModelName: String? derived from ModelArtifactCatalog.modelName by initialModelId
      initialModelVersion: String? derived from ModelArtifactCatalog.modelVersion by initialModelId
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
    }

    event TrainingRunConfigurationDefined {
      trainingRunConfigurationId: UUID id technical
      configurationName: String display
      federationId: UUID
      federationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      initialModelId: UUID
      initialModelName: String?
      initialModelVersion: String?
      initialModelArtifactUri: String derived {
        from ModelArtifact.modelArtifactUri
        rule "Snapshot the initial model artifact URI selected from the model repository."
      }
      initialModelRegistryRef: String derived {
        from ModelArtifact.modelRegistryRef
        rule "Snapshot the model registry reference so runtime agents can identify where the initial global model is managed. For built-in runtime-engine models this value is the runtime engine model plugin code, copied from the selected ModelArtifact rather than read from runtime-agent environment variables."
      }
      initialModelFormat: String derived {
        from ModelArtifact.modelFormat
        rule "Snapshot the model format needed by the runtime engine."
      }
      initialModelArtifactDigest: String derived {
        from ModelArtifact.modelArtifactDigest
        rule "Snapshot the artifact digest used by runtime agents to verify the pulled model."
      }
      initialModelSignatureUri: String? derived {
        from ModelArtifact.modelSignatureUri
        rule "Snapshot the optional signature URI used to verify model provenance."
      }
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
    }

    state Draft

    specification "Training Configuration Must Be Runnable" {
      rule """
        A training run configuration is accepted only when the selected federation, feature schema, and initial model exist; the round budget, quorum, timeouts, local training parameters, and target quality thresholds are valid.
      """

      scenario "Define Runnable Configuration" {
        when DefineTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-1"
          configurationName = "Readmission Risk Baseline"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelId = "model-1"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 10
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          minimumAccuracy = 0.9
        }
        then TrainingRunConfigurationDefined
      }

      scenario "Reject Empty Round Budget" {
        when DefineTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-2"
          configurationName = "Invalid Round Budget"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelId = "model-1"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 0
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          minimumAccuracy = 0.9
        }
        then reject "Positive Round Budget Required"
      }
    }
  }

  slice UpdateTrainingRunConfiguration {
    actor MLOpsEngineer
    ui TrainingRunConfigurationScreen
    reactsTo TrainingRunConfigurationDefined

    command UpdateTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id technical
      configurationName: String display
      federationId: UUID
      federationName: String? derived from FederationOverview.federationName by federationId
      featureSchemaId: UUID
      featureDomain: String? derived from FeatureSchemaCatalog.featureDomain by featureSchemaId
      featureSchemaVersion: String? derived from FeatureSchemaCatalog.version by featureSchemaId
      initialModelId: UUID from ModelArtifactCatalog.modelId
      initialModelName: String? derived from ModelArtifactCatalog.modelName by initialModelId
      initialModelVersion: String? derived from ModelArtifactCatalog.modelVersion by initialModelId
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      updateReason: String?
    }

    event TrainingRunConfigurationUpdated {
      trainingRunConfigurationId: UUID id technical
      configurationName: String display
      federationId: UUID
      federationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      initialModelId: UUID
      initialModelName: String?
      initialModelVersion: String?
      initialModelArtifactUri: String derived {
        from ModelArtifact.modelArtifactUri
        rule "Snapshot the updated initial model artifact URI selected from the model repository."
      }
      initialModelRegistryRef: String derived {
        from ModelArtifact.modelRegistryRef
        rule "Snapshot the updated model registry reference so runtime agents can identify where the initial global model is managed."
      }
      initialModelFormat: String derived {
        from ModelArtifact.modelFormat
        rule "Snapshot the updated model format needed by the runtime engine."
      }
      initialModelArtifactDigest: String derived {
        from ModelArtifact.modelArtifactDigest
        rule "Snapshot the updated artifact digest used by runtime agents to verify the pulled model."
      }
      initialModelSignatureUri: String? derived {
        from ModelArtifact.modelSignatureUri
        rule "Snapshot the updated optional signature URI used to verify model provenance."
      }
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      updateReason: String?
    }

    state Draft

    specification "Draft Training Configuration Can Be Updated" {
      rule """
        A training run configuration can be updated only while it is still Draft. The updated values must satisfy the same runnable configuration rules as creation. After the configuration is locked by training submission, correction must happen by creating a new configuration.
      """

      scenario "Update Draft Runnable Configuration" {
        given TrainingRunConfigurationDefined {
          trainingRunConfigurationId = "cfg-1"
        }
        when UpdateTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-1"
          configurationName = "Readmission Risk Tuned"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelId = "model-2"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 20
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          minimumAccuracy = 0.9
          updateReason = "Tune round budget before submission."
        }
        then TrainingRunConfigurationUpdated
      }

      scenario "Reject Update After Configuration Locked" {
        given TrainingRunConfigurationLocked {
          trainingRunConfigurationId = "cfg-2"
        }
        when UpdateTrainingRunConfiguration {
          trainingRunConfigurationId = "cfg-2"
          configurationName = "Locked Configuration Fix"
          federationId = "fed-1"
          featureSchemaId = "schema-1"
          initialModelId = "model-2"
          strategyName = "FED_AVG"
          aggregationAlgorithm = "FEDERATED_AVERAGING"
          maxRounds = 20
          minimumNodesPerRound = 3
          roundTimeoutSeconds = 1800
          nodeResponseTimeoutSeconds = 300
          localEpochs = 2
          batchSize = 64
          learningRate = 0.01
          optimizer = "SGD"
          lossFunction = "CROSS_ENTROPY"
          secureAggregationRequired = true
          minimumAccuracy = 0.9
          updateReason = "Fix submitted configuration."
        }
        then reject "Training Run Configuration Locked"
      }
    }
  }

  slice LockTrainingRunConfiguration {
    reactsTo TrainingJobSubmitted

    automation LockConfigurationWhenTrainingSubmitted {
      on TrainingJobSubmitted
      emits LockTrainingRunConfiguration
    }

    command LockTrainingRunConfiguration {
      trainingRunConfigurationId: UUID id technical derived {
        from TrainingJobSubmitted.trainingRunConfigurationId
        rule "Lock the configuration carried by the submitted training job event."
      }
      trainingJobId: UUID from TrainingJobSubmitted.trainingJobId
    }

    event TrainingRunConfigurationLocked {
      trainingRunConfigurationId: UUID id technical
      trainingJobId: UUID
    }

    state Locked
  }
  // 具体配置 TODO
  slice TrainingRunConfigurationCatalog {
    readmodel TrainingRunConfigurationCatalog[] {
      trainingRunConfigurationId: UUID id
      configurationName: String display
      federationId: UUID
      featureSchemaId: UUID
      initialModelId: UUID
      initialModelName: String
      initialModelVersion: String
      federationName: String?
      featureDomain: String?
      featureSchemaVersion: String?
      initialModelArtifactUri: String
      initialModelRegistryRef: String
      initialModelFormat: String
      initialModelArtifactDigest: String
      initialModelSignatureUri: String?
      strategyName: String dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      maxRounds: Int
      minimumNodesPerRound: Int
      roundTimeoutSeconds: Int
      nodeResponseTimeoutSeconds: Int
      localEpochs: Int
      batchSize: Int
      learningRate: Decimal
      optimizer: String dictionary "TRAINING_OPTIMIZER"
      lossFunction: String dictionary "TRAINING_LOSS_FUNCTION"
      gradientClippingNorm: Decimal?
      secureAggregationRequired: Boolean
      minimumAccuracy: Decimal
      minimumFairnessScore: Decimal?
      updateReason: String?
      lockedByTrainingJobId: UUID?
      state: TrainingRunConfiguration.State
      subscribe FederationCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingRunConfigurationDefined
      subscribe TrainingRunConfigurationUpdated
      subscribe TrainingRunConfigurationLocked
    }
  }

  concept TrainingRunConfiguration {
    state Draft
    state Locked

    slice DefineTrainingRunConfiguration
    slice UpdateTrainingRunConfiguration
    slice LockTrainingRunConfiguration
    slice TrainingRunConfigurationCatalog
  }

  slice CreateTrainingJob {
    startsLifecycle

    actor ResearchLead
    ui TrainingJobCreationScreen
    reactsTo TrainingRunConfigurationDefined

    // Participating organizations are resolved from federation membership and runtime readiness.
    command CreateTrainingJob {
      trainingJobId: UUID id generated technical
      federationId: UUID
      federationName: String? derived from FederationOverview.federationName by federationId
      trainingRunConfigurationId: UUID
      configurationName: String? derived from TrainingRunConfigurationCatalog.configurationName by trainingRunConfigurationId
      featureDomain: String? derived from TrainingRunConfigurationCatalog.featureDomain by trainingRunConfigurationId
      featureSchemaVersion: String? derived from TrainingRunConfigurationCatalog.featureSchemaVersion by trainingRunConfigurationId
      // 本次训练任务的业务目标或实验目的，用于列表、审计和结果解释；不承载训练超参数。
      objective: String
    }

    event TrainingJobCreated {
      trainingJobId: UUID id technical
      federationId: UUID
      federationName: String?
      initialModelId: UUID derived {
        from TrainingRunConfiguration.initialModelId
        rule "Carry the initial model selected by the training run configuration."
      }
      featureSchemaId: UUID derived {
        from TrainingRunConfiguration.featureSchemaId
        rule "Use the feature schema selected in the runnable training run configuration."
      }
      trainingRunConfigurationId: UUID
      configurationName: String?
      featureDomain: String?
      featureSchemaVersion: String?
      trainingJobObjective: String
      // 本次训练任务的业务目标或实验目的，用于列表、审计和结果解释；不承载训练超参数。
      objective: String
    }

    state Draft

    specification "Training Job Requires Runnable Configuration And Runtime Access" {
      rule """
        A training job can be created only from a defined runnable training run configuration. Runtime agents match local datasets by the configuration's feature schema when work is dispatched.
      """

      scenario "Create Training Job With Runnable Configuration" {
        given TrainingRunConfigurationDefined {
          trainingRunConfigurationId = "config-1"
        }
        when CreateTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then TrainingJobCreated
      }

      scenario "Reject Training Job Without Runnable Configuration" {
        when CreateTrainingJob {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        then reject "Runnable Training Configuration Required"
      }
    }
  }

  slice SubmitTrainingJob {
    actor ResearchLead
    ui TrainingSubmissionScreen
    reactsTo TrainingJobCreated

    command SubmitTrainingJob {
      trainingJobId: UUID id technical
    }

    event TrainingJobSubmitted {
      trainingJobId: UUID id technical from SubmitTrainingJob.trainingJobId
      trainingRunConfigurationId: UUID derived {
        from TrainingJob.trainingRunConfigurationId
        rule "Carry the submitted job's training run configuration so automation can lock the exact configuration instead of creating a new one."
      }
      federationId: UUID derived from TrainingJob.federationId by trainingJobId
      federationName: String? derived from TrainingJob.federationName by trainingJobId
      configurationName: String? derived from TrainingJob.configurationName by trainingJobId
      featureSchemaId: UUID derived from TrainingJob.featureSchemaId by trainingJobId
      featureDomain: String? derived from TrainingJob.featureDomain by trainingJobId
      featureSchemaVersion: String? derived from TrainingJob.featureSchemaVersion by trainingJobId
      trainingJobObjective: String derived from TrainingJob.objective by trainingJobId
      objective: String derived from TrainingJob.objective by trainingJobId
    }

    state Submitted

    specification "Only Created Training Jobs Can Be Submitted" {
      rule """
        A training job can be submitted after it is created from a runnable training run configuration. Dataset matching is delegated to each runtime agent using the selected feature schema.
      """

      scenario "Submit Created Training Job" {
        given TrainingJobCreated {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
        }
        when SubmitTrainingJob {
          trainingJobId = "job-1"
        }
        then TrainingJobSubmitted
      }

      scenario "Reject Unknown Training Job" {
        when SubmitTrainingJob {
          trainingJobId = "job-1"
        }
        then reject "Training Job Required"
      }
    }
  }

  slice TrainingJobDashboard {
    readmodel TrainingJobDashboard[] {
      trainingJobId: UUID id
      federationId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      federationName: String?
      featureDomain: String?
      featureSchemaVersion: String?
      objective: String
      strategyName: String? dictionary "TRAINING_STRATEGY"
      aggregationAlgorithm: String? dictionary "AGGREGATION_ALGORITHM"
      secureAggregationRequired: Boolean?
      state: TrainingJob.State
      workflowStage: String
      workflowStep: Int
      nextAction: String?
      availableActions: String[]
      blockedReason: String?
      canSubmit: Boolean
      canStartRound: Boolean
      canPause: Boolean
      canResume: Boolean
      canCancel: Boolean
      canComplete: Boolean
      currentRoundNumber: Int
      startedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      roundProgressPercent: Int
      globalAccuracy: Decimal?
      finalModelId: UUID?
      stopReason: String?
      subscribe FederationCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingJobCreated
      subscribe TrainingJobSubmitted
      subscribe TrainingJobPaused
      subscribe TrainingJobResumed
      subscribe TrainingJobCanceled
      subscribe TrainingRoundStarted
      subscribe TrainingRoundCompleted
      subscribe TrainingJobCompleted
    }
  }
  
  slice TrainingParticipantEligibility {
    reactsTo TrainingJobSubmitted

    readmodel TrainingParticipantEligibility[] {
      trainingJobId: UUID id
      federationId: UUID
      organizationId: UUID
      runtimeId: UUID?
      featureSchemaId: UUID
      federationName: String?
      organizationName: String?
      featureDomain: String?
      featureSchemaVersion: String?
      participantStatus: String
      readinessStatus: String
      readinessStage: String
      eligibilityScore: Int
      runtimeIdentityActive: Boolean
      runtimeCapabilitySatisfied: Boolean
      runtimeConnectionEstablished: Boolean
      runtimeHealthy: Boolean
      datasetId: UUID?
      datasetName: String?
      datasetReady: Boolean
      datasetReadinessStatus: String
      matchedDatasetMetadataReady: Boolean
      datasetAccessValidated: Boolean
      datasetApprovedForTraining: Boolean
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      qualityScore: Decimal?
      securityReady: Boolean
      eligible: Boolean
      eligibleRuntimeCount: Int
      minimumNodesPerRound: Int
      selectionReady: Boolean
      eligibilityReason: String?
      ineligibleReasons: String[]
      warningReasons: String[]
      nextRequiredAction: String?
      subscribe FederationCreated
      subscribe OrganizationRegistered
      subscribe FeatureSchemaDefined
      subscribe TrainingJobCreated
      subscribe TrainingJobSubmitted
      subscribe ParticipantJoined
      subscribe ParticipantSuspended
      subscribe ParticipantRemoved
      subscribe RuntimeIdentityActivated
      subscribe RuntimeIdentityRevoked
      subscribe RuntimeCapabilitiesDetected
      subscribe RuntimeConnectionEstablished
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
      subscribe DatasetDeclared
      subscribe DatasetMetadataReported
      subscribe DatasetContractValidated
      subscribe DatasetApprovedForTraining
      subscribe DatasetTrainingApprovalRevoked
      subscribe AgentDatasetAccessValidated
    }
  }

  slice PauseTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingRoundStarted

    command PauseTrainingJob {
      trainingJobId: UUID id technical
      pauseReason: String
    }

    event TrainingJobPaused {
      trainingJobId: UUID id technical
      pauseReason: String
    }

    state Paused
  }

  slice ResumeTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingJobPaused

    command ResumeTrainingJob {
      trainingJobId: UUID id technical
      resumeReason: String?
    }

    event TrainingJobResumed {
      trainingJobId: UUID id technical
      resumeReason: String?
    }

    state Running
  }

  slice CancelTrainingJob {
    actor MLOpsEngineer
    ui TrainingOperationsScreen
    reactsTo TrainingRoundStarted

    command CancelTrainingJob {
      trainingJobId: UUID id technical
      cancelReason: String?
    }

    event TrainingJobCanceled {
      trainingJobId: UUID id technical
      cancelReason: String?
    }

    state Canceled
  }

  slice ScheduleNextTrainingRound {
    reactsTo TrainingRoundCompleted

    automation SelectNextRoundParticipantsWhenTrainingShouldContinue {
      on TrainingRoundCompleted
      condition roundNumber < maxRounds
      emits SelectTrainingRoundParticipants
    }
  }
  slice CompleteTrainingJob {

    reactsTo TrainingRoundCompleted

    automation CompleteJobWhenTrainingStopCriteriaMet {
      on TrainingRoundCompleted
      condition roundNumber >= maxRounds
      emits CompleteTrainingJob
    }

    command CompleteTrainingJob {
      trainingJobId: UUID id technical
      finalRoundId: UUID from TrainingRoundCompleted.roundId
      finalModelId: UUID from TrainingRoundCompleted.aggregatedModelId
      trainingJobObjective: String from TrainingRoundCompleted.trainingJobObjective
      stopReason: String generated technical
    }

    event TrainingJobCompleted {
      trainingJobId: UUID id technical
      finalRoundId: UUID
      finalModelId: UUID
      trainingJobObjective: String
      stopReason: String
    }

    state Completed
  }


  concept TrainingJob {
    state Draft
    state Submitted
    state Running
    state Paused
    state Canceled
    state Completed

    slice CreateTrainingJob
    slice SubmitTrainingJob
    slice PauseTrainingJob
    slice ResumeTrainingJob
    slice CancelTrainingJob
    slice ScheduleNextTrainingRound
    slice CompleteTrainingJob
    slice TrainingJobDashboard
    slice TrainingParticipantEligibility
  }

  value TrainingRoundParticipant {
    organizationId: UUID
    runtimeId: UUID
    datasetId: UUID
  }

  slice SelectTrainingRoundParticipants {
    startsLifecycle
    reactsTo TrainingJobSubmitted
    port

    // TODO Confirm whether initial participant selection should be triggered by TrainingJobSubmitted directly
    // or by a future eligibility-ready domain event after TrainingParticipantEligibility is fully projected.
    automation SelectInitialRoundParticipantsWhenTrainingSubmitted {
      on TrainingJobSubmitted
      emits SelectTrainingRoundParticipants
    }

    command SelectTrainingRoundParticipants {
      trainingJobId: UUID id technical from TrainingJobSubmitted.trainingJobId
      federationId: UUID from TrainingJobSubmitted.federationId
      federationName: String? from TrainingJobSubmitted.federationName
      trainingRunConfigurationId: UUID from TrainingJobSubmitted.trainingRunConfigurationId
      configurationName: String? from TrainingJobSubmitted.configurationName
      featureSchemaId: UUID from TrainingJobSubmitted.featureSchemaId
      featureDomain: String? from TrainingJobSubmitted.featureDomain
      featureSchemaVersion: String? from TrainingJobSubmitted.featureSchemaVersion
      trainingJobObjective: String from TrainingJobSubmitted.trainingJobObjective
    }

    event TrainingRoundParticipantsSelected {
      trainingJobId: UUID id technical
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      trainingJobObjective: String
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      minimumNodesPerRound: Int
      secureAggregationRequired: Boolean
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedParticipants: TrainingRoundParticipant[]
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
    }

    event TrainingRoundParticipantSelectionFailed {
      trainingJobId: UUID id technical
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      trainingJobObjective: String
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregationAlgorithm: String dictionary "AGGREGATION_ALGORITHM"
      minimumNodesPerRound: Int
      secureAggregationRequired: Boolean
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedParticipants: TrainingRoundParticipant[]
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      failureReason: String
    }

    state ParticipantsSelected

    specification "Training Round Participants Are Snapshotted Per Round" {
      rule """
        Each training round starts from a runtime snapshot selected by domain policy. The policy evaluates submitted job, locked training configuration, active federation membership, active runtime identity, detected runtime capabilities, connected runtime status, and approved dataset evidence matching the feature schema. Runtimes that become ready after a round has begun cannot join that round, but they can be selected for a later round when policy allows dynamic round snapshots. If the selected runtime count is below quorum, the system records a failed participant selection event so the operator can fix runtime or dataset readiness and retry selection.
      """

      scenario "Select Participants When Runtime Pool Reaches Quorum" {
        given TrainingJobSubmitted {
          trainingJobId = "job-1"
        }
        when SelectTrainingRoundParticipants {
          trainingJobId = "job-1"
        }
        then TrainingRoundParticipantsSelected
      }

      scenario "Reject Participant Snapshot Below Quorum" {
        given TrainingJobSubmitted {
          trainingJobId = "job-1"
        }
        when SelectTrainingRoundParticipants {
          trainingJobId = "job-1"
        }
        then TrainingRoundParticipantSelectionFailed
      }
    }
  }

  slice RetryTrainingRoundParticipantSelection {
    actor TrainingOperator
    ui TrainingJobDashboard confirm
    reactsTo TrainingRoundParticipantSelectionFailed

    command RetryTrainingRoundParticipantSelection {
      trainingJobId: UUID id technical
    }

    event TrainingRoundParticipantSelectionRetryRequested {
      trainingJobId: UUID id technical
    }

    automation SelectTrainingRoundParticipantsWhenRetryRequested {
      on TrainingRoundParticipantSelectionRetryRequested
      emits SelectTrainingRoundParticipants
    }

    specification "Retry Participant Selection After Readiness Changes" {
      rule """
        Operators can retry participant selection after federation members, runtime identities, runtime connectivity, or dataset metadata readiness change. Retry records an explicit request and reuses the normal SelectTrainingRoundParticipants policy instead of duplicating participant selection rules.
      """

      scenario "Retry Participant Selection" {
        given TrainingRoundParticipantSelectionFailed {
          trainingJobId = "job-1"
        }
        when RetryTrainingRoundParticipantSelection {
          trainingJobId = "job-1"
        }
        then TrainingRoundParticipantSelectionRetryRequested
      }
    }
  }

  slice StartTrainingRound {
    reactsTo TrainingRoundParticipantsSelected
    reactsTo HomomorphicEncryptionContextPrepared
    port

    automation StartRoundWhenParticipantsSelectedWithoutSecureAggregation {
      on TrainingRoundParticipantsSelected
      condition secureAggregationRequired == false
      emits StartTrainingRound
    }

    automation StartRoundWhenEncryptionContextPrepared {
      on HomomorphicEncryptionContextPrepared
      condition selectedRuntimeCount >= minimumNodesPerRound
      emits StartTrainingRound
    }

    command StartTrainingRound {
      trainingJobId: UUID id technical derived {
        from TrainingRoundParticipantsSelected.trainingJobId, HomomorphicEncryptionContextPrepared.trainingJobId
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      federationId: UUID from TrainingRoundParticipantsSelected.federationId
      federationName: String? from TrainingRoundParticipantsSelected.federationName
      trainingRunConfigurationId: UUID derived {
        from TrainingRoundParticipantsSelected.trainingRunConfigurationId, HomomorphicEncryptionContextPrepared.trainingRunConfigurationId
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      configurationName: String? from TrainingRoundParticipantsSelected.configurationName
      trainingJobObjective: String from TrainingRoundParticipantsSelected.trainingJobObjective
      featureSchemaId: UUID derived {
        from TrainingRoundParticipantsSelected.featureSchemaId, HomomorphicEncryptionContextPrepared.featureSchemaId
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      featureDomain: String? from TrainingRoundParticipantsSelected.featureDomain
      featureSchemaVersion: String? from TrainingRoundParticipantsSelected.featureSchemaVersion
      roundId: UUID derived {
        from TrainingRoundParticipantsSelected.roundId, HomomorphicEncryptionContextPrepared.roundId
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      roundNumber: Int derived {
        from TrainingRoundParticipantsSelected.roundNumber, HomomorphicEncryptionContextPrepared.roundNumber
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      selectedOrganizationIds: UUID[] derived {
        from TrainingRoundParticipantsSelected.selectedOrganizationIds, HomomorphicEncryptionContextPrepared.selectedOrganizationIds
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      selectedRuntimeIds: UUID[] derived {
        from TrainingRoundParticipantsSelected.selectedRuntimeIds, HomomorphicEncryptionContextPrepared.selectedRuntimeIds
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      selectedOrganizationCount: Int derived {
        from TrainingRoundParticipantsSelected.selectedOrganizationCount, HomomorphicEncryptionContextPrepared.selectedOrganizationCount
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      selectedRuntimeCount: Int derived {
        from TrainingRoundParticipantsSelected.selectedRuntimeCount, HomomorphicEncryptionContextPrepared.selectedRuntimeCount
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      minimumNodesPerRound: Int derived {
        from TrainingRoundParticipantsSelected.minimumNodesPerRound, HomomorphicEncryptionContextPrepared.minimumNodesPerRound
        rule "Use the selected participant snapshot for plaintext rounds and the prepared encryption context for secure aggregation rounds."
      }
      maxRounds: Int derived {
        from TrainingRoundParticipantsSelected.maxRounds, HomomorphicEncryptionContextPrepared.maxRounds
        rule "Carry the configured maximum round budget for downstream completion and next-round decisions."
      }
      minimumAccuracy: Decimal derived {
        from TrainingRoundParticipantsSelected.minimumAccuracy, HomomorphicEncryptionContextPrepared.minimumAccuracy
        rule "Carry the target global accuracy for downstream completion and next-round decisions."
      }
      aggregationAlgorithm: String? from TrainingRoundParticipantsSelected.aggregationAlgorithm
      secureAggregationRequired: Boolean derived {
        from TrainingRoundParticipantsSelected.secureAggregationRequired, HomomorphicEncryptionContextPrepared.secureAggregationRequired
        rule "Plaintext rounds use false from participant selection; secure aggregation rounds use true from the prepared encryption context."
      }
      secureAggregationSessionId: UUID? from HomomorphicEncryptionContextPrepared.secureAggregationSessionId
      encryptionScheme: String? from HomomorphicEncryptionContextPrepared.encryptionScheme
      publicKeyVersion: String? from HomomorphicEncryptionContextPrepared.publicKeyVersion
      publicKeyRef: String? from HomomorphicEncryptionContextPrepared.publicKeyRef
      encryptedParameterScale: Int? from HomomorphicEncryptionContextPrepared.encryptedParameterScale
    }

    event TrainingRoundStarted {
      trainingJobId: UUID id technical
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      roundId: UUID
      roundNumber: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedParticipants: TrainingRoundParticipant[] derived from TrainingRoundParticipantsSelected.selectedParticipants by roundId
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregationAlgorithm: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
    }

    event TrainingRoundStartFailed {
      trainingJobId: UUID id technical
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      roundId: UUID
      roundNumber: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedParticipants: TrainingRoundParticipant[] derived from TrainingRoundParticipantsSelected.selectedParticipants by roundId
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
      failureReason: String
    }

    state Running

    specification "Training Round Requires Selected Runtime Quorum" {
      rule """
        Starting a training round is an automated domain decision. A selected participant snapshot that satisfies the configured runtime quorum starts the round; a snapshot below quorum records a failed start event instead of relying on an interactive rejection.
      """

      scenario "Start Round With Selected Runtime Quorum" {
        when StartTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 3
        }
        then TrainingRoundStarted
      }

      scenario "Record Failed Round Start Below Quorum" {
        when StartTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 2
        }
        then TrainingRoundStartFailed
      }
    }
  }

  slice GenerateParticipantExecutionPlan {
    startsLifecycle
    reactsTo TrainingRoundStarted

    automation GeneratePlanForSelectedRuntime {
      on TrainingRoundStarted
      condition selectedRuntimeCount > 0
      for each TrainingRoundStarted.selectedParticipants as participant
      emits GenerateParticipantExecutionPlan
    }

    command GenerateParticipantExecutionPlan {
      executionPlanId: UUID id generated technical
      executionSessionId: UUID generated technical
      trainingJobId: UUID from TrainingRoundStarted.trainingJobId
      federationId: UUID from TrainingRoundStarted.federationId
      federationName: String? from TrainingRoundStarted.federationName
      trainingRunConfigurationId: UUID from TrainingRoundStarted.trainingRunConfigurationId
      configurationName: String? from TrainingRoundStarted.configurationName
      trainingJobObjective: String from TrainingRoundStarted.trainingJobObjective
      featureSchemaId: UUID from TrainingRoundStarted.featureSchemaId
      roundId: UUID from TrainingRoundStarted.roundId
      roundNumber: Int from TrainingRoundStarted.roundNumber
      runtimeId: UUID from participant.runtimeId
      organizationId: UUID from participant.organizationId
      baseModelId: UUID derived {
        from TrainingRunConfiguration.initialModelId, TrainingRoundCompleted.aggregatedModelId
        rule "Round one uses the initial model selected by the training configuration; later rounds use the aggregated model from the previous completed round."
      }
      baseModelArtifactUri: String derived {
        from TrainingRunConfiguration.initialModelArtifactUri, TrainingRoundCompleted.aggregatedModelArtifactUri
        rule "Snapshot the pullable artifact URI for the base model used by this participant execution plan."
      }
      baseModelRegistryRef: String derived {
        from TrainingRunConfiguration.initialModelRegistryRef, TrainingRoundCompleted.aggregatedModelRegistryRef
        rule "Snapshot the model registry reference that owns the base model artifact."
      }
      baseModelFormat: String derived {
        from TrainingRunConfiguration.initialModelFormat, TrainingRoundCompleted.modelFormat
        rule "Snapshot the model format required by the runtime engine."
      }
      baseModelArtifactDigest: String derived {
        from TrainingRunConfiguration.initialModelArtifactDigest, TrainingRoundCompleted.modelArtifactDigest
        rule "Snapshot the artifact digest used by runtime agents to verify the base model."
      }
      baseModelSignatureUri: String? derived {
        from TrainingRunConfiguration.initialModelSignatureUri, TrainingRoundCompleted.aggregatedModelSignatureUri
        rule "Snapshot the optional signature URI for the base model used by this participant execution plan."
      }
      secureAggregationRequired: Boolean from TrainingRoundStarted.secureAggregationRequired
      secureAggregationSessionId: UUID? from TrainingRoundStarted.secureAggregationSessionId
      encryptionScheme: String? from TrainingRoundStarted.encryptionScheme
      publicKeyVersion: String? from TrainingRoundStarted.publicKeyVersion
      publicKeyRef: String? from TrainingRoundStarted.publicKeyRef
      encryptedParameterScale: Int? from TrainingRoundStarted.encryptedParameterScale
    }

    event ParticipantExecutionPlanGenerated {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
    }

    state PlanGenerated

    specification "Participant Execution Plan Carries Base Model Artifact Snapshot" {
      rule """
        A participant execution plan must carry the immutable base model artifact snapshot needed by the runtime agent: model identity, pullable artifact URI, registry reference, model format, artifact digest, and optional signature URI. Runtime agents must not infer or query these values later from a mutable model repository view. Round one uses the initial model snapshot from the training run configuration; later rounds use the aggregated model snapshot recorded when the previous training round completed.
      """

      scenario "Generate Initial Round Plan With Initial Model Snapshot" {
        given TrainingRoundStarted {
          trainingJobId = "job-1"
          roundId = "round-1"
          roundNumber = 1
        }
        when GenerateParticipantExecutionPlan {
          trainingJobId = "job-1"
          roundId = "round-1"
          roundNumber = 1
        }
        then ParticipantExecutionPlanGenerated
      }

      scenario "Generate Later Round Plan With Aggregated Model Snapshot" {
        given TrainingRoundCompleted {
          trainingJobId = "job-1"
          roundId = "round-1"
          aggregatedModelId = "model-round-1"
          aggregatedModelArtifactUri = "oci://registry.example.com/fl/model-round-1@sha256:def"
          aggregatedModelRegistryRef = "oci://registry.example.com/fl"
          modelArtifactDigest = "sha256:def"
        }
        when GenerateParticipantExecutionPlan {
          trainingJobId = "job-1"
          roundId = "round-2"
          roundNumber = 2
        }
        then ParticipantExecutionPlanGenerated
      }
    }
  }

  slice DispatchParticipantExecutionPlan {
    reactsTo ParticipantExecutionPlanGenerated
    port

    automation DispatchPlanWhenGenerated {
      on ParticipantExecutionPlanGenerated
      emits DispatchParticipantExecutionPlan
    }

    command DispatchParticipantExecutionPlan {
      executionPlanId: UUID id technical from ParticipantExecutionPlanGenerated.executionPlanId
      executionSessionId: UUID from ParticipantExecutionPlanGenerated.executionSessionId
      trainingJobId: UUID from ParticipantExecutionPlanGenerated.trainingJobId
      trainingRunConfigurationId: UUID from ParticipantExecutionPlanGenerated.trainingRunConfigurationId
      featureSchemaId: UUID from ParticipantExecutionPlanGenerated.featureSchemaId
      roundId: UUID from ParticipantExecutionPlanGenerated.roundId
      roundNumber: Int from ParticipantExecutionPlanGenerated.roundNumber
      runtimeId: UUID from ParticipantExecutionPlanGenerated.runtimeId
      organizationId: UUID from ParticipantExecutionPlanGenerated.organizationId
      baseModelId: UUID from ParticipantExecutionPlanGenerated.baseModelId
      baseModelArtifactUri: String from ParticipantExecutionPlanGenerated.baseModelArtifactUri
      baseModelRegistryRef: String from ParticipantExecutionPlanGenerated.baseModelRegistryRef
      baseModelFormat: String from ParticipantExecutionPlanGenerated.baseModelFormat
      baseModelArtifactDigest: String from ParticipantExecutionPlanGenerated.baseModelArtifactDigest
      baseModelSignatureUri: String? from ParticipantExecutionPlanGenerated.baseModelSignatureUri
      secureAggregationRequired: Boolean from ParticipantExecutionPlanGenerated.secureAggregationRequired
      secureAggregationSessionId: UUID? from ParticipantExecutionPlanGenerated.secureAggregationSessionId
      encryptionScheme: String? from ParticipantExecutionPlanGenerated.encryptionScheme
      publicKeyVersion: String? from ParticipantExecutionPlanGenerated.publicKeyVersion
      publicKeyRef: String? from ParticipantExecutionPlanGenerated.publicKeyRef
      encryptedParameterScale: Int? from ParticipantExecutionPlanGenerated.encryptedParameterScale
    }

    event ParticipantExecutionPlanDispatched {
      executionPlanId: UUID id technical
      executionSessionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      runtimeId: UUID
      organizationId: UUID
      baseModelId: UUID
      baseModelArtifactUri: String
      baseModelRegistryRef: String
      baseModelFormat: String
      baseModelArtifactDigest: String
      baseModelSignatureUri: String?
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
    }

    state PlanDispatched
  }

  slice SubmitModelUpdateSubmission {
    actor RuntimeAgent
    reactsTo AgentLocalModelUpdateSubmitted

    command SubmitModelUpdateSubmission {
      modelUpdateSubmissionId: UUID id generated technical
      executionSessionId: UUID from AgentLocalModelUpdateSubmitted.executionSessionId
      executionPlanId: UUID from AgentLocalModelUpdateSubmitted.executionPlanId
      trainingJobId: UUID from AgentLocalModelUpdateSubmitted.trainingJobId
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundExecutionId: UUID from AgentLocalModelUpdateSubmitted.roundExecutionId
      runtimeId: UUID from AgentLocalModelUpdateSubmitted.runtimeId
      featureSchemaId: UUID
      secureAggregationRequired: Boolean from AgentLocalModelUpdateSubmitted.secureAggregationRequired
      secureAggregationSessionId: UUID? from AgentLocalModelUpdateSubmitted.secureAggregationSessionId
      encryptionScheme: String? from AgentLocalModelUpdateSubmitted.encryptionScheme
      publicKeyVersion: String? from AgentLocalModelUpdateSubmitted.publicKeyVersion
      localModelId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      updateProtectionType: String from AgentLocalModelUpdateSubmitted.updateProtectionType
      trainingLoss: Decimal
    }

    event ModelUpdateSubmissionReceived {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      roundExecutionId: UUID
      runtimeId: UUID
      featureSchemaId: UUID
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      localModelId: UUID
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      updateProtectionType: String dictionary "MODEL_UPDATE_PROTECTION_TYPE"
      trainingLoss: Decimal
    }

    state Received
  }

  slice EvaluateModelUpdateSubmission {
    reactsTo ModelUpdateSubmissionReceived

    automation EvaluateModelUpdateWhenReceived {
      on ModelUpdateSubmissionReceived
      emits EvaluateModelUpdateSubmission
    }

    command EvaluateModelUpdateSubmission {
      modelUpdateSubmissionId: UUID id technical from ModelUpdateSubmissionReceived.modelUpdateSubmissionId
      executionSessionId: UUID from ModelUpdateSubmissionReceived.executionSessionId
      executionPlanId: UUID from ModelUpdateSubmissionReceived.executionPlanId
      trainingJobId: UUID from ModelUpdateSubmissionReceived.trainingJobId
      trainingRunConfigurationId: UUID from ModelUpdateSubmissionReceived.trainingRunConfigurationId
      roundId: UUID from ModelUpdateSubmissionReceived.roundId
      runtimeId: UUID from ModelUpdateSubmissionReceived.runtimeId
      featureSchemaId: UUID from ModelUpdateSubmissionReceived.featureSchemaId
      secureAggregationRequired: Boolean from ModelUpdateSubmissionReceived.secureAggregationRequired
      secureAggregationSessionId: UUID? from ModelUpdateSubmissionReceived.secureAggregationSessionId
      encryptionScheme: String? from ModelUpdateSubmissionReceived.encryptionScheme
      publicKeyVersion: String? from ModelUpdateSubmissionReceived.publicKeyVersion
      updateArtifactId: UUID from ModelUpdateSubmissionReceived.updateArtifactId
      artifactRef: String from ModelUpdateSubmissionReceived.artifactRef
      artifactDigest: String from ModelUpdateSubmissionReceived.artifactDigest
      updateProtectionType: String from ModelUpdateSubmissionReceived.updateProtectionType
      anomalyScore: Decimal generated technical
    }

    event ModelUpdateSubmissionAccepted {
      modelUpdateSubmissionId: UUID id technical
      executionSessionId: UUID
      executionPlanId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      trainingJobObjective: String from TrainingRoundStarted.trainingJobObjective
      roundId: UUID
      roundNumber: Int from TrainingRoundStarted.roundNumber
      maxRounds: Int from TrainingRoundStarted.maxRounds
      minimumAccuracy: Decimal from TrainingRoundStarted.minimumAccuracy
      aggregationAlgorithm: String? from TrainingRoundStarted.aggregationAlgorithm
      runtimeId: UUID
      featureSchemaId: UUID
      secureAggregationRequired: Boolean
      secureAggregationSessionId: UUID?
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      updateArtifactId: UUID
      artifactRef: String
      artifactDigest: String
      updateProtectionType: String dictionary "MODEL_UPDATE_PROTECTION_TYPE"
      anomalyScore: Decimal
      acceptedModelUpdateCount: Int derived from ModelUpdateSubmissionAccepted.acceptedRuntimeIds, EvaluateModelUpdateSubmission.runtimeId {
        rule "count(appendDistinct(ModelUpdateSubmissionAccepted.acceptedRuntimeIds, EvaluateModelUpdateSubmission.runtimeId))"
      }
      acceptedRuntimeIds: UUID[] derived from ModelUpdateSubmissionAccepted.acceptedRuntimeIds, EvaluateModelUpdateSubmission.runtimeId {
        rule "appendDistinct(ModelUpdateSubmissionAccepted.acceptedRuntimeIds, EvaluateModelUpdateSubmission.runtimeId)"
      }
      acceptedModelUpdateArtifactRefs: String[] derived from ModelUpdateSubmissionAccepted.acceptedModelUpdateArtifactRefs, EvaluateModelUpdateSubmission.artifactRef {
        rule "appendDistinct(ModelUpdateSubmissionAccepted.acceptedModelUpdateArtifactRefs, EvaluateModelUpdateSubmission.artifactRef)"
      }
      minimumNodesPerRound: Int from TrainingRoundStarted.minimumNodesPerRound
      requiredModelUpdateCount: Int from TrainingRoundStarted.selectedRuntimeCount
      plainAggregationReady: Boolean derived {
        from EvaluateModelUpdateSubmission.secureAggregationRequired, EvaluateModelUpdateSubmission.runtimeId, ModelUpdateSubmissionAccepted.acceptedRuntimeIds, ModelUpdateSubmissionAccepted.acceptedModelUpdateCount, ModelUpdateSubmissionAccepted.requiredModelUpdateCount
        rule "True only when secure aggregation is disabled and a newly accepted runtime makes the cumulative accepted model update count reach the selected runtime count."
      }
    }

    event ModelUpdateSubmissionRejected {
      modelUpdateSubmissionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      roundId: UUID
      runtimeId: UUID
      updateArtifactId: UUID from ModelUpdateSubmissionReceived.updateArtifactId
      anomalyScore: Decimal
      rejectionReason: String generated technical
    }

    state Evaluated

    specification "Poisoned Local Updates Are Excluded" {
      rule """
        A runtime agent submits only the protected model update artifact for secure aggregation rounds. The platform evaluates the submitted metadata, digest, protection type, participant identity, and anomaly signal without receiving plaintext model parameters. ModelUpdateSubmissionAccepted carries the cumulative accepted runtime snapshot for the round so downstream secure aggregation automation can count encrypted updates and complete aggregation. Anomalous update rejection remains an explicit business rule and should be wired to ModelUpdateSubmissionRejected after the anomaly scoring policy is modeled as a conditional decision or port-backed adapter.
      """

      expression {
        assert EvaluateModelUpdateSubmission.anomalyScore < 0.95
      }

      scenario "Accept Normal Update" {
        given TrainingRoundStarted {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          selectedRuntimeCount = 2
          minimumNodesPerRound = 2
        }
        given ModelUpdateSubmissionReceived {
          modelUpdateSubmissionId = "submission-1"
          roundId = "round-1"
          runtimeId = "runtime-1"
          updateArtifactId = "artifact-1"
          trainingLoss = 0.23
        }
        when EvaluateModelUpdateSubmission {
          modelUpdateSubmissionId = "submission-1"
          runtimeId = "runtime-1"
          anomalyScore = 0.12
        }
        then ModelUpdateSubmissionAccepted
      }

      scenario "Reject Anomalous Update" {
        given ModelUpdateSubmissionReceived {
          modelUpdateSubmissionId = "submission-1"
          roundId = "round-1"
          runtimeId = "runtime-1"
          updateArtifactId = "artifact-1"
          trainingLoss = 99.0
        }
        when EvaluateModelUpdateSubmission {
          modelUpdateSubmissionId = "submission-1"
          anomalyScore = 0.98
        }
        then reject "Anomalous Model Update Rejected"
      }
    }
  }

  slice AggregatePlainModelUpdates {
    reactsTo ModelUpdateSubmissionAccepted
    port

    automation AggregatePlainUpdatesWhenQuorumReached {
      on ModelUpdateSubmissionAccepted
      condition plainAggregationReady == true
      emits AggregatePlainModelUpdates
    }

    command AggregatePlainModelUpdates {
      trainingJobId: UUID id technical from ModelUpdateSubmissionAccepted.trainingJobId
      trainingRunConfigurationId: UUID from ModelUpdateSubmissionAccepted.trainingRunConfigurationId
      trainingJobObjective: String from ModelUpdateSubmissionAccepted.trainingJobObjective
      featureSchemaId: UUID from ModelUpdateSubmissionAccepted.featureSchemaId
      roundId: UUID from ModelUpdateSubmissionAccepted.roundId
      roundNumber: Int from ModelUpdateSubmissionAccepted.roundNumber
      maxRounds: Int from ModelUpdateSubmissionAccepted.maxRounds
      minimumAccuracy: Decimal from ModelUpdateSubmissionAccepted.minimumAccuracy
      aggregationAlgorithm: String from ModelUpdateSubmissionAccepted.aggregationAlgorithm
      aggregatedModelId: UUID generated technical
      modelUpdateArtifactRefs: String[] from ModelUpdateSubmissionAccepted.acceptedModelUpdateArtifactRefs
    }

    event PlainModelAggregationCompleted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregatedModelId: UUID
      aggregatedModelName: String portOutput
      aggregatedModelVersion: String portOutput
      aggregatedModelDescription: String? portOutput
      modelSourceType: String portOutput
      aggregatedModelArtifactUri: String portOutput
      aggregatedModelRegistryRef: String portOutput
      modelFormat: String portOutput
      modelArtifactDigest: String portOutput
      aggregatedModelSignatureUri: String? portOutput
      aggregatedModelSizeBytes: Int? portOutput
    }

    state Completed

    specification "Plain Model Updates Are Aggregated After Quorum" {
      rule """
        A round that does not require secure aggregation must aggregate accepted plaintext model updates after every selected runtime has contributed an accepted update. The aggregation input is the cumulative immutable artifact reference snapshot carried by ModelUpdateSubmissionAccepted. Completion produces the same global model metadata required by evaluation and model registration without creating a secure aggregation session. Duplicate submissions from an already accepted runtime must not trigger aggregation again.
      """

      scenario "Aggregate Accepted Plain Updates" {
        given ModelUpdateSubmissionAccepted {
          trainingJobId = "job-1"
          roundId = "round-1"
          secureAggregationRequired = false
          acceptedModelUpdateCount = 1
          minimumNodesPerRound = 1
        }
        when AggregatePlainModelUpdates {
          trainingJobId = "job-1"
          roundId = "round-1"
        }
        then PlainModelAggregationCompleted
      }
    }
  }

  slice RequestSecureAggregation {
    reactsTo TrainingRoundParticipantsSelected

    automation RequestAggregationWhenParticipantsSelected {
      on TrainingRoundParticipantsSelected
      condition secureAggregationRequired == true
      emits RequestSecureAggregation
    }

    command RequestSecureAggregation {
      trainingJobId: UUID id technical from TrainingRoundParticipantsSelected.trainingJobId
      federationId: UUID from TrainingRoundParticipantsSelected.federationId
      federationName: String? from TrainingRoundParticipantsSelected.federationName
      trainingRunConfigurationId: UUID from TrainingRoundParticipantsSelected.trainingRunConfigurationId
      configurationName: String? from TrainingRoundParticipantsSelected.configurationName
      trainingJobObjective: String from TrainingRoundParticipantsSelected.trainingJobObjective
      featureSchemaId: UUID from TrainingRoundParticipantsSelected.featureSchemaId
      featureDomain: String? from TrainingRoundParticipantsSelected.featureDomain
      featureSchemaVersion: String? from TrainingRoundParticipantsSelected.featureSchemaVersion
      roundId: UUID from TrainingRoundParticipantsSelected.roundId
      roundNumber: Int from TrainingRoundParticipantsSelected.roundNumber
      requiredParticipantCount: Int from TrainingRoundParticipantsSelected.selectedRuntimeCount
      selectedOrganizationIds: UUID[] from TrainingRoundParticipantsSelected.selectedOrganizationIds
      selectedRuntimeIds: UUID[] from TrainingRoundParticipantsSelected.selectedRuntimeIds
      selectedOrganizationCount: Int from TrainingRoundParticipantsSelected.selectedOrganizationCount
      selectedRuntimeCount: Int from TrainingRoundParticipantsSelected.selectedRuntimeCount
      minimumNodesPerRound: Int from TrainingRoundParticipantsSelected.minimumNodesPerRound
      maxRounds: Int from TrainingRoundParticipantsSelected.maxRounds
      minimumAccuracy: Decimal from TrainingRoundParticipantsSelected.minimumAccuracy
      secureAggregationRequired: Boolean from TrainingRoundParticipantsSelected.secureAggregationRequired
    }

    event SecureAggregationRequested {
      trainingJobId: UUID id technical
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      roundId: UUID
      roundNumber: Int
      requiredParticipantCount: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      secureAggregationRequired: Boolean
    }

  }

  slice CompleteModelAggregation {
    reactsTo SecureAggregationCompleted
    reactsTo PlainModelAggregationCompleted

    automation CompleteSecureAggregationWhenSessionCompleted {
      on SecureAggregationCompleted
      emits CompleteModelAggregation
    }

    automation CompletePlainAggregationWhenCompleted {
      on PlainModelAggregationCompleted
      emits CompleteModelAggregation
    }

    command CompleteModelAggregation {
      trainingJobId: UUID id technical derived {
        from SecureAggregationCompleted.trainingJobId, PlainModelAggregationCompleted.trainingJobId
        rule "Use the completed secure or plaintext aggregation result."
      }
      trainingRunConfigurationId: UUID derived {
        from SecureAggregationCompleted.trainingRunConfigurationId, PlainModelAggregationCompleted.trainingRunConfigurationId
        rule "Use the completed secure or plaintext aggregation result."
      }
      trainingJobObjective: String derived {
        from SecureAggregationCompleted.trainingJobObjective, PlainModelAggregationCompleted.trainingJobObjective
        rule "Carry the training job objective snapshot into the produced global model artifact."
      }
      featureSchemaId: UUID derived {
        from SecureAggregationCompleted.featureSchemaId, PlainModelAggregationCompleted.featureSchemaId
        rule "Use the completed secure or plaintext aggregation result."
      }
      roundId: UUID derived {
        from SecureAggregationCompleted.roundId, PlainModelAggregationCompleted.roundId
        rule "Use the completed secure or plaintext aggregation result."
      }
      roundNumber: Int derived {
        from SecureAggregationCompleted.roundNumber, PlainModelAggregationCompleted.roundNumber
        rule "Use the completed secure or plaintext aggregation result."
      }
      maxRounds: Int derived {
        from SecureAggregationCompleted.maxRounds, PlainModelAggregationCompleted.maxRounds
        rule "Use the completed secure or plaintext aggregation result."
      }
      minimumAccuracy: Decimal derived {
        from SecureAggregationCompleted.minimumAccuracy, PlainModelAggregationCompleted.minimumAccuracy
        rule "Use the completed secure or plaintext aggregation result."
      }
      secureAggregationSessionId: UUID? from SecureAggregationCompleted.secureAggregationSessionId
      aggregatedModelId: UUID derived {
        from SecureAggregationCompleted.aggregatedModelId, PlainModelAggregationCompleted.aggregatedModelId
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelName: String derived {
        from SecureAggregationCompleted.aggregatedModelName, PlainModelAggregationCompleted.aggregatedModelName
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelVersion: String derived {
        from SecureAggregationCompleted.aggregatedModelVersion, PlainModelAggregationCompleted.aggregatedModelVersion
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelDescription: String? derived {
        from SecureAggregationCompleted.aggregatedModelDescription, PlainModelAggregationCompleted.aggregatedModelDescription
        rule "Use the completed secure or plaintext aggregation result."
      }
      modelSourceType: String derived {
        from SecureAggregationCompleted.modelSourceType, PlainModelAggregationCompleted.modelSourceType
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelArtifactUri: String derived {
        from SecureAggregationCompleted.aggregatedModelArtifactUri, PlainModelAggregationCompleted.aggregatedModelArtifactUri
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelRegistryRef: String derived {
        from SecureAggregationCompleted.aggregatedModelRegistryRef, PlainModelAggregationCompleted.aggregatedModelRegistryRef
        rule "Use the completed secure or plaintext aggregation result."
      }
      modelFormat: String derived {
        from SecureAggregationCompleted.modelFormat, PlainModelAggregationCompleted.modelFormat
        rule "Use the completed secure or plaintext aggregation result."
      }
      modelArtifactDigest: String derived {
        from SecureAggregationCompleted.modelArtifactDigest, PlainModelAggregationCompleted.modelArtifactDigest
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelSignatureUri: String? derived {
        from SecureAggregationCompleted.aggregatedModelSignatureUri, PlainModelAggregationCompleted.aggregatedModelSignatureUri
        rule "Use the completed secure or plaintext aggregation result."
      }
      aggregatedModelSizeBytes: Int? derived {
        from SecureAggregationCompleted.aggregatedModelSizeBytes, PlainModelAggregationCompleted.aggregatedModelSizeBytes
        rule "Use the completed secure or plaintext aggregation result."
      }
    }

    event GlobalModelUpdated {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      secureAggregationSessionId: UUID?
      aggregatedModelId: UUID
      aggregatedModelName: String
      aggregatedModelVersion: String
      aggregatedModelDescription: String?
      modelSourceType: String
      aggregatedModelArtifactUri: String
      aggregatedModelRegistryRef: String
      modelFormat: String
      modelArtifactDigest: String
      aggregatedModelSignatureUri: String?
      aggregatedModelSizeBytes: Int?
    }

    state EvaluatingGlobalModel
  }

  slice SubmitGlobalModelEvaluation {
    reactsTo GlobalModelUpdated
    port

    automation SubmitGlobalModelEvaluationWhenGlobalModelUpdated {
      on GlobalModelUpdated
      emits SubmitGlobalModelEvaluation
    }

    command SubmitGlobalModelEvaluation {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      trainingJobObjective: String from GlobalModelUpdated.trainingJobObjective
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int from GlobalModelUpdated.roundNumber
      maxRounds: Int from GlobalModelUpdated.maxRounds
      minimumAccuracy: Decimal from GlobalModelUpdated.minimumAccuracy
      aggregatedModelId: UUID
      aggregatedModelArtifactUri: String from GlobalModelUpdated.aggregatedModelArtifactUri
      aggregatedModelRegistryRef: String from GlobalModelUpdated.aggregatedModelRegistryRef
      modelFormat: String from GlobalModelUpdated.modelFormat
      modelArtifactDigest: String from GlobalModelUpdated.modelArtifactDigest
      aggregatedModelSignatureUri: String? from GlobalModelUpdated.aggregatedModelSignatureUri
    }

    event GlobalModelEvaluationSubmitted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregatedModelId: UUID
      aggregatedModelArtifactUri: String
      aggregatedModelRegistryRef: String
      modelFormat: String
      modelArtifactDigest: String
      aggregatedModelSignatureUri: String?
      globalAccuracy: Decimal portOutput
      globalFairnessScore: Decimal portOutput
    }
  }

  slice CompleteTrainingRound {
    reactsTo GlobalModelEvaluationSubmitted

    automation FinishRoundAfterGlobalModelEvaluated {
      on GlobalModelEvaluationSubmitted
      emits CompleteTrainingRound
    }

    command CompleteTrainingRound {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      trainingJobObjective: String from GlobalModelEvaluationSubmitted.trainingJobObjective
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int from GlobalModelEvaluationSubmitted.roundNumber
      maxRounds: Int from GlobalModelEvaluationSubmitted.maxRounds
      minimumAccuracy: Decimal from GlobalModelEvaluationSubmitted.minimumAccuracy
      aggregatedModelId: UUID
      aggregatedModelArtifactUri: String from GlobalModelEvaluationSubmitted.aggregatedModelArtifactUri
      aggregatedModelRegistryRef: String from GlobalModelEvaluationSubmitted.aggregatedModelRegistryRef
      modelFormat: String from GlobalModelEvaluationSubmitted.modelFormat
      modelArtifactDigest: String from GlobalModelEvaluationSubmitted.modelArtifactDigest
      aggregatedModelSignatureUri: String? from GlobalModelEvaluationSubmitted.aggregatedModelSignatureUri
      globalAccuracy: Decimal
    }

    event TrainingRoundCompleted {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregatedModelId: UUID
      aggregatedModelArtifactUri: String
      aggregatedModelRegistryRef: String
      modelFormat: String
      modelArtifactDigest: String
      aggregatedModelSignatureUri: String?
      globalAccuracy: Decimal
    }

    state Completed

    specification "Training Round Completion Requires Global Evaluation" {
      rule """
        A training round can be completed only after the aggregated global model has been evaluated.
      """

      scenario "Complete Round After Global Evaluation" {
        given GlobalModelEvaluationSubmitted {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelId = "model-1"
          globalAccuracy = 0.91
        }
        when CompleteTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelId = "model-1"
          globalAccuracy = 0.91
        }
        then TrainingRoundCompleted
      }

      scenario "Reject Round Completion Without Global Evaluation" {
        given GlobalModelUpdated {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelId = "model-1"
        }
        when CompleteTrainingRound {
          trainingJobId = "job-1"
          trainingRunConfigurationId = "config-1"
          roundId = "round-1"
          aggregatedModelId = "model-1"
        }
        then reject "Global Model Evaluation Required"
      }
    }
  }

  slice FailTrainingRound {
    actor AggregationRuntime

    automation FailRoundWhenRejectedUpdatesBreakQuorum {
      on ModelUpdateSubmissionRejected
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    automation FailRoundWhenRuntimeExecutionFailureBreaksQuorum {
      on RoundExecutionFailed
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    automation FailRoundWhenRuntimeExecutionStartFailureBreaksQuorum {
      on RoundExecutionStartFailed
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    automation FailRoundWhenRuntimeExecutionStartRetryFailureBreaksQuorum {
      on RoundExecutionStartRetryFailed
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    automation FailRoundWhenRuntimeExecutionRetryFailureBreaksQuorum {
      on RoundExecutionRuntimeRetryFailed
      condition roundQuorumLost == true
      emits FailTrainingRound
    }

    command FailTrainingRound {
      trainingJobId: UUID id technical
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      failureReason: String
    }

    event TrainingRoundFailed {
      trainingJobId: UUID id technical from FailTrainingRound.trainingJobId
      trainingRunConfigurationId: UUID from FailTrainingRound.trainingRunConfigurationId
      featureSchemaId: UUID from FailTrainingRound.featureSchemaId
      roundId: UUID from FailTrainingRound.roundId
      selectedRuntimeCount: Int from FailTrainingRound.selectedRuntimeCount
      minimumNodesPerRound: Int from FailTrainingRound.minimumNodesPerRound
      failureReason: String from FailTrainingRound.failureReason
    }

    state Failed
  }

  slice TrainingRoundProgress {
    readmodel TrainingRoundProgress[] {
      trainingJobId: UUID id
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID id
      trainingJobObjective: String?
      featureDomain: String?
      featureSchemaVersion: String?
      roundNumber: Int
      state: TrainingRound.State
      selectedOrganizationIds: UUID[]
      selectedParticipants: TrainingRoundParticipant[]
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      targetRuntimeCount: Int
      executionPlanDispatchedCount: Int
      roundExecutionStartedCount: Int
      submittedModelUpdateCount: Int
      rejectedUpdateCount: Int
      acceptedModelUpdateCount: Int
      acceptedUpdateCount: Int
      pendingUpdateCount: Int
      failedRoundExecutionCount: Int
      completedRoundExecutionCount: Int
      retriedRoundExecutionCount: Int
      failedRoundExecutionRetryCount: Int
      quorumMet: Boolean
      quorumStatus: String
      minimumNodesPerRound: Int?
      aggregationReady: Boolean
      secureAggregationRequired: Boolean
      secureAggregationStatus: String?
      evaluationComplete: Boolean
      progressPercent: Int
      currentPhase: String
      nextAction: String?
      blockedReason: String?
      delayedReason: String?
      roundStartedAt: DateTime?
      contributionDeadlineAt: DateTime?
      aggregationStartedAt: DateTime?
      evaluationSubmittedAt: DateTime?
      completedAt: DateTime?
      failedAt: DateTime?
      baseModelId: UUID?
      artifactRefs: String[]
      rejectedUpdateReasons: String[]
      aggregatedModelId: UUID?
      globalAccuracy: Decimal?
      globalFairnessScore: Decimal?
      failureReason: String?
      subscribe TrainingJobCreated
      subscribe FeatureSchemaDefined
      subscribe TrainingRoundParticipantsSelected
      subscribe TrainingRoundParticipantSelectionFailed
      subscribe TrainingRoundStarted
      subscribe TrainingRoundStartFailed
      subscribe ParticipantExecutionPlanGenerated
      subscribe ParticipantExecutionPlanDispatched
      subscribe RoundExecutionStarted
      subscribe RoundExecutionStartFailed
      subscribe RoundExecutionStartRetryStarted
      subscribe RoundExecutionStartRetryFailed
      subscribe RoundExecutionCompleted
      subscribe RoundExecutionFailed
      subscribe RoundExecutionRuntimeRetryStarted
      subscribe RoundExecutionRuntimeRetryFailed
      subscribe ModelUpdateSubmissionReceived
      subscribe ModelUpdateSubmissionAccepted
      subscribe ModelUpdateSubmissionRejected
      subscribe SecureAggregationRequested
      subscribe GlobalModelUpdated
      subscribe GlobalModelEvaluationSubmitted
      subscribe TrainingRoundCompleted
      subscribe TrainingRoundFailed
    }
  }

  concept TrainingRound {
    state ParticipantsSelected
    state Running
    state CollectingUpdates
    state Aggregating
    state EvaluatingGlobalModel
    state Completed
    state Failed

    slice SelectTrainingRoundParticipants
    slice RetryTrainingRoundParticipantSelection
    slice StartTrainingRound
    slice SubmitModelUpdateSubmission
    slice EvaluateModelUpdateSubmission
    slice AggregatePlainModelUpdates
    slice RequestSecureAggregation
    slice CompleteModelAggregation
    slice SubmitGlobalModelEvaluation
    slice CompleteTrainingRound
    slice FailTrainingRound
    slice TrainingRoundProgress
  }

  concept ParticipantExecutionPlan {
    state PlanGenerated
    state PlanDispatched

    slice GenerateParticipantExecutionPlan
    slice DispatchParticipantExecutionPlan
  }
}

context ModelLifecycle {
  note "Model lifecycle starts after training has produced a final evaluated candidate."

  risk "A model can be promoted without a reproducibility package, model card, or approved evaluation report."
  risk "Rollback decisions may lose lineage if previous production versions are not captured."
  metric modelApprovalLeadTime
  metric productionRollbackRate

  slice RegisterCandidateModel {
    startsLifecycle
    reactsTo TrainingJobCompleted

    automation RegisterFinalModelWhenTrainingJobCompleted {
      on TrainingJobCompleted
      emits RegisterCandidateModel
    }

    command RegisterCandidateModel {
      modelId: UUID id technical
      trainingJobId: UUID from TrainingJobCompleted.trainingJobId
      trainingJobObjective: String from TrainingJobCompleted.trainingJobObjective
      finalRoundId: UUID from TrainingJobCompleted.finalRoundId
      modelArtifactId: UUID
      modelArtifactDigest: String
      evaluationReportId: UUID
      finalGlobalAccuracy: Decimal
    }

    event ModelCandidateRegistered {
      modelId: UUID id technical
      trainingJobId: UUID
      trainingJobObjective: String
      finalRoundId: UUID
      modelArtifactId: UUID
      modelArtifactDigest: String
      evaluationReportId: UUID
      finalGlobalAccuracy: Decimal
    }

    state Candidate
  }

  slice RecordModelEvaluationPackage {
    actor GovernanceReviewer
    ui ModelApprovalScreen
    reactsTo ModelCandidateRegistered

    command RecordModelEvaluationPackage {
      modelId: UUID id technical
      trainingJobId: UUID
      evaluationReportId: UUID
      experimentId: UUID
      hyperparameterSnapshotId: UUID
      reproducibilityManifestId: UUID
      modelCardId: UUID
      baselineModelId: UUID?
    }

    event ModelEvaluationPackageRecorded {
      modelId: UUID id technical from RecordModelEvaluationPackage.modelId
      trainingJobId: UUID from RecordModelEvaluationPackage.trainingJobId
      evaluationReportId: UUID from RecordModelEvaluationPackage.evaluationReportId
      experimentId: UUID from RecordModelEvaluationPackage.experimentId
      hyperparameterSnapshotId: UUID from RecordModelEvaluationPackage.hyperparameterSnapshotId
      reproducibilityManifestId: UUID from RecordModelEvaluationPackage.reproducibilityManifestId
      modelCardId: UUID from RecordModelEvaluationPackage.modelCardId
      baselineModelId: UUID? from RecordModelEvaluationPackage.baselineModelId
    }

    state EvaluationPackaged

    specification "Model Approval Requires Evaluation Package" {
      rule """
        A model candidate must have an evaluation report, reproducibility manifest, hyperparameter snapshot, and model card before governance approval.
      """

      scenario "Record Complete Evaluation Package" {
        given ModelCandidateRegistered {
          modelId = "model-1"
          evaluationReportId = "report-1"
        }
        when RecordModelEvaluationPackage {
          modelId = "model-1"
          reproducibilityManifestId = "manifest-1"
          modelCardId = "card-1"
        }
        then ModelEvaluationPackageRecorded
      }
    }
  }

  slice ApproveModel {
    actor GovernanceReviewer
    ui ModelApprovalScreen
    reactsTo ModelEvaluationPackageRecorded

    command ApproveModel {
      modelId: UUID id technical
      approvalNote: String?
    }

    event ModelApproved {
      modelId: UUID id technical
      approvalNote: String?
    }

    state Approved

    specification "Only Evaluation Packaged Models Can Be Approved" {
      rule """
        A model can be approved only after its evaluation package has been recorded.
      """

      scenario "Approve Evaluation Packaged Model" {
        given ModelEvaluationPackageRecorded {
          modelId = "model-1"
          evaluationReportId = "report-1"
          reproducibilityManifestId = "manifest-1"
          modelCardId = "card-1"
        }
        when ApproveModel {
          modelId = "model-1"
        }
        then ModelApproved
      }

      scenario "Reject Candidate Without Evaluation Package" {
        given ModelCandidateRegistered {
          modelId = "model-1"
          evaluationReportId = "report-1"
        }
        when ApproveModel {
          modelId = "model-1"
        }
        then reject "Model Evaluation Package Required"
      }
    }
  }

  slice PromoteModelToProduction {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelApproved

    command PromoteModelToProduction {
      modelId: UUID id technical
      releaseChannel: String dictionary "MODEL_RELEASE_CHANNEL"
      productionStage: String dictionary "MODEL_PRODUCTION_STAGE"
    }

    event ModelPromotedToProduction {
      modelId: UUID id technical
      releaseChannel: String dictionary "MODEL_RELEASE_CHANNEL"
      productionStage: String dictionary "MODEL_PRODUCTION_STAGE"
    }

    state Production

    specification "Only Approved Models Can Be Promoted To Production" {
      rule """
        A model can be promoted to production only after governance approval.
      """

      scenario "Promote Approved Model" {
        given ModelApproved {
          modelId = "model-1"
        }
        when PromoteModelToProduction {
          modelId = "model-1"
          releaseChannel = "stable"
          productionStage = "production"
        }
        then ModelPromotedToProduction
      }

      scenario "Reject Unapproved Model Promotion" {
        given ModelEvaluationPackageRecorded {
          modelId = "model-1"
        }
        when PromoteModelToProduction {
          modelId = "model-1"
          releaseChannel = "stable"
          productionStage = "production"
        }
        then reject "Model Approval Required"
      }
    }
  }

  slice RollbackModel {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelPromotedToProduction

    command RollbackModel {
      modelId: UUID id technical
      previousModelId: UUID
      rollbackReason: String
    }

    event ModelRolledBack {
      modelId: UUID id technical
      previousModelId: UUID
      rollbackReason: String
    }

    state RolledBack
  }

  slice RetireModel {
    actor ReleaseManager
    ui ModelReleaseScreen
    reactsTo ModelPromotedToProduction

    command RetireModel {
      modelId: UUID id technical
      retirementReason: String
    }

    event ModelRetired {
      modelId: UUID id technical
      retirementReason: String
    }

    state Retired
  }

  slice ModelCatalog {
    readmodel ModelCatalog[] {
      modelId: UUID id
      trainingJobId: UUID
      finalRoundId: UUID
      modelArtifactId: UUID
      trainingJobObjective: String?
      modelArtifactDigest: String
      evaluationReportId: UUID
      finalGlobalAccuracy: Decimal
      state: Model.State
      releaseChannel: String? dictionary "MODEL_RELEASE_CHANNEL"
      productionStage: String? dictionary "MODEL_PRODUCTION_STAGE"
      previousModelId: UUID?
      experimentId: UUID?
      hyperparameterSnapshotId: UUID?
      reproducibilityManifestId: UUID?
      modelCardId: UUID?
      baselineModelId: UUID?
      hasEvaluationPackage: Boolean
      approvalStatus: String
      releaseStatus: String
      isProduction: Boolean
      canRecordEvaluationPackage: Boolean
      canApprove: Boolean
      canPromoteToProduction: Boolean
      canRollback: Boolean
      canRetire: Boolean
      blockedReason: String?
      subscribe TrainingJobCreated
      subscribe ModelCandidateRegistered
      subscribe ModelEvaluationPackageRecorded
      subscribe ModelApproved
      subscribe ModelPromotedToProduction
      subscribe ModelRolledBack
      subscribe ModelRetired
    }
  }

  concept Model {
    state Candidate
    state EvaluationPackaged
    state Approved
    state Production
    state RolledBack
    state Retired

    slice RegisterCandidateModel
    slice RecordModelEvaluationPackage
    slice ApproveModel
    slice PromoteModelToProduction
    slice RollbackModel
    slice RetireModel
    slice ModelCatalog
  }
}

context RuntimeMonitoring {
  note "Runtime operations separates low-frequency runtime state changes, node inventory changes, latest telemetry views, training alerts, and append only audit records. High-frequency heartbeat and resource samples are telemetry, not event-sourced domain events."

  risk "Operational alerts without acknowledgement or resolution tracking can hide node degradation during training."
  risk "Audit records without payload hashes and source event classification weaken compliance evidence."
  metric runtimeAlertMeanTimeToAcknowledge
  metric auditTrailCompleteness

  slice RuntimeTelemetryLatest {
    readmodel todo RuntimeTelemetryLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      cpuLoad: Decimal?
      gpuLoad: Decimal?
      memoryLoad: Decimal?
      lastHeartbeatAt: DateTime?
      heartbeatMissingBeyondThreshold: Boolean
      heartbeatObservedAfterOffline: Boolean
      resourcePressureDetected: Boolean
      telemetryRetentionPolicy: String
    }
  }

  slice DetectRuntimeAgentOffline {
    startsLifecycle

    automation DetectOfflineRuntimeAgentFromTelemetry {
      on todo RuntimeTelemetryLatest
      condition heartbeatMissingBeyondThreshold == true
      emits DetectRuntimeAgentOffline
    }

    command DetectRuntimeAgentOffline {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      offlineReason: String
    }

    event RuntimeAgentOfflineDetected {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      offlineReason: String
    }

    state Offline
  }

  slice MarkRuntimeAgentRecovered {
    reactsTo RuntimeAgentOfflineDetected

    automation MarkRecoveredRuntimeAgentFromTelemetry {
      on todo RuntimeTelemetryLatest
      condition heartbeatObservedAfterOffline == true
      emits MarkRuntimeAgentRecovered
    }

    command MarkRuntimeAgentRecovered {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      recoveryReason: String?
    }

    event RuntimeAgentRecovered {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      recoveryReason: String?
    }

    state Healthy
  }

  slice DetectRuntimeNodeResourcePressure {
    startsLifecycle

    automation DetectResourcePressureFromTelemetry {
      on todo RuntimeTelemetryLatest
      condition resourcePressureDetected == true
      emits DetectRuntimeNodeResourcePressure
    }

    command DetectRuntimeNodeResourcePressure {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      pressureType: String
      observedValue: Decimal
      thresholdValue: Decimal
    }

    event RuntimeNodeResourcePressureDetected {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      federationId: UUID?
      federationName: String?
      trainingJobId: UUID?
      trainingJobObjective: String?
      roundExecutionId: UUID?
      runtimeNodeName: String?
      pressureType: String
      observedValue: Decimal
      thresholdValue: Decimal
    }

    state PressureDetected
  }

  slice RecordRuntimeNodeInventory {
    startsLifecycle
    reactsTo AgentRuntimeNodeInventoryReported

    automation RecordRuntimeNodeInventoryWhenAgentReported {
      on AgentRuntimeNodeInventoryReported
      emits RecordRuntimeNodeInventory
    }

    command RecordRuntimeNodeInventory {
      nodeId: UUID id technical
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      runtimeName: String?
      runtimeNodeName: String
      infrastructureNodeId: String?
      runtimeNodeRole: String
      nodeReady: Boolean
      runtimeEngineVersion: String?
      containerEngineVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
    }

    event RuntimeNodeInventoryReported {
      nodeId: UUID id technical
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      runtimeName: String?
      runtimeNodeName: String
      infrastructureNodeId: String?
      runtimeNodeRole: String
      nodeReady: Boolean
      runtimeEngineVersion: String?
      containerEngineVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
    }

    state Reported
  }

  slice RuntimeNodeInventoryView {
    readmodel RuntimeNodeInventoryView[] {
      nodeId: UUID id
      runtimeNodeInventoryReportId: UUID
      organizationId: UUID
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationName: String?
      runtimeName: String?
      runtimeNodeName: String
      infrastructureNodeId: String?
      runtimeNodeRole: String
      nodeReady: Boolean
      runtimeEngineVersion: String?
      containerEngineVersion: String?
      operatingSystem: String?
      architecture: String
      inventoryHash: String
      discoveredAt: DateTime
      recordedAt: DateTime
      subscribe OrganizationRegistered
      subscribe RuntimeInstallationPlanCreated
      subscribe RuntimeInfrastructureRegistered
      subscribe RuntimeNodeInventoryReported
    }
  }

  slice RuntimeNodeResourceLatest {
    readmodel todo RuntimeNodeResourceLatest[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      runtimeInfrastructureId: UUID?
      runtimeNodeName: String?
      nodeReady: Boolean
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
      allocatedCpuCores: Int
      allocatedMemoryGb: Int
      allocatedGpuCount: Int
      availableCpuCores: Int
      availableMemoryGb: Int
      availableGpuCount: Int
      runningWorkloadCount: Int
      workloadCapacity: Int
      observedAt: DateTime
      allocatableCapacityChanged: Boolean
      telemetryRetentionPolicy: String
    }
  }

  slice DetectRuntimeNodeCapacityChange {
    startsLifecycle

    automation DetectCapacityChangeFromResourceTelemetry {
      on todo RuntimeNodeResourceLatest
      condition allocatableCapacityChanged == true
      emits DetectRuntimeNodeCapacityChange
    }

    command DetectRuntimeNodeCapacityChange {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      previousCapacityHash: String?
      currentCapacityHash: String
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
    }

    event RuntimeNodeCapacityChanged {
      nodeId: UUID id technical
      runtimeAgentId: UUID
      previousCapacityHash: String?
      currentCapacityHash: String
      allocatableCpuCores: Int
      allocatableMemoryGb: Int
      allocatableGpuCount: Int
    }

    state CapacityChanged
  }

  slice RuntimeHealthDashboard {
    readmodel RuntimeHealthDashboard[] {
      nodeId: UUID id
      runtimeAgentId: UUID
      federationId: UUID
      trainingJobId: UUID?
      roundExecutionId: UUID?
      federationName: String?
      trainingJobObjective: String?
      cpuLoad: Decimal
      gpuLoad: Decimal
      memoryLoad: Decimal
      nodeReady: Boolean?
      availableCpuCores: Int?
      availableMemoryGb: Int?
      availableGpuCount: Int?
      runningWorkloadCount: Int?
      workloadCapacity: Int?
      healthStatus: String
      lastHeartbeatAt: DateTime
      lastResourceSnapshotAt: DateTime?
      subscribe FederationCreated
      subscribe TrainingJobCreated
      subscribe RuntimeAgentOfflineDetected
      subscribe RuntimeAgentRecovered
      subscribe RuntimeNodeResourcePressureDetected
      subscribe RuntimeNodeCapacityChanged
      subscribe RuntimeNodeInventoryReported
      subscribe TrainingAlertRaised
    }
  }

  concept NodeRuntimeHealth {
    state Healthy
    state Offline

    slice RuntimeTelemetryLatest
    slice DetectRuntimeAgentOffline
    slice MarkRuntimeAgentRecovered
    slice RuntimeHealthDashboard
  }

  concept RuntimeNodeResourcePressure {
    state PressureDetected

    slice DetectRuntimeNodeResourcePressure
  }

  concept RuntimeNodeCapacity {
    state CapacityChanged

    slice DetectRuntimeNodeCapacityChange
  }

  concept RuntimeNodeInventory {
    state Reported

    slice RecordRuntimeNodeInventory
    slice RuntimeNodeInventoryView
  }

  concept RuntimeNodeResourceTelemetry {
    slice RuntimeNodeResourceLatest
  }

  slice RaiseTrainingAlert {
    startsLifecycle
    reactsTo RuntimeNodeResourcePressureDetected

    automation RaiseAlertOnNodeResourcePressure {
      on RuntimeNodeResourcePressureDetected
      emits RaiseTrainingAlert
    }

    command RaiseTrainingAlert {
      alertId: UUID id generated technical
      nodeId: UUID from RuntimeNodeResourcePressureDetected.nodeId
      trainingJobId: UUID? from RuntimeNodeResourcePressureDetected.trainingJobId
      runtimeNodeName: String? from RuntimeNodeResourcePressureDetected.runtimeNodeName
      trainingJobObjective: String? from RuntimeNodeResourcePressureDetected.trainingJobObjective
      severity: String
      message: String
    }

    event TrainingAlertRaised {
      alertId: UUID id technical
      nodeId: UUID
      trainingJobId: UUID?
      runtimeNodeName: String?
      trainingJobObjective: String?
      severity: String
      message: String
    }

    state Raised
  }

  slice TrainingAlertCatalog {
    readmodel TrainingAlertCatalog[] {
      alertId: UUID id
      nodeId: UUID
      trainingJobId: UUID?
      runtimeNodeName: String?
      trainingJobObjective: String?
      severity: String
      message: String
      state: TrainingAlert.State
      acknowledgedAt: DateTime?
      resolvedAt: DateTime?
      resolutionSummary: String?
      canAcknowledge: Boolean
      canResolve: Boolean
      subscribe RuntimeNodeInventoryReported
      subscribe TrainingJobCreated
      subscribe TrainingAlertRaised
      subscribe TrainingAlertAcknowledged
      subscribe TrainingAlertResolved
    }
  }

  slice AcknowledgeTrainingAlert {
    actor MLOpsEngineer
    ui RuntimeHealthDashboard
    reactsTo TrainingAlertRaised

    command AcknowledgeTrainingAlert {
      alertId: UUID id technical
      acknowledgementNote: String?
    }

    event TrainingAlertAcknowledged {
      alertId: UUID id technical
      acknowledgementNote: String?
    }

    state Acknowledged
  }

  slice ResolveTrainingAlert {
    actor MLOpsEngineer
    ui RuntimeHealthDashboard
    reactsTo TrainingAlertAcknowledged

    command ResolveTrainingAlert {
      alertId: UUID id technical
      resolutionSummary: String
    }

    event TrainingAlertResolved {
      alertId: UUID id technical
      resolutionSummary: String
    }

    state Resolved
  }

  concept TrainingAlert {
    state Raised
    state Acknowledged
    state Resolved

    slice RaiseTrainingAlert
    slice AcknowledgeTrainingAlert
    slice ResolveTrainingAlert
    slice TrainingAlertCatalog
  }

  slice AppendAuditTrail {
    startsLifecycle
    reactsTo TrainingAlertRaised

    automation AuditCriticalTrainingEvents {
      on TrainingAlertRaised
      emits AppendAuditTrail
    }

    automation AuditFederationActivated {
      on FederationActivated
      emits AppendAuditTrail
    }

    automation AuditFederationSuspended {
      on FederationSuspended
      emits AppendAuditTrail
    }

    automation AuditFederationReactivated {
      on FederationReactivated
      emits AppendAuditTrail
    }

    automation AuditParticipantJoined {
      on ParticipantJoined
      emits AppendAuditTrail
    }

    automation AuditParticipantSuspended {
      on ParticipantSuspended
      emits AppendAuditTrail
    }

    automation AuditDatasetApproval {
      on DatasetApprovedForTraining
      emits AppendAuditTrail
    }

    automation AuditDatasetApprovalRevoked {
      on DatasetTrainingApprovalRevoked
      emits AppendAuditTrail
    }

    automation AuditTrainingJobSubmitted {
      on TrainingJobSubmitted
      emits AppendAuditTrail
    }

    automation AuditModelPromotedToProduction {
      on ModelPromotedToProduction
      emits AppendAuditTrail
    }

    command AppendAuditTrail {
      auditRecordId: UUID id generated technical
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
    }

    event AuditTrailAppended {
      auditRecordId: UUID id technical
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
    }

    state Appended
  }

  slice AuditRecordLog {
    readmodel AuditRecordLog[] {
      auditRecordId: UUID id
      sourceEventName: String
      sourceEntityId: UUID?
      severity: String
      payloadHash: String
      subscribe AuditTrailAppended
    }
  }

  concept AuditRecord {
    state Appended

    slice AppendAuditTrail
    slice AuditRecordLog
  }
}

context RuntimeGovernance {
  note "Runtime governance owns stable RuntimeIdentity activation, capability detection, and revocation. Runtime private keys, local paths, credentials, node scheduling, and data-plane connectivity stay inside participant runtime infrastructure."
  note "Platform-managed runtime agents are activated from platform deployment outcomes. Network reachability is not business authorization. Training eligibility uses active federation membership, RuntimeIdentity, detected capabilities, connected runtime status, and dataset readiness."
  note "Training parameter encryption, secure aggregation keys, and data-plane message encryption are handled by protocol adapters or SecureAggregation, not by RuntimeIdentity events."

  risk "A provisioned runtime can be mistaken for an active training participant."
  risk "Control-plane compromise must not expose runtime private keys or local dataset credentials."
  metric runtimeActivationLeadTime

  slice ActivateRuntimeIdentity {
    startsLifecycle

    actor PlatformAdmin
    ui RuntimeInstallationPlanScreen
    reactsTo RuntimeAgentInstallationSucceeded
    reactsTo RuntimeConnectionEstablished

    automation ActivateRuntimeIdentityWhenAgentInstalled {
      on RuntimeAgentInstallationSucceeded
      emits ActivateRuntimeIdentity
    }

    automation ActivateRuntimeIdentityWhenManualRuntimeConnected {
      on RuntimeConnectionEstablished
      condition agentInstallMode == "MANUAL_GUIDED"
      emits ActivateRuntimeIdentity
    }

    command ActivateRuntimeIdentity {
      runtimeId: UUID id generated technical
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationId: UUID derived {
        from RuntimeAgentInstallationSucceeded.organizationId, RuntimeConnectionEstablished.organizationId
        rule "Use the runtime identity activation source event."
      }
      organizationName: String? derived {
        from RuntimeAgentInstallationSucceeded.organizationName, RuntimeConnectionEstablished.organizationName
        rule "Use the runtime identity activation source event."
      }
      runtimeName: String derived {
        from RuntimeAgentInstallationSucceeded.runtimeName, RuntimeConnectionEstablished.runtimeName
        rule "Use the runtime identity activation source event."
      }
    }

    event RuntimeIdentityActivated {
      runtimeId: UUID id technical
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeName: String
    }

    state Active
  }

  slice RevokeRuntimeIdentity {
    actor SecurityReviewer
    ui RuntimeIdentityScreen confirm
    reactsTo RuntimeIdentityActivated

    command RevokeRuntimeIdentity {
      runtimeId: UUID id technical
      revocationReason: String
    }

    event RuntimeIdentityRevoked {
      runtimeId: UUID id technical
      revocationReason: String
    }

    state Revoked
  }

  slice DetectRuntimeCapabilities {
    startsLifecycle
    actor RuntimeAgent
    reactsTo RuntimeIdentityActivated
    port

    automation DetectRuntimeCapabilitiesWhenRuntimeActivated {
      on RuntimeIdentityActivated
      emits DetectRuntimeCapabilities
    }

    command DetectRuntimeCapabilities {
      runtimeId: UUID id technical from RuntimeIdentityActivated.runtimeId
      capabilityTypes: String[] dictionary "RUNTIME_CAPABILITY_TYPE"
    }

    event RuntimeCapabilitiesDetected {
      runtimeId: UUID id technical
      capabilityTypes: String[] dictionary "RUNTIME_CAPABILITY_TYPE"
    }

    state Detected
  }

  slice RuntimeIdentityCatalog {
    readmodel RuntimeIdentityCatalog[] {
      runtimeId: UUID id
      runtimeInfrastructureId: UUID
      runtimeAgentId: UUID
      organizationId: UUID
      organizationName: String?
      runtimeName: String display
      identityStatus: String
      activatedAt: DateTime?
      revokedAt: DateTime?
      subscribe OrganizationRegistered
      subscribe RuntimeIdentityActivated
      subscribe RuntimeIdentityRevoked
    }
  }

  slice RuntimeCapabilityCatalog {
    readmodel RuntimeCapabilityCatalog[] {
      runtimeId: UUID id
      capabilityTypes: String[] dictionary "RUNTIME_CAPABILITY_TYPE"
      capabilityStatus: String
      detectedAt: DateTime
      subscribe RuntimeCapabilitiesDetected
    }
  }

  concept RuntimeIdentity {
    state Active
    state Revoked

    slice ActivateRuntimeIdentity
    slice RevokeRuntimeIdentity
    slice RuntimeIdentityCatalog
  }

  concept RuntimeCapability {
    state Detected

    slice DetectRuntimeCapabilities
    slice RuntimeCapabilityCatalog
  }
}

context SecureAggregation {
  note "Secure aggregation owns homomorphic-encryption-based aggregation sessions. The platform owns the private key and publishes only encryption context metadata to runtime agents; raw key material, public key documents, and storage locations stay in SecureAggregationService or KMS adapter configuration."

  risk "Homomorphic encrypted updates protect individual parameters only when aggregation completes with enough participants; single-participant or very small cohorts can still expose local updates after decryption."
  risk "Aggregation can complete with insufficient encrypted updates or with an encryption context that does not match the active round."
  metric secureAggregationCompletionLatency

  slice CreateSecureAggregationSession {
    startsLifecycle
    reactsTo SecureAggregationRequested

    automation CreateSessionWhenAggregationRequested {
      on SecureAggregationRequested
      emits CreateSecureAggregationSession
    }

    command CreateSecureAggregationSession {
      secureAggregationSessionId: UUID id generated technical
      trainingJobId: UUID from SecureAggregationRequested.trainingJobId
      federationId: UUID from SecureAggregationRequested.federationId
      federationName: String? from SecureAggregationRequested.federationName
      trainingRunConfigurationId: UUID from SecureAggregationRequested.trainingRunConfigurationId
      configurationName: String? from SecureAggregationRequested.configurationName
      trainingJobObjective: String from SecureAggregationRequested.trainingJobObjective
      featureSchemaId: UUID from SecureAggregationRequested.featureSchemaId
      featureDomain: String? from SecureAggregationRequested.featureDomain
      featureSchemaVersion: String? from SecureAggregationRequested.featureSchemaVersion
      roundId: UUID from SecureAggregationRequested.roundId
      roundNumber: Int from SecureAggregationRequested.roundNumber
      requiredParticipantCount: Int from SecureAggregationRequested.requiredParticipantCount
      selectedOrganizationIds: UUID[] from SecureAggregationRequested.selectedOrganizationIds
      selectedRuntimeIds: UUID[] from SecureAggregationRequested.selectedRuntimeIds
      selectedOrganizationCount: Int from SecureAggregationRequested.selectedOrganizationCount
      selectedRuntimeCount: Int from SecureAggregationRequested.selectedRuntimeCount
      minimumNodesPerRound: Int from SecureAggregationRequested.minimumNodesPerRound
      maxRounds: Int from SecureAggregationRequested.maxRounds
      minimumAccuracy: Decimal from SecureAggregationRequested.minimumAccuracy
      secureAggregationRequired: Boolean from SecureAggregationRequested.secureAggregationRequired
    }

    event SecureAggregationSessionCreated {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      roundId: UUID
      roundNumber: Int
      requiredParticipantCount: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      secureAggregationRequired: Boolean
    }

    state Planned
  }

  slice SelectSecureAggregationParticipants {
    reactsTo SecureAggregationSessionCreated
    port

    automation SelectParticipantsWhenSessionCreated {
      on SecureAggregationSessionCreated
      emits SelectSecureAggregationParticipants
    }

    command SelectSecureAggregationParticipants {
      secureAggregationSessionId: UUID id technical
      roundId: UUID from SecureAggregationSessionCreated.roundId
      trainingJobId: UUID from SecureAggregationSessionCreated.trainingJobId
      federationId: UUID from SecureAggregationSessionCreated.federationId
      federationName: String? from SecureAggregationSessionCreated.federationName
      trainingRunConfigurationId: UUID from SecureAggregationSessionCreated.trainingRunConfigurationId
      configurationName: String? from SecureAggregationSessionCreated.configurationName
      trainingJobObjective: String from SecureAggregationSessionCreated.trainingJobObjective
      featureSchemaId: UUID from SecureAggregationSessionCreated.featureSchemaId
      featureDomain: String? from SecureAggregationSessionCreated.featureDomain
      featureSchemaVersion: String? from SecureAggregationSessionCreated.featureSchemaVersion
      roundNumber: Int from SecureAggregationSessionCreated.roundNumber
      selectedOrganizationIds: UUID[] from SecureAggregationSessionCreated.selectedOrganizationIds
      selectedRuntimeIds: UUID[] from SecureAggregationSessionCreated.selectedRuntimeIds
      selectedOrganizationCount: Int from SecureAggregationSessionCreated.selectedOrganizationCount
      selectedParticipantCount: Int from SecureAggregationSessionCreated.requiredParticipantCount
      minimumNodesPerRound: Int from SecureAggregationSessionCreated.minimumNodesPerRound
      maxRounds: Int from SecureAggregationSessionCreated.maxRounds
      minimumAccuracy: Decimal from SecureAggregationSessionCreated.minimumAccuracy
      secureAggregationRequired: Boolean from SecureAggregationSessionCreated.secureAggregationRequired
    }

    event SecureAggregationParticipantsSelected {
      secureAggregationSessionId: UUID id technical
      roundId: UUID
      trainingJobId: UUID
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      roundNumber: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedOrganizationCount: Int
      selectedParticipantCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      secureAggregationRequired: Boolean
    }

    state ParticipantsSelected
  }

  slice PrepareHomomorphicEncryptionContext {
    actor SecureAggregationService
    reactsTo SecureAggregationParticipantsSelected
    port

    automation PrepareEncryptionContextWhenParticipantsSelected {
      on SecureAggregationParticipantsSelected
      emits PrepareHomomorphicEncryptionContext
    }

    command PrepareHomomorphicEncryptionContext {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID from SecureAggregationParticipantsSelected.trainingJobId
      federationId: UUID from SecureAggregationParticipantsSelected.federationId
      federationName: String? from SecureAggregationParticipantsSelected.federationName
      trainingRunConfigurationId: UUID from SecureAggregationParticipantsSelected.trainingRunConfigurationId
      configurationName: String? from SecureAggregationParticipantsSelected.configurationName
      trainingJobObjective: String from SecureAggregationParticipantsSelected.trainingJobObjective
      featureSchemaId: UUID from SecureAggregationParticipantsSelected.featureSchemaId
      featureDomain: String? from SecureAggregationParticipantsSelected.featureDomain
      featureSchemaVersion: String? from SecureAggregationParticipantsSelected.featureSchemaVersion
      roundId: UUID from SecureAggregationParticipantsSelected.roundId
      roundNumber: Int from SecureAggregationParticipantsSelected.roundNumber
      selectedOrganizationIds: UUID[] from SecureAggregationParticipantsSelected.selectedOrganizationIds
      selectedRuntimeIds: UUID[] from SecureAggregationParticipantsSelected.selectedRuntimeIds
      selectedOrganizationCount: Int from SecureAggregationParticipantsSelected.selectedOrganizationCount
      selectedRuntimeCount: Int from SecureAggregationParticipantsSelected.selectedParticipantCount
      minimumNodesPerRound: Int from SecureAggregationParticipantsSelected.minimumNodesPerRound
      maxRounds: Int from SecureAggregationParticipantsSelected.maxRounds
      minimumAccuracy: Decimal from SecureAggregationParticipantsSelected.minimumAccuracy
      secureAggregationRequired: Boolean from SecureAggregationParticipantsSelected.secureAggregationRequired
    }

    event HomomorphicEncryptionContextPrepared {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID
      federationId: UUID
      federationName: String?
      trainingRunConfigurationId: UUID
      configurationName: String?
      trainingJobObjective: String
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      roundId: UUID
      roundNumber: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedOrganizationCount: Int
      selectedRuntimeCount: Int
      minimumNodesPerRound: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      secureAggregationRequired: Boolean
      // PAILLIER
      encryptionScheme: String portOutput
      publicKeyVersion: String portOutput
      publicKeyRef: String portOutput
      // 浮点参数转整数再加密时使用的缩放倍数/精度约定
      encryptedParameterScale: Int portOutput
    }

    state EncryptionContextPrepared
  }

  slice RecordEncryptedModelUpdate {
    actor SecureAggregationService
    reactsTo ModelUpdateSubmissionAccepted

    automation RecordEncryptedUpdateWhenSubmissionAccepted {
      on ModelUpdateSubmissionAccepted
      condition updateProtectionType == "HOMOMORPHIC_ENCRYPTED"
      emits RecordEncryptedModelUpdate
    }

    command RecordEncryptedModelUpdate {
      secureAggregationSessionId: UUID id technical from ModelUpdateSubmissionAccepted.secureAggregationSessionId
      submissionId: UUID from ModelUpdateSubmissionAccepted.modelUpdateSubmissionId
      trainingJobId: UUID from ModelUpdateSubmissionAccepted.trainingJobId
      trainingRunConfigurationId: UUID from ModelUpdateSubmissionAccepted.trainingRunConfigurationId
      trainingJobObjective: String from ModelUpdateSubmissionAccepted.trainingJobObjective
      featureSchemaId: UUID from ModelUpdateSubmissionAccepted.featureSchemaId
      roundId: UUID from ModelUpdateSubmissionAccepted.roundId
      roundNumber: Int from ModelUpdateSubmissionAccepted.roundNumber
      maxRounds: Int from ModelUpdateSubmissionAccepted.maxRounds
      minimumAccuracy: Decimal from ModelUpdateSubmissionAccepted.minimumAccuracy
      runtimeId: UUID from ModelUpdateSubmissionAccepted.runtimeId
      updateArtifactId: UUID from ModelUpdateSubmissionAccepted.updateArtifactId
      encryptedUpdateArtifactRef: String from ModelUpdateSubmissionAccepted.artifactRef
      encryptedUpdateDigest: String from ModelUpdateSubmissionAccepted.artifactDigest
      encryptionScheme: String from ModelUpdateSubmissionAccepted.encryptionScheme
      publicKeyVersion: String from ModelUpdateSubmissionAccepted.publicKeyVersion
    }

    event EncryptedModelUpdateReceived {
      secureAggregationSessionId: UUID id technical
      submissionId: UUID
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      runtimeId: UUID
      updateArtifactId: UUID
      encryptedUpdateArtifactRef: String
      encryptedUpdateDigest: String
      encryptionScheme: String dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String
      receivedEncryptedUpdateCount: Int derived from EncryptedModelUpdateReceived.receivedRuntimeIds, RecordEncryptedModelUpdate.runtimeId {
        rule "count(appendDistinct(EncryptedModelUpdateReceived.receivedRuntimeIds, RecordEncryptedModelUpdate.runtimeId))"
      }
      receivedRuntimeIds: UUID[] derived from EncryptedModelUpdateReceived.receivedRuntimeIds, RecordEncryptedModelUpdate.runtimeId {
        rule "appendDistinct(EncryptedModelUpdateReceived.receivedRuntimeIds, RecordEncryptedModelUpdate.runtimeId)"
      }
      receivedEncryptedUpdateArtifactRefs: String[] derived from EncryptedModelUpdateReceived.receivedEncryptedUpdateArtifactRefs, RecordEncryptedModelUpdate.encryptedUpdateArtifactRef {
        rule "appendDistinct(EncryptedModelUpdateReceived.receivedEncryptedUpdateArtifactRefs, RecordEncryptedModelUpdate.encryptedUpdateArtifactRef)"
      }
      selectedParticipantCount: Int from SecureAggregationParticipantsSelected.selectedParticipantCount
    }
  }

  slice CompleteHomomorphicAggregationSession {
    actor SecureAggregationService
    reactsTo EncryptedModelUpdateReceived
    port

    automation CompleteAggregationWhenEncryptedUpdatesReady {
      on EncryptedModelUpdateReceived
      condition receivedEncryptedUpdateCount >= selectedParticipantCount
      emits CompleteHomomorphicAggregationSession
    }

    command CompleteHomomorphicAggregationSession {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID from EncryptedModelUpdateReceived.trainingJobId
      trainingRunConfigurationId: UUID from EncryptedModelUpdateReceived.trainingRunConfigurationId
      trainingJobObjective: String from EncryptedModelUpdateReceived.trainingJobObjective
      featureSchemaId: UUID from EncryptedModelUpdateReceived.featureSchemaId
      roundId: UUID from EncryptedModelUpdateReceived.roundId
      roundNumber: Int from EncryptedModelUpdateReceived.roundNumber
      maxRounds: Int from EncryptedModelUpdateReceived.maxRounds
      minimumAccuracy: Decimal from EncryptedModelUpdateReceived.minimumAccuracy
      aggregatedModelId: UUID generated technical
      encryptedUpdateArtifactRefs: String[] from EncryptedModelUpdateReceived.receivedEncryptedUpdateArtifactRefs
    }

    event SecureAggregationCompleted {
      secureAggregationSessionId: UUID id technical
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      trainingJobObjective: String
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      maxRounds: Int
      minimumAccuracy: Decimal
      aggregatedModelId: UUID
      aggregatedModelName: String portOutput
      aggregatedModelVersion: String portOutput
      aggregatedModelDescription: String? portOutput
      modelSourceType: String portOutput
      aggregatedModelArtifactUri: String portOutput
      aggregatedModelRegistryRef: String portOutput
      modelFormat: String portOutput
      modelArtifactDigest: String portOutput
      aggregatedModelSignatureUri: String? portOutput
      aggregatedModelSizeBytes: Int? portOutput
    }

    state Completed
  }

  slice FailSecureAggregationSession {
    actor SecureAggregationService
    reactsTo SecureAggregationSessionCreated

    command FailSecureAggregationSession {
      secureAggregationSessionId: UUID id technical
      failureReason: String
    }

    event SecureAggregationFailed {
      secureAggregationSessionId: UUID id technical
      failureReason: String
    }

    state Failed
  }

  slice SecureAggregationSessionCatalog {
    readmodel SecureAggregationSessionCatalog[] {
      secureAggregationSessionId: UUID id
      trainingJobId: UUID
      trainingRunConfigurationId: UUID
      featureSchemaId: UUID
      roundId: UUID
      roundNumber: Int
      requiredParticipantCount: Int
      selectedOrganizationIds: UUID[]
      selectedRuntimeIds: UUID[]
      selectedOrganizationCount: Int?
      selectedRuntimeCount: Int?
      selectedParticipantCount: Int?
      encryptionContextPrepared: Boolean
      receivedEncryptedUpdateCount: Int
      encryptionScheme: String? dictionary "SECURE_AGGREGATION_ENCRYPTION_SCHEME"
      publicKeyVersion: String?
      publicKeyRef: String?
      encryptedParameterScale: Int?
      aggregatedModelId: UUID?
      modelFormat: String?
      modelArtifactDigest: String?
      state: SecureAggregationSession.State
      failureReason: String?
      createdAt: DateTime
      selectedAt: DateTime?
      encryptionContextPreparedAt: DateTime?
      decryptedAt: DateTime?
      completedAt: DateTime?
      failedAt: DateTime?
      subscribe SecureAggregationSessionCreated
      subscribe SecureAggregationParticipantsSelected
      subscribe HomomorphicEncryptionContextPrepared
      subscribe EncryptedModelUpdateReceived
      subscribe SecureAggregationCompleted
      subscribe SecureAggregationFailed
    }
  }

  concept SecureAggregationSession {
    state Planned
    state ParticipantsSelected
    state EncryptionContextPrepared
    state Completed
    state Failed

    slice CreateSecureAggregationSession
    slice SelectSecureAggregationParticipants
    slice PrepareHomomorphicEncryptionContext
    slice RecordEncryptedModelUpdate
    slice CompleteHomomorphicAggregationSession
    slice FailSecureAggregationSession
    slice SecureAggregationSessionCatalog
  }
}

context RuntimeAgentOperations {
  note "Runtime agent operations is a separate deployable that runs inside participant infrastructure and executes dispatched training jobs with local data and local secrets."

  risk "Agent jobs can leak local credentials if secret references are materialized outside the participant boundary."
  risk "Runtime engine jobs can remain running after platform cancellation unless local job lifecycle is tracked explicitly."
  metric agentRuntimeJobFailureRate
  metric agentRuntimeJobStartupLatency

  value FeatureDefinition {
    featureName: String
    dataType: String dictionary "FEATURE_DATA_TYPE"
    required: Boolean
    nullable: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
    isIdentifier: Boolean
    isSensitive: Boolean
    encodingStrategy: String? dictionary "FEATURE_ENCODING_STRATEGY"
    featureTags: String[]
  }
  
  value LabelDefinition {
    labelName: String
    dataType: String dictionary "FEATURE_DATA_TYPE"
    cardinality: Int
    classLabels: String[]?
    isMultilabel: Boolean
    description: String?
    validationRules: String[]
    defaultValue: String?
  }

  integration RoundRuntimeEngine {
    source RoundExecution
    target RuntimeEngine
    reactsTo RoundExecutionStarted
    emits ObserveRuntimeEngineJob
  }

  integration RoundRuntimeEngineObservation {
    source RoundExecution
    target RuntimeEngine
    reactsTo RuntimeEngineJobObserved
    emits CompleteRoundExecution
    emits SubmitAgentLocalModelUpdate
  }

  integration RetriedRoundRuntimeEngine {
    source RoundExecution
    target RuntimeEngine
    reactsTo RoundExecutionStartRetryStarted
    emits ObserveRuntimeEngineJob
  }

  integration RetriedRoundRuntimeEngineObservation {
    source RoundExecution
    target RuntimeEngine
    reactsTo RuntimeEngineJobObserved
    emits CompleteRoundExecution
    emits SubmitAgentLocalModelUpdate
  }

  integration RuntimeFailureRetriedRoundRuntimeEngine {
    source RoundExecution
    target RuntimeEngine
    reactsTo RoundExecutionRuntimeRetryStarted
    emits ObserveRuntimeEngineJob
  }

  integration RuntimeFailureRetriedRoundRuntimeEngineObservation {
    source RoundExecution
    target RuntimeEngine
    reactsTo RuntimeEngineJobObserved
    emits CompleteRoundExecution
    emits SubmitAgentLocalModelUpdate
  }

  integration PlatformDatasetMetadataReporting {
    source AgentDatasetProfile
    target DatasetGovernance
    reactsTo AgentDatasetMetadataReported
    emits RecordRuntimeDatasetMetadata
  }

  integration PlatformDatasetReprofiledMetadataReporting {
    source AgentDatasetProfile
    target DatasetGovernance
    reactsTo AgentDatasetReprofiled
    emits RecordRuntimeDatasetReprofiledMetadata
  }

  integration PlatformRoundUpdateReporting {
    source RoundExecution
    target TrainingOrchestration
    reactsTo AgentLocalModelUpdateSubmitted
    emits SubmitModelUpdateSubmission
  }

  integration PlatformRuntimeInfrastructureConnectionReporting {
    source AgentRuntimeInfrastructureConnection
    target RuntimeProvisioning
    reactsTo AgentRuntimeConnectionEstablished
    emits RecordRuntimeConnectionEstablished
  }

  integration PlatformRuntimeNodeInventoryReporting {
    source AgentRuntimeNodeInventory
    target RuntimeMonitoring
    reactsTo AgentRuntimeNodeInventoryReported
    emits RecordRuntimeNodeInventory
  }

  slice DeclareDataset {
    startsLifecycle

    tags {
      organizationId
      featureSchemaId
      datasetName
    }

    actor DataOwner
    ui DatasetRegistrationScreen
    reactsTo FeatureSchemaPublished
    port

    command DeclareDataset {
      datasetId: UUID id generated technical
      organizationId: UUID
      organizationName: String? derived from OrganizationDirectory.organizationName by organizationId
      featureSchemaId: UUID
      featureDomain: String? derived from FeatureSchemaCatalog.featureDomain by featureSchemaId
      featureSchemaVersion: String? derived from FeatureSchemaCatalog.version by featureSchemaId
      datasetName: String
      datasetUsage: String
    }

    event DatasetDeclared {
      datasetId: UUID id technical
      organizationId: UUID
      organizationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      datasetName: String
      datasetUsage: String
      features: FeatureDefinition[]
      labels: LabelDefinition[]?
    }

    specification "Feature Schema Snapshot Required For Dataset Declaration" {
      rule """
        Declaring a dataset synchronously loads the referenced feature schema through the DeclareDataset port adapter before the decision emits DatasetDeclared. The adapter must enrich the declaration result with the feature and label snapshot so the runtime agent can validate and profile local data without querying the platform later. Dataset usage describes the governance purpose of the dataset, such as training, validation, evaluation, or testing, and is stored as a maintained dictionary value. If the feature schema cannot be loaded, the adapter throws an exception and the declaration does not emit DatasetDeclared.
      """

      scenario "Declare Dataset With Feature Schema Snapshot" {
        when DeclareDataset {
          datasetId = "11111111-1111-4111-8111-111111111111"
          organizationId = "22222222-2222-4222-8222-222222222222"
          featureSchemaId = "33333333-3333-4333-8333-333333333333"
          datasetName = "credit-risk"
          datasetUsage = "TRAINING"
        }
        then DatasetDeclared
      }

      scenario "Feature Schema Load Failed" {
        when DeclareDataset {
          datasetId = "44444444-4444-4444-8444-444444444444"
          organizationId = "55555555-5555-4555-8555-555555555555"
          featureSchemaId = "66666666-6666-4666-8666-666666666666"
          datasetName = "credit-risk"
          datasetUsage = "TRAINING"
        }
        then error "Feature Schema Load Failed"
      }
    }

    state Registered
  }

  slice ConfigureRuntimeDatasetBinding {
    startsLifecycle
    actor NodeOperator
    ui RuntimeDatasetBindingScreen
    reactsTo DatasetDeclared

    tags {
      datasetId
      runtimeId
    }

    command ConfigureRuntimeDatasetBinding {
      runtimeDatasetBindingId: UUID id generated technical
      datasetId: UUID from DatasetDeclared.datasetId
      organizationId: UUID from DatasetDeclared.organizationId
      featureSchemaId: UUID from DatasetDeclared.featureSchemaId
      organizationName: String? from DatasetDeclared.organizationName
      featureDomain: String? from DatasetDeclared.featureDomain
      featureSchemaVersion: String? from DatasetDeclared.featureSchemaVersion
      datasetName: String from DatasetDeclared.datasetName
      runtimeId: UUID
      runtimeName: String? derived from RuntimeIdentityCatalog.runtimeName by runtimeId
      dataSourceType: String dictionary "RUNTIME_DATA_SOURCE_TYPE"
      host: String?
      port: Int?
      url: String?
      databaseName: String?
      schemaName: String?
      tableName: String?
      filePath: String?
      objectBucket: String?
      objectPrefix: String?
      dataFormat: String dictionary "DATA_FORMAT"
      // 访问密码/密钥 名
      credentialSecretName: String?
    }

    event RuntimeDatasetBindingConfigured {
      runtimeDatasetBindingId: UUID id technical
      datasetId: UUID
      organizationId: UUID
      featureSchemaId: UUID
      organizationName: String?
      featureDomain: String?
      featureSchemaVersion: String?
      datasetName: String
      runtimeId: UUID
      runtimeName: String?
      dataSourceType: String dictionary "RUNTIME_DATA_SOURCE_TYPE"
      host: String?
      port: Int?
      url: String?
      databaseName: String?
      schemaName: String?
      tableName: String?
      filePath: String?
      objectBucket: String?
      objectPrefix: String?
      dataFormat: String dictionary "DATA_FORMAT"
      credentialSecretName: String?
    }

    state Configured

    specification "Runtime Dataset Binding Unique Per Runtime Dataset" {
      rule """
        A runtime dataset binding represents the current local data source configuration for one dataset on one runtime. The same dataset may be bound on different runtimes, and the same runtime may bind different datasets, but one runtime cannot configure multiple current bindings for the same dataset. Reconfiguration should use an explicit reconfigure/update flow instead of creating another binding for the same runtimeId and datasetId.
      """

      expression {
        unique (RuntimeDatasetBinding.runtimeId, RuntimeDatasetBinding.datasetId)
      }

      scenario "Reject Duplicate Runtime Dataset Binding" {
        given RuntimeDatasetBindingConfigured {
          runtimeId = "runtime-1"
          datasetId = "dataset-1"
        }
        when ConfigureRuntimeDatasetBinding {
          runtimeId = "runtime-1"
          datasetId = "dataset-1"
        }
        then reject "Runtime Dataset Binding Already Exists"
      }
    }
  }

  slice RuntimeDatasetBindingCatalog {
    readmodel RuntimeDatasetBindingCatalog[] {
      runtimeDatasetBindingId: UUID id
      datasetId: UUID
      organizationId: UUID
      runtimeId: UUID
      organizationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      datasetName: String? display
      runtimeName: String?
      dataSourceType: String dictionary "RUNTIME_DATA_SOURCE_TYPE"
      host: String?
      port: Int?
      url: String?
      databaseName: String?
      schemaName: String?
      tableName: String?
      filePath: String?
      objectBucket: String?
      objectPrefix: String?
      dataFormat: String dictionary "DATA_FORMAT"
      credentialSecretName: String?
      configuredAt: DateTime
      subscribe DatasetDeclared
      subscribe RuntimeDatasetBindingConfigured
    }
  }

  concept RuntimeDatasetBinding {
    state Configured

    slice ConfigureRuntimeDatasetBinding
    slice RuntimeDatasetBindingCatalog
  }

  concept Dataset {
    state Registered
    state ContractValidationCompleted
    state Approved
    state Rejected
    state ApprovalRevoked

    slice DeclareDataset
    slice ValidateDatasetContract
    slice RetryDatasetContractValidation
    slice RejectDatasetForTraining
    slice ApproveDatasetForTraining
    slice RevokeDatasetTrainingApproval
    slice DatasetCapability
    slice DatasetReadiness
  }

  slice ValidateAgentDatasetAccess {
    startsLifecycle
    actor RuntimeAgent
    reactsTo RuntimeDatasetBindingConfigured
    port

    automation ValidateAgentDatasetAccessWhenBindingConfigured {
      on RuntimeDatasetBindingConfigured
      emits ValidateAgentDatasetAccess
    }

    command ValidateAgentDatasetAccess {
      datasetAccessValidationId: UUID id generated technical
      runtimeDatasetBindingId: UUID from RuntimeDatasetBindingConfigured.runtimeDatasetBindingId
      datasetId: UUID from RuntimeDatasetBindingConfigured.datasetId
      organizationId: UUID from RuntimeDatasetBindingConfigured.organizationId
      organizationName: String? from RuntimeDatasetBindingConfigured.organizationName
      featureSchemaId: UUID from RuntimeDatasetBindingConfigured.featureSchemaId
      featureDomain: String? from RuntimeDatasetBindingConfigured.featureDomain
      featureSchemaVersion: String? from RuntimeDatasetBindingConfigured.featureSchemaVersion
      datasetName: String from RuntimeDatasetBindingConfigured.datasetName
      runtimeId: UUID from RuntimeDatasetBindingConfigured.runtimeId
      runtimeName: String? from RuntimeDatasetBindingConfigured.runtimeName
      dataSourceType: String from RuntimeDatasetBindingConfigured.dataSourceType
      host: String? from RuntimeDatasetBindingConfigured.host
      port: Int? from RuntimeDatasetBindingConfigured.port
      url: String? from RuntimeDatasetBindingConfigured.url
      databaseName: String? from RuntimeDatasetBindingConfigured.databaseName
      schemaName: String? from RuntimeDatasetBindingConfigured.schemaName
      tableName: String? from RuntimeDatasetBindingConfigured.tableName
      filePath: String? from RuntimeDatasetBindingConfigured.filePath
      objectBucket: String? from RuntimeDatasetBindingConfigured.objectBucket
      objectPrefix: String? from RuntimeDatasetBindingConfigured.objectPrefix
      dataFormat: String from RuntimeDatasetBindingConfigured.dataFormat
      credentialSecretName: String? from RuntimeDatasetBindingConfigured.credentialSecretName
    }

    event AgentDatasetAccessValidated {
      datasetAccessValidationId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from RuntimeDatasetBindingConfigured.datasetId
      organizationId: UUID from RuntimeDatasetBindingConfigured.organizationId
      organizationName: String? from RuntimeDatasetBindingConfigured.organizationName
      featureSchemaId: UUID from RuntimeDatasetBindingConfigured.featureSchemaId
      featureDomain: String? from RuntimeDatasetBindingConfigured.featureDomain
      featureSchemaVersion: String? from RuntimeDatasetBindingConfigured.featureSchemaVersion
      datasetName: String from RuntimeDatasetBindingConfigured.datasetName
      runtimeId: UUID from RuntimeDatasetBindingConfigured.runtimeId
      runtimeName: String? from RuntimeDatasetBindingConfigured.runtimeName
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
    }

    event AgentDatasetAccessValidationFailed {
      datasetAccessValidationId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from RuntimeDatasetBindingConfigured.datasetId
      organizationId: UUID from RuntimeDatasetBindingConfigured.organizationId
      organizationName: String? from RuntimeDatasetBindingConfigured.organizationName
      featureSchemaId: UUID from RuntimeDatasetBindingConfigured.featureSchemaId
      featureDomain: String? from RuntimeDatasetBindingConfigured.featureDomain
      featureSchemaVersion: String? from RuntimeDatasetBindingConfigured.featureSchemaVersion
      datasetName: String from RuntimeDatasetBindingConfigured.datasetName
      runtimeId: UUID from RuntimeDatasetBindingConfigured.runtimeId
      runtimeName: String? from RuntimeDatasetBindingConfigured.runtimeName
      failureReason: String
    }

    specification "Agent Dataset Access Validation Outcome" {
      rule """
        The runtime agent validates that the configured local dataset binding is readable and can expose schema and sample batches before profiling starts.
      """

      scenario "Agent Dataset Access Validated" {
        when ValidateAgentDatasetAccess {
          datasetAccessValidationId = "11111111-1111-4111-8111-111111111111"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
          datasetId = "33333333-3333-4333-8333-333333333333"
          organizationId = "77777777-7777-4777-8777-777777777777"
          featureSchemaId = "88888888-8888-4888-8888-888888888888"
          runtimeId = "44444444-4444-4444-8444-444444444444"
          dataSourceType = "FILE"
          filePath = "/data/credit-risk.csv"
          dataFormat = "CSV"
        }
        then AgentDatasetAccessValidated
      }

      scenario "Agent Dataset Access Validation Failed" {
        when ValidateAgentDatasetAccess {
          datasetAccessValidationId = "33333333-3333-4333-8333-333333333333"
          runtimeDatasetBindingId = "44444444-4444-4444-8444-444444444444"
          datasetId = "55555555-5555-4555-8555-555555555555"
          organizationId = "77777777-7777-4777-8777-777777777777"
          featureSchemaId = "88888888-8888-4888-8888-888888888888"
          runtimeId = "66666666-6666-4666-8666-666666666666"
          dataSourceType = "FILE"
          filePath = "/data/missing.csv"
          dataFormat = "CSV"
        }
        then AgentDatasetAccessValidationFailed
      }
    }

    state Checked
  }

  slice RevalidateAgentDatasetAccess {
    actor NodeOperator
    ui RuntimeDatasetBindingScreen
    reactsTo AgentDatasetAccessValidationFailed
    port

    command RevalidateAgentDatasetAccess {
      datasetAccessValidationId: UUID id generated technical
      runtimeDatasetBindingId: UUID from AgentDatasetAccessValidationFailed.runtimeDatasetBindingId
    }

    event AgentDatasetAccessRevalidated {
      datasetAccessValidationId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from AgentDatasetAccessValidationFailed.datasetId
      organizationId: UUID from AgentDatasetAccessValidationFailed.organizationId
      organizationName: String? from AgentDatasetAccessValidationFailed.organizationName
      featureSchemaId: UUID from AgentDatasetAccessValidationFailed.featureSchemaId
      featureDomain: String? from AgentDatasetAccessValidationFailed.featureDomain
      featureSchemaVersion: String? from AgentDatasetAccessValidationFailed.featureSchemaVersion
      datasetName: String from AgentDatasetAccessValidationFailed.datasetName
      runtimeId: UUID from AgentDatasetAccessValidationFailed.runtimeId
      runtimeName: String? from AgentDatasetAccessValidationFailed.runtimeName
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
    }

    event AgentDatasetAccessRevalidationFailed {
      datasetAccessValidationId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from AgentDatasetAccessValidationFailed.datasetId
      organizationId: UUID from AgentDatasetAccessValidationFailed.organizationId
      organizationName: String? from AgentDatasetAccessValidationFailed.organizationName
      featureSchemaId: UUID from AgentDatasetAccessValidationFailed.featureSchemaId
      featureDomain: String? from AgentDatasetAccessValidationFailed.featureDomain
      featureSchemaVersion: String? from AgentDatasetAccessValidationFailed.featureSchemaVersion
      datasetName: String from AgentDatasetAccessValidationFailed.datasetName
      runtimeId: UUID from AgentDatasetAccessValidationFailed.runtimeId
      runtimeName: String? from AgentDatasetAccessValidationFailed.runtimeName
      failureReason: String
    }

    specification "Agent Dataset Access Revalidation Outcome" {
      rule """
        Node operators can manually retry dataset access validation after correcting local credentials or data source configuration.
      """

      scenario "Agent Dataset Access Revalidated" {
        when RevalidateAgentDatasetAccess {
          datasetAccessValidationId = "55555555-5555-4555-8555-555555555555"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
        }
        then AgentDatasetAccessRevalidated
      }

      scenario "Agent Dataset Access Revalidation Failed" {
        when RevalidateAgentDatasetAccess {
          datasetAccessValidationId = "66666666-6666-4666-8666-666666666666"
          runtimeDatasetBindingId = "44444444-4444-4444-8444-444444444444"
        }
        then AgentDatasetAccessRevalidationFailed
      }
    }

    state Checked
  }

  slice AgentDatasetAccessValidationCatalog {
    readmodel AgentDatasetAccessValidationCatalog[] {
      datasetAccessValidationId: UUID id
      runtimeDatasetBindingId: UUID
      datasetId: UUID
      organizationId: UUID
      organizationName: String?
      featureSchemaId: UUID
      featureDomain: String?
      featureSchemaVersion: String?
      runtimeId: UUID
      datasetName: String?
      runtimeName: String?
      readable: Boolean
      schemaReadable: Boolean
      sampleBatchReadable: Boolean
      validationStatus: String
      failureReason: String?
      validatedAt: DateTime
      subscribe DatasetDeclared
      subscribe AgentDatasetAccessValidated
      subscribe AgentDatasetAccessValidationFailed
      subscribe AgentDatasetAccessRevalidated
      subscribe AgentDatasetAccessRevalidationFailed
    }
  }

  concept AgentDatasetAccessValidation {
    state Checked

    slice ValidateAgentDatasetAccess
    slice RevalidateAgentDatasetAccess
    slice AgentDatasetAccessValidationCatalog
  }

  slice ProfileAgentDataset {
    startsLifecycle
    actor RuntimeAgent
    reactsTo AgentDatasetAccessValidated
    // 获取连接，连接具体数据库，分析统计数据，需要具体的统计分析方法
    port

    tags {
      runtimeDatasetBindingId
    }

    automation ProfileDatasetWhenAccessValidated {
      on AgentDatasetAccessValidated
      emits ProfileAgentDataset
    }

    automation ProfileDatasetWhenAccessRevalidated {
      on AgentDatasetAccessRevalidated
      emits ProfileAgentDataset
    }

    command ProfileAgentDataset {
      metadataReportId: UUID id generated technical
      runtimeDatasetBindingId: UUID from AgentDatasetAccessValidated.runtimeDatasetBindingId
      datasetId: UUID from AgentDatasetAccessValidated.datasetId
      organizationId: UUID from AgentDatasetAccessValidated.organizationId
      organizationName: String? from AgentDatasetAccessValidated.organizationName
      featureSchemaId: UUID from AgentDatasetAccessValidated.featureSchemaId
      featureDomain: String? from AgentDatasetAccessValidated.featureDomain
      featureSchemaVersion: String? from AgentDatasetAccessValidated.featureSchemaVersion
      datasetName: String from AgentDatasetAccessValidated.datasetName
      runtimeId: UUID from AgentDatasetAccessValidated.runtimeId
      runtimeName: String? from AgentDatasetAccessValidated.runtimeName
    }

    event AgentDatasetMetadataReported {
      metadataReportId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from AgentDatasetAccessValidated.datasetId
      organizationId: UUID from AgentDatasetAccessValidated.organizationId
      organizationName: String? from AgentDatasetAccessValidated.organizationName
      runtimeId: UUID from AgentDatasetAccessValidated.runtimeId
      runtimeName: String? from AgentDatasetAccessValidated.runtimeName
      featureSchemaId: UUID from AgentDatasetAccessValidated.featureSchemaId
      featureDomain: String? from AgentDatasetAccessValidated.featureDomain
      featureSchemaVersion: String? from AgentDatasetAccessValidated.featureSchemaVersion
      datasetName: String from AgentDatasetAccessValidated.datasetName
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      missingValueRate: Decimal?
      duplicateRate: Decimal?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
    }

    event AgentDatasetProfilingFailed {
      metadataReportId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from AgentDatasetAccessValidated.datasetId
      organizationId: UUID from AgentDatasetAccessValidated.organizationId
      organizationName: String? from AgentDatasetAccessValidated.organizationName
      featureSchemaId: UUID from AgentDatasetAccessValidated.featureSchemaId
      featureDomain: String? from AgentDatasetAccessValidated.featureDomain
      featureSchemaVersion: String? from AgentDatasetAccessValidated.featureSchemaVersion
      datasetName: String from AgentDatasetAccessValidated.datasetName
      runtimeId: UUID from AgentDatasetAccessValidated.runtimeId
      runtimeName: String? from AgentDatasetAccessValidated.runtimeName
      failureReason: String
    }

    specification "Agent Dataset Profiling Outcome" {
      rule """
        After dataset access is validated, the runtime agent profiles the local dataset and reports complete metadata needed by platform-side dataset contract validation.
      """

      scenario "Agent Dataset Metadata Reported" {
        when ProfileAgentDataset {
          metadataReportId = "11111111-1111-4111-8111-111111111111"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
          datasetId = "33333333-3333-4333-8333-333333333333"
          organizationId = "44444444-4444-4444-8444-444444444444"
          featureSchemaId = "55555555-5555-4555-8555-555555555555"
          runtimeId = "66666666-6666-4666-8666-666666666666"
        }
        then AgentDatasetMetadataReported
      }

      scenario "Agent Dataset Profiling Failed" {
        when ProfileAgentDataset {
          metadataReportId = "77777777-7777-4777-8777-777777777777"
          runtimeDatasetBindingId = "88888888-8888-4888-8888-888888888888"
          datasetId = "99999999-9999-4999-8999-999999999999"
          organizationId = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
          featureSchemaId = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
          runtimeId = "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
        }
        then AgentDatasetProfilingFailed
      }
    }

    state Reported
  }

  slice ReprofileAgentDataset {
    actor NodeOperator
    ui RuntimeDatasetBindingScreen
    reactsTo AgentDatasetProfilingFailed
    port

    command ReprofileAgentDataset {
      metadataReportId: UUID id generated technical
      runtimeDatasetBindingId: UUID from AgentDatasetProfilingFailed.runtimeDatasetBindingId
    }

    event AgentDatasetReprofiled {
      metadataReportId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from AgentDatasetProfilingFailed.datasetId
      organizationId: UUID from AgentDatasetProfilingFailed.organizationId
      organizationName: String? from AgentDatasetProfilingFailed.organizationName
      runtimeId: UUID from AgentDatasetProfilingFailed.runtimeId
      runtimeName: String? from AgentDatasetProfilingFailed.runtimeName
      featureSchemaId: UUID from AgentDatasetProfilingFailed.featureSchemaId
      featureDomain: String? from AgentDatasetProfilingFailed.featureDomain
      featureSchemaVersion: String? from AgentDatasetProfilingFailed.featureSchemaVersion
      datasetName: String from AgentDatasetProfilingFailed.datasetName
      sampleCount: Int
      featureCount: Int
      schemaCompatible: Boolean?
      labelCompatible: Boolean?
      missingValueRate: Decimal?
      duplicateRate: Decimal?
      qualityScore: Decimal?
      nonIidScore: Decimal?
      classBalanceScore: Decimal?
    }

    event AgentDatasetReprofilingFailed {
      metadataReportId: UUID id technical
      runtimeDatasetBindingId: UUID
      datasetId: UUID from AgentDatasetProfilingFailed.datasetId
      organizationId: UUID from AgentDatasetProfilingFailed.organizationId
      organizationName: String? from AgentDatasetProfilingFailed.organizationName
      featureSchemaId: UUID from AgentDatasetProfilingFailed.featureSchemaId
      featureDomain: String? from AgentDatasetProfilingFailed.featureDomain
      featureSchemaVersion: String? from AgentDatasetProfilingFailed.featureSchemaVersion
      datasetName: String from AgentDatasetProfilingFailed.datasetName
      runtimeId: UUID from AgentDatasetProfilingFailed.runtimeId
      runtimeName: String? from AgentDatasetProfilingFailed.runtimeName
      failureReason: String
    }

    specification "Agent Dataset Reprofiling Outcome" {
      rule """
        Node operators can retry profiling after a profiling failure without resubmitting dataset identity fields; the current profile state supplies those identifiers.
      """

      scenario "Agent Dataset Reprofiled" {
        given AgentDatasetProfilingFailed {
          metadataReportId = "11111111-1111-4111-8111-111111111111"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
          datasetId = "33333333-3333-4333-8333-333333333333"
          organizationId = "44444444-4444-4444-8444-444444444444"
          featureSchemaId = "55555555-5555-4555-8555-555555555555"
          runtimeId = "66666666-6666-4666-8666-666666666666"
          failureReason = "CSV header could not be read"
        }
        when ReprofileAgentDataset {
          metadataReportId = "77777777-7777-4777-8777-777777777777"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
        }
        then AgentDatasetReprofiled
      }

      scenario "Agent Dataset Reprofiling Failed" {
        given AgentDatasetProfilingFailed {
          metadataReportId = "11111111-1111-4111-8111-111111111111"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
          datasetId = "33333333-3333-4333-8333-333333333333"
          organizationId = "44444444-4444-4444-8444-444444444444"
          featureSchemaId = "55555555-5555-4555-8555-555555555555"
          runtimeId = "66666666-6666-4666-8666-666666666666"
          failureReason = "CSV header could not be read"
        }
        when ReprofileAgentDataset {
          metadataReportId = "88888888-8888-4888-8888-888888888888"
          runtimeDatasetBindingId = "22222222-2222-4222-8222-222222222222"
        }
        then AgentDatasetReprofilingFailed
      }
    }

    state Reported
  }

  concept AgentDatasetProfile {
    state Reported

    slice ProfileAgentDataset
    slice ReprofileAgentDataset
  }

  slice ValidateDatasetContract {
    reactsTo AgentDatasetMetadataReported
    port

    automation ValidateDatasetContractAutomatically {
      on AgentDatasetMetadataReported
      emits ValidateDatasetContract
    }

    command ValidateDatasetContract {
      datasetId: UUID id technical from AgentDatasetMetadataReported.datasetId
      metadataReportId: UUID from AgentDatasetMetadataReported.metadataReportId
      featureSchemaId: UUID from AgentDatasetMetadataReported.featureSchemaId
    }

    event DatasetContractValidated {
      datasetId: UUID id technical
      featureSchemaId: UUID
      metadataReportId: UUID
      schemaCompatible: Boolean
      labelCompatible: Boolean
      qualityScore: Decimal
      nonIidScore: Decimal
    }

    event DatasetContractValidationFailed {
      datasetId: UUID id technical
      featureSchemaId: UUID
      metadataReportId: UUID
      schemaCompatible: Boolean
      labelCompatible: Boolean
      qualityScore: Decimal
      nonIidScore: Decimal
      failureReason: String generated technical
    }

    specification "Dataset Contract Validation Outcome" {
      rule """
        Dataset contract validation succeeds only when the reported dataset metadata is compatible with the expected feature schema and label contract.
      """

      scenario "Dataset Contract Validation Succeeded" {
        when ValidateDatasetContract {
          datasetId = "dataset-1"
          metadataReportId = "metadata-report-1"
          featureSchemaId = "feature-schema-1"
        }
        then DatasetContractValidated
      }

      scenario "Dataset Contract Validation Failed" {
        when ValidateDatasetContract {
          datasetId = "dataset-2"
          metadataReportId = "metadata-report-2"
          featureSchemaId = "feature-schema-1"
        }
        then DatasetContractValidationFailed
      }
    }

    state ContractValidationCompleted
  }

  slice RetryDatasetContractValidation {
    actor DataOwner
    ui DatasetRegistrationScreen
    reactsTo DatasetContractValidationFailed
    port

    command RetryDatasetContractValidation {
      datasetId: UUID id technical
    }

    event DatasetContractRevalidated {
      datasetId: UUID id technical
      featureSchemaId: UUID from DatasetContractValidationFailed.featureSchemaId
      metadataReportId: UUID from DatasetContractValidationFailed.metadataReportId
      schemaCompatible: Boolean from DatasetContractValidationFailed.schemaCompatible
      labelCompatible: Boolean from DatasetContractValidationFailed.labelCompatible
      qualityScore: Decimal from DatasetContractValidationFailed.qualityScore
      nonIidScore: Decimal from DatasetContractValidationFailed.nonIidScore
    }

    event DatasetContractRevalidationFailed {
      datasetId: UUID id technical
      featureSchemaId: UUID from DatasetContractValidationFailed.featureSchemaId
      metadataReportId: UUID from DatasetContractValidationFailed.metadataReportId
      schemaCompatible: Boolean from DatasetContractValidationFailed.schemaCompatible
      labelCompatible: Boolean from DatasetContractValidationFailed.labelCompatible
      qualityScore: Decimal from DatasetContractValidationFailed.qualityScore
      nonIidScore: Decimal from DatasetContractValidationFailed.nonIidScore
      failureReason: String generated technical
    }

    specification "Dataset Contract Validation Retry Outcome" {
      rule """
        A user can retry dataset contract validation after fixing local data, bindings, or feature schema synchronization issues. The retry uses the latest failed validation context from Dataset state and records a new validation outcome without requiring the user to resubmit metadata identifiers manually.
      """

      scenario "Dataset Contract Revalidated" {
        given DatasetContractValidationFailed {
          datasetId = "dataset-1"
          featureSchemaId = "feature-schema-1"
          metadataReportId = "metadata-report-1"
          schemaCompatible = false
          labelCompatible = false
          qualityScore = 0.40
          nonIidScore = 0.20
          failureReason = "CSV schema mismatch"
        }
        when RetryDatasetContractValidation {
          datasetId = "dataset-1"
        }
        then DatasetContractRevalidated
      }

      scenario "Dataset Contract Revalidation Failed" {
        given DatasetContractValidationFailed {
          datasetId = "dataset-2"
          featureSchemaId = "feature-schema-1"
          metadataReportId = "metadata-report-2"
          schemaCompatible = false
          labelCompatible = false
          qualityScore = 0.10
          nonIidScore = 0.30
          failureReason = "CSV label missing"
        }
        when RetryDatasetContractValidation {
          datasetId = "dataset-2"
        }
        then DatasetContractRevalidationFailed
      }
    }

    state ContractValidationCompleted
  }

  slice RejectDatasetForTraining {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetContractValidated

    command RejectDatasetForTraining {
      datasetId: UUID id technical
      rejectionReason: String
    }

    event DatasetRejectedForTraining {
      datasetId: UUID id technical
      rejectionReason: String
    }

    state Rejected
  }

  slice ApproveDatasetForTraining {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetContractValidated

    command ApproveDatasetForTraining {
      datasetId: UUID id technical
    }

    event DatasetApprovedForTraining {
      datasetId: UUID id technical
      organizationId: UUID derived {
        from Dataset.organizationId
        rule "Carry the owning organization for organization-level approved dataset counts."
      }
    }

    specification "Only Validated Quality Datasets Are Approved" {
      rule """
        A dataset can be approved only after contract validation succeeds with acceptable quality and schema compatibility.
      """

      scenario "Approve Validated Dataset" {
        given DatasetContractValidated {
          datasetId = "dataset-1"
          schemaCompatible = true
          labelCompatible = true
          qualityScore = 0.86
        }
        when ApproveDatasetForTraining {
          datasetId = "dataset-1"
        }
        then DatasetApprovedForTraining
      }

      scenario "Reject Approval Before Contract Validation" {
        when ApproveDatasetForTraining {
          datasetId = "dataset-2"
        }
        then reject "Dataset Contract Validation Required"
      }
    }

    state Approved
  }

  slice RevokeDatasetTrainingApproval {
    actor ComplianceOfficer
    ui DatasetApprovalScreen
    reactsTo DatasetApprovedForTraining

    command RevokeDatasetTrainingApproval {
      datasetId: UUID id technical
      revokeReason: String
    }

    event DatasetTrainingApprovalRevoked {
      datasetId: UUID id technical
      revokeReason: String
    }

    state ApprovalRevoked
  }

  slice DatasetCapability {
