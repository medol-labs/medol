import "./shared-types.medol"

domain Commerce {
  context Orders {
    slice SubmitOrder {
      startsLifecycle

      command SubmitOrder {
        orderId: UUID id
        shippingAddress: Address
        status: OrderStatus
      }

      event OrderSubmitted {
        orderId: UUID id
        shippingAddress: Address
        status: OrderStatus
      }
    }
    concept Order {
      slice SubmitOrder
    }
  }
}
