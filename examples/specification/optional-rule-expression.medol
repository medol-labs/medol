domain OptionalSpecificationDefinition {
  context OrganizationManagement {
    slice RegisterOrganization {
      command RegisterOrganization {
        organizationName: String
      }

      event OrganizationRegistered {
        organizationName: String
      }

      specification "Organization Registration Succeeds" {
        scenario "Register an organization" {
          when RegisterOrganization {
            organizationName = "Acme"
          }
          then OrganizationRegistered
        }
      }

      specification "Organization Registration Is Valid" {
        rule """
        """

        expression {
        }

        scenario "Register a valid organization" {
          when RegisterOrganization {
            organizationName = "Acme"
          }
          then OrganizationRegistered
        }
      }
    }
    concept Organization {
      slice RegisterOrganization
    }
  }
}
