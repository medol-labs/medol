context DataExchange {
  slice DataImportJob {
    startsLifecycle

    command RequestDataImport {
      dataImportJobId: UUID id
      commandName: String
      resourceName: String
      originalFileName: String
      filePath: String
      requestedLocale: String?
      requestedAt: DateTime
      requestHash: String
      status: String
    }

    event DataImportRequested {
      dataImportJobId: UUID id
      commandName: String
      resourceName: String
      originalFileName: String
      filePath: String
      requestedLocale: String?
      requestedAt: DateTime
      requestHash: String
      status: String
    }

    command MarkDataImportProcessing {
      dataImportJobId: UUID id
      totalRows: Long
      status: String
    }

    event DataImportProcessingStarted {
      dataImportJobId: UUID id
      totalRows: Long
      status: String
    }

    command CompleteDataImport {
      dataImportJobId: UUID id
      totalRows: Long
      successRows: Long
      failedRows: Long
      failureIndexPath: String?
      status: String
    }

    event DataImportCompleted {
      dataImportJobId: UUID id
      totalRows: Long
      successRows: Long
      failedRows: Long
      failureIndexPath: String?
      status: String
    }

    command FailDataImport {
      dataImportJobId: UUID id
      errorMessage: Text
      status: String
    }

    event DataImportFailed {
      dataImportJobId: UUID id
      errorMessage: Text
      status: String
    }

    automation ExecuteDataImport {
      on DataImportRequested
      uses PlatformDataExchange.import
      emits MarkDataImportProcessing
      emits CompleteDataImport
      emits FailDataImport
    }

    readmodel DataImportJobCatalog[] {
      dataImportJobId: UUID id
      commandName: String query
      resourceName: String query
      originalFileName: String display
      filePath: String
      requestedLocale: String?
      requestedAt: DateTime
      requestHash: String
      status: String query
      totalRows: Long?
      successRows: Long?
      failedRows: Long?
      failureIndexPath: String?
      errorMessage: Text?
    }
  }

  slice DataExportJob {
    startsLifecycle

    command RequestDataExport {
      dataExportJobId: UUID id
      resourceName: String
      criteriaJson: Text
      sortJson: Text
      columnsJson: Text
      requestedLocale: String?
      requestedAt: DateTime
      snapshotUpperBound: DateTime
      requestHash: String
      fileName: String
      status: String
    }

    event DataExportRequested {
      dataExportJobId: UUID id
      resourceName: String
      criteriaJson: Text
      sortJson: Text
      columnsJson: Text
      requestedLocale: String?
      requestedAt: DateTime
      snapshotUpperBound: DateTime
      requestHash: String
      fileName: String
      status: String
    }

    command MarkDataExportProcessing {
      dataExportJobId: UUID id
      status: String
    }

    event DataExportProcessingStarted {
      dataExportJobId: UUID id
      status: String
    }

    command CompleteDataExport {
      dataExportJobId: UUID id
      fileName: String
      filePath: String
      rowCount: Long
      status: String
    }

    event DataExportCompleted {
      dataExportJobId: UUID id
      fileName: String
      filePath: String
      rowCount: Long
      status: String
    }

    command FailDataExport {
      dataExportJobId: UUID id
      errorMessage: Text
      status: String
    }

    event DataExportFailed {
      dataExportJobId: UUID id
      errorMessage: Text
      status: String
    }

    automation ExecuteDataExport {
      on DataExportRequested
      uses PlatformDataExchange.export
      emits MarkDataExportProcessing
      emits CompleteDataExport
      emits FailDataExport
    }

    readmodel DataExportJobCatalog[] {
      dataExportJobId: UUID id
      resourceName: String display
      criteriaJson: Text
      sortJson: Text
      columnsJson: Text
      requestedLocale: String?
      requestedAt: DateTime
      snapshotUpperBound: DateTime
      requestHash: String
      status: String query
      fileName: String?
      filePath: String?
      rowCount: Long?
      errorMessage: Text?
    }
  }
}
