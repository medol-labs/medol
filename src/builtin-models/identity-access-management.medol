domain IdentityAccessManagement {
  context IdentityAccessManagement {
    slice RegisterUserAccount {
      startsLifecycle
      actor IdentityAdministrator

      command RegisterUserAccount {
        userAccountId: UUID id generated technical
        username: String
        providerSubject: String? technical
        passwordHash: String? technical
      }

      event UserAccountRegistered {
        userAccountId: UUID id technical
        username: String
        providerSubject: String? technical
        passwordHash: String? technical
      }

      state Active

      specification "User Account Username Unique" {
        rule """
          Active user account usernames must be unique.
        """

        scenario "Reject Duplicate Username" {
          given UserAccountRegistered {
            username = "admin"
          }
          when RegisterUserAccount {
            username = "admin"
          }
          then reject "Username already exists."
        }
      }
    }

    slice DeactivateUserAccount {
      actor IdentityAdministrator

      command DeactivateUserAccount {
        userAccountId: UUID id technical
        reason: String
      }

      event UserAccountDeactivated {
        userAccountId: UUID id technical
        reason: String
      }

      state Deactivated
    }

    slice GenerateUserAccountLoginPassword {
      actor IdentityAdministrator
      reactsTo UserAccountRegistered
      port

      command GenerateUserAccountLoginPassword {
        userAccountId: UUID id technical
        passwordResetRequired: Boolean

        result {
          temporaryPassword: String technical
        }
      }

      event UserAccountLoginPasswordGenerated {
        userAccountId: UUID id technical
        passwordHash: String portOutput technical
        passwordResetRequired: Boolean
      }
    }

    slice RegisterRole {
      startsLifecycle
      actor IdentityAdministrator

      tags {
        roleCode = normalize(roleCode)
      }

      command RegisterRole {
        roleId: UUID id generated technical
        roleCode: String
        roleName: String
      }

      event RoleRegistered {
        roleId: UUID id technical
        roleCode: String
        roleName: String
      }

      state Registered
    }

    slice RegisterPermission {
      startsLifecycle
      actor IdentityAdministrator

      tags {
        permissionCode = normalize(permissionCode)
      }

      command RegisterPermission {
        permissionId: UUID id generated technical
        permissionCode: String
        permissionName: String
        description: String?
      }

      event PermissionRegistered {
        permissionId: UUID id technical
        permissionCode: String
        permissionName: String
        description: String?
      }

      state Registered
    }

    slice GrantPermissionToRole {
      actor IdentityAdministrator

      command GrantPermissionToRole {
        roleId: UUID id from RoleCatalog.roleId
        roleCode: String from RoleCatalog.roleCode
        permissionCodes: String[] from PermissionCatalog.permissionCode
      }

      event PermissionGrantedToRole {
        roleId: UUID id technical
        roleCode: String
        permissionCode: String
      }

      event PermissionRevokedFromRole {
        roleId: UUID id technical
        roleCode: String
        permissionCode: String
      }

      state Registered

    }

    slice AssignRoleToUser {
      actor IdentityAdministrator

      command AssignRoleToUser {
        userAccountId: UUID id from UserAccountCatalog.userAccountId
        roleCodes: String[] from RoleCatalog.roleCode
      }

      event RoleAssignedToUser {
        userAccountId: UUID id technical
        roleCode: String
      }

      event RoleUnassignedFromUser {
        userAccountId: UUID id technical
        roleCode: String
      }

      state Active

    }

    slice IssueServiceAccountApiToken {
      startsLifecycle
      actor SuperAdministrator
      port
      tags {
        userAccountId
      }

      command IssueServiceAccountApiToken {
        apiTokenId: UUID id generated technical
        userAccountId: UUID from UserAccountCatalog.userAccountId
        tokenName: String

        result {
          apiToken: String technical
        }
      }

      event ServiceAccountApiTokenIssued {
        apiTokenId: UUID id technical
        userAccountId: UUID
        username: String portOutput
        tokenName: String
        tokenPrefix: String portOutput
        tokenDigest: String portOutput technical
        issuedAt: LocalDateTime
        roles: String[] portOutput
        permissions: String[] portOutput
      }

      state Issued

      specification "Only Super Administrator Can Issue Service Account Api Token" {
        rule """
          Service account API tokens are intended for third-party system integration only.
          Normal users do not issue tokens for themselves. A super administrator creates
          a dedicated service account user, grants the required roles, and issues a long-lived
          token for that account.
        """

        scenario "Super Administrator Issues Token For Service Account" {
          given UserAccountRegistered {
            userAccountId = "00000000-0000-0000-0000-000000000001"
            username = "dictionary-sync-service"
          }
          when IssueServiceAccountApiToken {
            userAccountId = "00000000-0000-0000-0000-000000000001"
            tokenName = "dictionary init"
          }
          then ServiceAccountApiTokenIssued
        }
      }

      specification "Service Account Api Token Plaintext Returned Once" {
        rule """
          The generated API token plaintext is returned only as the command result.
          Domain events and read models store only the token prefix and token digest.
        """

        scenario "Issued Event Stores Digest Instead Of Plaintext Token" {
          when IssueServiceAccountApiToken {
            tokenName = "offline integration"
          }
          then ServiceAccountApiTokenIssued
        }
      }

      specification "Service Account Api Token Captures Permission Snapshot" {
        rule """
          The issued token carries the service account roles and permissions at issuance time.
          When permissions change, the operator generates a new token for the service account.
        """

        scenario "Issued Token Captures Current Permissions" {
          given RoleAssignedToUser {
            roleCode = "DictionaryInitializer"
          }
          given PermissionGrantedToRole {
            roleCode = "DictionaryInitializer"
            permissionCode = "register_dictionary:execute"
          }
          when IssueServiceAccountApiToken {
            tokenName = "dictionary initializer"
          }
          then ServiceAccountApiTokenIssued
        }
      }
    }

    slice UserAccountCatalogs {
      actor IdentityAdministrator

      readmodel UserAccountCatalog[] {
        userAccountId: UUID id
        username: String display
        providerSubject: String?
        passwordHash: String? technical
        active: Boolean
        subscribe UserAccountRegistered
        subscribe UserAccountLoginPasswordGenerated
        subscribe UserAccountDeactivated
      }
    }

    slice RoleCatalogs {
      actor IdentityAdministrator

      readmodel RoleCatalog[] {
        roleId: UUID id
        roleCode: String
        roleName: String display
        subscribe RoleRegistered
      }
    }

    slice PermissionCatalogs {
      actor IdentityAdministrator

      readmodel PermissionCatalog[] {
        permissionId: UUID id
        permissionCode: String
        permissionName: String display
        description: String?
        subscribe PermissionRegistered
      }
    }

    slice UserRoleAssignmentCatalog {
      actor IdentityAdministrator

      readmodel UserRoleAssignmentCatalog[] {
        userAccountId: UUID id
        username: String? display derived from UserAccountCatalog.username by userAccountId
        roleCode: String id
        roleName: String? derived from RoleCatalog.roleName by roleCode
        subscribe RoleAssignedToUser
      }
    }

    slice RolePermissionGrantCatalog {
      actor IdentityAdministrator

      readmodel RolePermissionGrantCatalog[] {
        roleId: UUID
        roleCode: String id display derived from RoleCatalog.roleCode by roleId
        roleName: String? derived from RoleCatalog.roleName by roleId
        permissionCode: String id
        permissionName: String? derived from PermissionCatalog.permissionName by permissionCode
        subscribe PermissionGrantedToRole
      }
    }

    slice ServiceAccountApiTokenCatalogs {
      actor SuperAdministrator

      readmodel ServiceAccountApiTokenCatalog[] {
        apiTokenId: UUID id
        userAccountId: UUID
        username: String display
        tokenName: String display
        tokenPrefix: String display
        issuedAt: LocalDateTime
        roles: String[]
        permissions: String[]
        subscribe ServiceAccountApiTokenIssued
      }
    }

    concept UserAccount {
      state Active
      state Deactivated
      slice RegisterUserAccount
      slice GenerateUserAccountLoginPassword
      slice DeactivateUserAccount
      slice AssignRoleToUser
      slice UserAccountCatalogs
    }

    concept Role {
      state Registered
      slice RegisterRole
      slice GrantPermissionToRole
      slice RoleCatalogs
    }

    concept Permission {
      state Registered
      slice RegisterPermission
      slice PermissionCatalogs
    }

    concept UserRoleAssignment {
      slice UserRoleAssignmentCatalog
    }

    concept RolePermissionGrant {
      slice RolePermissionGrantCatalog
    }

    concept ServiceAccountApiToken {
      state Issued
      slice IssueServiceAccountApiToken
      slice ServiceAccountApiTokenCatalogs
    }

  }
}
